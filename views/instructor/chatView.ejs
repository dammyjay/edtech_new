<%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>

<div class="dm-page">

  <div class="dm-header">
    <img src="<%= student.profile_picture || '/images/profile male.png' %>" class="dm-header-avatar" alt="">
    <div class="dm-header-info">
      <h2><%= student.fullname %></h2>
      <p><%= student.email %></p>
    </div>
    <% if (messages.length > 0) { %>
      <span class="dm-streak">💬 <%= messages.length %> messages</span>
    <% } %>
  </div>

  <div id="chatContainer" class="dm-messages"></div>

  <div class="dm-input-bar">
    <textarea id="chatMessage" rows="1" placeholder="Type your message..." onkeydown="if(event.key==='Enter' && !event.shiftKey){event.preventDefault(); sendMessage();}"></textarea>
    <button class="dm-send-btn" onclick="sendMessage()" title="Send">➤</button>
  </div>

  <a href="/instructor/chats" class="dm-header-back" style="display:inline-block; margin-top:14px;">← Back to Chats</a>

</div>

<script>
const studentId = "<%= student.id %>";
const instructorAvatar = "<%= profilePic || '/images/profile male.png' %>";
const studentAvatar = "<%= student.profile_picture || '/images/profile male.png' %>";
const chatContainer = document.getElementById('chatContainer');

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function renderMessages(messages) {
  if (!messages.length) {
    chatContainer.innerHTML = '<p class="dm-empty">No messages yet — say hello 👋</p>';
    return;
  }

  let html = '';
  let lastDay = null;

  messages.forEach(msg => {
    const date = new Date(msg.created_at);
    const dayKey = date.toDateString();
    if (dayKey !== lastDay) {
      html += `<div class="dm-day-divider">${date.toLocaleDateString(undefined, { weekday: 'long', month: 'short', day: 'numeric' })}</div>`;
      lastDay = dayKey;
    }

    const isSelf = msg.sender === 'self';
    let statusIcon = '';
    if (isSelf) {
      if (msg.is_read) statusIcon = '✅✅';
      else if (msg.is_delivered) statusIcon = '✅';
      else statusIcon = '⏳';
    }

    html += `
      <div class="dm-msg-row ${isSelf ? 'dm-self' : 'dm-other'}">
        <img class="dm-msg-avatar" src="${isSelf ? instructorAvatar : studentAvatar}" alt="">
        <div class="dm-bubble">
          ${escapeHtml(msg.message)}
          <span class="dm-meta">${date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} ${statusIcon}</span>
        </div>
      </div>`;
  });

  chatContainer.innerHTML = html;
  chatContainer.scrollTop = chatContainer.scrollHeight;
}

renderMessages(<%- JSON.stringify(messages).replace(/</g, '\\u003c') %>);

async function sendMessage() {
  const input = document.getElementById('chatMessage');
  const message = input.value.trim();
  if (!message) return showAlert('Please type a message.');

  try {
    const res = await fetch('/instructor/chat/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ receiverId: studentId, message })
    });

    const data = await res.json();
    if (data.success) {
      input.value = '';
      await loadNewMessages();
    } else {
      showAlert('❌ ' + data.message);
    }
  } catch (err) {
    console.error('Send message error:', err);
    showAlert('Server error sending message.');
  }
}

async function loadNewMessages() {
  try {
    const res = await fetch(`/instructor/chat/messages/${studentId}`);
    const messages = await res.json();
    renderMessages(messages);
  } catch (err) {
    console.error('Error loading messages:', err);
  }
}

setInterval(loadNewMessages, 5000);

(async () => {
  try {
    await fetch(`/instructor/chat/markRead/${studentId}`, { method: 'POST' });
  } catch (err) {
    console.warn('Failed to mark messages as read:', err);
  }
})();
</script>
