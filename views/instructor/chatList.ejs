<%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>

<div class="dm-list-wrap">

  <h2 style="margin-top:20px;">💬 Your Chat Conversations</h2>

  <div style="margin:20px 0;">
    <button class="chat-tab active" onclick="showTab('privateChat')">
      💬 Private Chat
    </button>

    <button class="chat-tab" onclick="showTab('classChat')">
      📚 Class Groups
    </button>
  </div>

  <div id="privateChat">

    <form id="searchForm" class="dm-search-bar">
      <input type="text" id="searchInput" placeholder="🔍 Search student by name or class" />
      <button type="submit">Search</button>
    </form>

    <div id="searchResults"></div>

    <h3 style="margin:18px 0 10px;">Previous Chats</h3>

    <% if (chats.length > 0) { %>
      <div class="dm-list">
        <% chats.forEach(c => { %>
          <a href="/instructor/chats/<%= c.student_id %>" class="dm-list-item <%= c.unread_count > 0 ? 'dm-unread' : '' %>">
            <img src="<%= c.profile_picture || '/images/profile male.png' %>" class="dm-list-avatar" alt="">
            <div class="dm-list-body">
              <div class="dm-list-top">
                <span class="dm-list-name"><%= c.student_name %></span>
                <span class="dm-list-time"><%= new Date(c.last_message_time).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %></span>
              </div>
              <div class="dm-list-preview">
                <%= c.last_message_sender_id == user.id ? 'You: ' : '' %><%= c.last_message %>
              </div>
            </div>
            <% if (c.unread_count > 0) { %>
              <span class="dm-unread-badge"><%= c.unread_count %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="dm-empty-state">No chat conversations yet — search for a student above to start one.</div>
    <% } %>

  </div>

  <div id="classChat" style="display:none;">
    <select id="schoolFilter" style="padding:8px 14px; border-radius:20px; border:1.8px solid #ddd; margin-bottom:14px;">
      <option value="">All Schools</option>
      <% classes.forEach(c => { %>
      <option value="<%= c.school_name %>"><%= c.school_name %></option>
      <% }) %>
    </select>

    <h3 style="margin-bottom:10px;">📚 School Class Groups</h3>
    <% if (classes && classes.length > 0) { %>
      <div class="dm-list">
        <% classes.forEach(c => { %>
          <a href="/instructor/class-chat/<%= c.id %>" class="dm-list-item" data-school="<%= c.school_name %>">
            <div class="dm-list-avatar" style="background:var(--brand-pri-light); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700;">
              <%= c.name.charAt(0).toUpperCase() %>
            </div>
            <div class="dm-list-body">
              <div class="dm-list-name"><%= c.name %></div>
              <div class="dm-list-preview"><%= c.school_name %></div>
            </div>
            <span style="color:var(--brand-pri-dark); font-weight:600; font-size:13px;">Open →</span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="dm-empty-state">No classes found</div>
    <% } %>
  </div>

</div>

<script>
  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  document.getElementById("searchForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const query = document.getElementById("searchInput").value.trim();
    if (!query) return showAlert("Enter a student name or class");

    const res = await fetch(`/instructor/search-student?q=${encodeURIComponent(query)}`);
    const data = await res.json();

    const container = document.getElementById("searchResults");
    container.innerHTML = "";

    if (data.length === 0) {
      container.innerHTML = "<div class='dm-empty-state'>No matching students found.</div>";
      return;
    }

    const list = document.createElement("div");
    list.className = "dm-list";
    list.style.marginBottom = "16px";
    list.innerHTML = data.map(s => `
      <a href="/instructor/chats/${s.id}" class="dm-list-item">
        <img src="/images/profile male.png" class="dm-list-avatar" alt="">
        <div class="dm-list-body">
          <div class="dm-list-name">${escapeHtml(s.fullname)}</div>
          <div class="dm-list-preview">${escapeHtml(s.email)}</div>
        </div>
        <span style="color:var(--brand-pri-dark); font-weight:600; font-size:13px;">💬 Chat</span>
      </a>
    `).join("");
    container.appendChild(list);
  });
</script>

<script>
  document.getElementById("schoolFilter").addEventListener("change", function () {
    const school = this.value;
    document.querySelectorAll("#classChat .dm-list-item").forEach(row => {
      row.style.display = (!school || row.dataset.school === school) ? "" : "none";
    });
  });
</script>

<script>
  function showTab(tab) {
    document.getElementById("privateChat").style.display = "none";
    document.getElementById("classChat").style.display = "none";
    document.getElementById(tab).style.display = "block";

    document.querySelectorAll(".chat-tab").forEach(btn => btn.classList.remove("active"));
    event.target.classList.add("active");
  }
</script>
