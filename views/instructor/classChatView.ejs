<%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>

<h2 class="class-title">📚 Class Chat: <%= classroom.name %></h2>

<div class="chat-layout">

    <!-- LEFT: Chat -->
    <div class="chat-section">

        <div id="chatContainer" class="chat-box">

            <% messages.forEach(msg => { %>

            <div class="chat-msg">

                <div class="chat-name">

                    <img src="<%= msg.profile_picture %>" 
                    class="chat-avatar">

                    <%= msg.fullname %>

                    <span class="chat-role role-<%= msg.role %>">
                        <%= msg.role %>
                    </span>

                </div>

                <div class="chat-bubble msg-<%= msg.role %>">

                    <%= msg.message %>

                    <br>

                    <small class="chat-time">
                        <%= new Date(msg.created_at).toLocaleTimeString() %>
                    </small>

                </div>

            </div>

            <% }) %>

        </div>

        <div class="chat-input-area">

            <textarea
            id="chatMessage"
            rows="2"
            placeholder="Type message to class..."
            ></textarea>

            <button onclick="sendClassMessage()">
                Send
            </button>

        </div>

    </div>

    <!-- RIGHT: Student List -->

    <div class="student-section">

        <h3>👩‍🎓 Students</h3>

        <% students.forEach(s => { %>

        <div class="student-row">

            <div>
                <b><%= s.fullname %></b><br>
                <small><%= s.email %></small>
            </div>

            <div class="student-actions">

                <a  href="/instructor/chats/<%= s.id %>" class="chat-btn">
                    💬
                </a>

                <button onclick="muteStudent(<%= s.id %>)" class="mute-btn">
                    🔇
                </button>

                <button onclick="unmuteStudent(<%= s.id %>)" class="unmute-btn">
                    🔊
                </button>

            </div>

        </div>

        <% }) %>

    </div>

</div>

<script>

    const classroomId = "<%= classroom.id %>"
    const chatContainer = document.getElementById('chatContainer')

    chatContainer.scrollTop = chatContainer.scrollHeight

    async function muteStudent(studentId){

        await fetch("/instructor/mute-student",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
                classroomId,
                studentId
            })
        })

        alert("Student muted")

    }

    async function unmuteStudent(studentId){

        await fetch("/instructor/unmute-student",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
                classroomId,
                studentId
            })
        })

        alert("Student unmuted")

    }

    async function sendClassMessage(){

        const message = document.getElementById('chatMessage').value.trim()

        if(!message) return

        await fetch('/instructor/class/send',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
        classroomId,
        message
        })
        })

        document.getElementById('chatMessage').value=""

        loadMessages()

    }


    async function loadMessages(){

        const res = await fetch(`/instructor/class/messages/${classroomId}`)
        const messages = await res.json()

        chatContainer.innerHTML=""

        messages.forEach(msg=>{

            const div=document.createElement("div")
            div.className="chat-msg"

            const avatar = msg.profile_picture
                ? `<img src="${msg.profile_picture}" class="chat-avatar">`
                : `<img src="/images/profile male.png" class="chat-avatar">`

            div.innerHTML=`

            <div class="chat-row">

                ${avatar}

                <div>

                    <div class="chat-name">
                        ${msg.fullname}

                        <span class="chat-role role-${msg.role}">
                            ${msg.role}
                        </span>
                    </div>

                    <div class="chat-bubble msg-${msg.role}">
                        ${msg.message}

                        <br>

                        <small style="color:gray;font-size:10px;">
                            ${new Date(msg.created_at).toLocaleTimeString()}
                        </small>
                    </div>

                </div>

            </div>
            `

            chatContainer.appendChild(div)

        })

        chatContainer.scrollTop = chatContainer.scrollHeight
    }

    setInterval(loadMessages,5000)

</script>