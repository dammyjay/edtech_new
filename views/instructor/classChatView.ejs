<%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>

<h2 class="class-title">📚 Class Chat: <%= classroom.name %></h2>
<!-- <div class="display:flex">
    <button class="btn-black" onclick="lockChat()">🔒 Lock Chat</button>
    <button class="btn-black" onclick="unlockChat()">🔓 Unlock Chat</button>
</div> -->

<button id="chatToggleBtn" class="btn-black" onclick="toggleChatLock()"></button>
<div class="chat-layout">

    <!-- LEFT: Chat -->
    <div class="chat-section">

        <div id="chatContainer" class="chat-box">

            <% messages.forEach(msg => { %>

            <div class="chat-msg">

                <div class="chat-name">

                    <img src="<%= msg.profile_picture %>" 
                    class="chat-avatar">

                    <%= msg.fullname %>

                    <span class="chat-role role-<%= msg.role %>">
                        <%= msg.role %>
                    </span>
                    <button onclick="deleteMessage(<%= msg.id %>)" style="margin-left:8px;">🗑</button>
                </div>

                <div class="chat-bubble msg-<%= msg.role %>">

                   <% if (msg.role !== 'instructor') { %>
                    <button onclick="deleteMessage(<%= msg.id %>)" class="delete-msg">
                    🗑
                    </button>
                    <% } %>

                    <br>

                    <small class="chat-time">
                        <%= new Date(msg.created_at).toLocaleTimeString() %>
                    </small>

                </div>

            </div>

            <% }) %>

        </div>

        <div class="chat-input-area">

            <textarea
            id="chatMessage"
            rows="2"
            placeholder="Type message to class..."
            ></textarea>

            <button onclick="sendClassMessage()">
                Send
            </button>

        </div>

    </div>

    <!-- RIGHT: Student List -->

    <div class="student-section">

        <h3>👩‍🎓 Students</h3>

        <% students.forEach(s => { %>

        <div class="student-row">

            <div>
                <b><%= s.fullname %></b><br>
                <small><%= s.email %></small>
            </div>

            <div class="student-actions">

                <a  href="/instructor/chats/<%= s.id %>" class="chat-btn">
                    💬
                </a>

                <button onclick="muteStudent(<%= s.id %>)" class="mute-btn">
                    🔇
                </button>

                <button onclick="unmuteStudent(<%= s.id %>)" class="unmute-btn">
                    🔊
                </button>

            </div>

        </div>

        <% }) %>

    </div>

</div>

<script>

    const classroomId = "<%= classroom.id %>"
    const chatContainer = document.getElementById('chatContainer')
    const bannedWords = [
        "stupid",
        "idiot",
        "hate",
        "fool",
        "nonsense"
    ]

    chatContainer.scrollTop = chatContainer.scrollHeight

    async function muteStudent(studentId){

        await fetch("/instructor/mute-student",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
                classroomId,
                studentId
            })
        })

        alert("Student muted")

    }

    async function unmuteStudent(studentId){

        await fetch("/instructor/unmute-student",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
                classroomId,
                studentId
            })
        })

        alert("Student unmuted")

    }

    async function sendClassMessage(){

        const message = document.getElementById('chatMessage').value.trim()

        if(!message) return

        await fetch('/instructor/class/send',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
        classroomId,
        message
        })
        })

        document.getElementById('chatMessage').value=""

        loadMessages()

    }


    async function loadMessages(){

        const res = await fetch(`/instructor/class/messages/${classroomId}`)
        const messages = await res.json()

        chatContainer.innerHTML=""

        messages.forEach(msg=>{

            const div=document.createElement("div")
            div.className="chat-msg"

            const avatar = msg.profile_picture
                ? `<img src="${msg.profile_picture}" class="chat-avatar">`
                : `<img src="/images/profile male.png" class="chat-avatar">`

            // div.innerHTML=`

            // <div class="chat-row">

            //     ${avatar}

            //     <div>

            //         <div class="chat-name">
            //             ${msg.fullname}

            //             <span class="chat-role role-${msg.role}">
            //                 ${msg.role}
            //             </span>
            //         </div>

            //         <div class="chat-bubble msg-${msg.role}">
            //             ${msg.message}

            //             <br>

            //             <small style="color:gray;font-size:10px;">
            //                 ${new Date(msg.created_at).toLocaleTimeString()}
            //             </small>
            //         </div>

            //     </div>

            // </div>
            // `

                div.innerHTML=`
                <div class="chat-row">

                    ${avatar}

                    <div>

                        <div class="chat-name">
                            ${msg.fullname}

                            <span class="chat-role role-${msg.role}">
                                ${msg.role}
                            </span>

                        </div>

                        <div class="chat-bubble msg-${msg.role}">
                            ${msg.message}

                            <br>
                            
                            <small style="color:gray;font-size:10px;">
                                ${new Date(msg.created_at).toLocaleTimeString()}
                            </small>
                            <span>
                            ${msg.role !== 'instructor' ? `
                            <button class="btn-nobg" onclick="deleteMessage(${msg.id})" style="margin-left:8px;">
                            🗑
                            </button>
                            ` : ''}
                            </span>
                        </div>

                    </div>

                </div>
                `

            chatContainer.appendChild(div)

        })

        chatContainer.scrollTop = chatContainer.scrollHeight
    }

    let chatLocked = <%= classroom.chat_locked ? "true" : "false" %>

    function updateLockButton(){

        const btn = document.getElementById("chatToggleBtn")

        if(chatLocked){

            btn.innerText = "🔓 Unlock Chat"
            btn.style.background = "#28a745"
            btn.style.color = "#fff"

        }else{

            btn.innerText = "🔒 Lock Chat"
            btn.style.background = "#000"
            btn.style.color = "#fff"

        }

    }

   async function lockChat(){

        await fetch("/instructor/class/lock",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ classroomId })
        })

        alert("Chat locked")

    }

    async function unlockChat(){

    await fetch("/instructor/class/unlock",{
        method:"POST",
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ classroomId })
    })

    alert("Chat unlocked")

    }

    async function deleteMessage(messageId){

        if(!confirm("Delete this message?")) return

        await fetch("/instructor/class/delete-message",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({messageId})
        })

        loadMessages()

    }
   
    async function toggleChatLock(){

        const url = chatLocked
            ? "/instructor/class/unlock"
            : "/instructor/class/lock"

        const res = await fetch(url,{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ classroomId })
        })

        const data = await res.json()

        if(data.success){

            chatLocked = !chatLocked
            updateLockButton()

        }else{
            alert("Action failed")
        }

    }

    updateLockButton()
    setInterval(loadMessages,5000)

</script>