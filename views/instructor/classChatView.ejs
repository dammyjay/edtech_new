<%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>

<div class="gc-header">
  <div class="gc-header-icon">📚</div>
  <div class="gc-header-info">
    <h2><%= classroom.name %></h2>
    <p><%= students.length %> student<%= students.length === 1 ? '' : 's' %> in this class</p>
  </div>
  <button id="chatToggleBtn" class="gc-lock-toggle" onclick="toggleChatLock()"></button>
</div>

<div class="chat-layout">

    <!-- LEFT: Chat -->
    <div class="chat-section">

        <div id="chatContainer" class="chat-box"></div>

        <div class="chat-input-area gc-input-bar">

            <textarea
            id="chatMessage"
            rows="1"
            placeholder="Type message to class..."
            onkeydown="if(event.key==='Enter' && !event.shiftKey){event.preventDefault(); sendClassMessage();}"
            ></textarea>

            <button class="gc-send-btn" onclick="sendClassMessage()" title="Send">➤</button>

        </div>

    </div>

    <!-- RIGHT: Student List -->

    <div class="student-section">

        <h3>👩‍🎓 Students</h3>

        <% students.forEach(s => { %>

        <div class="student-row">

            <div style="display:flex; align-items:center; gap:10px;">
                <div class="gc-student-avatar-wrap">
                    <img src="<%= s.profile_picture || '/images/profile male.png' %>" class="chat-avatar" style="width:32px; height:32px;">
                    <% if (s.muted) { %>
                        <span class="gc-muted-dot" title="Muted">🔇</span>
                    <% } %>
                </div>
                <div>
                    <b><%= s.fullname %></b><br>
                    <small><%= s.email %></small>
                </div>
            </div>

            <div class="student-actions">

                <a  href="/instructor/chats/<%= s.id %>" class="chat-btn">
                    💬
                </a>

                <% if (s.muted) { %>
                    <button onclick="unmuteStudent(<%= s.id %>)" class="unmute-btn">🔊</button>
                <% } else { %>
                    <button onclick="muteStudent(<%= s.id %>)" class="mute-btn">🔇</button>
                <% } %>

            </div>

        </div>

        <% }) %>

    </div>

</div>

<script>

    const classroomId = "<%= classroom.id %>"
    const currentUserId = <%= user.id %>
    const chatContainer = document.getElementById('chatContainer')

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function renderMessages(messages) {
        if (!messages.length) {
            chatContainer.innerHTML = '<p style="text-align:center; color:#999;">No messages yet — start the conversation 👋</p>';
            return;
        }

        chatContainer.innerHTML = messages.map(msg => {
            const isSelf = Number(msg.sender_id) === Number(currentUserId);
            const avatar = msg.profile_picture || '/images/profile male.png';

            return `
                <div class="chat-msg gc-msg-row ${isSelf ? 'gc-self' : ''}">
                    <img src="${avatar}" class="chat-avatar">
                    <div>
                        <div class="chat-name">
                            ${escapeHtml(msg.fullname)}
                            <span class="chat-role role-${msg.role}">${msg.role}</span>
                        </div>
                        <div class="chat-bubble msg-${msg.role}">
                            ${escapeHtml(msg.message)}
                            <br>
                            <small class="chat-time">${new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</small>
                            ${msg.role !== 'instructor' || isSelf ? `<button class="btn-nobg" onclick="deleteMessage(${msg.id})" style="margin-left:8px;">🗑</button>` : ''}
                        </div>
                    </div>
                </div>
            `;
        }).join('');

        chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    async function muteStudent(studentId){
        await fetch("/instructor/mute-student",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ classroomId, studentId })
        })
        location.reload()
    }

    async function unmuteStudent(studentId){
        await fetch("/instructor/unmute-student",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ classroomId, studentId })
        })
        location.reload()
    }

    async function sendClassMessage(){
        const input = document.getElementById('chatMessage')
        const message = input.value.trim()
        if(!message) return

        await fetch('/instructor/class/send',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ classroomId, message })
        })

        input.value = ""
        loadMessages()
    }

    async function loadMessages(){
        const res = await fetch(`/instructor/class/messages/${classroomId}`)
        const messages = await res.json()
        renderMessages(messages)
    }

    let chatLocked = <%= classroom.chat_locked ? "true" : "false" %>

    function updateLockButton(){
        const btn = document.getElementById("chatToggleBtn")
        if(chatLocked){
            btn.innerText = "🔓 Unlock Chat"
            btn.style.background = "#28a745"
        }else{
            btn.innerText = "🔒 Lock Chat"
            btn.style.background = "#c0392b"
        }
    }

    async function deleteMessage(messageId){
        if(!(await showConfirm("Delete this message?"))) return
        await fetch("/instructor/class/delete-message",{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({messageId})
        })
        loadMessages()
    }

    async function toggleChatLock(){
        const url = chatLocked ? "/instructor/class/unlock" : "/instructor/class/lock"
        const res = await fetch(url,{
            method:"POST",
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ classroomId })
        })
        const data = await res.json()
        if(data.success){
            chatLocked = !chatLocked
            updateLockButton()
        }else{
            showAlert("Action failed")
        }
    }

    renderMessages(<%- JSON.stringify(messages).replace(/</g, '\\u003c') %>);
    updateLockButton()
    setInterval(loadMessages,5000)

</script>
