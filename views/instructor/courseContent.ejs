
<%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>


<h2><%= course.title %></h2>

<div class="learning-container">
  <aside class="lesson-sidebar">
    <% modules.forEach(module => { %>
      <div class="module-card">
        <button class="module-toggle no-bg" onclick="toggleModule(<%= module.id %>)">
          📦 <%= module.title %> ▾
        </button>
        <ul id="module-<%= module.id %>" class="lesson-list" style="display:none; margin-left:15px;">
          <% (moduleLessons[module.id] || []).forEach(lesson => { %>
            <li>
              <button class="lesson-toggle no-bg" onclick="toggleLessonMenu(<%= lesson.id %>)">
                📘 <%= lesson.title %> ▾
              </button>
              <ul id="lesson-menu-<%= lesson.id %>" style="display:none; margin-left:15px;">
                <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'lesson_plan')">📘 Lesson Plan</button></li>
                <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'video')">🎥 Video</button></li>
                <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'content')">📝 Lesson Note</button></li>
                <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'presentation')">📊 Slide Deck</button></li>
                <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'quiz')">📝 Quiz</button></li>
              </ul>
            </li>
          <% }) %>

          <h4>Assignments</h4>
          <% (moduleAssignments[module.id] || []).forEach(assign => { %>
            <li>
              <button class="no-bg" onclick="loadAssignment(<%= assign.id %>)">📂 <%= assign.title %></button>
            </li>
          <% }) %>

          <h4>Quizzes</h4>
          <% (moduleQuizzes[module.id] || []).forEach(quiz => { %>
            <li>
              <button onclick="loadQuiz(<%= quiz.id %>)">📝 <%= quiz.title %></button>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  </aside>

  <div class="lesson-main-area" id="lessonMainArea">
    <p>Select a lesson, quiz, or assignment to preview.</p>
  </div>
</div>

<script>
function toggleModule(moduleId) {
  const el = document.getElementById(`module-${moduleId}`);
  el.style.display = el.style.display === "none" ? "block" : "none";
}

function toggleLessonMenu(lessonId) {
  const el = document.getElementById(`lesson-menu-${lessonId}`);
  el.style.display = el.style.display === "none" ? "block" : "none";
}

function loadLessonPart(lessonId, part) {
  const mainArea = document.getElementById("lessonMainArea");
  mainArea.innerHTML = `<p>Loading ${part}...</p>`;

  fetch(`/instructor/preview/lesson/${lessonId}?part=${part}`)
    .then(res => res.json())
    .then(data => {

      // 📝 CONTENT

      if (data.type === "lesson_plan") {
        const plan = data.lesson_plan?.trim();

        mainArea.innerHTML = `
          <h3>${data.title} – Lesson Plan</h3>
          <div class="lesson-plan-content">
            ${plan ? plan : "<p>No lesson plan provided.</p>"}
          </div>
        `;
      } else if (data.type === "content") {
        buildSlidesView(data.content, data.title);
      }

      // 🎥 VIDEO
      else if (data.type === "video") {
        if (!data.video_url) {
          mainArea.innerHTML = "<p>No video for this lesson.</p>";
          return;
        }

        let embedUrl = data.video_url.trim();

        if (embedUrl.includes("youtube.com/watch?v=")) {
          embedUrl = `https://www.youtube.com/embed/${embedUrl.split("v=")[1].split("&")[0]}`;
        } else if (embedUrl.includes("youtu.be/")) {
          embedUrl = `https://www.youtube.com/embed/${embedUrl.split("youtu.be/")[1]}`;
        }

        mainArea.innerHTML = `
          <h3>${data.title}</h3>
          <iframe width="100%" height="420"
            src="${embedUrl}"
            frameborder="0"
            allowfullscreen>
          </iframe>
        `;
      }

      // 📊 SLIDE DECK
      else if (data.type === "presentation") {
        if (!data.lesson_file_url) {
          mainArea.innerHTML = `<h3>${data.title}</h3><p>No slide deck has been uploaded for this lesson yet.</p>`;
          return;
        }

        const encodedFileUrl = encodeURIComponent(data.lesson_file_url);
        const viewerUrl = `https://view.officeapps.live.com/op/embed.aspx?src=${encodedFileUrl}`;
        const fullscreenViewerUrl = `https://view.officeapps.live.com/op/view.aspx?src=${encodedFileUrl}`;

        mainArea.innerHTML = `
          <h3>${data.title}</h3>
          <div class="lesson-presentation">
            <iframe src="${viewerUrl}" frameborder="0" allowfullscreen></iframe>
          </div>
          <p>
            <a href="${fullscreenViewerUrl}" target="_blank" rel="noopener">🔍 Open Fullscreen (sharper, zoomable)</a>
          </p>
          <!-- Download link intentionally disabled:
          <p><a href="${data.lesson_file_url}" target="_blank" rel="noopener">⬇ Download slide deck</a></p>
          -->
        `;
      }

      // 🧩 LESSON QUIZ
      else if (data.type === "quiz") {
        currentQuizData = data;
        quizMode = "attempt";
        renderQuizAttempt(data);
      }
    })
    .catch(err => {
      console.error(err);
      mainArea.innerHTML = "<p style='color:red'>Failed to load content</p>";
    });
}

function buildSlidesView(rawContent, lessonTitle) {
  // ✅ Split slides by <hr> or ---
  const slideBreaks = /(<hr\s*\/?>|---)/gi;
  const rawSlides = rawContent
    .split(slideBreaks)
    .map(s => s.trim())
    .filter(s => {
      const clean = s.replace(/<img[^>]*>/g, '').replace(/<[^>]+>/g, '').trim();
      return clean.length > 0 && !/^(-{3,}|<hr\s*\/?>)$/i.test(s);
    });

  // ✅ Build slide objects with title + body
  const slides = rawSlides.map((s, index) => {
    let title = "";
    const boldMatch = s.match(/<strong>(.*?)<\/strong>|<b>(.*?)<\/b>/i);
    if (boldMatch) title = boldMatch[1] || boldMatch[2];
    else {
      const plain = s.replace(/<[^>]+>/g, "").trim();
      title = plain.split(/\s+/).slice(0, 5).join(" ") + "...";
    }
    return { title, body: s };
  });

  // ✅ Build HTML structure
  const noteViewHTML = `
    <div class="lesson-view-controls">
      <div class="text-controls">
        <label>Text size:</label>
        <button id="fontInc">A+</button>
        <button id="fontDec">A−</button>

        <label>Font:</label>
        <select id="fontSelect">
          <option value="system-ui">Default</option>
          <option value="serif">Serif</option>
          <option value="sans-serif">Sans-serif</option>
          <option value="OpenDyslexic, Arial">Dyslexic</option>
        </select>

        <label>Line spacing:</label>
        <select id="lineSpacing">
          <option value="1.4">Normal</option>
          <option value="1.8">Comfort</option>
          <option value="2.2">Wide</option>
        </select>
      </div>

      <div class="lesson-view-mode">
        <button id="noteBtn" class="active">📝 Note View</button>
        <button id="slideBtn">📑 Slides View</button>
      </div>
    </div>

    <div id="noteView" class="lesson-note">${rawContent}</div>
    <div id="slideView" class="lesson-slides" style="display:none;"></div>
  `;

  const mainArea = document.getElementById("lessonMainArea");
  mainArea.innerHTML = noteViewHTML;

  // 🔹 Slide rendering
  let current = 0;

  function renderSlide() {
    const total = slides.length;
    const { title, body } = slides[current];
    const html = `
      <div class="slide-box">
        <div class="slide-body">${body}</div>
        <div class="slide-controls">
          <button id="prevSlide" ${current === 0 ? "disabled" : ""}>⬅ Prev</button>
          <span>Slide ${current + 1} of ${total}</span>
          <button id="nextSlide" ${current === total - 1 ? "disabled" : ""}>Next ➡</button>
          <button id="fullscreenBtn" class="fullscreen-btn" title="Toggle Fullscreen">⛶</button>
        </div>
      </div>
    `;
    document.getElementById("slideView").innerHTML = html;

    document.getElementById("prevSlide").onclick = () => { if (current > 0) { current--; renderSlide(); } };
    document.getElementById("nextSlide").onclick = () => { if (current < total - 1) { current++; renderSlide(); } };
    document.getElementById("fullscreenBtn").onclick = toggleFullscreen;
  }

  // 🔹 Fullscreen toggle
  function toggleFullscreen() {
    const slideView = document.getElementById("slideView");
    if (!document.fullscreenElement) {
      slideView.requestFullscreen().catch(err => {
        console.error("Fullscreen error:", err);
        alert("Your browser doesn't support fullscreen mode.");
      });
    } else {
      document.exitFullscreen();
    }
  }

  // 🔹 Font size and text controls
  let fontSize = 16;

  function adjustFont(delta) {
    fontSize = Math.min(26, Math.max(12, fontSize + delta));
    applyTextStyles();
  }

  function applyTextStyles() {
    const font = document.getElementById("fontSelect").value;
    const spacing = document.getElementById("lineSpacing").value;
    document.querySelectorAll(".lesson-note, .slide-body").forEach(el => {
      el.style.fontSize = fontSize + "px";
      el.style.fontFamily = font;
      el.style.lineHeight = spacing;
    });
  }

  document.getElementById("fontInc").onclick = () => adjustFont(2);
  document.getElementById("fontDec").onclick = () => adjustFont(-2);
  document.getElementById("fontSelect").onchange = applyTextStyles;
  document.getElementById("lineSpacing").onchange = applyTextStyles;

  // 🔹 Dark mode
  let darkMode = false;
  function toggleDarkMode() {
    const slideBox = document.querySelector(".slide-box");
    if (!slideBox) return;
    darkMode = !darkMode;
    slideBox.style.background = darkMode ? "#111" : "#fff";
    slideBox.style.color = darkMode ? "#fff" : "#111";
  }

  // 🔹 Auto-play
  let autoPlay = null;
  function toggleAutoPlay() {
    if (autoPlay) {
      clearInterval(autoPlay);
      autoPlay = null;
      showToast("⏸ Auto-play stopped");
    } else {
      autoPlay = setInterval(() => document.getElementById("nextSlide")?.click(), 5000);
      showToast("▶️ Auto-play started");
    }
  }

  // 🔹 Toast notifications
  function showToast(message) {
    const toast = document.createElement("div");
    toast.textContent = message;
    Object.assign(toast.style, {
      position: "fixed",
      bottom: "20px",
      right: "20px",
      background: "rgba(0,0,0,0.7)",
      color: "#fff",
      padding: "10px 14px",
      borderRadius: "6px",
      zIndex: 9999,
      fontSize: "14px",
      transition: "opacity 0.3s"
    });
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = "0"; }, 2000);
    setTimeout(() => { toast.remove(); }, 2500);
  }

  // 🔹 Keyboard shortcuts (fullscreen only)
  document.addEventListener("keydown", e => {
    if (!document.fullscreenElement) return;
    switch (e.key.toLowerCase()) {
      case "arrowright": case "d": document.getElementById("nextSlide")?.click(); break;
      case "arrowleft": case "a": document.getElementById("prevSlide")?.click(); break;
      case "f": toggleFullscreen(); break;
      case "escape": document.exitFullscreen(); break;
      case "+": adjustFont(1); break;
      case "-": adjustFont(-1); break;
      case "0": fontSize = 17; applyTextStyles(); break;
      case "p": toggleAutoPlay(); break;
      case "m": toggleDarkMode(); break;
    }
  });

  // 🔹 Note / Slide view toggle
  const noteBtn = document.getElementById("noteBtn");
  const slideBtn = document.getElementById("slideBtn");
  const noteDiv = document.getElementById("noteView");
  const slideDiv = document.getElementById("slideView");

  noteBtn.onclick = () => { noteDiv.style.display = "block"; slideDiv.style.display = "none"; noteBtn.classList.add("active"); slideBtn.classList.remove("active"); };
  slideBtn.onclick = () => { noteDiv.style.display = "none"; slideDiv.style.display = "block"; slideBtn.classList.add("active"); noteBtn.classList.remove("active"); };

  // 🔹 Initial render
  renderSlide();
  applyTextStyles();
}

function loadAssignment(assignId) {
  const mainArea = document.getElementById("lessonMainArea");
  mainArea.innerHTML = `<p>Loading assignment...</p>`;

  fetch(`/instructor/preview/assignment/${assignId}`)
    .then(res => res.json())
    .then(data => {
      mainArea.innerHTML = `
        <h3>${data.title}</h3>
        <p>${data.description || "No instructions"}</p>
        ${
          data.file_url
            ? `<a href="${data.file_url}" target="_blank">📎 Download Attachment</a>`
            : ""
        }
      `;
    })
    .catch(err => {
      console.error(err);
      mainArea.innerHTML = "<p style='color:red'>Failed to load assignment</p>";
    });
}

let quizMode = "attempt"; // attempt | preview
let currentQuizData = null;

function loadQuiz(quizId) {
  const mainArea = document.getElementById("lessonMainArea");
  mainArea.innerHTML = `<p>Loading quiz...</p>`;

  fetch(`/instructor/preview/quiz/${quizId}`)
    .then(res => res.json())
    .then(data => {
      currentQuizData = data;
      quizMode = "attempt"; // default
      renderQuizAttempt(data);
    })
    .catch(err => {
      console.error(err);
      mainArea.innerHTML = "<p style='color:red'>Failed to load quiz</p>";
    });
}

function renderQuizAttempt(quiz) {
  const mainArea = document.getElementById("lessonMainArea");

  let html = `
    <div class="quiz-header">
      <h3>📝 ${quiz.title}</h3>
    </div>

    <form id="quizAttemptForm">
  `;

  quiz.questions.forEach((q, index) => {
    html += `
      <div class="quiz-question">
        <p><strong>Q${index + 1}.</strong> ${q.question}</p>

        ${(q.options || []).map(opt => `
          <label class="quiz-option">
            <input type="radio" name="q_${q.id}" value="${opt}">
            ${opt}
          </label>
        `).join("")}
      </div>
      <hr>
    `;
  });

  html += `
      <button type="submit" class="primary-btn">Submit Attempt</button>
    </form>

    <div id="quizResult"></div>
  `;

  mainArea.innerHTML = html;

  document.getElementById("quizAttemptForm").onsubmit = (e) => {
    e.preventDefault();
    gradeInstructorAttempt(quiz);
  };
}

function gradeInstructorAttempt(quiz) {
  let score = 0;

  quiz.questions.forEach(q => {
    const selected = document.querySelector(`input[name="q_${q.id}"]:checked`);
    if (selected && selected.value === q.correct_option) {
      score++;
    }
  });

  const resultDiv = document.getElementById("quizResult");

  resultDiv.innerHTML = `
    <p><strong>Score:</strong> ${score} / ${quiz.questions.length}</p>
    <p>This is an instructor-only attempt (not saved).</p>

    <button onclick="switchQuizMode('preview')" class="secondary-btn">
      👁 Preview Answers
    </button>
  `;
}


function renderQuizPreview(quiz) {
  const mainArea = document.getElementById("lessonMainArea");

  let html = `
    <div class="quiz-header">
      <h3>📝 ${quiz.title} (Preview)</h3>
      <button onclick="switchQuizMode('attempt')" class="secondary-btn">
        ✍ Attempt Quiz
      </button>
    </div>

    <div class="quiz-preview">
  `;

  quiz.questions.forEach((q, index) => {
    html += `
      <div class="quiz-question">
        <p><strong>Q${index + 1}.</strong> ${q.question}</p>

        <ul>
          ${(q.options || []).map(opt => `
            <li ${opt === q.correct_option
              ? 'style="color:green;font-weight:bold;"'
              : ''}>
              ${opt}
            </li>
          `).join("")}
        </ul>

        <p class="correct-answer">
          ✔ Correct Answer: <strong>${q.correct_option}</strong>
        </p>
      </div>
      <hr>
    `;
  });

  html += `</div>`;
  mainArea.innerHTML = html;
}

function switchQuizMode(mode) {
  quizMode = mode;
  if (!currentQuizData) return;

  if (mode === "attempt") {
    renderQuizAttempt(currentQuizData);
  } else {
    renderQuizPreview(currentQuizData);
  }
}

</script>
