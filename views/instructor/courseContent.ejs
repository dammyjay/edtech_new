function loadLessonPart(lessonId, part) {
  fetch(`/instructor/preview/lesson/${lessonId}?part=${part}`)
    .then(res => res.json())
    .then(data => {
      if (part === "content") buildSlidesView(data.content, data.title);
      // handle video or quiz differently
    })
    .catch(err => console.error(err));
}


