<!DOCTYPE html>
<html>
<head>
  <title>Instructor Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/style3.css">
</head>
<body>
  <script src="/js/attendance.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<!-- <%- include('../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %> -->
<%- include('./partials/instructor_sidenav') %>

<div class="main-content" id="main-content">
  <p>Loading dashboard…</p>
</div>

<script>
let currentSection = "dashboard";


async function loadSection(section) {
  const schoolSelect = document.getElementById("schoolSelect");
  const schoolId = schoolSelect ? schoolSelect.value : null;

  let url = `/instructor/section/${section}`;
  if (schoolId) url += `?school_id=${schoolId}`;

  // 🔹 Highlight active tab
  document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.classList.toggle("active", btn.dataset.tab === section);
  });

  try {
    const res = await fetch(url);
    const html = await res.text();
    document.getElementById("main-content").innerHTML = html;
    bindSchoolSelector();
  } catch (err) {
    document.getElementById("main-content").innerHTML =
      "<p style='color:red'>Failed to load section</p>";
  }
}


/**
 * Re-attach school selector listener (AJAX-safe)
 */
function bindSchoolSelector() {
  const schoolSelect = document.getElementById("schoolSelect");
  if (!schoolSelect) return;

  schoolSelect.onchange = () => {
    loadSection("dashboard");
  };
}

document.querySelectorAll(".tab-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    loadSection(btn.dataset.tab);
  });
});

window.addEventListener("DOMContentLoaded", () => {
  loadSection("dashboard");
});


// Initial load
window.addEventListener("DOMContentLoaded", () => {
  loadSection(currentSection);
});
</script>

</body>
</html>
