<div class="instructor-topbar">
  <div>
    <h1><i class="fa-solid fa-book-open"></i> Assigned Courses</h1>
    <p class="subtitle">Courses assigned to your classrooms in this school.</p>
  </div>
</div>

<% if (!classroomCourse || classroomCourse.length === 0) { %>
  <div class="instructor-empty">
    <i class="fa-solid fa-book-open"></i>
    <p>No courses assigned to your classrooms in this school yet.</p>
  </div>
<% } else { %>
  <div class="course-card-grid">
    <% classroomCourse.forEach(course => { %>
      <div class="course-card">
        <div class="course-card-icon"><i class="fa-solid fa-book"></i></div>
        <h3><%= course.title %></h3>
        <div class="course-card-meta">
          <span><i class="fa-solid fa-school"></i> <%= course.classroom_name %></span>
          <span><i class="fa-solid fa-user-graduate"></i> <%= course.student_count %> students</span>
        </div>
        <div class="course-card-actions">
          <button class="btn-view" onclick="window.location.href='/instructor/courses/<%= course.id %>/learn?classroomId=<%= course.classroom_id %>'">
            <i class="fa-solid fa-chalkboard"></i> Teach
          </button>
          <button class="btn-blue" onclick="loadSection('students?classroom_id=<%= course.classroom_id %>')">
            <i class="fa-solid fa-user-graduate"></i> Students
          </button>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
