<%- include('../../partials/adminHeader', { info: info, role: role, profilePic: profilePic, user: user }) %>
<link rel="stylesheet" href="/css/instructor.css" />

<div style="max-width:1100px; margin:0 auto; padding:24px;">
  <div class="instructor-breadcrumb">
    <a href="/instructor/dashboard"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
  </div>

  <div class="instructor-topbar">
    <div>
      <h1><i class="fa-solid fa-chart-line"></i> <%= student.fullname %></h1>
      <p class="subtitle"><%= student.email %></p>
    </div>
  </div>

  <% if (!courses || courses.length === 0) { %>
    <div class="instructor-empty">
      <i class="fa-solid fa-chart-line"></i>
      <p>No progress data available for this student yet.</p>
    </div>
  <% } else { %>
    <% courses.forEach(c => { %>
      <div class="card" style="margin-bottom:18px;">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:8px;">
          <h3 style="margin:0;"><i class="fa-solid fa-graduation-cap"></i> <%= c.course_title %></h3>
          <span class="student-coin-badge"><%= c.percent %>% complete</span>
        </div>
        <div class="award-budget-meter" style="margin:0;">
          <div class="fill" style="width: <%= c.percent %>%;"></div>
        </div>

        <% c.modules.forEach(m => { %>
          <div class="module-card gamified" style="margin-top:14px;">
            <button class="module-toggle" onclick="this.classList.toggle('open'); const c = this.nextElementSibling; c.style.display = c.style.display === 'none' ? 'block' : 'none';">
              <span>📦 <%= m.module_title %> — <%= m.percent %>% complete</span>
              <i class="fa-solid fa-chevron-right chevron"></i>
            </button>

            <div style="display:none; padding: 14px;">
              <div class="table-responsive">
                <table class="user-table">
                  <thead>
                    <tr>
                      <th>Lesson</th>
                      <th>Status</th>
                      <th>Quiz</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% m.lessons.forEach(l => { %>
                      <tr>
                        <td><%= l.title %></td>
                        <td><%= l.completed ? "✅ Completed" : "⏳ Not Completed" %></td>
                        <td>
                          <% const lessonQuizzes = m.quizzes.filter(q => q.lesson_id === l.id); %>
                          <% if (lessonQuizzes.length) { %>
                            <% lessonQuizzes.forEach(q => { %>
                              <%
                                const quizLabel = /^quiz for lesson\s*\d+$/i.test((q.title || '').trim())
                                  ? `Quiz for Lesson: ${l.title}`
                                  : (q.title || 'Quiz');
                              %>
                              <div style="margin-bottom:4px;">
                                <%= quizLabel %> —
                                <% if (q.score !== null) { %>
                                  Score: <strong><%= q.score %></strong>
                                  &nbsp;<a href="/instructor/student/<%= student.id %>/quizzes/<%= q.id %>/download" style="color:var(--brand-pri-dark); font-weight:600;">📥 Download</a>
                                <% } else { %>
                                  <span style="color:#999;">Not attempted</span>
                                <% } %>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <span style="color:#999;">–</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <div style="margin-top:14px;">
                <h5 style="margin:0 0 8px; font-size:13px; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.04em;">Module Assignments</h5>
                <% if (m.assignments.length) { %>
                  <ul class="recent-awards-list">
                    <% m.assignments.forEach(a => { %>
                      <li>
                        <span><%= a.title %></span>
                        <span class="award-amount"><%= a.grade ?? "Pending" %> / <%= a.total ?? "–" %></span>
                      </li>
                    <% }) %>
                  </ul>
                <% } else { %>
                  <p style="color:#999; font-size:13px;">No assignments for this module.</p>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</div>
