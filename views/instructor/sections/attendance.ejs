    async function loadAttendanceHistory() {
    const term_id = document.getElementById("attendanceFilterTerm").value;
    const classroom_id = document.getElementById("attendanceFilterClassroom").value;

    console.log("term:", term_id, "classroom:", classroom_id);

    const res = await fetch(`/instructor/attendance/history?term_id=${term_id}&classroom_id=${classroom_id}`);
