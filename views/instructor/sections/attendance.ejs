<div class="instructor-topbar">
  <div>
    <h1><i class="fa-solid fa-user-check"></i> Attendance</h1>
    <p class="subtitle">Take attendance and review past sessions for your classes.</p>
  </div>
  <button class="btn-primary" onclick="openAttendanceModal()"><i class="fa-solid fa-plus"></i> Take Attendance</button>
</div>

<div class="card" style="display:flex; flex-wrap:wrap; gap:14px; align-items:flex-end; margin-bottom:18px;">
  <div>
    <label style="font-size:13px; font-weight:600; display:block; margin-bottom:4px;">Term</label>
    <select id="attendanceFilterTerm">
      <% (school?.terms || []).forEach(t => { %>
        <option value="<%= t.term_id %>"><%= t.term_name %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label style="font-size:13px; font-weight:600; display:block; margin-bottom:4px;">Classroom</label>
    <select id="attendanceFilterClassroom">
      <option value="">All</option>
      <% classes.forEach(c => { %>
        <option value="<%= c.id %>"><%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <button class="btn-blue" onclick="loadAttendanceHistory()"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button>
</div>

<div id="studentList" style="margin-top:15px;"></div>
<div class="table-responsive">
  <table class="user-table sortable-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Classroom</th>
        <th>Status</th>
        <th>Students</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody id="attendanceTableBody">
      <tr><td colspan="5"><div class="instructor-loading-inline"><div class="instructor-spinner small"></div> Loading history…</div></td></tr>
    </tbody>
  </table>
</div>

<div id="attendanceModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span onclick="closeModal('attendanceModal')" class="close">&times;</span>

    <h3><i class="fa-solid fa-user-check"></i> Take Attendance</h3>

    <label style="font-size:13px; font-weight:600;">Session Type</label>
    <select id="sessionStatus" style="width:100%; margin-bottom:12px;">
      <option value="held">✅ Class Held</option>
      <option value="holiday">🎉 Holiday</option>
      <option value="no_class">📭 No Class</option>
      <option value="cancelled">❌ Cancelled</option>
    </select>

    <label style="font-size:13px; font-weight:600;">Date</label>
    <input type="date" id="attendanceDate" style="width:100%; margin-bottom:12px;"
      value="<%= new Date().toISOString().split('T')[0] %>" />

    <label style="font-size:13px; font-weight:600;">Week</label>
    <select id="week_number" style="width:100%; margin-bottom:12px;">
      <% for(let i = 1; i <= 10; i++) { %>
        <option value="<%= i %>">Week <%= i %></option>
      <% } %>
    </select>

    <div id="attendanceStudentList"></div>
  </div>
</div>
