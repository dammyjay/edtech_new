<link rel="stylesheet" href="/css/styles3.css">


<h3>📋 Attendance</h3>

<div style="margin-bottom:15px;">
  <label>Term:</label>
  <select id="attendanceFilterTerm">
    <% (school?.terms || []).forEach(t => { %>
      <option value="<%= t.term_id %>"><%= t.term_name %></option>
    <% }) %>
  </select>

  <label>Classroom:</label>
  <select id="attendanceFilterClassroom">
    <option value="">All</option>
    <% classes.forEach(c => { %>
      <option value="<%= c.id %>"><%= c.name %></option>
    <% }) %>
  </select>

  <button onclick="loadAttendanceHistory()">Load</button>
</div>

<button onclick="openAttendanceModal()">➕ Take Attendance</button>

<div id="studentList" style="margin-top:15px;"></div>
<div class="table-responsive">
  <table class="user-table sortable-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Classroom</th>
        <th>Status</th>
        <th>Students</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody id="attendanceTableBody">
      <tr>
        <td colspan="5">No data yet</td>
      </tr>
    </tbody>
  </table>
</div>

<div id="attendanceModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span onclick="closeModal('attendanceModal')" class="close-btn">&times;</span>

    <h3>📋 Take Attendance</h3>

    <label>Session Type</label>
    <select id="sessionStatus">
      <option value="held">✅ Class Held</option>
      <option value="holiday">🎉 Holiday</option>
      <option value="no_class">📭 No Class</option>
      <option value="cancelled">❌ Cancelled</option>
    </select>

    <label>Date</label>
    <input type="date" id="attendanceDate"
    value="<%= new Date().toISOString().split('T')[0] %>" />

    <label>Week</label>
    <select id="week_number">
      <% for(let i = 1; i <= 10; i++) { %>
        <option value="<%= i %>">Week <%= i %></option>
      <% } %>
    </select>

    <div id="attendanceStudentList"></div>
  </div>
</div>
