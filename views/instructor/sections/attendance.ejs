<h3>📋 Attendance</h3>

<div style="margin-bottom:15px;">
  <label>Term:</label>
  <select id="attendanceFilterTerm">
    <% (school?.terms || []).forEach(t => { %>
      <option value="<%= t.term_id %>"><%= t.term_name %></option>
    <% }) %>
  </select>

  <label>Classroom:</label>
  <select id="attendanceFilterClassroom">
    <option value="">All</option>
    <% classes.forEach(c => { %>
      <option value="<%= c.id %>"><%= c.name %></option>
    <% }) %>
  </select>

  <button onclick="loadAttendanceHistory()">Load</button>
</div>

<button onclick="openAttendanceModal()">➕ Take Attendance</button>

<div id="studentList" style="margin-top:15px;"></div>

<table class="user-table">
  <thead>
    <tr>
      <th>Date</th>
      <th>Classroom</th>
      <th>Status</th>
      <th>Students</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody id="attendanceTableBody">
    <tr>
      <td colspan="5">No data yet</td>
    </tr>
  </tbody>
</table>

