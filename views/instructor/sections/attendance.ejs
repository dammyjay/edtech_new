<div class="jk-header-card">
  <div><h2>✅ Attendance</h2></div>
  <button class="jk-btn-dark" onclick="openAttendanceModal()"><i class="fa-solid fa-plus"></i> Take Attendance</button>
</div>

<div class="jk-toolbar">
  <div>
    <label style="font-size:12px; font-weight:700; display:block; margin-bottom:4px; color:#4C3802;">Term</label>
    <select id="attendanceFilterTerm" class="jk-select">
      <% (school?.terms || []).forEach(t => { %>
        <option value="<%= t.term_id %>"><%= t.term_name %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label style="font-size:12px; font-weight:700; display:block; margin-bottom:4px; color:#4C3802;">Classroom</label>
    <select id="attendanceFilterClassroom" class="jk-select">
      <option value="">All</option>
      <% classes.forEach(c => { %>
        <option value="<%= c.id %>"><%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <button class="jk-btn-outline" onclick="loadAttendanceHistory()"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button>
</div>

<div id="studentList" style="margin-top:15px;"></div>
<div class="jk-table-wrap">
  <table class="jk-table sortable-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Classroom</th>
        <th>Status</th>
        <th>Students</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody id="attendanceTableBody">
      <tr><td colspan="5"><div class="instructor-loading-inline"><div class="instructor-spinner small"></div> Loading history…</div></td></tr>
    </tbody>
  </table>
</div>

<div id="attendanceModal" class="jk-modal-overlay" style="display:none;">
  <div class="jk-modal">
    <div class="jk-modal-head">
      <h4>✅ Take Attendance</h4>
      <button class="jk-modal-close" onclick="closeModal('attendanceModal')" aria-label="Close">&times;</button>
    </div>
    <div class="jk-modal-body">
      <label style="font-size:13px; font-weight:600;">Session Type</label>
      <select id="sessionStatus" class="jk-select" style="width:100%;">
        <option value="held">✅ Class Held</option>
        <option value="holiday">🎉 Holiday</option>
        <option value="no_class">📭 No Class</option>
        <option value="cancelled">❌ Cancelled</option>
      </select>

      <label style="font-size:13px; font-weight:600;">Date</label>
      <input type="date" id="attendanceDate" class="jk-select" style="width:100%;"
        value="<%= new Date().toISOString().split('T')[0] %>" />

      <label style="font-size:13px; font-weight:600;">Week</label>
      <select id="week_number" class="jk-select" style="width:100%;">
        <% for(let i = 1; i <= 10; i++) { %>
          <option value="<%= i %>">Week <%= i %></option>
        <% } %>
      </select>

      <div id="attendanceStudentList"></div>
    </div>
  </div>
</div>
