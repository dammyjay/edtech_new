<style>
  .jk-grade-card { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; padding: 16px 18px; margin-bottom: 14px; }
  .jk-grade-card .ai-box { background: #FAF8F2; border-radius: 10px; padding: 10px 12px; margin: 10px 0; font-size: 12.5px; color: #4C3802; }
  .jk-grade-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; margin-top: 10px; }
  .jk-grade-form label { display: block; font-size: 11px; font-weight: 700; color: #6E6350; margin-bottom: 4px; }
  .jk-grade-form input { padding: 7px 10px; border-radius: 8px; border: 1px solid #E7E0CE; font-family: inherit; font-size: 13px; }
</style>

<div class="jk-header-card">
  <div><h2>📝 Grading Queue</h2><p>Assignments submitted by students you teach — AI-graded or not.</p></div>
</div>

<div class="jk-toolbar">
  <button class="<%= filter === 'ungraded' ? 'jk-btn-gold' : 'jk-btn-outline' %>" onclick="loadSection('grading?filter=ungraded')">Ungraded</button>
  <button class="<%= filter === 'unreviewed' ? 'jk-btn-gold' : 'jk-btn-outline' %>" onclick="loadSection('grading?filter=unreviewed')">AI-Graded, Not Reviewed</button>
  <button class="<%= filter === 'all' ? 'jk-btn-gold' : 'jk-btn-outline' %>" onclick="loadSection('grading?filter=all')">All</button>
</div>

<% if (!submissions.length) { %>
  <div class="instructor-empty">
    <i class="fa-solid fa-square-check"></i>
    <p>Nothing here — you're all caught up!</p>
  </div>
<% } else { %>
  <% submissions.forEach(s => { %>
    <div class="jk-grade-card">
      <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; align-items:center;">
        <div>
          <h3 style="margin:0 0 4px; font-size:15px; color:#1A1510;"><%= s.assignment_title %></h3>
          <p style="margin:0; color:#6E6350; font-size:12.5px;"><%= s.student_name %> · <%= s.classroom_name %> · <%= new Date(s.created_at).toLocaleDateString() %></p>
        </div>
        <% if (s.manually_graded_at) { %>
          <span class="jk-pill jk-pill--active">✅ Reviewed</span>
        <% } else if (s.grade) { %>
          <span class="jk-pill jk-pill--on">🤖 AI-graded</span>
        <% } else { %>
          <span class="jk-pill jk-pill--inactive">⏳ Ungraded</span>
        <% } %>
      </div>

      <p style="margin:10px 0; font-size:13.5px; white-space:pre-wrap; color:#332A18;"><%- s.description %></p>

      <% if (s.grade || s.ai_feedback) { %>
        <div class="ai-box">
          <strong>AI suggestion:</strong> Grade <%= s.grade || "–" %>, Total <%= s.total ?? "–" %>
          <% if (s.ai_feedback) { %><br><%= s.ai_feedback %><% } %>
        </div>
      <% } %>

      <form class="jk-grade-form" data-id="<%= s.id %>">
        <div>
          <label>Grade</label>
          <input type="text" name="grade" value="<%= s.grade || '' %>" style="width:70px;" />
        </div>
        <div>
          <label>Total</label>
          <input type="number" name="total" value="<%= s.total ?? '' %>" min="0" max="100" style="width:70px;" />
        </div>
        <div style="flex:1; min-width:200px;">
          <label>Feedback</label>
          <input type="text" name="teacher_feedback" value="<%= s.teacher_feedback || '' %>" placeholder="Feedback for the student" style="width:100%;" />
        </div>
        <button type="submit" class="jk-btn-dark">Save Grade</button>
      </form>
    </div>
  <% }) %>
<% } %>

<script>
  document.querySelectorAll('.jk-grade-form').forEach(form => {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const id = form.dataset.id;
      const grade = form.grade.value;
      const total = form.total.value;
      const teacher_feedback = form.teacher_feedback.value;

      const res = await fetch(`/instructor/grading/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ grade, score: total, total, teacher_feedback })
      });
      const data = await res.json();
      showAlert(data.message || (data.success ? 'Grade saved' : 'Error saving grade'), data.success ? 'success' : 'error');
      if (data.success) loadSection('grading?filter=<%= filter %>');
    });
  });
</script>
