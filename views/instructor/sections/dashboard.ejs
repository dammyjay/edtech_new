<div class="instructor-topbar">
  <div>
    <h1>👋 Welcome, <%= user.fullname %></h1>
    <p class="subtitle">Here's what's happening across your classes today.</p>
  </div>

  <div class="school-switcher">
    <select id="schoolSelect">
      <% if (schools && schools.length > 0) { %>
        <% schools.forEach(s => { %>
          <option value="<%= s.id %>" <%= selectedSchoolId == s.id ? "selected" : "" %>><%= s.name %></option>
        <% }) %>
      <% } else { %>
        <option disabled>No schools available</option>
      <% } %>
    </select>
  </div>
</div>

<% if (!school || !school.name) { %>
  <p style="color:#999;">You haven't been assigned to a school yet — contact your platform admin.</p>
<% } %>

<div class="stat-card-grid">
  <div class="stat-card">
    <div class="stat-icon icon-gold"><i class="fa-solid fa-book"></i></div>
    <div><div class="stat-value"><%= total_courses %></div><div class="stat-label">Courses</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon icon-blue"><i class="fa-solid fa-layer-group"></i></div>
    <div><div class="stat-value"><%= total_modules %></div><div class="stat-label">Modules</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon icon-purple"><i class="fa-solid fa-chalkboard"></i></div>
    <div><div class="stat-value"><%= total_lessons %></div><div class="stat-label">Lessons</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon icon-green"><i class="fa-solid fa-user-graduate"></i></div>
    <div><div class="stat-value"><%= total_students %></div><div class="stat-label">Students</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon icon-red"><i class="fa-solid fa-file-circle-check"></i></div>
    <div><div class="stat-value"><%= total_submissions %></div><div class="stat-label">Submissions</div></div>
  </div>
</div>

<h2><i class="fa-solid fa-school"></i> Assigned Classrooms</h2>
<% if (classrooms.length > 0) { %>
  <div class="card-grid">
    <% classrooms.forEach(c => { %>
      <div class="card"><h3>🏫 <%= c.name %></h3></div>
    <% }) %>
  </div>
<% } else { %>
  <p style="color:#999;">No classroom assigned yet.</p>
<% } %>

<h2><i class="fa-solid fa-book"></i> Your Courses</h2>
<div class="table-responsive">
  <table class="user-table sortable-table">
    <thead>
      <tr>
        <th>Course Title</th>
        <th>Students Enrolled</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (courses.length > 0) { %>
        <% courses.forEach(course => { %>
          <tr>
            <td><%= course.title %></td>
            <td><%= course.student_count %></td>
            <td class="multi-btn">
              <button class="btn-view" onclick="window.location.href='/instructor/courses/<%= course.id %>/learn'">View Content</button>
              <button class="btn-edit" onclick="window.location.href='/instructor/admin/courses/<%= course.id %>/edit'">Edit</button>
              <button class="btn-blue" onclick="window.location.href='/instructor/courses/<%= course.id %>/students'">Students</button>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="3" style="text-align:center;">No courses created yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<h2><i class="fa-solid fa-envelope"></i> Recent Messages (<%= (receivedMessages || []).length %>)</h2>
<% if (receivedMessages && receivedMessages.length > 0) { %>
  <div class="table-responsive">
    <table class="user-table sortable-table">
      <thead>
        <tr>
          <th>Sender</th>
          <th>Email</th>
          <th>Message</th>
          <th>Time</th>
        </tr>
      </thead>
      <tbody>
        <% receivedMessages.forEach(msg => { %>
          <tr>
            <td><%= msg.sender_name %></td>
            <td><%= msg.sender_email %></td>
            <td>
              <%= msg.message %><br>
              <button class="btn-blue" style="margin-top:4px; padding:4px 10px; font-size:12px;"
                onclick="openReplyBox(<%= msg.sender_id %>, '<%= msg.sender_name.replace(/'/g, "\\'") %>')">💬 Reply</button>
            </td>
            <td><%= new Date(msg.created_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <p style="color:#999;">No messages received yet.</p>
<% } %>

<div id="replyBox" style="display:none; margin-top:16px;" class="card">
  <h4>Replying to <span id="replyToName"></span></h4>
  <input type="hidden" id="replyReceiverId">
  <textarea id="replyMessage" rows="3" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--border-light);"></textarea>
  <div class="multi-btn" style="margin-top:8px;">
    <button class="btn-green" onclick="sendReply()">Send Reply</button>
    <button class="btn-pri" onclick="closeReplyBox()">Cancel</button>
  </div>
</div>
