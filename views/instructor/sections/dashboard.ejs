<div class="jk-header-card">
  <div><h2>👋 Welcome, <%= user.fullname %></h2></div>
  <select id="schoolSelect" class="jk-select">
    <% if (schools && schools.length > 0) { %>
      <% schools.forEach(s => { %>
        <option value="<%= s.id %>" <%= selectedSchoolId == s.id ? "selected" : "" %>><%= s.name %></option>
      <% }) %>
    <% } else { %>
      <option disabled>No schools available</option>
    <% } %>
  </select>
</div>

<% if (!school || !school.name) { %>
  <p style="color:#999;">You haven't been assigned to a school yet — contact your platform admin.</p>
<% } %>

<div class="jk-stat-grid">
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Courses</span><span class="jk-stat-icon">📚</span></div>
    <div class="jk-stat-value"><%= total_courses %></div>
  </div>
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Modules</span><span class="jk-stat-icon">🧩</span></div>
    <div class="jk-stat-value"><%= total_modules %></div>
  </div>
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Lessons</span><span class="jk-stat-icon">📖</span></div>
    <div class="jk-stat-value"><%= total_lessons %></div>
  </div>
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Students</span><span class="jk-stat-icon">🎓</span></div>
    <div class="jk-stat-value"><%= total_students %></div>
  </div>
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Submissions</span><span class="jk-stat-icon">✅</span></div>
    <div class="jk-stat-value"><%= total_submissions %></div>
  </div>
</div>

<% if (topStudentsPerClassroom && topStudentsPerClassroom.length > 0) { %>
  <div class="jk-section-head">
    <h3>🏆 Top Students — <%= school && school.name ? school.name : "this school" %></h3>
  </div>
  <p style="font-size:12px; color:#8A7B55; margin:-6px 0 10px;">Top 3 per classroom, ranked by lesson completion, then quiz average.</p>
  <div class="jk-table-wrap">
    <table class="jk-table">
      <thead>
        <tr>
          <th>Classroom</th>
          <th>Rank</th>
          <th>Student</th>
          <th>Lessons</th>
          <th>Quiz Avg</th>
          <th>Why they're top</th>
        </tr>
      </thead>
      <tbody>
        <% topStudentsPerClassroom.forEach((s) => { %>
          <tr>
            <td><%= s.classroomName %></td>
            <td><%= ["🥇","🥈","🥉"][s.rank - 1] || s.rank %></td>
            <td><%= s.fullname %></td>
            <td><%= s.completedLessons %> / <%= s.totalLessons %></td>
            <td><%= s.quizAvg %>%</td>
            <td><%= s.completionPercent %>% lessons done, <%= s.quizAvg %>% quiz avg</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="jk-section-head"><h3>🏫 Assigned Classrooms</h3></div>
<% if (classrooms.length > 0) { %>
  <div class="jk-course-grid">
    <% classrooms.forEach(c => { %>
      <div class="jk-course-card">
        <div class="card-content"><h4>🏫 <%= c.name %></h4></div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p style="color:#999;">No classroom assigned yet.</p>
<% } %>

<div class="jk-section-head"><h3>📚 Your Courses</h3></div>
<div class="jk-table-wrap">
  <table class="jk-table sortable-table">
    <thead>
      <tr>
        <th>Course Title</th>
        <th>Students Enrolled</th>
        <th class="jk-col-actions">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (courses.length > 0) { %>
        <% courses.forEach(course => { %>
          <tr>
            <td><%= course.title %></td>
            <td><%= course.student_count %></td>
            <td class="jk-col-actions multi-btn">
              <button class="btn-view" onclick="window.location.href='/instructor/courses/<%= course.id %>/learn'">View Content</button>
              <button class="btn-edit" onclick="window.location.href='/instructor/courses/<%= course.id %>'">Edit</button>
              <button class="btn-blue" onclick="loadSection('students')">Students</button>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="3" style="text-align:center;">No courses created yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="jk-section-head"><h3>✉️ Recent Messages (<%= (receivedMessages || []).length %>)</h3></div>
<% if (receivedMessages && receivedMessages.length > 0) { %>
  <div class="jk-table-wrap">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Sender</th>
          <th>Email</th>
          <th>Message</th>
          <th>Time</th>
        </tr>
      </thead>
      <tbody>
        <% receivedMessages.forEach(msg => { %>
          <tr>
            <td><%= msg.sender_name %></td>
            <td><%= msg.sender_email %></td>
            <td>
              <%= msg.message %><br>
              <button class="btn-blue" style="margin-top:4px; padding:4px 10px; font-size:12px;"
                onclick="openReplyBox(<%= msg.sender_id %>, '<%= msg.sender_name.replace(/'/g, "\\'") %>')">💬 Reply</button>
            </td>
            <td><%= new Date(msg.created_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <p style="color:#999;">No messages received yet.</p>
<% } %>

<div id="replyBox" style="display:none; margin-top:16px;" class="jk-report-panel">
  <h4>Replying to <span id="replyToName"></span></h4>
  <input type="hidden" id="replyReceiverId">
  <textarea id="replyMessage" rows="3" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--border-light); box-sizing:border-box;"></textarea>
  <div class="multi-btn" style="margin-top:8px;">
    <button class="btn-green" onclick="sendReply()">Send Reply</button>
    <button class="btn-pri" onclick="closeReplyBox()">Cancel</button>
  </div>
</div>
