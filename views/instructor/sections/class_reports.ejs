<div class="jk-header-card">
  <div><h2>📝 Class Reports</h2></div>
  <button class="jk-btn-dark" onclick="openNewReportModal()"><i class="fa-solid fa-plus"></i> New Report</button>
</div>

<% if (!classReports || classReports.length === 0) { %>
  <p style="color:#999;">No class reports yet — write your first one above.</p>
<% } else { %>
  <div class="jk-course-grid">
    <% classReports.forEach(r => { %>
      <div class="jk-course-card">
        <div class="card-content">
          <h4><%= r.title %></h4>
          <div class="report-meta">
            <span><i class="fa-solid fa-school"></i> <%= r.classroom_name %></span>
            <% if (r.term_name) { %><span><i class="fa-solid fa-calendar"></i> <%= r.term_name %></span><% } %>
            <span><i class="fa-solid fa-clock"></i> <%= new Date(r.report_date).toLocaleDateString() %></span>
          </div>
          <div class="article-buttons">
            <button class="btn-view" onclick="openViewReportModal(<%= r.id %>)"><i class="fa-solid fa-eye"></i> View Report</button>
            <button class="btn-edit" onclick="openEditReportModal(<%= r.id %>)">Edit</button>
            <button class="btn-delete" onclick="deleteClassReportConfirm(<%= r.id %>)">Delete</button>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- View Modal (read-only) -->
<div id="viewReportModal" class="jk-modal-overlay" style="display:none;">
  <div class="jk-modal jk-modal--wide">
    <div class="jk-modal-head">
      <h4 id="viewReportTitle">📄 Report</h4>
      <button class="jk-modal-close" onclick="closeViewReportModal()" aria-label="Close">&times;</button>
    </div>
    <div class="jk-modal-body">
      <div class="report-meta" id="viewReportMeta" style="margin-bottom:12px;"></div>
      <div id="viewReportContent" class="report-preview"></div>
      <div class="multi-btn" style="margin-top:16px;">
        <button class="btn-pri" onclick="closeViewReportModal()">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Compose / Edit Modal -->
<div id="classReportModal" class="jk-modal-overlay" style="display:none;">
  <div class="jk-modal jk-modal--wide">
    <div class="jk-modal-head">
      <h4 id="reportModalTitle">📝 New Class Report</h4>
      <button class="jk-modal-close" onclick="closeClassReportModal()" aria-label="Close">&times;</button>
    </div>
    <div class="jk-modal-body">
      <div id="reportClassroomRow">
        <label style="font-size:13px; font-weight:600;">Classroom</label>
        <select id="reportClassroomSelect" class="jk-select" style="width:100%; margin-bottom:12px;">
          <% (classes || []).forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <label style="font-size:13px; font-weight:600;">Title</label>
      <input type="text" id="reportTitleInput" class="jk-select" placeholder="e.g. Week 5 progress notes"
        style="width:100%; margin-bottom:12px;" />

      <label style="font-size:13px; font-weight:600;">Date</label>
      <input type="date" id="reportDateInput" class="jk-select" style="margin-bottom:12px;" />

      <label style="font-size:13px; font-weight:600;">Report</label>
      <textarea id="reportContentField" name="content" rows="10"></textarea>

      <div class="multi-btn" style="margin-top:16px;">
        <button class="btn-primary" onclick="submitClassReport()"><i class="fa-solid fa-floppy-disk"></i> Save Report</button>
        <button class="btn-pri" onclick="closeClassReportModal()">Cancel</button>
      </div>
    </div>
  </div>
</div>
