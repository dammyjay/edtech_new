<div class="jk-header-card">
  <div><h2>📊 Classroom Analytics</h2></div>
  <select id="analyticsClassroomSelect" class="jk-select" onchange="loadSection('schools?classroom_id=' + this.value)">
    <% (classes || []).forEach(c => { %>
      <option value="<%= c.id %>" <%= String(selectedClassroomId) === String(c.id) ? "selected" : "" %>><%= c.name %></option>
    <% }) %>
  </select>
</div>

<% if (!classes || classes.length === 0) { %>
  <p style="color:#999;">No classrooms assigned yet.</p>
<% } else { %>

<div class="jk-stat-grid">
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Avg Progress</span><span class="jk-stat-icon">📘</span></div>
    <div class="jk-stat-value"><%= avgProgress %>%</div>
  </div>
  <div class="jk-stat-card">
    <div class="jk-stat-head"><span class="jk-stat-label">Top Student</span><span class="jk-stat-icon">🏅</span></div>
    <% if (topStudent && topStudent.fullname) { %>
      <div style="font-size:15px; font-weight:800; color:#1A1510;"><%= topStudent.fullname %></div>
      <div style="font-size:12px; color:#6E6350;">Quiz Avg: <%= topStudent.avg_quiz_score || "–" %></div>
    <% } else { %>
      <div style="font-size:13px; color:#6E6350;">No student data</div>
    <% } %>
  </div>
</div>

<div class="jk-report-panel" style="margin-bottom:16px;">
  <h4 style="margin:0 0 10px;">👩‍🎓 Gender Ratio</h4>
  <div style="max-width:320px; max-height:280px; margin:0 auto;">
    <canvas id="genderChart"></canvas>
  </div>
</div>

<div class="jk-section-head"><h3>📈 Class Analytics</h3></div>
<div style="display:flex; gap:20px; flex-wrap:wrap;">
  <div class="jk-report-panel" style="flex:1; min-width:300px;">
    <h4 style="margin:0 0 10px;">Progress Distribution</h4>
    <canvas id="progressChart"></canvas>
  </div>
  <div class="jk-report-panel" style="flex:1; min-width:300px;">
    <h4 style="margin:0 0 10px;">Quiz Performance</h4>
    <canvas id="quizChart"></canvas>
  </div>
</div>

<div class="jk-section-head"><h3>👥 Student Details</h3></div>
<div class="jk-table-wrap">
  <table class="jk-table sortable-table">
    <thead>
      <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Gender</th>
        <th>Lessons</th>
        <th>Quiz Avg</th>
        <th>Assignment Avg</th>
        <th>Last Active</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length > 0) { %>
        <% students.forEach(stu => { %>
          <tr>
            <td><%= stu.fullname %></td>
            <td><%= stu.email %></td>
            <td><%= stu.gender || "–" %></td>
            <td><%= stu.lessons_completed %> / <%= stu.total_lessons %></td>
            <td><%= stu.avg_quiz_score || "–" %></td>
            <td><%= stu.avg_assignment_score || "–" %></td>
            <td><%= stu.last_login ? new Date(stu.last_login).toLocaleString() : "Never" %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="7">No students found in this classroom.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Chart.js is loaded once, persistently, from the shell — and this
     JSON block (never executed, just read) is how the analytics data
     reaches instructorDashboard.js's renderAnalyticsCharts(), since this
     whole section arrives via innerHTML= and a real <script> here would
     never run (same reason the award modal / class-report JS all live
     in the persistent shell instead of inline in their own sections). -->
<script type="application/json" id="analyticsChartData">
  <%- JSON.stringify({
    genderLabels: genderSummary.map(g => g.gender || "Unknown"),
    genderCounts: genderSummary.map(g => parseInt(g.count)),
    progressDist,
    studentNames: students.map(s => s.fullname),
    studentQuizAvgs: students.map(s => s.avg_quiz_score || 0),
  }) %>
</script>
<% } %>
