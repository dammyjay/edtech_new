<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= (info?.company_name || 'JKT Hub').trim() %> — Testimonies</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/styles2.css" />
    <link rel="stylesheet" href="/css/styles3.css" />
    <link rel="icon" type="image/x-icon" href="/images/JKT logo bg.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <%- include('./partials/userHeader', { title: 'Testimonies' }) %>

    <section class="section">
      <h2 style="text-align:center;">Testimonies</h2>
      <% if (!testimonies || testimonies.length === 0) { %>
        <p style="text-align:center;">No testimonies have been shared yet.</p>
      <% } else { %>
        <div class="testimony-grid">
          <% testimonies.forEach(t => { %>
            <div class="testimony-card" onclick='openTestimonyModal(<%- JSON.stringify(t.message) %>, <%- JSON.stringify(t.name) %>)'>
              <p class="testimony-message">“<%= t.message.length > 200 ? t.message.substring(0, 200) + '...' : t.message %>”</p>
              <p class="testimony-name">— <strong><%= t.name %></strong></p>
            </div>
          <% }) %>
        </div>
      <% } %>
      <div style="text-align: center; margin-top: 20px">
        <a href="/testimony" class="btn-sec" style="text-decoration:none;">Share your own testimony</a>
      </div>
    </section>

    <div id="testimonyModal" class="modal" style="display: none;">
      <div class="modal-content">
        <span class="close" onclick="closeTestimonyModal()">&times;</span>
        <h3 style="text-align: center; color: var(--brand-pri-dark);">Full Testimony</h3>
        <p id="fullTestimonyMessage" style="text-align: justify;"></p>
        <p id="fullTestimonyName" style="text-align: right; font-weight: bold;"></p>
      </div>
    </div>

    <%- include('./partials/userFooter') %>

    <script>
      function openTestimonyModal(message, name) {
        document.getElementById("fullTestimonyMessage").innerText = message;
        document.getElementById("fullTestimonyName").innerText = `— ${name}`;
        document.getElementById("testimonyModal").style.display = "block";
      }

      function closeTestimonyModal() {
        document.getElementById("testimonyModal").style.display = "none";
      }

      window.addEventListener("click", function (e) {
        const modal = document.getElementById("testimonyModal");
        if (e.target === modal) {
          modal.style.display = "none";
        }
      });
    </script>

    <!-- For the navigation toggle -->
    <script>
      function toggleNav() {
        const nav = document.getElementById("main-nav");
        nav.classList.toggle("open");
      }

      document.addEventListener("click", function (event) {
        const nav = document.getElementById("main-nav");
        const toggleBtn = document.querySelector(".nav-toggle");
        if (!nav || !toggleBtn) return;

        const clickedInsideNav = nav.contains(event.target);
        const clickedToggle = toggleBtn.contains(event.target);

        if (!clickedInsideNav && !clickedToggle) {
          nav.classList.remove("open");
        }
      });
    </script>
  </body>
</html>
