<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= (info?.company_name || 'JKT Hub').trim() %> — Testimonies</title>
    <link rel="icon" type="image/x-icon" href="/images/JKT logo bg.png" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/styles2.css" />
    <link rel="stylesheet" href="/css/styles3.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      integrity="sha512-..."
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <%- include('./partials/userHeader', { title: 'Testimonials' }) %>
    <section class="section">
      <h2>Share Your Testimony</h2>
      <form method="POST" action="/testimony">
        <input type="text" name="name" placeholder="Your Name" required /><br /><br />
        <input type="email" name="email" placeholder="Email (optional)" /><br /><br />
        <textarea name="message" placeholder="Your testimony..." required></textarea><br /><br />
        <button type="submit" class="btn-sec">Submit</button>
      </form>
      <hr style="margin: 40px 0" />

    </section>

    <section class="section">   
      <h3 style="text-align:center;">Testimonies</h3>
      <div class="testimony-grid">
        <% testimonies.forEach(t => { %>
          <div class="testimony-card" onclick='openTestimonyModal(<%- JSON.stringify(t.message) %>, <%- JSON.stringify(t.name) %>)'>
            <p class="testimony-message">“<%= t.message.substring(0, 200) %>...”</p>
            <p class="testimony-name">— <strong><%= t.name %></strong></p>
            <!-- <p class="testimony-name">— <strong>Anonymous</strong></p> -->
          </div>
        <% }) %>
      </div>
    </section>

  <section class="section">
    <h1>What our users say</h1>
    <div class="testimony-grid">
      <% feedbacks.forEach(t => { %>
        <div class="testimony-card" style="text-align: left; text-wrap: inherit;">
          <p><strong><%= t.name %></strong></p>
          <p><strong><%= t.user_type %></strong></p>
          <p>Rating: <%= t.rating %> ⭐</p>
          <blockquote><%= t.message %></blockquote>
        </div>
      <% }) %>
    </div>
  </section>

    <div id="testimonyModal" class="modal" style="display: none;">
      <div class="modal-content">
        <span class="close" onclick="closeTestimonyModal()">&times;</span>
        <h3 style="text-align: center; color: #a9712f;">Full Testimony</h3>
        <p id="fullTestimonyMessage" style="text-align: justify;"></p>
        <p id="fullTestimonyName" style="text-align: right; font-weight: bold;"></p>
      </div>
    </div>

    <%- include('./partials/userFooter') %>
    <!-- open and close modal script -->
    <script>
      function openTestimonyModal(message, name) {
        document.getElementById("fullTestimonyMessage").innerText = message;
        // document.getElementById("fullTestimonyName").innerText = `— ${name}`;
        document.getElementById("fullTestimonyName").innerText = "— Anonymous";
        document.getElementById("testimonyModal").style.display = "block";
      }

      function closeTestimonyModal() {
        document.getElementById("testimonyModal").style.display = "none";
      }

      window.addEventListener("click", function (e) {
        const modal = document.getElementById("testimonyModal");
        if (e.target === modal) {
          modal.style.display = "none";
        }
      });
    </script>

    <!-- For the navigation toggle -->
<script>
  function toggleNav() {
    const nav = document.getElementById("main-nav");
    nav.classList.toggle("open");
  }

  // Close nav when clicking outside
  document.addEventListener("click", function(event) {
    const nav = document.getElementById("main-nav");
    const toggleBtn = document.querySelector(".nav-toggle");

    const clickedInsideNav = nav.contains(event.target);
    const clickedToggle = toggleBtn.contains(event.target);

    if (!clickedInsideNav && !clickedToggle) {
      nav.classList.remove("open");
    }
  });
</script>

    
  </body>
</html>
