
 <div id="sidenav" class="sidenav">
  <h2>📌 Teacher Menu</h2>
  <ul>
    <li><a href="javascript:void(0)" onclick="loadSection('dashboard')">Dashboard</a></li>
    <li><a href="javascript:void(0)" onclick="loadSection('classes')">Classes</a></li>
    <li><a href="javascript:void(0)" onclick="loadSection('students')">Students</a></li>
    <li><a href="javascript:void(0)" onclick="loadSection('reports')">Reports</a></li>
    <li><a href="/admin/logout">🚪 Logout</a></li>
  </ul>
</div>

<button id="toggleBtn" class="toggle-btn">☰</button>


<style>
  /* Sidebar */
  .sidenav {
    width: 220px;
    background: var(--sidebar-bg);
    color: var(--sidebar-text);
    height: 100vh;
    padding: 15px;
    position: fixed;
    top: 0;
    left: 0;
    transition: transform 0.3s ease-in-out;
    z-index: 1000;
  }

  .sidenav h2 {
    margin-bottom: 20px;
    color: var(--sidebar-text);
    font-size: 1.05rem;
  }

  .sidenav ul {
    list-style: none;
    padding: 0;
  }

  .sidenav ul li {
    margin: 4px 0;
  }

  .sidenav ul li a {
    color: var(--sidebar-text-muted);
    text-decoration: none;
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .sidenav ul li a:hover {
    background: var(--sidebar-bg-active);
    color: var(--brand-pri-light);
  }

  /* Main content */
  .main-content {
    margin-left: 240px;
    padding: 20px;
    transition: margin-left 0.3s ease-in-out;
  }

  /* Toggle button */
  .toggle-btn {
    display: none;
    position: fixed;
    top: 10px;
    right: 10px;
    background: var(--sidebar-bg);
    color: #fff;
    border: none;
    padding: 10px 14px;
    font-size: 20px;
    cursor: pointer;
    border-radius: 5px;
    z-index: 1100;
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
    /* allows horizontal scroll if needed */
    -webkit-overflow-scrolling: touch;
    /* smooth scrolling on iOS */
    max-height: 400px;
        /* Adjust height as needed */
        overflow-y: auto;
        margin-top: 20px;
}

.user-table-wrapper {
    max-height: 400px;
    /* Adjust height as needed */
    overflow-y: auto;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 20px;
    border: 1px solid #ddd;
    border-radius: 6px;   
}

.user-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
    font-family: sans-serif;
}

.user-table th {
    position: sticky;
        top: 0;
    background-color: #333;
    color: white;
    text-align: left;
    padding: 12px;
}

.user-table td {
    padding: 10px;
    border-bottom: 1px solid #ddd;
}

.user-table tr:hover {
    background-color: #f5f5f5;
}

.btn-edit {
    background-color: #4CAF50;
    color: white;
    border: none;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 4px;
}

.btn-view {
    background-color: #000000;
    color: white;
    border: none;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 4px;
}

.btn-edit:hover {
    background-color: #45a049;
}
.btn-delete {
    background-color: #f44336;
    color: white;
    border: none;
    padding: 6px 12px;
    cursor: pointer;
    border-radius: 4px;
}
.btn-delete:hover {
    background-color: #e53935;
}

  .cards { display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 1rem; margin: 1rem 0; }
  .card { background: #fff; padding: 1rem; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
  .btn-view { display:inline-block; margin-top:.5rem; padding:.4rem .8rem; background:#2980b9; color:#fff; border-radius:6px; }
  .profile-box { display:flex; align-items:center; gap:1rem; margin:1rem 0; }
  .profile-pic { width:60px; height:60px; border-radius:50%; object-fit:cover; }

.user-table th, .user-table td {
  text-align: left;
  padding: 10px;
  border-bottom: 1px solid #ddd;
}

.user-table th {
  background: var(--brand-pri);
  color: #fff;
  position: sticky;
  top: 0;
}

.user-table tr:hover {
  background: #f9f9f9;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .user-table th, .user-table td {
    font-size: 13px;
    padding: 8px 6px;
  }
}


  /* Responsive */
  @media (max-width: 768px) {
    .sidenav {
      transform: translateX(-100%);
    }
    .sidenav.active {
      transform: translateX(0);
    }
    .main-content {
      margin-left: 0;
      padding: 15px;
    }
    .toggle-btn {
      display: block;
    }
    .table-responsive {
            width: 100%;
            overflow-x: auto;
            /* allows horizontal scroll if needed */
            -webkit-overflow-scrolling: touch;
            /* smooth scrolling on iOS */   }
    .user-table th,
    .user-table td {
        padding: 8px 6px;
        font-size: 12px;
    }
    .user-table img {
        width: 35px !important;
        height: 35px !important;
    }
  }
</style>

<script>
  const sidenav = document.getElementById("sidenav");
  const toggleBtn = document.getElementById("toggleBtn");
  const mainContent = document.querySelector(".main-content");

  toggleBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    sidenav.classList.toggle("active");
  });

  
  // Close when clicking a link inside sidenav
  sidenav.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      if (window.innerWidth <= 768) { // only on mobile
        sidenav.classList.remove("active");
      }
    });
  });

  // Close when clicking outside sidenav
  document.addEventListener("click", (e) => {
    if (
      window.innerWidth <= 768 && // only mobile
      sidenav.classList.contains("active") && 
      !sidenav.contains(e.target) && 
      e.target !== toggleBtn
    ) {
      sidenav.classList.remove("active");
    }
  });


  // load section dynamically
  async function loadSection(section) {
    try {
      const res = await fetch(`/teacher/section/${section}`);
      const html = await res.text();
      mainContent.innerHTML = html;
      if (window.innerWidth <= 768) sidenav.classList.remove("active");
    } catch (err) {
      mainContent.innerHTML = "<p style='color:red'>Error loading section</p>";
    }
  }

  // load dashboard on page load
  window.addEventListener("DOMContentLoaded", () => loadSection("dashboard"));
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

  document.querySelectorAll(".sortable-table").forEach(table => {

    const headers = table.querySelectorAll("thead th");

    headers.forEach((header, columnIndex) => {

      header.classList.add("sortable");

      let ascending = true;

      header.addEventListener("click", () => {

        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));

        // Remove previous sort indicators
        headers.forEach(h => {
          h.classList.remove("sort-asc", "sort-desc");
        });

        rows.sort((a, b) => {

          let aText =
            a.children[columnIndex]?.innerText.trim() || "";

          let bText =
            b.children[columnIndex]?.innerText.trim() || "";

          // Numeric sorting
          const aNum =
            parseFloat(aText.replace(/[^\d.-]/g, ""));

          const bNum =
            parseFloat(bText.replace(/[^\d.-]/g, ""));

          if (!isNaN(aNum) && !isNaN(bNum)) {
            return ascending
              ? aNum - bNum
              : bNum - aNum;
          }

          // Date sorting
          const aDate = Date.parse(aText);
          const bDate = Date.parse(bText);

          if (!isNaN(aDate) && !isNaN(bDate)) {
            return ascending
              ? aDate - bDate
              : bDate - aDate;
          }

          // Text sorting
          return ascending
            ? aText.localeCompare(bText)
            : bText.localeCompare(aText);

        });

        tbody.innerHTML = "";
        rows.forEach(row => tbody.appendChild(row));

        header.classList.add(
          ascending ? "sort-asc" : "sort-desc"
        );

        ascending = !ascending;
      });

    });

  });

});
</script>

