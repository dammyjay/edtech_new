<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Teacher Dashboard</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/styles2.css" />
  <link rel="stylesheet" href="/css/styles3.css" />
  <link rel="icon" type="image/x-icon" href="/images/JKT logo bg.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/uiAlerts.js"></script>
  <style>
    
    .announcement-thumb{
        width:70px;
        height:45px;
        object-fit:cover;
        border-radius:6px;
        display:block;
    }

    .announcement-modal {
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, .65);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 99999;
    }

    .announcement-content {
        background: #fff;
        width: 50%;
        max-width: 500px;
        max-height: 85vh;
        overflow: auto;
        padding: 25px;
        border-radius: 12px;
        position: relative;
        text-align: center;
    }

    .close-announcement {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 28px;
        cursor: pointer;
    }

    .announcement-slide {
        display: none;
    }

    .announcement-slide.active {
        display: block;
    }

    .announcement-content img {
        width: 60%;
        border-radius: 8px;
        margin-bottom: 15px;
        text-align: center;
    }

  </style>
</head>
<body>
  <!-- sidenav -->
  <%- include('./partials/teacher_sidenav') %>
  <%- include("../partials/announcementPopup") %>

  <!-- Loading overlay — same breathing-logo pattern used in
       partials/header.ejs (#loadingOverlay/.spin, styled in styles2.css,
       already loaded above), shown while any AJAX section is loading. -->
  <div id="loadingOverlay">
    <div class="spin">
      <% if (info?.logo_url) { %>
      <img src="<%= info.logo_url %>" alt="">
      <% } %>
    </div>
  </div>

  <!-- AJAX-loaded content -->
  <div class="main-content" id="main-content">
    <p>Welcome, <%= teacher.fullname %> 👋</p>
    <p>Select a section from the menu</p>
  </div>

  <!-- loadSection() itself, plus the DOMContentLoaded initial load, are
       defined once in ./partials/teacher_sidenav.ejs (included above) so
       they don't need redeclaring here. -->

  <script>
    // Same function names as partials/header.ejs's own loadingOverlay, kept
    // consistent across the app even though this is a separate element.
    function showLoading() {
      const el = document.getElementById("loadingOverlay");
      if (el) el.style.display = "flex";
    }
    function hideLoading() {
      const el = document.getElementById("loadingOverlay");
      if (el) el.style.display = "none";
    }
  </script>

</body>
</html>
