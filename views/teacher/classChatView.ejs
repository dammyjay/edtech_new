<style>
  .tc-chat-hero {
    background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807));
    color: #fff;
    border-radius: var(--radius-lg, 16px);
    padding: 22px 24px;
    margin: 18px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }
  .tc-chat-hero-info h1 { margin: 0 0 4px; font-size: 20px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .tc-chat-hero-info p { margin: 0; opacity: 0.92; font-size: 13px; }
  .tc-lock-pill {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 999px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .tc-chat-hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  .tc-announcements-strip { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 18px; scroll-snap-type: x proximity; }
  .tc-announcement-card {
    scroll-snap-align: start;
    flex: 0 0 260px;
    background: linear-gradient(160deg, #fff, var(--brand-tint, #FBF3DD));
    border: 1px solid var(--brand-pri-light, #D9A82C)55;
    border-radius: var(--radius-lg, 16px);
    padding: 14px 16px;
    position: relative;
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06));
  }
  .tc-announcement-card .pin-icon { color: var(--brand-pri, #A17807); font-size: 13px; margin-right: 4px; }
  .tc-announcement-card h4 { margin: 0 0 6px; font-size: 13.5px; color: var(--brand-pri-dark, #4C3802); padding-right: 20px; }
  .tc-announcement-card p { margin: 0 0 6px; font-size: 12.5px; color: #444; line-height: 1.4; }
  .tc-announcement-card small { color: #999; font-size: 10.5px; }
  .tc-announcement-del {
    position: absolute; top: 10px; right: 10px; background: none; border: none; cursor: pointer;
    font-size: 12px; color: #bbb; padding: 2px;
  }
  .tc-announcement-del:hover { color: #D64545; }
  .tc-announcement-empty { color: #999; font-size: 12.5px; padding: 4px 0; }

  .tc-chat-tabs { display: none; gap: 8px; margin-bottom: 12px; }
  .tc-chat-tab { flex: 1; border: none; border-radius: 10px; padding: 10px; font-weight: 700; font-size: 13px; cursor: pointer; background: #f0f0f0; color: #555; }
  .tc-chat-tab.active { background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807)); color: #fff; }

  .tc-chat-layout { display: flex; gap: 20px; align-items: flex-start; }
  .tc-chat-panel { flex: 2.2; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; background:#fff; border:1px solid #eee; border-radius: var(--radius-lg, 16px); box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06)); overflow: hidden; }

  .tc-chat-box { height: 480px; overflow-y: auto; padding: 18px; background: #fafafa; display: flex; flex-direction: column; gap: 4px; }
  .tc-chat-empty { margin: auto; text-align: center; color: #999; }
  .tc-chat-empty .icon { font-size: 34px; margin-bottom: 8px; color: #ddd; }

  .tc-chat-msg { display: flex; gap: 8px; margin: 6px 0; max-width: 78%; animation: tcFadeIn 0.2s ease; }
  .tc-chat-msg.mine { align-self: flex-end; flex-direction: row-reverse; }
  @keyframes tcFadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

  .tc-chat-avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .tc-chat-msg.grouped .tc-chat-avatar { visibility: hidden; }

  .tc-chat-col { display: flex; flex-direction: column; gap: 2px; }
  .tc-chat-name { display: flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 700; color: #666; }
  .tc-chat-msg.mine .tc-chat-name { flex-direction: row-reverse; }
  .tc-chat-role { font-size: 9px; text-transform: uppercase; background: var(--brand-tint, #FBF3DD); color: var(--brand-pri-dark, #4C3802); padding: 1px 7px; border-radius: 999px; }

  .tc-chat-bubble { background: #fff; border: 1px solid #eee; border-radius: 14px 14px 14px 4px; padding: 9px 13px; font-size: 13.5px; line-height: 1.4; word-break: break-word; }
  .tc-chat-msg.mine .tc-chat-bubble { background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807)); color: #fff; border-radius: 14px 14px 4px 14px; border: none; }
  .tc-chat-time { display: block; margin-top: 3px; font-size: 9.5px; opacity: 0.65; }
  .tc-chat-del { background: none; border: none; cursor: pointer; font-size: 11px; opacity: 0.5; margin-left: 4px; }
  .tc-chat-del:hover { opacity: 1; }

  .tc-chat-input-area { display: flex; gap: 10px; padding: 14px; border-top: 1px solid #eee; background: #fff; }
  .tc-chat-input-area textarea {
    flex: 1; border-radius: 20px; border: 1px solid #ddd; padding: 10px 16px; font-family: inherit;
    resize: none; font-size: 13.5px; max-height: 80px;
  }
  .tc-chat-input-area textarea:focus { outline: none; border-color: var(--brand-pri, #A17807); }
  .tc-send-btn {
    width: 42px; height: 42px; border-radius: 50%; border: none; flex-shrink: 0;
    background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807));
    color: #fff; font-size: 16px; cursor: pointer; display:flex; align-items:center; justify-content:center;
    transition: transform 0.1s ease;
  }
  .tc-send-btn:active { transform: scale(0.92); }
  .tc-locked-banner { padding: 10px 16px; background: #FBEAEA; color: #A83232; font-size: 12.5px; text-align: center; border-top: 1px solid #E5747455; }

  .tc-student-panel { flex: 1; min-width: 260px; box-sizing: border-box; background:#fff; border:1px solid #eee; border-radius: var(--radius-lg, 16px); padding: 16px; box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06)); max-height: 560px; overflow-y: auto; }
  .tc-student-panel h3 { margin: 0 0 12px; font-size: 14px; }
  .tc-student-card { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f2f2f2; }
  .tc-student-card:last-child { border-bottom: none; }
  .tc-student-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .tc-student-info { flex: 1; min-width: 0; }
  .tc-student-info b { display: block; font-size: 13px; }
  .tc-student-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .tc-student-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .tc-icon-btn {
    width: 30px; height: 30px; border-radius: 50%; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 12px;
    background: #f0f0f0; color: #555; transition: transform 0.1s ease;
  }
  .tc-icon-btn:active { transform: scale(0.9); }
  .tc-icon-btn.muted { background: #FBEAEA; color: #D64545; }

  @media (max-width: 900px) {
    .tc-chat-layout { flex-direction: column; }
    .tc-chat-tabs { display: flex; }
    .tc-chat-panel, .tc-student-panel { width: 100%; min-width: 0; }
    .tc-student-panel.tc-hidden-mobile, .tc-chat-panel.tc-hidden-mobile { display: none; }
    .tc-chat-box { height: 400px; }
  }
  @media (max-width: 480px) {
    .tc-chat-hero { padding: 16px; }
    .tc-chat-hero-info h1 { font-size: 17px; }
    .tc-chat-msg { max-width: 90%; }
    .tc-announcement-card { flex-basis: 220px; }
  }
</style>

<button type="button" class="back-btn" onclick="goBackSection()" style="margin-bottom:12px;">⬅ Back</button>

<div class="tc-chat-hero">
  <div class="tc-chat-hero-info">
    <h1>📚 <%= classroom.name %> <span class="tc-lock-pill" id="lockPill"><i class="fa-solid fa-lock-open"></i> Open</span></h1>
    <p><%= students.length %> student<%= students.length === 1 ? '' : 's' %> · Class Chat</p>
  </div>
  <div class="tc-chat-hero-actions">
    <button id="chatToggleBtn" class="tc-btn tc-btn-secondary" onclick="toggleChatLock()"></button>
    <button class="tc-btn tc-btn-primary" onclick="openAnnouncementModal()"><i class="fa-solid fa-bullhorn"></i> New Announcement</button>
  </div>
</div>

<div class="tc-announcements-strip" id="announcementsStrip">
  <% if (!announcements.length) { %>
    <p class="tc-announcement-empty">No announcements yet — post one to pin it here for the whole class.</p>
  <% } %>
  <% announcements.forEach(a => { %>
    <div class="tc-announcement-card">
      <button class="tc-announcement-del" onclick="deleteAnnouncement(<%= a.id %>)" title="Delete">🗑</button>
      <h4><span class="pin-icon"><i class="fa-solid fa-thumbtack"></i></span><%= a.title %></h4>
      <p><%= a.message %></p>
      <small><%= new Date(a.created_at).toLocaleString() %></small>
    </div>
  <% }) %>
</div>

<div class="tc-chat-tabs">
  <button class="tc-chat-tab active" id="tabChatBtn" onclick="showMobileTab('chat')">💬 Chat</button>
  <button class="tc-chat-tab" id="tabStudentsBtn" onclick="showMobileTab('students')">👥 Students</button>
</div>

<div class="tc-chat-layout">
  <div class="tc-chat-panel" id="chatPanel">
    <div id="chatContainer" class="tc-chat-box"></div>
    <% if (classroom.chat_locked) { %>
      <div class="tc-locked-banner"><i class="fa-solid fa-lock"></i> Chat is locked — students can't send messages right now.</div>
    <% } %>
    <div class="tc-chat-input-area">
      <textarea id="chatMessage" rows="1" placeholder="Type a message to the class..."></textarea>
      <button class="tc-send-btn" onclick="sendClassMessage()" title="Send"><i class="fa-solid fa-paper-plane"></i></button>
    </div>
  </div>

  <div class="tc-student-panel tc-hidden-mobile" id="studentPanel">
    <h3>👩‍🎓 Students</h3>
    <% students.forEach(s => { %>
      <div class="tc-student-card">
        <img class="tc-student-avatar" src="<%= s.profile_picture || '/profile.webp' %>" alt="">
        <div class="tc-student-info">
          <b><%= s.fullname %></b>
          <div class="tc-student-meta">
            <span class="tc-chip">Lvl <%= s.levelInfo.level %></span>
            <span class="tc-streak">🔥 <%= s.streak.currentStreak %></span>
            <span class="tc-badge-count">🏅 <%= s.badgeCount %></span>
          </div>
        </div>
        <div class="tc-student-actions">
          <a href="/teacher/chat/<%= s.id %>" class="tc-icon-btn" title="1:1 chat"><i class="fa-solid fa-comment"></i></a>
          <button class="tc-icon-btn <%= s.muted ? 'muted' : '' %>" id="mute-btn-<%= s.id %>" onclick="toggleMute(<%= s.id %>)" title="<%= s.muted ? 'Unmute' : 'Mute' %>">
            <i class="fa-solid <%= s.muted ? 'fa-volume-xmark' : 'fa-volume-high' %>"></i>
          </button>
        </div>
      </div>
    <% }) %>
    <% if (!students.length) { %>
      <p class="tc-empty">No students in this classroom yet.</p>
    <% } %>
  </div>
</div>

<!-- New Announcement Modal -->
<div id="announcementModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span onclick="document.getElementById('announcementModal').style.display='none'" class="close-btn">&times;</span>
    <h3>📌 New Class Announcement</h3>
    <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Title</label>
    <input type="text" id="announcementTitle" placeholder="Title" style="width:100%; padding:9px; margin-bottom:10px; border-radius:8px; border:1px solid #ddd; box-sizing:border-box;">
    <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Message</label>
    <textarea id="announcementMessage" rows="4" placeholder="Message" style="width:100%; padding:9px; margin-bottom:12px; border-radius:8px; border:1px solid #ddd; box-sizing:border-box; font-family:inherit;"></textarea>
    <button class="tc-btn tc-btn-primary" onclick="submitAnnouncement()">Post Announcement</button>
  </div>
</div>

<script>
// Wrapped in an IIFE — this fragment loads via the teacher dashboard's AJAX
// section loader (see loadUrl in teacher_sidenav.ejs), so its <script> can
// re-execute more than once in the same page (switching classrooms,
// leaving and coming back). Bare top-level const/let would throw
// "already declared" on a second run; function-scoping everything here
// avoids that. Handlers referenced from inline onclick="..." attributes
// still need to be reachable from global scope, so they're explicitly
// exported to window at the bottom.
(function () {
  const classroomId = "<%= classroom.id %>";
  const currentUserId = <%= user.id %>;
  const chatContainer = document.getElementById('chatContainer');

  function renderMessages(messages) {
    chatContainer.innerHTML = "";
    if (!messages.length) {
      chatContainer.innerHTML = `<div class="tc-chat-empty"><div class="icon"><i class="fa-solid fa-comments"></i></div>No messages yet — say hello to the class!</div>`;
      return;
    }

    let lastSenderId = null;
    messages.forEach(msg => {
      const mine = String(msg.sender_id) === String(currentUserId);
      const grouped = msg.sender_id === lastSenderId;
      lastSenderId = msg.sender_id;

      const avatar = msg.profile_picture
        ? `<img src="${msg.profile_picture}" class="tc-chat-avatar">`
        : `<img src="/profile.webp" class="tc-chat-avatar">`;

      const delBtn = msg.role !== 'teacher'
        ? `<button class="tc-chat-del" onclick="deleteMessage(${msg.id})" title="Delete">🗑</button>`
        : '';

      const div = document.createElement('div');
      div.className = `tc-chat-msg ${mine ? 'mine' : ''} ${grouped ? 'grouped' : ''}`;
      div.innerHTML = `
        ${avatar}
        <div class="tc-chat-col">
          ${grouped ? '' : `<div class="tc-chat-name">${escapeHtml(msg.fullname)} <span class="tc-chat-role">${msg.role}</span></div>`}
          <div class="tc-chat-bubble">
            ${escapeHtml(msg.message)}${delBtn}
            <small class="tc-chat-time">${new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</small>
          </div>
        </div>
      `;
      chatContainer.appendChild(div);
    });
    chatContainer.scrollTop = chatContainer.scrollHeight;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // loadMessages() fires from three places that can overlap (the initial
  // load, the 5s poll, and right after sending a message) — without
  // sequencing, an older in-flight request that happens to resolve AFTER a
  // newer one clobbers the fresh render with stale data. This tags each
  // call and only applies the result if it's still the most recent one
  // issued by the time it resolves.
  let loadMessagesRequestId = 0;
  async function loadMessages() {
    const requestId = ++loadMessagesRequestId;
    const res = await fetch(`/teacher/class/messages/${classroomId}`);
    const messages = await res.json();
    if (requestId !== loadMessagesRequestId) return; // a newer call already superseded this one
    renderMessages(Array.isArray(messages) ? messages : []);
  }

  async function sendClassMessage() {
    const input = document.getElementById('chatMessage');
    const message = input.value.trim();
    if (!message) return;

    const res = await fetch('/teacher/class/send', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ classroomId, message })
    });
    const data = await res.json();
    if (!data.success) {
      showAlert(data.message || "Message failed to send", "error");
      return;
    }
    input.value = "";
    loadMessages();
  }

  document.getElementById('chatMessage').addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendClassMessage();
    }
  });

  async function deleteMessage(messageId) {
    if (!(await showConfirm("Delete this message?"))) return;
    await fetch("/teacher/class/delete-message", {
      method: "POST", headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messageId })
    });
    loadMessages();
  }

  const mutedState = {};
  <% students.forEach(s => { %>
    mutedState[<%= s.id %>] = <%= s.muted ? 'true' : 'false' %>;
  <% }) %>

  async function toggleMute(studentId) {
    const willMute = !mutedState[studentId];
    const url = willMute ? "/teacher/mute-student" : "/teacher/unmute-student";
    const res = await fetch(url, {
      method: "POST", headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ classroomId, studentId })
    });
    const data = await res.json();
    if (!data.success) { showAlert("Action failed", "error"); return; }

    mutedState[studentId] = willMute;
    const btn = document.getElementById(`mute-btn-${studentId}`);
    btn.classList.toggle('muted', willMute);
    btn.title = willMute ? 'Unmute' : 'Mute';
    btn.innerHTML = `<i class="fa-solid ${willMute ? 'fa-volume-xmark' : 'fa-volume-high'}"></i>`;
    showAlert(willMute ? "Student muted" : "Student unmuted", "success");
  }

  let chatLocked = <%= classroom.chat_locked ? "true" : "false" %>;

  function updateLockButton() {
    const btn = document.getElementById("chatToggleBtn");
    const pill = document.getElementById("lockPill");
    btn.innerHTML = chatLocked ? '<i class="fa-solid fa-lock-open"></i> Unlock Chat' : '<i class="fa-solid fa-lock"></i> Lock Chat';
    pill.innerHTML = chatLocked ? '<i class="fa-solid fa-lock"></i> Locked' : '<i class="fa-solid fa-lock-open"></i> Open';
  }

  async function toggleChatLock() {
    const url = chatLocked ? "/teacher/class/unlock" : "/teacher/class/lock";
    const res = await fetch(url, {
      method: "POST", headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ classroomId })
    });
    const data = await res.json();
    if (data.success) {
      chatLocked = !chatLocked;
      updateLockButton();
    } else {
      showAlert("Action failed", "error");
    }
  }

  function openAnnouncementModal() {
    document.getElementById('announcementModal').style.display = 'flex';
  }

  async function submitAnnouncement() {
    const title = document.getElementById('announcementTitle').value.trim();
    const message = document.getElementById('announcementMessage').value.trim();
    if (!title || !message) {
      showAlert("Title and message are required.");
      return;
    }
    const res = await fetch('/teacher/classroom-announcements', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ classroomId, title, message })
    });
    const data = await res.json();
    if (data.success) {
      showAlert("Announcement posted!", "success").then(refreshChat);
    } else {
      showAlert(data.message || "Failed to post announcement", "error");
    }
  }

  async function deleteAnnouncement(id) {
    if (!(await showConfirm("Delete this announcement?"))) return;
    const res = await fetch(`/teacher/classroom-announcements/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) refreshChat();
    else showAlert(data.message || "Failed to delete", "error");
  }

  // Reloading the whole page would bounce back to /teacher/dashboard's
  // default section (the browser's actual URL never left it) — this just
  // re-fetches this same classroom's chat fragment instead.
  function refreshChat() {
    loadUrl(`/teacher/class-chat/${classroomId}`, 'classes');
  }

  function showMobileTab(which) {
    document.getElementById('chatPanel').classList.toggle('tc-hidden-mobile', which !== 'chat');
    document.getElementById('studentPanel').classList.toggle('tc-hidden-mobile', which !== 'students');
    document.getElementById('tabChatBtn').classList.toggle('active', which === 'chat');
    document.getElementById('tabStudentsBtn').classList.toggle('active', which === 'students');
  }

  updateLockButton();
  loadMessages();
  const pollIntervalId = setInterval(loadMessages, 5000);

  // The dashboard's section loader calls this (if defined) before swapping
  // in whatever the user navigates to next, so this stops polling instead
  // of leaving an orphaned interval running against a container that's no
  // longer on the page.
  window.__teacherSectionCleanup = function () {
    clearInterval(pollIntervalId);
  };

  // Inline onclick="..." attributes in this fragment's HTML resolve
  // against global scope, not this IIFE's local scope — export exactly
  // the handlers referenced that way.
  window.sendClassMessage = sendClassMessage;
  window.deleteMessage = deleteMessage;
  window.toggleMute = toggleMute;
  window.toggleChatLock = toggleChatLock;
  window.openAnnouncementModal = openAnnouncementModal;
  window.submitAnnouncement = submitAnnouncement;
  window.deleteAnnouncement = deleteAnnouncement;
  window.showMobileTab = showMobileTab;
})();
</script>
