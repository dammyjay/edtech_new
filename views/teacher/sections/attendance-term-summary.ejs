<style>
  .tc-att-hero {
    background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807));
    color: #fff; border-radius: var(--radius-lg, 16px); padding: 22px 24px; margin: 16px 0;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
  }
  .tc-att-hero h2 { margin: 0 0 4px; font-size: 19px; }
  .tc-att-hero p { margin: 0; opacity: 0.9; font-size: 13px; }
  .tc-att-hero-stats { display: flex; gap: 14px; flex-wrap: wrap; }
  .tc-att-hero-stat { background: rgba(255,255,255,0.18); border-radius: 12px; padding: 10px 16px; text-align: center; min-width: 90px; }
  .tc-att-hero-stat .val { display: block; font-size: 19px; font-weight: 800; }
  .tc-att-hero-stat .lbl { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; opacity: 0.9; margin-top: 2px; }

  .tc-att-row { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; flex-wrap: wrap; }
  .tc-att-rank { font-weight: 800; color: var(--brand-pri, #A17807); width: 30px; flex-shrink: 0; }
  .tc-att-name { font-weight: 700; font-size: 13.5px; flex: 1; min-width: 140px; }
  .tc-att-breakdown { display: flex; gap: 10px; font-size: 11.5px; color: #666; }
  .tc-att-breakdown span.present { color: #1E6B34; }
  .tc-att-breakdown span.absent { color: #A83232; }
  .tc-att-breakdown span.late { color: #8A5300; }
  .tc-att-chip { display: inline-block; padding: 3px 12px; border-radius: 999px; font-size: 12px; font-weight: 800; white-space: nowrap; }
  .tc-att-great { background: #EAF6EE; color: #1E6B34; }
  .tc-att-good { background: #FFF4E5; color: #8A5300; }
  .tc-att-try { background: #FBEAEA; color: #A83232; }
  .tc-att-perfect { background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807)); color: #fff; margin-left: 6px; }
</style>

<button type="button" class="back-btn" onclick="loadSection('attendance')" style="margin-bottom:12px;">⬅ Back to attendance</button>

<div class="tc-att-hero">
  <div>
    <h2>📊 <%= term.name %> Attendance Summary<%= term.is_ended ? '' : ' (term still active)' %></h2>
    <p><%= classroom ? classroom.name : '' %></p>
  </div>
  <div class="tc-att-hero-stats">
    <div class="tc-att-hero-stat"><span class="val"><%= totalSessions %></span><span class="lbl">Sessions Held</span></div>
    <div class="tc-att-hero-stat"><span class="val"><%= students.length %></span><span class="lbl">Students</span></div>
    <div class="tc-att-hero-stat"><span class="val"><%= averageAttendance %>%</span><span class="lbl">Avg Attendance</span></div>
  </div>
</div>

<h2 class="tc-section-title">🏆 Attendance Leaderboard</h2>
<% if (!totalSessions) { %>
  <p class="tc-empty">No sessions were held in this term yet.</p>
<% } else if (!students.length) { %>
  <p class="tc-empty">No students found in this classroom.</p>
<% } else { %>
  <% students.forEach((s, i) => { %>
    <% const tier = s.attendancePercent >= 90 ? 'great' : s.attendancePercent >= 70 ? 'good' : 'try'; %>
    <div class="tc-att-row">
      <span class="tc-att-rank">#<%= i + 1 %></span>
      <span class="tc-att-name"><%= s.fullname %></span>
      <div class="tc-att-breakdown">
        <span class="present">✅ <%= s.present %></span>
        <span class="late">⏰ <%= s.late %></span>
        <span class="absent">❌ <%= s.absent %></span>
      </div>
      <span class="tc-att-chip tc-att-<%= tier %>"><%= s.attendancePercent %>%</span>
      <% if (s.attendancePercent === 100) { %>
        <span class="tc-att-chip tc-att-perfect">🌟 Perfect Attendance</span>
      <% } %>
    </div>
  <% }) %>
<% } %>
