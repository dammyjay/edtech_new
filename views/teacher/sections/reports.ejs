<button type="button" class="back-btn" onclick="loadSection('dashboard')">⬅ Back to dashboard</button>

<h2 class="tc-section-title">📑 Student Reports</h2>
<p class="tc-empty" style="margin-top:-8px;">Pick a student to choose which course's report to review — reports open as a page, not a downloadable file.</p>
<div class="table-responsive">
  <table class="user-table sortable-table" width="100%">
    <thead>
      <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Classroom</th>
        <th>Report</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length > 0) { %>
        <% students.forEach(stu => { %>
          <tr>
            <td><%= stu.fullname %></td>
            <td><%= stu.email %></td>
            <td><%= stu.classroom_name %></td>
            <td><button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" onclick="loadUrl('/teacher/student/<%= stu.id %>/report', 'reports')">👁️ View Reports</button></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4" class="tc-empty">No reports available.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
