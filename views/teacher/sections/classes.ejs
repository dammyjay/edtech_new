<button type="button" class="back-btn" onclick="loadSection('dashboard')">⬅ Back to dashboard</button>

<h2 class="tc-section-title">📚 My Classes Overview</h2>

<div class="tc-stat-grid">
  <div class="tc-stat-card"><div class="icon">🏫</div><div class="val"><%= overview.total_classes || 0 %></div><div class="lbl">Total Classes</div></div>
  <div class="tc-stat-card"><div class="icon">👩‍🎓</div><div class="val"><%= overview.total_students || 0 %></div><div class="lbl">Students</div></div>
  <div class="tc-stat-card"><div class="icon">📘</div><div class="val"><%= overview.total_lessons || 0 %></div><div class="lbl">Lessons</div></div>
  <div class="tc-stat-card"><div class="icon">📊</div><div class="val"><%= overview.avg_quiz_score || "–" %></div><div class="lbl">Avg Quiz Score</div></div>
</div>

<% if (genderStats && genderStats.length) { %>
  <h2 class="tc-section-title">👥 Student Gender Mix</h2>
  <div style="max-width:320px;">
    <canvas id="classesGenderChart" style="max-height:180px;"></canvas>
  </div>
<% } %>

<h2 class="tc-section-title">📚 My Classes</h2>
<% if (classes.length > 0) { %>
  <div class="tc-classroom-grid">
    <% classes.forEach(cls => { %>
      <% const a = analyticsByClassId.get(cls.id); %>
      <div class="tc-classroom-card">
        <h3><%= cls.name %></h3>
        <p>📘 Lessons: <%= (lessonsPerClass.find(l => l.id == cls.id) || {}).lesson_count || 0 %></p>
        <p>👥 Students: <%= (studentCounts.find(s => s.id == cls.id) || {}).student_count || 0 %></p>
        <p>📊 Avg Quiz: <%= (quizScores.find(q => q.id == cls.id) || {}).avg_quiz_score || "–" %></p>
        <% if (a && a.selectedTerm) { %>
          <p>📈 Avg Completion (<%= a.selectedTerm.name %>): <%= a.averageCompletion %>%</p>
          <% if (a.atRiskStudents && a.atRiskStudents.length) { %>
            <p style="color:#A83232; font-weight:700;">⚠️ <%= a.atRiskStudents.length %> student<%= a.atRiskStudents.length === 1 ? '' : 's' %> need attention</p>
          <% } %>
        <% } %>
        <div class="tc-classroom-actions">
          <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" onclick="loadUrl('/teacher/classroom/<%= cls.id %>/students', 'classes')">👀 Classroom Overview</button>
          <button type="button" class="tc-btn tc-btn-primary tc-btn-sm" onclick="loadUrl('/teacher/class-chat/<%= cls.id %>', 'classes')">💬 Class Chat</button>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p class="tc-empty">No classes assigned.</p>
<% } %>

<script>
(function () {
  function renderChart() {
    var el = document.getElementById('classesGenderChart');
    if (!el) return;
    new Chart(el, {
      type: 'doughnut',
      data: {
        labels: <%- JSON.stringify((genderStats || []).map(g => g.gender || "Unknown")) %>,
        datasets: [{
          data: <%- JSON.stringify((genderStats || []).map(g => parseInt(g.count))) %>,
          backgroundColor: ['#A17807', '#D9A82C', '#4C3802']
        }]
      },
      options: { plugins: { legend: { position: 'bottom' } } }
    });
  }
  if (window.Chart) {
    renderChart();
  } else {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
    s.onload = renderChart;
    document.body.appendChild(s);
  }
})();
</script>
