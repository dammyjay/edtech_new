<h2 class="tc-section-title">📋 Attendance</h2>

<div style="margin-bottom:15px; display:flex; gap:12px; flex-wrap:wrap; align-items:end;">
  <div>
    <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Term</label>
    <select id="attendanceFilterTerm" onchange="updateTermSummaryButton()">
      <% (school?.terms || []).forEach(t => { %>
        <option value="<%= t.term_id %>" data-ended="<%= t.is_ended ? '1' : '0' %>" <%= t.is_active ? 'selected' : '' %>><%= t.term_name %><%= t.is_active ? ' (active)' : (t.is_ended ? ' (ended)' : '') %></option>
      <% }) %>
    </select>
  </div>

  <div>
    <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Classroom</label>
    <select id="attendanceFilterClassroom" onchange="updateTermSummaryButton()">
      <option value="">All</option>
      <% classes.forEach(c => { %>
        <option value="<%= c.id %>"><%= c.name %></option>
      <% }) %>
    </select>
  </div>

  <button class="tc-btn tc-btn-secondary" onclick="loadAttendanceHistory()">Load</button>
  <button class="tc-btn tc-btn-primary" onclick="openAttendanceModal()">➕ Take Attendance</button>
  <button class="tc-btn tc-btn-primary" id="termSummaryBtn" style="display:none;" onclick="viewTermAttendanceSummary()">📊 View Term Summary</button>
</div>

<div class="table-responsive">
  <table class="user-table sortable-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Classroom</th>
        <th>Status</th>
        <th>Students</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="attendanceTableBody">
      <tr><td colspan="5" class="tc-empty">No data yet — pick a term and click Load.</td></tr>
    </tbody>
  </table>
</div>

<div id="attendanceModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span onclick="closeModal('attendanceModal')" class="close-btn">&times;</span>

    <h3>📋 Take Attendance</h3>

    <label>Session Type</label>
    <select id="sessionStatus">
      <option value="held">✅ Class Held</option>
      <option value="holiday">🎉 Holiday</option>
      <option value="no_class">📭 No Class</option>
      <option value="cancelled">❌ Cancelled</option>
    </select>

    <label>Date</label>
    <input type="date" id="attendanceDate" value="<%= new Date().toISOString().split('T')[0] %>" />

    <label>Week</label>
    <select id="week_number">
      <% for(let i = 1; i <= 10; i++) { %>
        <option value="<%= i %>">Week <%= i %></option>
      <% } %>
    </select>

    <div id="attendanceStudentList"></div>
  </div>
</div>

<script src="/js/teacherAttendance.js"></script>
