<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:15px;">
  <button type="button" class="back-btn" onclick="loadSection('classes')">⬅ Back to classes</button>
  <% if (termAnalytics.terms && termAnalytics.terms.length > 1) { %>
    <select id="termSelect" class="tc-term-select" onchange="loadUrl('/teacher/classroom/<%= classroomId %>/students?termId=' + this.value, 'classes')">
      <% termAnalytics.terms.forEach(t => { %>
        <option value="<%= t.id %>" <%= termAnalytics.selectedTerm && termAnalytics.selectedTerm.id === t.id ? 'selected' : '' %>>
          <%= t.name %><%= t.is_active ? ' (active)' : '' %>
        </option>
      <% }) %>
    </select>
  <% } %>
</div>

<h2 class="tc-section-title">📊 <%= classroomName %> — Classroom Overview</h2>
<% if (termAnalytics.selectedTerm) { %>
  <p class="tc-empty" style="margin-top:-10px;">Showing: <%= termAnalytics.selectedTerm.name %></p>
<% } %>

<div class="tc-stat-grid">
  <div class="tc-stat-card"><div class="icon">👥</div><div class="val"><%= termAnalytics.totalStudents || 0 %></div><div class="lbl">Students</div></div>
  <div class="tc-stat-card"><div class="icon">📘</div><div class="val"><%= termAnalytics.averageCompletion || 0 %>%</div><div class="lbl">Avg Completion</div></div>
  <div class="tc-stat-card"><div class="icon">📊</div><div class="val"><%= termAnalytics.averageQuiz || 0 %></div><div class="lbl">Avg Quiz Score</div></div>
  <div class="tc-stat-card">
    <div class="icon">🏅</div>
    <% if (topStudent && topStudent.fullname) { %>
      <div class="val" style="font-size:14px;"><%= topStudent.fullname %></div>
      <div class="lbl">Top by Quiz Avg</div>
    <% } else { %>
      <div class="lbl">No student data</div>
    <% } %>
  </div>
</div>

<% if (termAnalytics.atRiskStudents && termAnalytics.atRiskStudents.length) { %>
  <h2 class="tc-section-title">⚠️ Needs Attention</h2>
  <div class="tc-alerts">
    <% termAnalytics.atRiskStudents.forEach(s => { %>
      <div class="tc-alert tc-alert-risk">
        <div class="tc-alert-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="tc-alert-body">
          <strong><%= s.fullname %></strong> — <%= s.completionPercent %>% complete, quiz avg <%= s.quizAvg %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (termAnalytics.leaderboard && termAnalytics.leaderboard.length) { %>
  <h2 class="tc-section-title">🏆 Leaderboard</h2>
  <div class="tc-leaderboard">
    <% termAnalytics.leaderboard.forEach((s, i) => { %>
      <div class="tc-leaderboard-row">
        <span class="tc-lb-rank">#<%= i + 1 %></span>
        <span class="tc-lb-name"><%= s.fullname %></span>
        <span class="tc-lb-metric"><%= s.completionPercent %>% done</span>
        <span class="tc-lb-metric">Quiz <%= s.quizAvg %></span>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (termAnalytics.courseBreakdown && termAnalytics.courseBreakdown.length) { %>
  <h2 class="tc-section-title">📚 Course Breakdown</h2>
  <div class="table-responsive">
    <table class="user-table sortable-table" width="100%">
      <thead>
        <tr><th>Course</th><th>Engaged</th><th>Avg Completion</th><th>Avg Quiz</th></tr>
      </thead>
      <tbody>
        <% termAnalytics.courseBreakdown.forEach(c => { %>
          <tr>
            <td><%= c.title %></td>
            <td><%= c.studentsEngaged %> / <%= c.totalStudents %></td>
            <td><%= c.avgCompletion %>%</td>
            <td><%= c.avgQuiz %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<h2 class="tc-section-title">📈 Class Analytics</h2>
<div style="display:flex; gap:30px; flex-wrap:wrap;">
  <div style="flex:1; min-width:280px;">
    <h3 style="font-size:14px; color:#555;">Gender</h3>
    <canvas id="genderChart" style="max-height:180px;"></canvas>
  </div>
  <div style="flex:1; min-width:280px;">
    <h3 style="font-size:14px; color:#555;">Progress Distribution</h3>
    <canvas id="progressChart"></canvas>
  </div>
  <div style="flex:1; min-width:280px;">
    <h3 style="font-size:14px; color:#555;">Quiz Performance</h3>
    <canvas id="quizChart"></canvas>
  </div>
</div>

<h2 class="tc-section-title">👥 Student Details</h2>
<div class="table-responsive">
  <table class="user-table sortable-table" width="100%">
    <thead>
      <tr>
        <th>Full Name</th>
        <th>Level</th>
        <th>Streak</th>
        <th>Badges</th>
        <th>Lessons</th>
        <th>Quiz Avg</th>
        <th>Assignment Avg</th>
        <th>Last Active</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length > 0) { %>
        <% students.forEach(stu => { %>
          <tr>
            <td><%= stu.fullname %></td>
            <td><span class="tc-chip">Lvl <%= stu.levelInfo.level %> · <%= stu.levelInfo.name %></span></td>
            <td><span class="tc-streak">🔥 <%= stu.streak.currentStreak %></span></td>
            <td><span class="tc-badge-count">🏅 <%= stu.badgeCount %></span></td>
            <td><%= stu.lessons_completed %> / <%= stu.total_lessons %></td>
            <td><%= stu.avg_quiz_score || "–" %></td>
            <td><%= stu.avg_assignment_score || "–" %></td>
            <td><%= stu.last_login ? new Date(stu.last_login).toLocaleString() : "Never" %></td>
            <td><button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" onclick="loadUrl('/teacher/student/<%= stu.id %>/progress', 'classes')">View Progress</button></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="9">No students found in this class.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<style>
  .tc-term-select { padding: 8px 12px; border-radius: 8px; border: 1px solid #ddd; font-size: 13px; font-weight: 600; }
</style>

<script>
(function () {
  // Chart.js is already loaded once by the dashboard shell; guard against
  // re-declaring it if this fragment gets swapped in more than once.
  function renderCharts() {
    new Chart(document.getElementById('genderChart'), {
      type: 'doughnut',
      data: {
        labels: <%- JSON.stringify(genderSummary.map(g => g.gender || "Unknown")) %>,
        datasets: [{
          data: <%- JSON.stringify(genderSummary.map(g => parseInt(g.count))) %>,
          backgroundColor: ['#A17807', '#D9A82C', '#4C3802']
        }]
      },
      options: { plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('progressChart'), {
      type: 'bar',
      data: {
        labels: ['0–49%', '50–74%', '75–100%'],
        datasets: [{
          label: 'Number of Students',
          data: [<%= progressDist.low %>, <%= progressDist.mid %>, <%= progressDist.high %>],
          backgroundColor: ['#E9615C', '#F0B23A', '#34C77B']
        }]
      },
      options: { responsive: true, plugins: { legend: { display: false } } }
    });

    new Chart(document.getElementById('quizChart'), {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(students.map(s => s.fullname)) %>,
        datasets: [{
          label: 'Avg Quiz Score',
          data: <%- JSON.stringify(students.map(s => s.avg_quiz_score || 0)) %>,
          backgroundColor: '#A17807'
        }]
      },
      options: { responsive: true, plugins: { legend: { display: false } } }
    });
  }

  if (window.Chart) {
    renderCharts();
  } else {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
    s.onload = renderCharts;
    document.body.appendChild(s);
  }
})();
</script>
