<h2 class="tc-section-title">🎓 My Students</h2>
<div class="table-responsive">
  <table class="user-table sortable-table" width="100%">
    <thead>
      <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Classroom</th>
        <th>Progress</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length > 0) { %>
        <% students.forEach(stu => { %>
          <tr>
            <td><%= stu.fullname %></td>
            <td><%= stu.email %></td>
            <td><%= stu.classroom_name %></td>
            <td><button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" onclick="loadUrl('/teacher/student/<%= stu.id %>/progress', 'students')">📊 View Progress</button></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4" class="tc-empty">No students found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
