<style>
  .tc-sp-hero {
    background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807));
    color: #fff; border-radius: var(--radius-lg, 16px); padding: 22px 24px; margin: 16px 0;
    display: flex; gap: 18px; align-items: center; flex-wrap: wrap; justify-content: space-between;
  }
  .tc-sp-hero-left { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .tc-sp-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,0.5); flex-shrink: 0; }
  .tc-sp-hero-info h2 { margin: 0 0 4px; font-size: 20px; }
  .tc-sp-hero-info p { margin: 0; opacity: 0.9; font-size: 13px; }
  .tc-sp-level-chip { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; margin-top: 8px; }
  .tc-sp-xp-bar-wrap { margin-top: 8px; width: 220px; max-width: 100%; }
  .tc-sp-xp-bar { background: rgba(255,255,255,0.25); border-radius: 999px; height: 8px; overflow: hidden; }
  .tc-sp-xp-bar-fill { background: #fff; height: 100%; border-radius: 999px; }
  .tc-sp-xp-label { font-size: 10.5px; opacity: 0.85; margin-top: 4px; display: block; }
  .tc-sp-streak-block { text-align: center; }
  .tc-sp-streak-val { font-size: 26px; font-weight: 800; line-height: 1; }
  .tc-sp-streak-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; opacity: 0.85; }

  .tc-sp-badge-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 14px; margin: 14px 0; }
  .tc-sp-badge-card { background: #fff; border: 1px solid #eee; border-radius: var(--radius-lg, 16px); padding: 12px; text-align: center; box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06)); }
  .tc-sp-badge-card img { width: 64px; height: 64px; object-fit: contain; margin-bottom: 6px; }
  .tc-sp-badge-card .name { font-size: 11.5px; font-weight: 700; color: var(--brand-pri-dark, #4C3802); }
  .tc-sp-badge-card .sub { font-size: 10px; color: #888; margin-top: 2px; }

  .tc-sp-cert-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin: 14px 0; }
  .tc-sp-cert-card { background: #fff; border: 1px solid #eee; border-radius: var(--radius-lg, 16px); padding: 10px; text-align: center; box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06)); }
  .tc-sp-cert-card img { width: 100%; border-radius: 8px; margin-bottom: 6px; }
  .tc-sp-cert-card .title { font-size: 11.5px; font-weight: 700; color: var(--brand-pri-dark, #4C3802); }

  .tc-sp-score-chip { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700; white-space: nowrap; }
  .tc-sp-score-great { background: #EAF6EE; color: #1E6B34; }
  .tc-sp-score-good { background: #FFF4E5; color: #8A5300; }
  .tc-sp-score-try { background: #FBEAEA; color: #A83232; }
  .tc-sp-score-neutral { background: #f0f0f0; color: #666; }

  /* ---- Gamified tabbed progress browser, modeled on the instructor
     role's sp- design (views/instructor/sections/studentProgress.ejs)
     so a score/grade/tier looks the same everywhere a teacher or
     instructor sees it — just scoped tc-sp- to coexist with the hero/
     badge styles above and teacher_sidenav.ejs's .tc- library. ---- */
  .tc-sp-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 16px; }
  .tc-sp-tab {
    padding: 9px 16px; border-radius: 999px; background: #fff;
    border: 1px solid #e5e0d0; cursor: pointer; font-weight: 700; font-size: 12.5px;
    color: #665c3f; transition: 0.15s ease; white-space: nowrap;
  }
  .tc-sp-tab:hover { background: var(--brand-tint, #FBF3DD); }
  .tc-sp-tab.active { background: var(--brand-pri, #A17807); color: #fff; border-color: var(--brand-pri, #A17807); }

  .tc-sp-panel { display: none; }
  .tc-sp-panel.active { display: block; animation: tcSpFadeIn 0.22s ease; }
  @keyframes tcSpFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .tc-sp-bar { height: 9px; background: #f2ede0; border-radius: 999px; overflow: hidden; }
  .tc-sp-bar-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807)); transition: width 0.3s; }

  .tc-sp-grade-circle {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  .tc-sp-grade-circle .letter { font-size: 15px; font-weight: 800; line-height: 1; }
  .tc-sp-grade-circle .lbl { font-size: 6px; text-transform: uppercase; letter-spacing: 0.03em; margin-top: 2px; }
  .tc-sp-grade-circle.great { background: #EAF6EE; color: #1E6B34; }
  .tc-sp-grade-circle.good { background: #FFF4E5; color: #8A5300; }
  .tc-sp-grade-circle.try { background: #FBEAEA; color: #A83232; }
  .tc-sp-grade-circle.neutral { background: #f0f0f0; color: #888; }

  .tc-sp-course-card { background: #fff; border-radius: var(--radius-lg, 16px); box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06)); overflow: hidden; margin-bottom: 16px; }
  .tc-sp-course-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; cursor: pointer; gap: 10px; flex-wrap: wrap; }
  .tc-sp-course-head:hover { background: var(--brand-tint, #FBF3DD); }
  .tc-sp-course-head h3 { margin: 0; font-size: 15px; color: var(--brand-pri-dark, #4C3802); }
  .tc-sp-course-head .percent { font-size: 12px; color: #777; }
  .tc-sp-toggle-icon { font-size: 18px; font-weight: 800; transition: transform 0.25s ease; color: var(--brand-pri-dark, #4C3802); flex-shrink: 0; }
  .tc-sp-toggle-icon.open { transform: rotate(45deg); }
  .tc-sp-course-bar-wrap { padding: 0 18px; }
  .tc-sp-course-body { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .tc-sp-course-body.open { max-height: 6000px; }
  .tc-sp-course-body-inner { padding: 14px 18px 18px; }

  .tc-sp-module-card { background: #FBF9F3; border: 1px solid #f0ead8; border-radius: var(--radius, 10px); padding: 14px 16px; margin-bottom: 10px; }
  .tc-sp-module-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .tc-sp-module-head h4 { margin: 0; font-size: 13.5px; color: #4C3802; }
  .tc-sp-module-sub { font-size: 11.5px; color: #887c5c; margin: 4px 0 8px; }
  .tc-sp-lesson-row { display: flex; align-items: center; gap: 10px; padding: 6px 0; font-size: 12.5px; border-bottom: 1px dashed #ece4d0; }
  .tc-sp-lesson-row:last-child { border-bottom: none; }
  .tc-sp-lesson-row .lesson-title { flex: 1; }

  .tc-sp-list-card {
    background: #fff; border-radius: var(--radius, 10px); padding: 13px 16px; margin-bottom: 9px;
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06));
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .tc-sp-list-card .main { flex: 1; min-width: 180px; }
  .tc-sp-list-card .title { font-weight: 700; font-size: 13.5px; color: #333; }
  .tc-sp-list-card .sub { font-size: 11.5px; color: #888; margin-top: 2px; }

  .course-card { background: #fff; border: 1px solid #eee; border-radius: var(--radius-lg, 16px); padding: 16px 18px; margin-bottom: 14px; box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06)); }

  /* Printing is disabled for teacher-viewed student progress — matches the
     "view, never download/print" restriction; this blanks the page on
     print (a JS-level nudge, not a real security boundary — nothing a
     browser page renders can stop a screenshot or a phone photo of the
     screen, only make casual copy/print/save meaningfully less convenient). */
  @media print {
    body { display: none !important; }
  }

  @media (max-width: 600px) {
    .tc-sp-hero { padding: 18px; }
    .tc-sp-tabs { gap: 6px; }
    .tc-sp-tab { padding: 8px 12px; font-size: 11.5px; }
  }
</style>

<%
  function tcSpScoreTier(score) {
    if (score === null || score === undefined) return { emoji: "📋", cls: "neutral" };
    if (score >= 80) return { emoji: "⭐", cls: "great" };
    if (score >= 60) return { emoji: "👍", cls: "good" };
    return { emoji: "💪", cls: "try" };
  }
  function tcSpLetterGrade(score) {
    if (score === null || score === undefined) return null;
    if (score >= 80) return "A";
    if (score >= 70) return "B";
    if (score >= 60) return "C";
    if (score >= 50) return "D";
    return "F";
  }
  function tcSpModuleQuizAvg(m) {
    const scored = m.quizzes.filter((q) => q.score !== null && q.score !== undefined);
    return scored.length ? Math.round(scored.reduce((a, b) => a + b.score, 0) / scored.length) : null;
  }
  function tcSpModuleAssignmentAvg(m) {
    const scored = m.assignments.filter((a) => a.total !== null && a.total !== undefined);
    return scored.length ? Math.round(scored.reduce((a, b) => a + (b.total || 0), 0) / scored.length) : null;
  }
  // Mirrors utils/reportTemplate.js's smartScore — the average of lesson
  // completion %, quiz average (if any quizzes exist) and assignment
  // average (if any exist), so the grade shown here matches the one in
  // the downloadable report exactly.
  function tcSpModuleScore(m, quizAvg, assignmentAvg) {
    const parts = [m.percent];
    if (quizAvg !== null) parts.push(quizAvg);
    if (assignmentAvg !== null) parts.push(assignmentAvg);
    return Math.round(parts.reduce((a, b) => a + b, 0) / parts.length);
  }
  function tcSpFriendlyQuizTitle(q, lessonTitle) {
    const raw = (q.title || "").trim();
    if (lessonTitle && /^quiz for lesson\s*\d+$/i.test(raw)) return `Quiz for Lesson: ${lessonTitle}`;
    return raw || lessonTitle || "Quiz";
  }
%>

<div id="tcStudentProgressRoot">
  <div class="btns" style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
    <button type="button" class="back-btn" onclick="goBackSection()">⬅ Back</button>
  </div>

  <div class="tc-sp-hero">
    <div class="tc-sp-hero-left">
      <img class="tc-sp-avatar" src="<%= student.profile_picture || '/profile.webp' %>" alt="">
      <div class="tc-sp-hero-info">
        <h2>📊 <%= student.fullname %></h2>
        <p><%= student.email %></p>
        <span class="tc-sp-level-chip">🎮 Lvl <%= levelInfo.level %> · <%= levelInfo.name %></span>
        <div class="tc-sp-xp-bar-wrap">
          <div class="tc-sp-xp-bar"><div class="tc-sp-xp-bar-fill" style="width:<%= levelInfo.progressPercent %>%"></div></div>
          <span class="tc-sp-xp-label">
            <%= levelInfo.xp.toLocaleString() %> XP
            <% if (levelInfo.xpForNextLevel) { %>
              · <%= (levelInfo.xpForNextLevel - levelInfo.xpIntoLevel).toLocaleString() %> to next level
            <% } else { %>
              · Max level!
            <% } %>
          </span>
        </div>
      </div>
    </div>
    <div class="tc-sp-streak-block">
      <div class="tc-sp-streak-val">🔥 <%= streak.currentStreak %></div>
      <div class="tc-sp-streak-lbl">Day Streak</div>
    </div>
  </div>

  <div class="tc-stat-grid">
    <div class="tc-stat-card"><div class="icon">🎓</div><div class="val"><%= courses.length %></div><div class="lbl">Courses</div></div>
    <div class="tc-stat-card"><div class="icon">📘</div><div class="val"><%= courses.length ? Math.round(courses.reduce((s,c)=>s+c.percent,0)/courses.length) : 0 %>%</div><div class="lbl">Avg Completion</div></div>
    <div class="tc-stat-card"><div class="icon">📊</div><div class="val"><%= overallQuizAvg !== null ? overallQuizAvg : '–' %></div><div class="lbl">Quiz Avg</div></div>
    <div class="tc-stat-card"><div class="icon">📑</div><div class="val"><%= overallAssignmentAvg !== null ? overallAssignmentAvg : '–' %></div><div class="lbl">Assignment Avg</div></div>
    <div class="tc-stat-card"><div class="icon">🏅</div><div class="val"><%= badges.length %></div><div class="lbl">Badges</div></div>
  </div>

  <% if (badges.length) { %>
    <h2 class="tc-section-title">🏅 Badges Earned</h2>
    <div class="tc-sp-badge-gallery">
      <% badges.forEach(b => { %>
        <div class="tc-sp-badge-card">
          <% if (b.badge_image) { %><img src="<%= b.badge_image %>" alt=""><% } else { %><div style="font-size:40px;">🏅</div><% } %>
          <div class="name"><%= b.badge_name %></div>
          <% if (b.module_title) { %><div class="sub"><%= b.module_title %></div><% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (certificates.length) { %>
    <h2 class="tc-section-title">🎖️ Certificates</h2>
    <div class="tc-sp-cert-gallery">
      <% certificates.forEach(c => { %>
        <div class="tc-sp-cert-card">
          <img src="<%= c.certificate_url %>" alt="">
          <div class="title"><%= c.course_title %></div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (!courses.length) { %>
    <h2 class="tc-section-title">📚 Course Progress</h2>
    <p class="tc-empty">No progress data available.</p>
  <% } else { %>

  <div class="tc-sp-tabs">
    <div class="tc-sp-tab active" data-tcsp-tab="courses" onclick="tcSpOpenTab('courses')">🎓 Courses</div>
    <div class="tc-sp-tab" data-tcsp-tab="modules" onclick="tcSpOpenTab('modules')">🧩 Modules</div>
    <div class="tc-sp-tab" data-tcsp-tab="lessons" onclick="tcSpOpenTab('lessons')">📖 Lessons</div>
    <div class="tc-sp-tab" data-tcsp-tab="quizzes" onclick="tcSpOpenTab('quizzes')">🧠 Quizzes</div>
    <div class="tc-sp-tab" data-tcsp-tab="assignments" onclick="tcSpOpenTab('assignments')">📝 Assignments</div>
  </div>

  <!-- ============ COURSES ============ -->
  <div id="tcsp-courses" class="tc-sp-panel active">
    <% courses.forEach((c, ci) => { %>
      <div class="tc-sp-course-card">
        <div class="tc-sp-course-head" onclick="tcSpToggleCourse(<%= ci %>)">
          <h3>🎓 <%= c.course_title %></h3>
          <div style="display:flex; align-items:center; gap:10px;">
            <span class="percent"><%= c.percent %>% complete</span>
            <span class="tc-sp-toggle-icon" id="tcsp-icon-<%= ci %>">➕</span>
          </div>
        </div>
        <div class="tc-sp-course-bar-wrap"><div class="tc-sp-bar"><div class="tc-sp-bar-fill" style="width:<%= c.percent %>%"></div></div></div>

        <div class="tc-sp-course-body" id="tcsp-course-body-<%= ci %>">
          <div class="tc-sp-course-body-inner">
            <% c.modules.forEach(m => { %>
              <% const mQuizAvg = tcSpModuleQuizAvg(m); const mAssignAvg = tcSpModuleAssignmentAvg(m); %>
              <div class="tc-sp-module-card">
                <div class="tc-sp-module-head">
                  <h4><%= m.percent === 100 ? "🏆" : m.percent > 0 ? "📦" : "⚪" %> <%= m.module_title %></h4>
                  <% if (m.percent === 100) { %>
                    <% const grade = tcSpLetterGrade(tcSpModuleScore(m, mQuizAvg, mAssignAvg)); const gt = tcSpScoreTier(tcSpModuleScore(m, mQuizAvg, mAssignAvg)); %>
                    <span class="tc-sp-score-chip tc-sp-score-<%= gt.cls === 'great' ? 'great' : gt.cls === 'good' ? 'good' : gt.cls === 'try' ? 'try' : 'neutral' %>">Grade <%= grade %> · <%= m.percent %>%</span>
                  <% } else { %>
                    <span class="tc-sp-score-chip tc-sp-score-neutral">⏳ In Progress · <%= m.percent %>%</span>
                  <% } %>
                </div>
                <div class="tc-sp-bar" style="margin:6px 0 8px;"><div class="tc-sp-bar-fill" style="width:<%= m.percent %>%"></div></div>
                <div class="tc-sp-module-sub">
                  <%= m.completedLessons %>/<%= m.totalLessons %> lessons · Quiz <%= mQuizAvg !== null ? mQuizAvg + '%' : 'N/A' %> · Assignment <%= mAssignAvg !== null ? mAssignAvg + '%' : 'N/A' %>
                </div>
                <% m.lessons.forEach(l => { %>
                  <div class="tc-sp-lesson-row">
                    <span><%= l.completed ? "✅" : "⭕" %></span>
                    <span class="lesson-title"><%= l.title %></span>
                  </div>
                <% }) %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- ============ MODULES ============ -->
  <div id="tcsp-modules" class="tc-sp-panel">
    <% courses.forEach(c => { %>
      <% c.modules.forEach(m => { %>
        <% const mQuizAvg = tcSpModuleQuizAvg(m); const mAssignAvg = tcSpModuleAssignmentAvg(m); const score = tcSpModuleScore(m, mQuizAvg, mAssignAvg); const grade = tcSpLetterGrade(score); const gt = tcSpScoreTier(score); %>
        <div class="tc-sp-list-card">
          <% if (m.percent === 100) { %>
            <div class="tc-sp-grade-circle <%= gt.cls %>"><span class="letter"><%= grade %></span><span class="lbl">Grade</span></div>
          <% } else { %>
            <div class="tc-sp-grade-circle neutral"><span class="letter" style="font-size:12px;"><%= m.percent %>%</span><span class="lbl">In Progress</span></div>
          <% } %>
          <div class="main">
            <div class="title"><%= m.module_title %> <span style="font-weight:400; color:#999; font-size:11.5px;">— <%= c.course_title %></span></div>
            <div class="sub"><%= m.completedLessons %>/<%= m.totalLessons %> lessons · Quiz <%= mQuizAvg !== null ? mQuizAvg + '%' : 'N/A' %> · Assignment <%= mAssignAvg !== null ? mAssignAvg + '%' : 'N/A' %></div>
            <div class="tc-sp-bar" style="margin-top:6px; max-width:220px;"><div class="tc-sp-bar-fill" style="width:<%= m.percent %>%"></div></div>
          </div>
        </div>
      <% }) %>
    <% }) %>
  </div>

  <!-- ============ LESSONS ============ -->
  <div id="tcsp-lessons" class="tc-sp-panel">
    <% courses.forEach(c => { %>
      <% c.modules.forEach(m => { %>
        <% m.lessons.forEach(l => { %>
          <div class="tc-sp-list-card">
            <span style="font-size:20px;"><%= l.completed ? "✅" : "⭕" %></span>
            <div class="main">
              <div class="title"><%= l.title %></div>
              <div class="sub"><%= m.module_title %> · <%= c.course_title %></div>
            </div>
          </div>
        <% }) %>
      <% }) %>
    <% }) %>
  </div>

  <!-- ============ QUIZZES ============ -->
  <div id="tcsp-quizzes" class="tc-sp-panel">
    <% let anyQuizzes = false; %>
    <% courses.forEach(c => { %>
      <% c.modules.forEach(m => { %>
        <% m.quizzes.forEach(q => { %>
          <% anyQuizzes = true; %>
          <% const lesson = m.lessons.find(l => l.id === q.lesson_id); const t = tcSpScoreTier(q.score); %>
          <div class="tc-sp-list-card">
            <span class="tc-sp-score-chip tc-sp-score-<%= t.cls %>"><%= t.emoji %> <%= q.score !== null ? q.score + '%' : 'Not yet taken' %></span>
            <div class="main">
              <div class="title"><%= tcSpFriendlyQuizTitle(q, lesson ? lesson.title : null) %></div>
              <div class="sub"><%= m.module_title %> · <%= c.course_title %></div>
            </div>
          </div>
        <% }) %>
      <% }) %>
    <% }) %>
    <% if (!anyQuizzes) { %><p class="tc-empty">No quizzes in this student's courses yet.</p><% } %>
  </div>

  <!-- ============ ASSIGNMENTS ============ -->
  <div id="tcsp-assignments" class="tc-sp-panel">
    <% let anyAssignments = false; %>
    <% courses.forEach(c => { %>
      <% c.modules.forEach(m => { %>
        <% m.assignments.forEach(a => { %>
          <% anyAssignments = true; %>
          <% const t = tcSpScoreTier(a.total); %>
          <div class="tc-sp-list-card">
            <span class="tc-sp-score-chip tc-sp-score-<%= t.cls %>"><%= a.total !== null && a.total !== undefined ? a.total + '%' : 'Pending' %></span>
            <div class="main">
              <div class="title"><%= a.title %></div>
              <div class="sub"><%= m.module_title %> · <%= c.course_title %></div>
            </div>
          </div>
        <% }) %>
      <% }) %>
    <% }) %>
    <% if (!anyAssignments) { %><p class="tc-empty">No assignments in this student's courses yet.</p><% } %>
  </div>

  <% } %>
</div>

<script>
(function () {
  window.tcSpOpenTab = function (tabId) {
    document.querySelectorAll('.tc-sp-tab').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.tc-sp-panel').forEach(panel => panel.classList.remove('active'));
    const tab = document.querySelector(`.tc-sp-tab[data-tcsp-tab="${tabId}"]`);
    if (tab) tab.classList.add('active');
    const panel = document.getElementById('tcsp-' + tabId);
    if (panel) panel.classList.add('active');
  };

  window.tcSpToggleCourse = function (index) {
    const body = document.getElementById("tcsp-course-body-" + index);
    const icon = document.getElementById("tcsp-icon-" + index);
    if (!body || !icon) return;
    body.classList.toggle("open");
    icon.textContent = body.classList.contains("open") ? "✖" : "➕";
    icon.classList.toggle("open", body.classList.contains("open"));
  };

  // Open the first course by default so there's something to see on load.
  const firstBody = document.getElementById("tcsp-course-body-0");
  const firstIcon = document.getElementById("tcsp-icon-0");
  if (firstBody && firstIcon) {
    firstBody.classList.add("open");
    firstIcon.textContent = "✖";
    firstIcon.classList.add("open");
  }

  // Same copy/right-click deterrent already used elsewhere in this app
  // (e.g. views/admin/courses.ejs's article body) — a convenience friction,
  // not a real security boundary; it doesn't and can't block screenshots.
  const root = document.getElementById('tcStudentProgressRoot');
  if (root) {
    root.style.userSelect = 'none';
    root.addEventListener('contextmenu', e => e.preventDefault());
    root.addEventListener('copy', e => e.preventDefault());
  }
})();
</script>
