<div class="tc-hero">
  <div class="tc-hero-info">
    <img class="tc-hero-avatar" src="<%= profile.profile_picture || '/profile.webp' %>" alt="">
    <div>
      <h1>👨‍🏫 Welcome, <%= profile.fullname %></h1>
      <p><%= profile.email %> · <%= new Date().toLocaleDateString() %></p>
    </div>
  </div>
  <div class="tc-hero-stats">
    <div class="tc-hero-stat"><span class="val"><%= keyStats.total_classes || 0 %></span><span class="lbl">Classes</span></div>
    <div class="tc-hero-stat"><span class="val"><%= keyStats.total_students || 0 %></span><span class="lbl">Students</span></div>
    <div class="tc-hero-stat"><span class="val"><%= keyStats.lessons_completed || 0 %>/<%= keyStats.total_lessons || 0 %></span><span class="lbl">Lessons Done</span></div>
    <div class="tc-hero-stat"><span class="val"><%= keyStats.avg_quiz_score || "–" %></span><span class="lbl">Avg Quiz</span></div>
  </div>
</div>

<div style="display:flex; gap:20px; flex-wrap:wrap; margin-bottom:16px;">
  <div>
    <label for="classSelect" style="font-weight:600; margin-right:8px;">Select Class:</label>
    <select id="classSelect">
      <option value="all">All Classes</option>
      <% classStats.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(c.id) === String(classId) ? 'selected' : '' %>><%= c.class_name %></option>
      <% }) %>
    </select>
  </div>
  <% if (terms && terms.length > 1) { %>
    <div>
      <label for="termSelect" style="font-weight:600; margin-right:8px;">Term:</label>
      <select id="termSelect">
        <% terms.forEach(t => { %>
          <option value="<%= t.id %>" <%= String(t.id) === String(selectedTermId) ? 'selected' : '' %>>
            <%= t.name %><%= t.is_active ? ' (active)' : '' %>
          </option>
        <% }) %>
      </select>
    </div>
  <% } %>
</div>

<div id="dashboardContent">
  <%- include('./dashboard-inner', { keyStats, classStats, topStudents, strugglingStudents, pendingAssignments, analytics }) %>
</div>

<script>
// IIFE — this section can be re-loaded more than once in the same page
// (loadSection('dashboard') fires on every visit, including returning to
// it), and runScripts() appends a fresh <script> each time without
// removing the previous one, so a bare top-level const here would throw
// "already declared" on the second visit.
(function () {
  function refreshTeacherDashboard() {
    const classId = document.getElementById('classSelect').value;
    const termSelect = document.getElementById('termSelect');
    const termId = termSelect ? termSelect.value : '';
    const params = new URLSearchParams({ classId, partial: '1' });
    if (termId) params.set('termId', termId);

    // ?partial=1 tells the server to render only the inner content (see
    // getDashboardData) — without it, this AJAX refresh would re-render
    // the WHOLE dashboard (hero + selectors + #dashboardContent again) and
    // nest a duplicate copy inside #dashboardContent.
    if (window.showLoading) window.showLoading();
    fetch(`/teacher/dashboard/data?${params.toString()}`)
      .then(res => res.text())
      .then(html => {
        const container = document.getElementById('dashboardContent');
        container.innerHTML = html;
        container.querySelectorAll("script").forEach(oldScript => {
          const newScript = document.createElement("script");
          if (oldScript.src) newScript.src = oldScript.src;
          else newScript.textContent = oldScript.textContent;
          document.body.appendChild(newScript);
          oldScript.remove();
        });
      })
      .catch(err => console.error('Error loading class dashboard:', err))
      .finally(() => { if (window.hideLoading) window.hideLoading(); });
  }

  document.getElementById('classSelect').addEventListener('change', refreshTeacherDashboard);
  const termSelectEl = document.getElementById('termSelect');
  if (termSelectEl) termSelectEl.addEventListener('change', refreshTeacherDashboard);
})();
</script>
