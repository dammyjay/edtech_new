<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= displayName %> completed <%= certificate.course_title %> — <%= (company.company_name || 'JKT Hub').trim() %></title>

  <!-- Open Graph tags for a nice link preview. certificateImageUrl is safe
       to use here — it's a second render of the real certificate template
       with this page's already-redacted "First L." name baked in, never
       the real certificate_url (which has the student's full legal name
       printed on it). -->
  <meta property="og:title" content="<%= displayName %> completed <%= certificate.course_title %>! 🎓" />
  <meta property="og:description" content="Issued <%= new Date(certificate.issued_at).toDateString() %>" />
  <meta property="og:image" content="<%= certificateImageUrl || company.logo_url %>" />
  <meta property="og:type" content="website" />

  <link rel="stylesheet" href="/css/style.css" />
  <% if (company.logo_url) { %><link rel="icon" type="image/x-icon" href="<%= company.logo_url %>" /><% } %>
  <style>
    body { margin: 0; background: var(--bg-secondary, #f8f9fa); font-family: Arial, sans-serif; color: var(--text-primary, #222); }
    .pa-wrap { max-width: 640px; margin: 0 auto; padding: 40px 16px 60px; text-align: center; }
    .pa-cert-image-card {
      background: #fff; border-radius: var(--radius-lg, 16px); padding: 12px;
      box-shadow: var(--shadow-md, 0 4px 16px rgba(0,0,0,0.08));
      border: 3px solid var(--brand-pri-light, #D9A82C);
    }
    .pa-cert-image-card img { width: 100%; height: auto; border-radius: 8px; display: block; }
    .pa-cert-caption { margin-top: 14px; font-size: 13px; color: var(--text-secondary, #666); }
    .pa-cert-caption strong { color: var(--brand-pri-dark, #4C3802); }
    .pa-share-back { display: inline-block; margin-top: 22px; font-size: 13px; color: var(--brand-pri, #A17807); text-decoration: none; font-weight: 700; }
    .pa-cta { margin-top: 28px; }
    .pa-cta p { color: var(--text-secondary, #666); font-size: 13px; margin: 0 0 12px; }
    .pa-cta a { display: inline-block; background: var(--brand-pri, #A17807); color: #fff; text-decoration: none; padding: 11px 24px; border-radius: 8px; font-weight: 700; font-size: 13.5px; }
  </style>
</head>
<body>
  <div class="pa-wrap">
    <% if (certificateImageUrl) { %>
      <div class="pa-cert-image-card">
        <img src="<%= certificateImageUrl %>" alt="<%= displayName %>'s certificate for <%= certificate.course_title %>" />
      </div>
      <div class="pa-cert-caption">
        <strong><%= certificate.course_title %></strong> — issued <%= new Date(certificate.issued_at).toDateString() %>
      </div>
    <% } else { %>
      <div class="pa-cert-caption">
        <strong><%= certificate.course_title %></strong> — issued <%= new Date(certificate.issued_at).toDateString() %>
        <br><span style="font-size:11px;">🎨 Preparing a shareable certificate image — refresh this page in a moment.</span>
      </div>
    <% } %>

    <a class="pa-share-back" href="/achievements/<%= slug %>">← View full achievement page</a>

    <div class="pa-cta">
      <p>Start your own learning journey with <%= (company.company_name || 'JKT Hub').trim() %>.</p>
      <a href="https://acad.jkthub.com/">Get Started</a>
    </div>
  </div>
</body>
</html>
