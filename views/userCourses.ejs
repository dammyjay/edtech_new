<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Courses — <%= (info?.company_name || 'JKT Hub').trim() %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/styles2.css" />
    <link rel="stylesheet" href="/css/styles3.css" />
    <link rel="icon" type="image/x-icon" href="/images/JKT logo bg.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <% const ogTitle = 'Courses — ' + (info?.company_name || 'JKT Hub').trim();
       const ogDescription = 'Explore our full catalog of courses and start building real skills.';
       const ogImage = info?.hero_image_url || info?.logo_url;
       const ogUrl = 'https://acad.jkthub.com/courses';
       const ogType = 'website'; %>
    <%- include('./partials/ogMeta', { ogTitle, ogDescription, ogImage, ogUrl, ogType }) %>
    <style>
      .courses-page-wrap { max-width: 1200px; margin: 0 auto; padding: 16px 16px 60px; }

      .courses-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin: 8px 0 20px;
      }
      .courses-page-header h1 { margin: 0; font-size: 22px; }

      .courses-search-note { font-size: 14px; color: var(--text-secondary, #666); margin: 0 0 16px; }
      .courses-search-note a { color: var(--brand-pri, #A17807); font-weight: 600; }

      .courses-layout { display: flex; gap: 24px; align-items: flex-start; }

      /* Deliberately NOT position:sticky — the site's own header
         (public/css/style.css `header { position: sticky; top: 0; }`) is
         itself sticky and can grow past 180px tall once its nav wraps
         (confirmed live at an 800px viewport), so a sidebar also stuck at
         a small top offset ends up pinned underneath/behind it once the
         page scrolls, making its buttons unclickable. Scrolls with the
         page instead — simpler and avoids fighting the header's own
         sticky behavior across every viewport width. */
      .courses-sidebar {
        width: 220px;
        flex-shrink: 0;
      }
      .courses-filter-group { margin-bottom: 22px; }
      .courses-filter-group h4 {
        margin: 0 0 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-secondary, #666);
      }
      .courses-filter-btn {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--text-primary, #222);
        cursor: pointer;
      }
      .courses-filter-btn:hover { background: var(--brand-tint, #f5f0e0); }
      .courses-filter-btn.active { background: var(--brand-pri, #A17807); color: #fff; }

      .courses-grid-wrap { flex: 1; min-width: 0; }
      .courses-result-count { font-size: 13px; color: var(--text-secondary, #666); margin: 0 0 14px; }

      .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 18px;
      }

      .course-card {
        background: #fff;
        border: 1px solid var(--border-light, #e0e0e0);
        border-radius: var(--radius-lg, 14px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,0.06));
      }
      .course-card-img-link { position: relative; display: block; }
      .course-card-img-link img { width: 100%; height: 140px; object-fit: cover; display: block; }
      .course-card-img-fallback {
        width: 100%; height: 140px;
        display: flex; align-items: center; justify-content: center;
        font-size: 36px;
        background: linear-gradient(135deg, var(--brand-pri-light, #D9A82C), var(--brand-pri, #A17807));
      }
      .course-card-level-badge {
        position: absolute; top: 10px; left: 10px;
        background: rgba(0,0,0,0.65); color: #fff;
        font-size: 10.5px; font-weight: 700; text-transform: uppercase;
        padding: 3px 9px; border-radius: 999px;
      }
      .course-card-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
      .course-card-body h4 { margin: 0; font-size: 15.5px; }
      .course-card-body h4 a { color: var(--text-primary, #222); text-decoration: none; }
      .course-card-blurb {
        font-size: 12.5px; color: var(--text-secondary, #666); margin: 0;
        display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .course-card-price { font-weight: 700; font-size: 14px; margin: 4px 0 2px; color: var(--brand-pri-dark, #4C3802); }
      .course-card-actions { margin-top: auto; padding-top: 8px; }
      .course-card-actions form { margin: 0; }
      .course-card-actions .btn-black { width: 100%; text-align: center; display: block; box-sizing: border-box; }
      .course-card-enrolled { color: #1f9d55; font-weight: 600; font-size: 13px; margin: 0; }
      .course-card-insufficient { color: #d64545; font-size: 12px; margin: 0 0 6px; }

      .courses-empty { text-align: center; color: var(--text-secondary, #666); padding: 50px 10px; }

      @media (max-width: 760px) {
        .courses-layout { flex-direction: column; }
        .courses-sidebar { width: 100%; position: static; display: flex; gap: 20px; overflow-x: auto; }
        .courses-filter-group { margin-bottom: 0; }
        .courses-filter-btn { white-space: nowrap; }
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <%- include('./partials/userHeader', { title: 'Courses for you', activePage: 'courses' }) %>

    <div class="courses-page-wrap">
      <div class="courses-page-header">
        <h1>Explore Courses</h1>
        <% if (isLoggedIn) { %>
          <a href="/make-payment" class="btn-black" style="text-decoration: none;">Fund wallet</a>
        <% } else { %>
          <button onclick="promptLogin()" class="btn-black">Fund wallet</button>
          <script>
            function promptLogin() {
              showAlert("Please login to make a payment.").then(() => {
                window.location.href = "/admin/login";
              });
            }
          </script>
        <% } %>
      </div>

      <% if (typeof q !== 'undefined' && q) { %>
        <p class="courses-search-note">Showing results for "<%= q %>" — <a href="/courses">Clear search</a></p>
      <% } %>

      <%
        // Every level that actually occurs in the current result set,
        // sorted into the standard Beginner/Intermediate/Advanced order
        // first, then anything else (e.g. "Unspecified") alphabetically —
        // avoids showing a level filter button with zero matching courses.
        const STANDARD_LEVEL_ORDER = ["Beginner", "Intermediate", "Advanced"];
        const seenLevels = new Set();
        for (const pathway in groupedCourses) {
          for (const level in groupedCourses[pathway]) seenLevels.add(level);
        }
        const levels = [...seenLevels].sort((a, b) => {
          const ai = STANDARD_LEVEL_ORDER.indexOf(a);
          const bi = STANDARD_LEVEL_ORDER.indexOf(b);
          if (ai !== -1 && bi !== -1) return ai - bi;
          if (ai !== -1) return -1;
          if (bi !== -1) return 1;
          return a.localeCompare(b);
        });
      %>

      <% if (Object.keys(groupedCourses).length === 0) { %>
        <p class="courses-empty">
          No courses match "<%= typeof q !== 'undefined' ? q : '' %>" — <a href="/courses">browse the full catalog</a>.
        </p>
      <% } else { %>
        <div class="courses-layout">
          <aside class="courses-sidebar">
            <div class="courses-filter-group" id="pathwayFilterGroup">
              <h4>Pathway</h4>
              <button type="button" class="courses-filter-btn active" data-pathway="">All Pathways</button>
              <% careerPathways.forEach(path => { %>
                <button type="button" class="courses-filter-btn" data-pathway="<%= path.title %>"><%= path.title %></button>
              <% }) %>
            </div>
            <div class="courses-filter-group" id="levelFilterGroup">
              <h4>Level</h4>
              <button type="button" class="courses-filter-btn active" data-level="">All Levels</button>
              <% levels.forEach(level => { %>
                <button type="button" class="courses-filter-btn" data-level="<%= level %>"><%= level %></button>
              <% }) %>
            </div>
          </aside>

          <div class="courses-grid-wrap">
            <p class="courses-result-count" id="coursesResultCount"></p>
            <div class="courses-grid" id="coursesGrid">
              <% for (let pathway in groupedCourses) { %>
                <% for (let level in groupedCourses[pathway]) { %>
                  <% groupedCourses[pathway][level].forEach(course => { %>
                    <%
                      const isEnrolled = enrolledCourseIds?.includes(course.id);
                      // course.description is CKEditor-authored rich HTML
                      // (see the admin course editor), not plain text — a
                      // card blurb needs tags stripped first, or multiple
                      // <p> paragraphs render in full and blow the card's
                      // height out (the 2-line CSS clamp only works within
                      // one flowed block, not across several nested ones).
                      // Rendered through the escaping EJS output tag, not
                      // the raw/unescaped one — this is also untrusted-ish
                      // rich content, not meant to inject further markup
                      // into the card.
                      const plainDescription = (course.description || "")
                        .replace(/<[^>]*>/g, " ")
                        // CKEditor's stored HTML has entities encoded
                        // TWICE for some punctuation (confirmed live:
                        // "&amp;#39;" and "&amp;mdash;" appearing as
                        // literal text, not a single &#39;/&mdash;) — decode
                        // &amp; first so the inner entity becomes visible,
                        // then decode the common entities underneath it,
                        // before this goes through the escaping output tag
                        // below (otherwise it re-escapes into visible
                        // "&amp;#39;" all over again).
                        .replace(/&amp;/g, "&")
                        .replace(/&#39;|&apos;/g, "'")
                        .replace(/&quot;/g, '"')
                        .replace(/&mdash;/g, "—")
                        .replace(/&ndash;/g, "–")
                        .replace(/&nbsp;/g, " ")
                        .replace(/&lt;/g, "<")
                        .replace(/&gt;/g, ">")
                        .replace(/\s+/g, " ")
                        .trim();
                      const blurb = plainDescription.length > 140 ? plainDescription.slice(0, 140) + "…" : plainDescription;
                    %>
                    <div class="course-card" data-pathway="<%= pathway %>" data-level="<%= level %>">
                      <a class="course-card-img-link" href="/courses/<%= course.id %>">
                        <% if (course.thumbnail_url) { %>
                          <img src="<%= course.thumbnail_url %>" alt="<%= course.title %>">
                        <% } else { %>
                          <div class="course-card-img-fallback">📘</div>
                        <% } %>
                        <span class="course-card-level-badge"><%= level %></span>
                      </a>
                      <div class="course-card-body">
                        <h4><a href="/courses/<%= course.id %>"><%= course.title %></a></h4>
                        <p class="course-card-blurb"><%= blurb %></p>
                        <p class="course-card-price"><%= course.amount == 0 ? "Free" : "₦" + Number(course.amount).toLocaleString() %></p>

                        <div class="course-card-actions">
                          <% if (isLoggedIn && !isEnrolled) { %>
                            <% if (course.amount == 0) { %>
                              <form action="/student/courses/enroll/<%= course.id %>" method="POST">
                                <button type="submit" class="btn-black">Enroll for Free</button>
                              </form>
                            <% } else if (walletBalance >= course.amount) { %>
                              <form action="/student/courses/enroll/<%= course.id %>" method="POST">
                                <button type="submit" class="btn-black">Enroll (₦<%= Number(course.amount).toLocaleString() %>)</button>
                              </form>
                            <% } else { %>
                              <p class="course-card-insufficient">❌ Not sufficient funds.</p>
                              <a class="btn-black" style="display:block; text-align:center; text-decoration:none; box-sizing:border-box;" href="/make-payment">Fund wallet</a>
                            <% } %>
                          <% } else if (isLoggedIn && isEnrolled) { %>
                            <p class="course-card-enrolled"><i class="fas fa-check-circle"></i> Already Enrolled</p>
                          <% } else { %>
                            <button class="btn-black" onclick="promptLogin()">Login to Enroll</button>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              <% } %>
            </div>
            <p class="courses-empty" id="coursesEmptyFiltered" style="display:none;">No courses match these filters.</p>
          </div>
        </div>
      <% } %>

      <% if (subscribed === 'success') { %>
        <p style="color: green; text-align: center;">Thank you for subscribing!</p>
      <% } else if (subscribed === 'fail') { %>
        <p style="color: red; text-align: center;">There was a problem with your subscription.</p>
      <% } %>
    </div>

    <%- include('./partials/userFooter') %>

    <!-- For the navigation toggle -->
    <script>
    function toggleNav() {
        var nav = document.getElementById("main-nav");
        nav.classList.toggle("open");
    }
    </script>

    <!-- script for confirm enrollment -->
    <script>
      async function confirmEnroll(amount) {
        if (amount === 0) return true;
        return await showConfirm(`This course costs ₦${amount.toLocaleString()}. Proceed to enroll using your wallet balance?`);
      }
    </script>

    <!-- script for closing nav on outside click -->
    <script>
    document.addEventListener("click", function (event) {
        const nav = document.getElementById("main-nav");
        const toggleBtn = document.querySelector(".nav-toggle");
        if (
        nav.classList.contains("open") &&
        !nav.contains(event.target) &&
        !toggleBtn.contains(event.target)
        ) {
        nav.classList.remove("open");
        }
    });
    </script>

    <!-- script for push notifications -->
    <script>
    const vapidPublicKey = "<%= vapidPublicKey %>";

    if ('serviceWorker' in navigator && 'PushManager' in window) {
        window.addEventListener('load', async () => {
        const permission = Notification.permission;
        const lastPrompt = localStorage.getItem("lastPromptTime");
        const now = Date.now();
        if (permission !== 'granted' && (!lastPrompt || now - Number(lastPrompt) > 86400000)) {
            const banner = document.getElementById('notif-banner');
            if (banner) banner.style.display = 'block';
        }
        });
    }

    async function triggerSubscription() {
        const permission = await Notification.requestPermission();
        localStorage.setItem("lastPromptTime", Date.now());

        if (permission !== 'granted') {
        await showAlert("❌ Notification permission denied.");
        dismissBanner();
        return;
        }

        try {
        const registration = await navigator.serviceWorker.register('/sw.js');
        const subscription = await registration.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array("<%= vapidPublicKey %>")
        });

        await fetch('/notifications/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(subscription)
        });

        await showAlert("✅ Subscribed to notifications!");
        localStorage.setItem("pushStatus", "granted");
        dismissBanner();
        } catch (err) {
        console.error("Subscription error:", err);
        }
    }

    function dismissBanner() {
        const banner = document.getElementById('notif-banner');
        if (banner) banner.style.display = 'none';
    }

    function urlBase64ToUint8Array(base64String) {
        const padding = "=".repeat((4 - base64String.length % 4) % 4);
        const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
        const rawData = atob(base64);
        return Uint8Array.from([...rawData].map((char) => char.charCodeAt(0)));
    }
    </script>

    <!-- script for the sidebar pathway/level filters -->
    <script>
      (function () {
        const grid = document.getElementById("coursesGrid");
        if (!grid) return; // no courses in the current result set

        const pathwayGroup = document.getElementById("pathwayFilterGroup");
        const levelGroup = document.getElementById("levelFilterGroup");
        const resultCount = document.getElementById("coursesResultCount");
        const emptyEl = document.getElementById("coursesEmptyFiltered");
        const cards = Array.from(grid.querySelectorAll(".course-card"));

        const state = { pathway: "", level: "" };

        function apply() {
          let visible = 0;
          cards.forEach((card) => {
            const matchesPathway = !state.pathway || card.dataset.pathway === state.pathway;
            const matchesLevel = !state.level || card.dataset.level === state.level;
            const show = matchesPathway && matchesLevel;
            card.style.display = show ? "" : "none";
            if (show) visible++;
          });
          resultCount.textContent = `${visible} course${visible === 1 ? "" : "s"}`;
          emptyEl.style.display = visible === 0 ? "block" : "none";
        }

        function wireGroup(group, key) {
          if (!group) return;
          group.addEventListener("click", (e) => {
            const btn = e.target.closest(".courses-filter-btn");
            if (!btn) return;
            group.querySelectorAll(".courses-filter-btn").forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            state[key] = key === "pathway" ? btn.dataset.pathway : btn.dataset.level;
            apply();
          });
        }

        wireGroup(pathwayGroup, "pathway");
        wireGroup(levelGroup, "level");
        apply();
      })();
    </script>
  </body>
</html>
