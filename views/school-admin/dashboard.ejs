<%- include('../partials/header', { title: 'School Admin Dashboard' }) %>
<%- include('../partials/sidenav') %>
<%- include("../partials/announcementPopup") %>
<h1>🏫 School Admin Dashboard</h1>
<p>
  Welcome, <%= schoolAdmin.fullname %> 
  (<%= school.name %>)
</p>

<div class="main-content">
  <!-- Overview is the default content -->
  <div id="dashboard-content">
    <%- include('../partials/overview', {
      schoolAdmin, school, pendingUsers, teachers, students, classrooms
    }) %>
  </div>
</div>

<!-- Create/Edit Classroom modals — live here, outside #dashboard-content,
     because they're triggered from both partials/overview.ejs and
     partials/classrooms.ejs. Those get swapped in and out of
     #dashboard-content by loadSection(), so a modal defined inside one of
     them simply doesn't exist in the DOM once a different section is
     showing — that was the "Create Classroom modal not working" bug:
     clicking the button from the Classrooms tab called
     openModal('createClassroomModal') against an element that had
     already been removed from the page. -->
<div id="createClassroomModal" class="modal-overlay">
  <div class="modal-content">
    <span class="close-btn" onclick="closeModal('createClassroomModal')">&times;</span>
    <h2>➕ Create Classroom</h2>

    <form method="POST" action="/school-admin/classrooms/new">
      <label for="name">Classroom Name</label>
      <input type="text" name="name" id="name" required>

      <label for="teacher_id">Assign Teachers (optional)</label>
      <select name="teacher_id" id="teacher_id" multiple size="5">
        <% teachers.forEach(t => { %>
          <option value="<%= t.id %>"><%= t.fullname %> (<%= t.email %>)</option>
        <% }) %>
      </select>
      <small>Hold <b>Ctrl</b> (Windows) or <b>Cmd</b> (Mac) to select multiple</small>

      <button type="submit" class="btn-edit">Create</button>
    </form>
  </div>
</div>

<div id="editClassroomModal" class="modal-overlay">
  <div class="modal-content">
    <span class="close-btn" onclick="closeModal('editClassroomModal')">&times;</span>
    <h2>✏ Edit Classroom</h2>
    <form id="editClassroomForm" method="POST">
      <input type="hidden" name="id" id="edit_classroom_id">

      <label for="edit_name">Classroom Name</label>
      <input type="text" name="name" id="edit_name" required>

      <label for="teacher_id">Assign Teachers</label>
      <select name="teacher_id" id="edit_teacher_ids" multiple size="5">
        <% teachers.forEach(t => { %>
          <option value="<%= t.id %>"><%= t.fullname %> (<%= t.email %>)</option>
        <% }) %>
      </select>
      <small>Hold <b>Ctrl</b> (Windows) or <b>Cmd</b> (Mac) to select multiple</small>

      <button type="submit" class="btn-edit">Update</button>
    </form>
  </div>
</div>

<script>
  function toggleCollapse(id) {
    const section = document.getElementById(id);
    section.classList.toggle("active");
  }

  function openModal(id) {
    document.getElementById(id).style.display = "flex";
  }
  function closeModal(id) {
    document.getElementById(id).style.display = "none";
  }

  function openEditModal(classroomId, classroomName, teacherIds) {
    document.getElementById("edit_classroom_id").value = classroomId;
    document.getElementById("edit_name").value = classroomName;

    const select = document.getElementById("edit_teacher_ids");
    Array.from(select.options).forEach(opt => {
      opt.selected = teacherIds.includes(parseInt(opt.value));
    });

    document.getElementById("editClassroomForm").action = "/school-admin/classrooms/" + classroomId + "/edit";
    openModal("editClassroomModal");
  }

  // Shared feedback modal for the "Classroom Courses" tab's assign/update
  // forms (#courseActionModal, defined in partials/classroom-courses.ejs
  // — only ever present in the DOM while that section is loaded, which is
  // fine since these functions are only ever called from within it).
  // Submitting used to be a plain <form method="POST">, so a rejection
  // (e.g. "not allowed to assign this course") landed on a bare text
  // page outside the dashboard shell — this intercepts the submit,
  // shows a spinner, then swaps to a result icon/message and
  // auto-closes, refreshing the section on success.
  function resetCourseActionModal() {
    document.getElementById("courseActionSpinner").style.display = "block";
    document.getElementById("courseActionIcon").style.display = "none";
    document.getElementById("courseActionMessage").textContent = "Working on it…";
  }

  function finishCourseActionModal(success, message) {
    document.getElementById("courseActionSpinner").style.display = "none";
    const icon = document.getElementById("courseActionIcon");
    icon.textContent = success ? "✅" : "❌";
    icon.style.display = "block";
    document.getElementById("courseActionMessage").textContent = message;

    setTimeout(() => {
      closeModal("courseActionModal");
      if (success) loadSection("classroom-courses");
    }, 1600);
  }

  async function submitCourseAction(form) {
    resetCourseActionModal();
    openModal("courseActionModal");

    try {
      const body = new URLSearchParams(new FormData(form));
      const res = await fetch(form.action, { method: "POST", body });

      let data;
      try {
        data = await res.json();
      } catch (e) {
        data = { success: res.ok, message: res.ok ? "Done." : "Something went wrong." };
      }

      finishCourseActionModal(!!data.success, data.message || (data.success ? "Done!" : "Something went wrong."));
    } catch (err) {
      finishCourseActionModal(false, "Network error — please try again.");
    }

    return false; // stop the native form submission/page navigation
  }
</script>

<script>
  async function loadSection(section) {
    try {
      const res = await fetch(`/school-admin/section/${section}`);
      const html = await res.text();
      document.getElementById("dashboard-content").innerHTML = html;
      // ✅ reattach events AFTER loading
      attachEvents();
    } catch (err) {
      document.getElementById("dashboard-content").innerHTML = "<p>Error loading section.</p>";
    }
  }

