  document.getElementById("bulkUploadForm").addEventListener("submit", async function(e) {
    e.preventDefault();

    const formData = new FormData(this);

    const res = await fetch("/school-admin/bulk-add-students", {
      method: "POST",
      body: formData
    });

    const data = await res.json();

    // ✅ CLOSE upload modal FIRST
    closeStudentModal();

    if (data.success) {
      showBulkModal("✅ Success", data.message);

      setTimeout(() => {
        closeBulkModal();
        loadSection("students"); // refresh table
      }, 2000);
    } else {
      let errorText = data.message;

      if (data.errors) {
        errorText += "<br><br>" + data.errors.join("<br>");
      }

      showBulkModal("❌ Upload Error", errorText);
    }
  });

  function showBulkModal(title, message) {
    document.getElementById("bulkModalTitle").innerHTML = title;
    document.getElementById("bulkModalMessage").innerHTML = message;
    document.getElementById("bulkModal").style.display = "block";
  }

  function closeBulkModal() {
    document.getElementById("bulkModal").style.display = "none";
  }
</script>