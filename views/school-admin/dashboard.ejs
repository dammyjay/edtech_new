  // #bulkUploadForm lives inside partials/students.ejs, an AJAX-loaded
  // section swapped into #dashboard-content via loadSection()'s plain
  // innerHTML= (no script re-execution) — so a direct addEventListener
  // here, at initial page load, would attach before the form ever exists.
  // Delegating from document works regardless of when that section loads.
  document.addEventListener("submit", async function(e) {
    if (e.target.id !== "bulkUploadForm") return;
    e.preventDefault();

    const formData = new FormData(e.target);

    const res = await fetch("/school-admin/bulk-add-students", {
      method: "POST",
      body: formData
    });

    const data = await res.json();

    // ✅ CLOSE upload modal FIRST
    closeStudentModal();

    if (data.success) {
      showBulkModal("✅ Success", data.message);

      setTimeout(() => {
        closeBulkModal();
        loadSection("students"); // refresh table
      }, 2000);
    } else {
      let errorText = data.message;

      if (data.errors) {
        errorText += "<br><br>" + data.errors.join("<br>");
      }

      showBulkModal("❌ Upload Error", errorText);
    }
  });

  function showBulkModal(title, message) {
    document.getElementById("bulkModalTitle").innerHTML = title;
    document.getElementById("bulkModalMessage").innerHTML = message;
    document.getElementById("bulkModal").style.display = "block";
  }

  function closeBulkModal() {
    document.getElementById("bulkModal").style.display = "none";
  }
</script>