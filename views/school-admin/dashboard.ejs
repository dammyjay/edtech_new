// Weekly present/absent/attendance-% chart — same endpoint contract and
// Chart.js rendering as the platform admin's version
// (views/admin/school-details.ejs), now that
// schoolAdminController.js's getWeeklyAttendanceStats matches it (it
// used to query a column, attendance_date, that doesn't exist, so this
// never had real data to render). Chart.js itself is loaded once by
// partials/overview.ejs on first page load and stays available globally.
let schoolAdminAttendanceChart = null;
async function loadAttendanceStats() {
  const termId = document.getElementById("attendanceFilterTerm")?.value;
  const classroomId = document.getElementById("attendanceFilterClassroom")?.value;
  const canvas = document.getElementById("attendanceChart");
  const summary = document.getElementById("attendanceSummary");
  if (!termId || !canvas) return;

  try {
    const res = await fetch(`/school-admin/attendance/stats?term_id=${termId}${classroomId ? "&classroom_id=" + classroomId : ""}`);
    const data = await res.json();

    const labels = data.map((d) => `Week ${d.week_number}`);
    const present = data.map((d) => Number(d.present));
    const absent = data.map((d) => Number(d.absent));
    const percent = data.map((d) => Number(d.attendance_percent) || 0);

    if (schoolAdminAttendanceChart) schoolAdminAttendanceChart.destroy();
    schoolAdminAttendanceChart = new Chart(canvas, {
      type: "bar",
      data: {
        labels,
        datasets: [
          { label: "Present", data: present, backgroundColor: "#4CAF50" },
          { label: "Absent", data: absent, backgroundColor: "#e74c3c" },
        ],
      },
    });

    if (summary) {
      const avg = percent.length ? percent.reduce((a, b) => a + b, 0) / percent.length : 0;
      summary.innerHTML = data.length
        ? `<h3>Average Attendance: ${avg.toFixed(1)}%</h3>`
        : `<p>No attendance sessions recorded for this term yet.</p>`;
    }
  } catch (err) {
    console.error(err);
    if (summary) summary.innerHTML = "<p>Error loading attendance chart.</p>";
  }
}

async function loadAttendanceHistory() {
  try {
    const termId = document.getElementById("attendanceFilterTerm")?.value;
    const classroomId = document.getElementById("attendanceFilterClassroom")?.value;

    loadAttendanceStats();

    const url = `/school-admin/attendance/history?term_id=${termId || ""}&classroom_id=${classroomId || ""}`;

    const res = await fetch(url);
    const data = await res.json();

    const tbody = document.getElementById("attendanceTableBody");

    if (!data.length) {
      tbody.innerHTML = `<tr><td colspan="6">No history found</td></tr>`;
      return;
    }

    tbody.innerHTML = data.map(a => `
      <tr>
        <td>${a.date}</td>
        <td>${a.classroom}</td>
        <td>${a.term_name}</td>

        <td>Admin</td>

        <td>${a.student_count || 0}</td>

        <td class="actions-col">

          <i class="fa fa-eye action-icon"
             title="View Attendance"
             style="cursor:pointer; color:blue;"
             onclick="viewAttendance(${a.id})"></i>

          <i class="fa fa-file-pdf action-icon"
             title="Download PDF"
             style="cursor:pointer; color:#d9534f;"
             onclick="exportPDF(${a.id})"></i>

          <i class="fa fa-file-excel action-icon"
             title="Download Excel"
             style="cursor:pointer; color:green;"
             onclick="exportExcel(${a.term_id})"></i>

        </td>
      </tr>
    `).join("");

  } catch (err) {
    console.error(err);
    showAlert("Failed to load attendance history");
  }
}

// Renders, per classroom: the session log (week/date/status/note) and a
// student x week attendance matrix, for the currently-selected term (see
// #attendanceFilterTerm) — schoolAdminController.js's getAttendanceSummary.
async function loadAttendanceSummary() {
  const termId = document.getElementById("attendanceFilterTerm")?.value;
  const box = document.getElementById("attendanceSummaryReport");
  if (!termId) {
    showAlert("Select a term first.");
    return;
  }

  box.innerHTML = "<p>Loading...</p>";
  try {
    const res = await fetch(`/school-admin/attendance/summary?term_id=${termId}`);
    const data = await res.json();

    if (!data.success) {
      box.innerHTML = `<p>${data.message || "Error loading attendance summary."}</p>`;
      return;
    }

    if (!data.classrooms.length) {
      box.innerHTML = "<p>No attendance sessions recorded for this term yet.</p>";
      return;
    }

    const statusEmoji = { present: "✅", absent: "❌", late: "⏰" };

    box.innerHTML = data.classrooms.map((cls) => {
      const sessionRows = cls.sessions.map((s) =>
        `<tr>
          <td>Week ${s.week}</td>
          <td>${s.date ? new Date(s.date).toLocaleDateString() : "-"}</td>
          <td>${s.status}</td>
          <td>${s.note || "-"}</td>
        </tr>`
      ).join("");

      const weekHeaders = cls.weeks.map((w) => `<th>Wk ${w}</th>`).join("");
      const studentRows = cls.students.map((s) => {
        const weekCells = cls.weeks.map((w) => {
          const status = s.weeks[w];
          return `<td style="text-align:center;">${status ? (statusEmoji[status] || status) : "-"}</td>`;
        }).join("");
        return `<tr><td>${s.name}</td>${weekCells}</tr>`;
      }).join("");

      return `
        <div class="report-panel" style="background:#fff; border-radius:12px; padding:16px; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,.06);">
          <h4>${cls.classroomName}</h4>

          <h5 style="margin-top:12px; color:#666;">Sessions</h5>
          <div class="table-responsive">
            <table class="user-table">
              <thead><tr><th>Week</th><th>Date</th><th>Status</th><th>Note</th></tr></thead>
              <tbody>${sessionRows || '<tr><td colspan="4" style="text-align:center;">No sessions recorded</td></tr>'}</tbody>
            </table>
          </div>

          <h5 style="margin-top:16px; color:#666;">Student Attendance by Week</h5>
          <div class="table-responsive">
            <table class="user-table">
              <thead><tr><th>Student</th>${weekHeaders}</tr></thead>
              <tbody>${studentRows || `<tr><td colspan="${cls.weeks.length + 1}" style="text-align:center;">No students recorded</td></tr>`}</tbody>
            </table>
          </div>
        </div>
      `;
    }).join("");
  } catch (err) {
    console.error(err);
    box.innerHTML = "<p>Error loading attendance summary.</p>";
  }
}

function exportPDF(sessionId) {
  window.open(`/school-admin/attendance/${sessionId}/pdf`, "_blank");
}

function exportExcel(termId) {
  if (!termId) {
    showAlert("Missing term ID");
    return;
  }

  window.open(`/school-admin/attendance/${termId}/excel`, "_blank");
}

// Used by the "Term Report Cards" widget rendered inside the Terms
// section (loadSection's response). Declared here — not inline in that
// response — because a <script> tag inserted via innerHTML never
// executes; this has to be a real global function from a page-load
// script for the onclick="..." handler in that HTML to find it.
//
// Report cards are generated only by the platform admin (when they mark
// a term ended, or manually regenerate one) — this never generates
// anything itself, it only asks whether reports exist yet for the chosen
// classroom + term and, if so, shows download links to the exact stored
// copies (see schoolAdminController.js's getClassTermReportStatus).
async function checkTermReportStatus() {
  const classroomId = document.getElementById("reportClassroom").value;
  const termId = document.getElementById("reportTerm").value;
  const box = document.getElementById("termReportStudents");
  if (!classroomId || !termId) {
    showAlert("Select a classroom and a term first.");
    return;
  }

  box.innerHTML = "<p>Loading...</p>";
  try {
    const res = await fetch(`/school-admin/reports/${classroomId}/${termId}/status`);
    const data = await res.json();

    if (!data.success) {
      box.innerHTML = `<p>${data.message || "Error loading report status."}</p>`;
      return;
    }

    if (!data.termEnded) {
      box.innerHTML = `<p style="color:#888;">⏳ Report not available yet — the admin hasn't finalized this term.</p>`;
      return;
    }

    let html = "";
    html += data.classReport
      ? `<p><a href="/school-admin/stored-reports/${data.classReport.id}/download">📥 Download Full Class Report</a> <span style="color:#888; font-size:12px;">(generated ${new Date(data.classReport.generated_at).toLocaleString()})</span></p>`
      : `<p style="color:#888;">No whole-class report generated for this classroom yet.</p>`;

    if (data.students && data.students.length) {
      html +=
        '<table class="user-table"><thead><tr><th>Name</th><th>Email</th><th>Action</th></tr></thead><tbody>' +
        data.students
          .map((s) =>
            `<tr><td>${s.fullname}</td><td>${s.email}</td><td>` +
            (s.report_id
              ? `<a href="/school-admin/stored-reports/${s.report_id}/download">📥 Download Report</a>`
              : `<span style="color:#888;">Not generated yet</span>`) +
            `</td></tr>`
          )
          .join("") +
        "</tbody></table>";
    } else {
      html += "<p>No students enrolled in this classroom for this term.</p>";
    }

    box.innerHTML = html;
  } catch (err) {
    console.error(err);
    box.innerHTML = "<p>Error loading report status.</p>";
  }
}

async function viewAttendance(sessionId) {
  try {
    const res = await fetch(`/school-admin/attendance/${sessionId}`);
    const data = await res.json();

    const records = data.records;

    let html = `
      <h3>📋 Attendance Details</h3>
      <p><b>Class:</b> ${data.session.classroom}</p>

      <table border="1" width="100%" cellpadding="5">
        <tr>
          <th>Student</th>
          <th>Status</th>
        </tr>
    `;

    records.forEach(r => {
      html += `
        <tr>
          <td>${r.fullname}</td>
          <td>${r.status}</td>
        </tr>
      `;
    });

    html += `</table>`;

    // simple modal (you can replace with your modal system)
    const win = window.open("", "_blank");
    win.document.write(html);

  } catch (err) {
    console.error(err);
    showAlert("Failed to load attendance details");
  }
}
</script>

<script>
  function openStudentModal() {
    document.getElementById("studentModal").style.display = "block";
  }

  function closeStudentModal() {
    document.getElementById("studentModal").style.display = "none";
  }

  function openAssignClassroomModal(studentId, studentName) {
    document.getElementById("modalStudentId").value = studentId;
    document.getElementById("modalStudentName").textContent = studentName;
    document.getElementById("assignClassroomModal").style.display = "block";
  }

  function closeAssignClassroomModal() {
    document.getElementById("assignClassroomModal").style.display = "none";
  }

  function openAssignSuccessModal() {
    document.getElementById("assignSuccessModal").style.display = "block";
  }

  function closeAssignSuccessModal() {
    document.getElementById("assignSuccessModal").style.display = "none";
  }

  function openStudentSuccessModal() {
    document.getElementById("studentSuccessModal").style.display = "block";
  }

  function closeStudentSuccessModal() {
    document.getElementById("studentSuccessModal").style.display = "none";
  }

  window.addEventListener("click", function(event) {
    const studentModal = document.getElementById("studentModal");
    const assignModal = document.getElementById("assignClassroomModal");

    if (event.target === studentModal) {
      studentModal.style.display = "none";
    }

    if (event.target === assignModal) {
      assignModal.style.display = "none";
    }
  });

function attachEvents() {
  // EXISTING CODE (keep it)
  const form = document.getElementById("assignClassForm");

  if (form) {
    form.addEventListener("submit", async function(e) {
      e.preventDefault();

      const studentId = document.getElementById("modalStudentId").value;
      const classroomId = document.getElementById("modalClassroomSelect").value;

      const res = await fetch(`/school-admin/students/${studentId}/assign-classroom`, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({ classroom_id: classroomId })
      });

      const data = await res.json();

      if (data.success) {
        closeAssignClassroomModal();
        openAssignSuccessModal();

        setTimeout(() => {
          loadSection("students");
        }, 1500);
      }
    });
  }

  // ✅ ADD THIS BLOCK HERE
  const bulkForm = document.getElementById("bulkUploadForm");

  if (bulkForm) {
    bulkForm.addEventListener("submit", async function(e) {
      e.preventDefault();

      const formData = new FormData(this);

      const res = await fetch("/school-admin/bulk-add-students", {
        method: "POST",
        body: formData
      });

      const data = await res.json();

      // ✅ close upload modal
      closeStudentModal();

      if (data.success) {
        showBulkModal("✅ Success", data.message);

        setTimeout(() => {
          closeBulkModal();
          loadSection("students");
        }, 2000);
      } else {
        let errorText = data.message;

        if (data.errors) {
          errorText += "<br><br>" + data.errors.join("<br>");
        }

        showBulkModal("❌ Upload Error", errorText);
      }
    });
  }

  // The Attendance section's history table + chart both need a term
  // selected to mean anything — auto-load using the first term in the
  // dropdown as soon as the section is swapped in, so the chart isn't
  // just an empty canvas until the admin manually clicks Filter.
  const attendanceTermFilter = document.getElementById("attendanceFilterTerm");
  if (attendanceTermFilter && attendanceTermFilter.options.length) {
    loadAttendanceHistory();
  }
}

</script>

