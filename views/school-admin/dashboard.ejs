function attachEvents() {
  // EXISTING CODE (keep it)
  const form = document.getElementById("assignClassForm");

  if (form) {
    form.addEventListener("submit", async function(e) {
      e.preventDefault();

      const studentId = document.getElementById("modalStudentId").value;
      const classroomId = document.getElementById("modalClassroomSelect").value;

      const res = await fetch(`/school-admin/students/${studentId}/assign-classroom`, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({ classroom_id: classroomId })
      });

      const data = await res.json();

      if (data.success) {
        closeAssignClassroomModal();
        openAssignSuccessModal();

        setTimeout(() => {
          loadSection("students");
        }, 1500);
      }
    });
  }

  // ✅ ADD THIS BLOCK HERE
  const bulkForm = document.getElementById("bulkUploadForm");

  if (bulkForm) {
    bulkForm.addEventListener("submit", async function(e) {
      e.preventDefault();

      const formData = new FormData(this);

      const res = await fetch("/school-admin/bulk-add-students", {
        method: "POST",
        body: formData
      });

      const data = await res.json();

      // ✅ close upload modal
      closeStudentModal();

      if (data.success) {
        showBulkModal("✅ Success", data.message);

        setTimeout(() => {
          closeBulkModal();
          loadSection("students");
        }, 2000);
      } else {
        let errorText = data.message;

        if (data.errors) {
          errorText += "<br><br>" + data.errors.join("<br>");
        }

        showBulkModal("❌ Upload Error", errorText);
      }
    });
  }
}

</script>


<script>
