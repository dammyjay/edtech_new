async function loadAttendanceHistory() {
  try {
    const termId = document.getElementById("attendanceFilterTerm")?.value;
    const classroomId = document.getElementById("attendanceFilterClassroom")?.value;

    const url = `/school-admin/attendance/history?term_id=${termId || ""}&classroom_id=${classroomId || ""}`;

    const res = await fetch(url);
    const data = await res.json();

    const tbody = document.getElementById("attendanceTableBody");

    if (!data.length) {
      tbody.innerHTML = `<tr><td colspan="6">No history found</td></tr>`;
      return;
    }

    tbody.innerHTML = data.map(a => `
      <tr>
        <td>${a.date}</td>
        <td>${a.classroom}</td>
        <td>${a.term_name}</td>

        <td>Admin</td>

        <td>${a.student_count || 0}</td>

        <td class="actions-col">

          <i class="fa fa-eye action-icon"
             title="View Attendance"
             style="cursor:pointer; color:blue;"
             onclick="viewAttendance(${a.id})"></i>

          <i class="fa fa-file-pdf action-icon"
             title="Download PDF"
             style="cursor:pointer; color:#d9534f;"
             onclick="exportPDF(${a.id})"></i>

          <i class="fa fa-file-excel action-icon"
             title="Download Excel"
             style="cursor:pointer; color:green;"
             onclick="exportExcel(${a.term_id})"></i>

        </td>
      </tr>
    `).join("");

  } catch (err) {
    console.error(err);
    alert("Failed to load attendance history");
  }
}

function exportPDF(sessionId) {
  window.open(`/school-admin/attendance/${sessionId}/pdf`, "_blank");
}

function exportExcel(termId) {
  if (!termId) {
    alert("Missing term ID");
    return;
  }

  window.open(`/school-admin/attendance/${termId}/excel`, "_blank");
}

async function viewAttendance(sessionId) {
  try {
    const res = await fetch(`/school-admin/attendance/${sessionId}`);
    const data = await res.json();

    const records = data.records;

    let html = `
      <h3>📋 Attendance Details</h3>
      <p><b>Class:</b> ${data.session.classroom}</p>

      <table border="1" width="100%" cellpadding="5">
        <tr>
          <th>Student</th>
          <th>Status</th>
        </tr>
    `;

    records.forEach(r => {
      html += `
        <tr>
          <td>${r.fullname}</td>
          <td>${r.status}</td>
        </tr>
      `;
    });

    html += `</table>`;

    // simple modal (you can replace with your modal system)
    const win = window.open("", "_blank");
    win.document.write(html);

  } catch (err) {
    console.error(err);
    alert("Failed to load attendance details");
  }
}
</script>

<script>
  function openStudentModal() {
    document.getElementById("studentModal").style.display = "block";
  }

  function closeStudentModal() {
    document.getElementById("studentModal").style.display = "none";
  }

  function openAssignClassroomModal(studentId, studentName) {
    document.getElementById("modalStudentId").value = studentId;
    document.getElementById("modalStudentName").textContent = studentName;
    document.getElementById("assignClassroomModal").style.display = "block";
  }

  function closeAssignClassroomModal() {
    document.getElementById("assignClassroomModal").style.display = "none";
  }

  function openAssignSuccessModal() {
    document.getElementById("assignSuccessModal").style.display = "block";
  }

  function closeAssignSuccessModal() {
    document.getElementById("assignSuccessModal").style.display = "none";
  }

  function openStudentSuccessModal() {
    document.getElementById("studentSuccessModal").style.display = "block";
  }

  function closeStudentSuccessModal() {
    document.getElementById("studentSuccessModal").style.display = "none";
  }

  window.addEventListener("click", function(event) {
    const studentModal = document.getElementById("studentModal");
    const assignModal = document.getElementById("assignClassroomModal");

    if (event.target === studentModal) {
      studentModal.style.display = "none";
    }

    if (event.target === assignModal) {
      assignModal.style.display = "none";
    }
  });

function attachEvents() {
  // EXISTING CODE (keep it)
  const form = document.getElementById("assignClassForm");

  if (form) {
    form.addEventListener("submit", async function(e) {
      e.preventDefault();

      const studentId = document.getElementById("modalStudentId").value;
      const classroomId = document.getElementById("modalClassroomSelect").value;

      const res = await fetch(`/school-admin/students/${studentId}/assign-classroom`, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({ classroom_id: classroomId })
      });

      const data = await res.json();

      if (data.success) {
        closeAssignClassroomModal();
        openAssignSuccessModal();

        setTimeout(() => {
          loadSection("students");
        }, 1500);
      }
    });
  }

  // ✅ ADD THIS BLOCK HERE
  const bulkForm = document.getElementById("bulkUploadForm");

  if (bulkForm) {
    bulkForm.addEventListener("submit", async function(e) {
      e.preventDefault();

      const formData = new FormData(this);

      const res = await fetch("/school-admin/bulk-add-students", {
        method: "POST",
        body: formData
      });

      const data = await res.json();

      // ✅ close upload modal
      closeStudentModal();

      if (data.success) {
        showBulkModal("✅ Success", data.message);

        setTimeout(() => {
          closeBulkModal();
          loadSection("students");
        }, 2000);
      } else {
        let errorText = data.message;

        if (data.errors) {
          errorText += "<br><br>" + data.errors.join("<br>");
        }

        showBulkModal("❌ Upload Error", errorText);
      }
    });
  }
}

</script>

