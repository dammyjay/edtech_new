<h2><i class="fa-solid fa-file-lines"></i> Class Reports</h2>
<p style="color:#666; margin-top:-8px;">Narrative reports written by instructors for <%= schoolName %>'s classes.</p>

<% if (!reports.length) { %>
  <p style="color:#888;">No class reports have been written yet.</p>
<% } else { %>
  <div class="card-grid">
    <% reports.forEach(r => { %>
      <div class="card" style="cursor:pointer;" onclick="openClassroomReport(<%= r.id %>)">
        <h3 style="margin-bottom:6px;"><%= r.title %></h3>
        <p style="font-size:13px; color:#666; margin:0 0 8px;">
          <i class="fa-solid fa-chalkboard-user"></i> <%= r.instructor_name %>
          &nbsp;·&nbsp;
          <i class="fa-solid fa-school"></i> <%= r.classroom_name %>
          <% if (r.term_name) { %>&nbsp;·&nbsp;<%= r.term_name %><% } %>
        </p>
        <p style="font-size:12px; color:#999;">
          <%= new Date(r.report_date).toLocaleDateString() %>
        </p>
      </div>
      <div id="classroomReportData-<%= r.id %>" hidden><%- r.content %></div>
    <% }) %>
  </div>
<% } %>

<div id="classroomReportModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="document.getElementById('classroomReportModal').style.display='none'">&times;</span>
    <h3 id="classroomReportModalTitle"></h3>
    <div id="classroomReportModalBody" style="line-height:1.6;"></div>
  </div>
</div>
<!-- openClassroomReport() is defined once in the persistent shell
     (school-admin/dashboard.ejs) — see the comment there for why. -->
