<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

    <h2>company Info</h2>
    <form method="POST" action="/admin/company" enctype="multipart/form-data">
      <label>Logo URL:</label><br />
      <!-- <input type="text" name="logo_url" value="<%= info?.logo_url || '' %>"><br><br> -->
      <input type="file" name="logo" /><br /><br />
      <% if (info?.logo_url) { %>
      <img
        src="<%= info.logo_url %>"
        alt="company Logo"
        style="max-width: 200px"
        requred
      />
      <% } %><br /><br />

      <label>Vision:</label><br />
      <textarea name="vision"><%= info?.vision || '' %></textarea><br /><br />

      <label>Mission:</label><br />
      <textarea name="mission"><%= info?.mission || '' %></textarea><br /><br />

      <label>History:</label><br />
      <textarea name="history" id="content"><%= info?.history || '' %></textarea
      ><br /><br />

      <label>Hero Image:</label><br />
      <input type="file" name="heroImage" accept="image/*" required/><br /><br />
      <% if (info?.hero_image_url) { %>
      <img
        src="<%= info.hero_image_url %>"
        alt="Hero Image"
        style="max-width: 300px"
      /><br /><br />
      <% } %>

      <label>Company Name:</label><br />
      <textarea name="company" id="content" required><%= (info?.company_name || 'JKT Hub').trim() %></textarea
      ><br /><br />


      <label>Marquee Message:</label><br />
      <textarea name="marquee_message" id="content" rows="2">
<%= info?.marquee_message || '' %></textarea
      ><br /><br />

      <hr />
      <h3>🎓 Certificate Template</h3>
      <p style="font-size:13px; color:#666;">Controls what students see on the certificate awarded when they complete a course. Leave any field as-is to keep what's already set.</p>

      <label>Certificate Background:</label><br />
      <input type="file" name="certificateBackground" accept="image/*" /><br /><br />
      <img
        src="<%= info?.certificate_background_url || 'https://acad.jkthub.com/images/Certificate.png' %>"
        alt="Certificate background"
        style="max-width: 300px"
      /><br /><br />

      <label>Signature Image:</label><br />
      <input type="file" name="certificateSignature" accept="image/*" /><br /><br />
      <img
        src="<%= info?.certificate_signature_url || 'https://acad.jkthub.com/images/Signature.jpg' %>"
        alt="Signature"
        style="max-width: 150px"
      /><br /><br />

      <label>Signee Name:</label><br />
      <input type="text" name="certificate_signee_name" value="<%= info?.certificate_signee_name || 'Jimoh Damilola' %>" /><br /><br />

      <label>Certificate Title:</label><br />
      <input type="text" name="certificate_title" value="<%= info?.certificate_title || 'CERTIFICATE OF COMPLETION' %>" /><br /><br />

      <button type="submit">Save</button>
    </form>

    <br />

    <a href="/admin/dashboard">Back to Dashboard</a>
    <script>
      CKEDITOR.replace("content");
    </script>
