<%- include('../partials/adminHeader', { title: 'Schools' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div>
      <h2>All Registered Schools</h2>
      <p><%= schools.length %> school<%= schools.length === 1 ? '' : 's' %> on the platform</p>
    </div>
    <div style="display:flex; gap:8px;">
      <a class="jk-btn-outline" style="text-decoration:none;" href="/admin/schools/export/excel">⬇️ Excel</a>
      <a class="jk-btn-outline" style="text-decoration:none;" href="/admin/schools/export/pdf">⬇️ PDF</a>
    </div>
  </div>

  <% const jkTotalStudents = schools.reduce((sum, s) => sum + Number(s.student_count || 0), 0); %>
  <% const jkTotalTeachers = schools.reduce((sum, s) => sum + Number(s.teacher_count || 0), 0); %>
  <% const jkTotalClassrooms = schools.reduce((sum, s) => sum + Number(s.classroom_count || 0), 0); %>

  <div class="jk-stat-grid" style="grid-template-columns: repeat(4, minmax(0,1fr));">

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Schools</span>
        <div class="jk-stat-icon" style="background:#E9F3FB;"><i class="fas fa-school" style="color:#1F7AC9; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= schools.length %></span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Students</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-user-graduate" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= jkTotalStudents %></span>
      <span class="jk-stat-sub">last term on record</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Teachers</span>
        <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-chalkboard-user" style="color:#A17807; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= jkTotalTeachers %></span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Classrooms</span>
        <div class="jk-stat-icon" style="background:#F1EAFB;"><i class="fas fa-door-open" style="color:#7C4DCC; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= jkTotalClassrooms %></span>
    </div>

  </div>

  <div class="jk-table-wrap">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>School</th>
          <th>Phone</th>
          <th>Address</th>
          <th>Last Term</th>
          <th>Students</th>
          <th>Teachers</th>
          <th>Classrooms</th>
          <th>Last Paid</th>
          <th class="jk-col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% schools.forEach(school => { %>
          <tr>
            <td>
              <div class="jk-row-user">
                <img src="<%= school.logo_url || '/images/default-logo.png' %>" alt="" style="width:34px; height:34px; border-radius:10px; object-fit:contain; background:#FAF8F2; flex:0 0 auto;">
                <div>
                  <p class="jk-row-name"><a href="/admin/schools/<%= school.id %>" style="color:inherit; text-decoration:none;"><%= school.name %></a></p>
                  <p class="jk-row-sub"><%= school.email %></p>
                </div>
              </div>
            </td>
            <td><%= school.phone || '—' %></td>
            <td><%= school.address || '—' %></td>
            <td>
              <% if (school.last_term_name) { %>
                <%= school.last_term_name %>
              <% } else { %>
                <span class="jk-pill jk-pill--inactive">No term yet</span>
              <% } %>
            </td>
            <td><%= school.student_count %></td>
            <td><%= school.teacher_count %></td>
            <td><%= school.classroom_count %></td>
            <td>
              <% if (school.last_term_id) { %>
                ₦<%= Number(school.last_payment_amount).toLocaleString() %>
              <% } else { %>
                <span style="color:#8A7B55;">—</span>
              <% } %>
            </td>
            <td class="jk-col-actions">
              <a href="/admin/schools/<%= school.id %>" class="jk-icon-btn" title="View <%= school.name %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              <button
                class="jk-icon-btn"
                title="Edit <%= school.name %>"
                onclick="openEditSchoolModal('<%= school.id %>', '<%= school.name %>', '<%= school.email || '' %>', '<%= school.phone || '' %>', '<%= (school.address || '').replace(/'/g, "\\'") %>', '<%= school.logo_url || '' %>', '<%= (school.class_days || []).join(',') %>')"
                type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</section>

<!-- Edit School Modal -->
<div id="editSchoolModal" class="jk-modal-overlay" hidden>
  <div class="jk-modal">
    <div class="jk-modal-head">
      <h4 id="modalTitle">Edit School Information</h4>
      <button class="jk-modal-close" onclick="closeEditSchoolModal()" type="button">&times;</button>
    </div>

    <form id="editSchoolForm" class="jk-modal-body" enctype="multipart/form-data">
      <input type="hidden" name="id" id="schoolId">

      <div>
        <label>School Name</label>
        <input type="text" id="schoolName" readonly style="background:#FAF8F2; border:1px solid #E7E0CE; border-radius:9px; padding:9px 12px; width:100%; box-sizing:border-box; font-family:inherit; font-size:13px; margin-top:4px;">
      </div>

      <div>
        <label>Email</label>
        <input type="email" name="email" id="schoolEmail" placeholder="Enter school email" style="width:100%; box-sizing:border-box; padding:9px 12px; border-radius:9px; border:1px solid #E7E0CE; font-family:inherit; font-size:13px; margin-top:4px;">
      </div>

      <div>
        <label>Phone</label>
        <input type="text" name="phone" id="schoolPhone" placeholder="Enter phone number" style="width:100%; box-sizing:border-box; padding:9px 12px; border-radius:9px; border:1px solid #E7E0CE; font-family:inherit; font-size:13px; margin-top:4px;">
      </div>

      <div>
        <label>Address</label>
        <input type="text" name="address" id="schoolAddress" placeholder="Enter address" style="width:100%; box-sizing:border-box; padding:9px 12px; border-radius:9px; border:1px solid #E7E0CE; font-family:inherit; font-size:13px; margin-top:4px;">
      </div>

      <div>
        <label>Weekly Class Day(s)</label>
        <p style="font-size:12px; color:#8A7B55; margin:2px 0 6px;">Which day(s) this school holds its weekly class — used to time lesson-task reminders to the school admin.</p>
        <input type="hidden" name="class_days_touched" value="1">
        <div id="schoolClassDays" style="display:flex; flex-wrap:wrap; gap:10px;">
          <% ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].forEach((label, idx) => { %>
            <label style="display:flex; align-items:center; gap:4px; font-size:13px; font-weight:400;">
              <input type="checkbox" name="class_days" value="<%= idx %>"> <%= label %>
            </label>
          <% }) %>
        </div>
      </div>

      <div>
        <label>Logo</label>
        <div style="margin:8px 0;">
          <img id="logoPreview"
               src="/Images/default-logo.png"
               alt="School Logo"
               width="90"
               height="90"
               style="border-radius: 10px; border: 1px solid #E7E0CE; object-fit: contain; background:#FAF8F2;">
        </div>
        <input type="file" name="logo" id="logoInput" accept="image/*">
      </div>

      <button type="submit" class="jk-btn-dark" style="width:100%; justify-content:center;">💾 Update</button>
    </form>
  </div>
</div>

<script>
// Open modal & populate fields
function openEditSchoolModal(id, name, email, phone, address, logo, classDays) {
  document.getElementById("editSchoolModal").hidden = false;
  document.getElementById("schoolId").value = id;
  document.getElementById("schoolName").value = name;
  document.getElementById("schoolEmail").value = email;
  document.getElementById("schoolPhone").value = phone;
  document.getElementById("schoolAddress").value = address;
  document.getElementById("logoPreview").src = logo || '/images/profile.jpg';

  const selectedDays = (classDays || "").split(",").filter((d) => d !== "");
  document.querySelectorAll('#schoolClassDays input[name="class_days"]').forEach((cb) => {
    cb.checked = selectedDays.includes(cb.value);
  });
}

function closeEditSchoolModal() {
  document.getElementById("editSchoolModal").hidden = true;
}

// Preview uploaded logo
document.getElementById("logoInput").addEventListener("change", function (e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = () => {
      document.getElementById("logoPreview").src = reader.result;
    };
    reader.readAsDataURL(file);
  }
});

// Handle update form submission
document.getElementById("editSchoolForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);

  const res = await fetch("/admin/schools/update", {
    method: "POST",
    body: formData
  });

  const data = await res.json();
  if (data.ok) {
    showAlert("✅ School info updated successfully!").then(() => {
      window.location.reload();
    });
  } else {
    showAlert("⚠️ " + data.error);
  }
});
</script>
