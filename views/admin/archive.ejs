<style>
  .arc-tabs { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .arc-tab {
    padding: 8px 16px; border: 1px solid #E7E0CE; border-radius: 999px;
    background: #fff; cursor: pointer; font-size: 12.5px; font-weight: 700; color: var(--brand-pri-dark); font-family: inherit;
  }
  .arc-tab:hover:not(.active) { background: #FAF8F2; }
  .arc-tab.active { background: #201B12; color: #EDE6D6; border-color: #201B12; }
  .arc-empty { text-align: center; color: #8A7B55; padding: 24px; }
  .arc-actions { display: flex; gap: 8px; white-space: nowrap; }
  .arc-actions button {
    padding: 6px 10px; border-radius: 7px; border: 1px solid #E7E0CE; background: #fff; cursor: pointer; font-size: 11.5px; font-weight: 700; font-family: inherit;
  }
  .arc-restore-btn { border-color: #B6DFC4; color: #1E7A42; }
  .arc-restore-btn:hover { background: #1E7A42; color: #fff; border-color: #1E7A42; }
  .arc-delete-btn { border-color: #F3D4CE; color: #B23A2A; }
  .arc-delete-btn:hover { background: #B23A2A; color: #fff; border-color: #B23A2A; }
</style>

<script>
  document.querySelectorAll(".arc-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".arc-tab").forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      document.querySelectorAll(".arc-tab-panel").forEach((p) => (p.style.display = "none"));
      document.getElementById("arc-tab-" + tab.dataset.tab).style.display = "block";
    });
  });

  document.querySelectorAll(".jk-page").forEach((page) => {
    page.addEventListener("click", async (e) => {
      const row = e.target.closest("tr[data-entity]");
      if (!row) return;
      const entity = row.dataset.entity;
      const id = row.dataset.id;
      const label = row.dataset.label;

      if (e.target.classList.contains("arc-restore-btn")) {
        const ok = await window.showConfirm(`Restore "${label}"? It will reappear everywhere it was hidden from.`, { confirmText: "Restore" });
        if (!ok) return;
        try {
          const res = await fetch(`/admin/archive/${entity}/${id}/restore`, { method: "POST" });
          const data = await res.json();
          if (data.success) {
            row.remove();
          } else {
            await window.showAlert(data.message || "Could not restore.", "error");
          }
        } catch (err) {
          console.error("Restore error:", err);
          await window.showAlert("Server error while restoring.", "error");
        }
      }

      if (e.target.classList.contains("arc-delete-btn")) {
        let counts = {};
        try {
          const impactRes = await fetch(`/admin/archive/${entity}/${id}/impact`);
          const impactData = await impactRes.json();
          counts = impactData.counts || {};
        } catch (err) {
          console.error("Impact fetch error:", err);
        }
        const countsLine = Object.entries(counts)
          .filter(([, v]) => Number(v) > 0)
          .map(([k, v]) => `${v} ${k.replace(/_/g, " ")}`)
          .join(", ");

        const ok = await window.showConfirm(
          `Permanently delete "${label}"? This cannot be undone.` +
            (countsLine ? ` It will also delete: ${countsLine}.` : ""),
          { type: "danger", confirmText: "Continue" }
        );
        if (!ok) return;

        const typed = prompt(`Type the exact name to confirm permanent deletion:\n\n${label}`);
        if (typed !== label) {
          if (typed !== null) await window.showAlert("That didn't match — nothing was deleted.", "warning");
          return;
        }

        try {
          const res = await fetch(`/admin/archive/${entity}/${id}/delete-permanent`, { method: "POST" });
          const data = await res.json();
          if (data.success) {
            row.remove();
          } else {
            await window.showAlert(data.message || "Could not delete.", "error");
          }
        } catch (err) {
          console.error("Permanent delete error:", err);
          await window.showAlert("Server error while deleting.", "error");
        }
      }
    });
  });
</script>
