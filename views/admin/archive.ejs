<%- include('../partials/adminHeader', { info: typeof info !== 'undefined' ? info : {}, currentPage: 'archive' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div>
      <h2>🗄️ Archive</h2>
      <p>"Delete" on a school, a user, a course, a module, a lesson, a classroom, a term, an external project task, an event, or a quote archives it here first — nothing is destroyed. Restore an item to bring it back exactly as it was, or use <strong>Delete Permanently</strong> to run the real, irreversible delete (which also removes everything attached to it — submissions, progress, payments, and more).</p>
    </div>
  </div>

  <div class="arc-tabs">
    <button type="button" class="arc-tab active" data-tab="users">Users (<%= users.length %>)</button>
    <button type="button" class="arc-tab" data-tab="schools">Schools (<%= schools.length %>)</button>
    <button type="button" class="arc-tab" data-tab="courses">Courses (<%= courses.length %>)</button>
    <button type="button" class="arc-tab" data-tab="modules">Modules (<%= modules.length %>)</button>
    <button type="button" class="arc-tab" data-tab="lessons">Lessons (<%= lessons.length %>)</button>
    <button type="button" class="arc-tab" data-tab="classrooms">Classrooms (<%= classrooms.length %>)</button>
    <button type="button" class="arc-tab" data-tab="terms">Terms (<%= terms.length %>)</button>
    <button type="button" class="arc-tab" data-tab="externalProjects">External Projects (<%= externalProjects.length %>)</button>
    <button type="button" class="arc-tab" data-tab="events">Events (<%= events.length %>)</button>
    <button type="button" class="arc-tab" data-tab="quotes">Quotes (<%= quotes.length %>)</button>
    <button type="button" class="arc-tab" data-tab="labProjects">Lab Projects (<%= labProjects.length %>)</button>
  </div>

  <!-- USERS -->
  <div id="arc-tab-users" class="arc-tab-panel">
    <form class="jk-toolbar" method="GET" action="/admin/archive">
      <div class="jk-search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9A8C66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" name="search" class="jk-search-input" placeholder="Search by name or email…" value="<%= search %>" />
      </div>
      <select name="role" class="jk-select">
        <option value="">All roles</option>
        <% ["student","parent","teacher","instructor","school_admin","admin","user"].forEach(r => { %>
          <option value="<%= r %>" <%= role === r ? "selected" : "" %>><%= r %></option>
        <% }) %>
      </select>
      <div class="jk-toolbar-spacer"></div>
      <button type="submit" class="jk-btn-dark">Filter</button>
    </form>
    <div class="jk-table-wrap">
      <table class="jk-table sortable-table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Role</th><th>School</th><th>Archived</th><th>By</th><th class="jk-col-actions"></th></tr>
        </thead>
        <tbody>
          <% if (!users.length) { %>
            <tr><td colspan="7" class="arc-empty">No archived users.</td></tr>
          <% } %>
          <% users.forEach(u => { %>
            <tr data-entity="user" data-id="<%= u.id %>" data-label="<%= u.label %>">
              <td><%= u.label %></td>
              <td><%= u.extra || '—' %></td>
              <td><%= u.context || '—' %></td>
              <td><%= u.parent_label || '—' %></td>
              <td><%= new Date(u.archived_at).toLocaleDateString() %></td>
              <td><%= u.archived_by_name || '—' %></td>
              <td class="arc-actions jk-col-actions">
                <button type="button" class="arc-restore-btn">Restore</button>
                <button type="button" class="arc-delete-btn">Delete Permanently</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

