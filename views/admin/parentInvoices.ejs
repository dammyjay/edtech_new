<!-- chart script -->
 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trend = <%- JSON.stringify(trend || []) %>;

    if (!trend.length) return;

    const labels = trend.map(t => t.day);
    const data = trend.map(t => Number(t.total || 0));

    const ctx = document.getElementById("paymentChart");

    if (ctx) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            label: "Payments",
            data,
            fill: true,
            tension: 0.3
          }]
        }
      });
    }
  });
</script>

<!-- Analytics script -->
<script>
  const summary = <%- JSON.stringify(summary || {}) %>;

  const totalExpected = Number(summary.total_expected || 0);
  const totalPaid = Number(summary.total_paid || 0);
  const outstanding = Number(summary.outstanding || 0);

  const rate = totalExpected > 0 
    ? ((totalPaid / totalExpected) * 100).toFixed(1)
    : 0;

  // Fill cards
  document.getElementById("cardTotalExpected").innerText = "₦" + totalExpected.toLocaleString();
  document.getElementById("cardTotalPaid").innerText = "₦" + totalPaid.toLocaleString();
  document.getElementById("cardOutstanding").innerText = "₦" + outstanding.toLocaleString();
  document.getElementById("cardCollectionRate").innerText = rate + "%";

  document.getElementById("cardPaidQuotes").innerText = summary.paid_quotes || 0;
  document.getElementById("cardPartialQuotes").innerText = summary.partial_quotes || 0;
  // document.getElementById("cardUnpaidQuotes").innerText = summary.unpaid_quotes || 0;
  document.getElementById("cardUnpaidQuotes").innerText = summary.unpaid_quotes || 0;
  document.getElementById("cardPendingQuotes").innerText = summary.pending_quotes || 0;
</script>

