
<%- include('../partials/adminHeader', { title: 'Quotes' }) %>

  <style>
    /* small local styles — integrate into your style.css later */
    .analytics-container { width: 95%; margin: 20px auto; padding: 20px;}
    .cards { display:flex; gap:16px; flex-wrap:wrap; }
    .card { background:#fff; padding:16px; border-radius:8px; box-shadow:0 1px 4px rgba(0,0,0,0.08); flex:1 1 220px; min-width:180px; }
    .charts { display:flex; gap:16px; margin-top:16px; flex-wrap:wrap; }
    .chart-card { flex:1 1 480px; background:#fff; padding:16px; border-radius:8px; }
    .table-responsive { margin-top:20px; }
    .filter-row { display:flex; gap:10px; align-items:center; margin-bottom:12px; }
    .activity-feed { max-height:360px; overflow:auto; background:#fff; padding:12px; border-radius:8px; }
  </style>

<h2>Parent Invoice</h2>

<div style="margin:20px 0;">
    <button class="btn btn-primary" onclick="openCreateInvoiceModal()">
        <i class="fa fa-plus"></i>
        Create Parent Invoice
    </button>
</div>

<div class="analytics-container">
  <h1>Financial Analytics</h1>

  <div class="filter-row">

    <label style="margin-left:8px;">School:
      <select id="schoolFilter"><option value="">All Schools</option></select>
    </label>

    <button id="refreshBtn">Refresh</button>
  </div>

  <!-- 🔥 FINANCE CARDS -->
  <section class="section">
    <div class="engagement-grid">

      <!-- TOTAL EXPECTED -->
      <div class="metric-card">
            <div class="card-title blue-bg">
                <p>Total Expected</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon blue-bg">
                  <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <h4 id="cardTotalExpected">₦0</h4>
            </div>
        </div>

      <!-- TOTAL PAID -->
       <div class="metric-card">
            <div class="card-title dark-green-bg">
                <p>Total Collected</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon dark-green-bg">
                  <i class="fa-solid fa-check"></i>
                </div>
                <h4 id="cardTotalPaid">₦0</h4>
            </div>
        </div>

      <!-- OUTSTANDING -->
       <div class="metric-card">
            <div class="card-title dark-red-bg">
                <p>Outstanding</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon dark-red-bg">
                  <i class="fa-solid fa-clock"></i>
                </div>
                <h4 id="cardOutstanding">₦0</h4>
            </div>
        </div>

      <!-- COLLECTION RATE -->
       <div class="metric-card">
            <div class="card-title purple-bg">
                <p>Collection Rate</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon purple-bg">
                  <i class="fa-solid fa-chart-line"></i>
                </div>
                <h4 id="cardCollectionRate">₦0</h4>
            </div>
        </div>

      <!-- PAID QUOTES -->
       <div class="metric-card">
            <div class="card-title green-bg">
                <p>Paid Quotes</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon green-bg">
                  <i class="fa-solid fa-circle-check"></i>
                </div>
                <h4 id="cardPaidQuotes">₦0</h4>
            </div>
        </div>

      <!-- PARTIAL -->
       <div class="metric-card">
            <div class="card-title orange-bg">
                <p>Partial Payments</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon orange-bg">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h4 id="cardPartialQuotes">₦0</h4>
            </div>
        </div>

      <!-- UNPAID -->
       <div class="metric-card">
            <div class="card-title dark-red-bg">
                <p>Overdue Payment</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon dark-red-bg">
                  <i class="fa-solid fa-xmark"></i>
                </div>
                <h4 id="cardUnpaidQuotes">₦0</h4>
            </div>
        </div>

      <!-- Pending -->
       <div class="metric-card">
            <div class="card-title indigo-bg">
                <p>Ongoing Quotes</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon indigo-bg">
                  <i class="fa-solid fa-hourglass-half"></i>
                </div>
                <h4 id="cardPendingQuotes">₦0</h4>
            </div>
        </div>

    </div>
  </section>
  <div class="chart-card">
    <h4>Payment Trends</h4>
    <canvas id="paymentChart" height="150"></canvas>
  </div>
</div>

<input type="text" id="searchInput" placeholder="Search quotes..." />
    <select id="statusFilter">
      <option value="">All</option>
      <option value="paid">Paid</option>
      <option value="partial">Partial</option>
      <option value="overdue">Overdue</option>
      <option value="pending">Ongoing</option>
      <option value="upcoming">Upcoming</option>
    </select>

<div class="table-responsive">
  <table class="user-table" style="width:100%; margin-top:20px;">

    <thead>
        <tr>

        <th>Invoice</th>

        <th>Parent</th>

        <th>Students</th>

        <th>Training</th>

        <th>Amount</th>

        <th>Paid</th>

        <th>Balance</th>

        <th>Status</th>

        <th>Action</th>

        </tr>

    </thead>
    <tbody>
        <% invoices.forEach(invoice=>{ %>

            <tr>

            <td>

            <strong><%= invoice.invoice_number %></strong>

            </td>

            <td>

            <b><%= invoice.parent_name %></b>

            <br>

            <small><%= invoice.phone || "" %></small>

            </td>

            <td>

            <%= invoice.students || "-" %>

            </td>

            <td>

            <%= invoice.training_title %>

            </td>

            <td>

            ₦<%= Number(invoice.agreed_amount).toLocaleString() %>

            </td>

            <td>

            ₦<%= Number(invoice.total_paid).toLocaleString() %>

            </td>

            <td>

            ₦<%= Number(invoice.balance).toLocaleString() %>

            </td>

            <td>

            <% if(invoice.status==="paid"){ %>

            <span class="badge payment-status <%= invoice.status %>">
                Paid
            </span>

            <% }else if(invoice.status==="partial"){ %>

            <span class="badge payment-status partial bg-warning">

                Part Payment

            </span>

            <% }else{ %>

            <span class="badge payment-status pending bg-danger">

                Pending

            </span>

            <% } %>

            </td>

            <td>

                <a href="/admin/parent-invoices/<%= invoice.id %>/download" class="no-bg">
                    <i class="fa-solid fa-file-pdf" style="color:red;"></i>
                </a>

                <a href="/admin/parent-invoices/<%= invoice.id %>/send" class="no-bg">
                    <i class="fa-solid fa-paper-plane" style="color:#007bff;"></i>
                </a>

                <button
                class="btn btn-success btn-sm"
                onclick="openPaymentModal('<%= invoice.id %>')">

                <i class="fa fa-credit-card"></i>

                </button>

            </td>

            </tr>

            <% }) %>
    </tbody>
  </table>
</div>

<div id="createInvoiceModal" class="modal-overlay" style="display:none;">

    <div class="modal-content" style="max-width:700px;">

        <span class="close-btn" onclick="closeModal('createInvoiceModal')">
        &times;
        </span>

        <h2>Create Parent Training Invoice</h2>

        <form action="/admin/parent-training-invoices/create" method="POST">

            <!-- Parent Search -->

            <label>Parent</label>

            <input
            type="text"
            id="parentSearch"
            placeholder="Type parent name..."
            autocomplete="off">

            <input
            type="hidden"
            name="parent_id"
            id="parentId">

            <div
            id="parentSuggestions"
            class="autocomplete-box">
            </div>


            <hr>


            <!-- Students -->

            <label>Students</label>

            <div id="studentContainer">

            <p style="color:#888;">
            Select a parent first.
            </p>

            </div>


            <hr>


            <label>Training Title</label>

            <input
            type="text"
            name="training_title"
            value="Coding & Robotics Training">


            <label>Agreed Amount</label>

            <input
            type="number"
            name="agreed_amount"
            required>


            <label>Discount</label>

            <input
            type="number"
            name="discount"
            value="0">


            <label>Due Date</label>

            <input
            type="date"
            name="due_date">


            <label>Notes</label>

            <textarea
            name="notes"
            rows="4"></textarea>


            <button type="submit">

            Create Invoice

            </button>

        </form>

    </div>

</div>

<!-- Payment modal -->
<div id="paymentModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span class="close-btn" onclick="closeModal('paymentModal')">&times;</span>

    <h2>💳 Add Payment</h2>
    <p id="quoteInfo"></p>
    <form action="/admin/parent-payments" method="POST">

        <input
        type="hidden"
        name="invoice_id"
        id="invoiceId">

        <label>

        Payment Method

        </label>

        <select name="payment_method">

        <option>Cash</option>

        <option>Transfer</option>

        <option>POS</option>

        <option>Online</option>

        </select>

        <label>

        Amount

        </label>

        <input
        type="number"
        name="amount"
        required>

        <label>

        Payment Note

        </label>

        <textarea
        name="payment_note"
        rows="3"></textarea>

        <button type="submit">

        Save Payment

        </button>

    </form>
  </div>
</div>

<!-- chart script -->
 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trend = <%- JSON.stringify(trend || []) %>;

    if (!trend.length) return;

    const labels = trend.map(t => t.day);
    const data = trend.map(t => Number(t.total || 0));

    const ctx = document.getElementById("paymentChart");

    if (ctx) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            label: "Payments",
            data,
            fill: true,
            tension: 0.3
          }]
        }
      });
    }
  });
</script>

<!-- Analytics script -->
<script>
  const summary = <%- JSON.stringify(summary || {}) %>;

  const totalExpected = Number(summary.total_expected || 0);
  const totalPaid = Number(summary.total_paid || 0);
  const outstanding = Number(summary.outstanding || 0);

  const rate = totalExpected > 0 
    ? ((totalPaid / totalExpected) * 100).toFixed(1)
    : 0;

  // Fill cards
  document.getElementById("cardTotalExpected").innerText = "₦" + totalExpected.toLocaleString();
  document.getElementById("cardTotalPaid").innerText = "₦" + totalPaid.toLocaleString();
  document.getElementById("cardOutstanding").innerText = "₦" + outstanding.toLocaleString();
  document.getElementById("cardCollectionRate").innerText = rate + "%";

  document.getElementById("cardPaidQuotes").innerText = summary.paid_quotes || 0;
  document.getElementById("cardPartialQuotes").innerText = summary.partial_quotes || 0;
  // document.getElementById("cardUnpaidQuotes").innerText = summary.unpaid_quotes || 0;
  document.getElementById("cardUnpaidQuotes").innerText = summary.unpaid_quotes || 0;
  document.getElementById("cardPendingQuotes").innerText = summary.pending_quotes || 0;
</script>

<!-- Payment modal script -->
<script>

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  // optional: close when clicking outside
window.onclick=function(e){

    ["paymentModal","createInvoiceModal"].forEach(id=>{

        const modal=document.getElementById(id);

        if(e.target===modal){

            modal.style.display="none";

        }

    });

}

  function openPaymentModal(invoiceId){

    document.getElementById("invoiceId").value = invoiceId;

    document.getElementById("paymentModal").style.display = "flex";

}
</script>

