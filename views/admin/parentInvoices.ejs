
<%- include('../partials/adminHeader', { title: 'Parent Invoices' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div>
      <h2>Parent Invoices</h2>
      <p>Training invoices, payments and collection analytics.</p>
    </div>
    <button class="jk-btn-dark" onclick="openCreateInvoiceModal()">
      <i class="fa fa-plus"></i> Create Parent Invoice
    </button>
  </div>

  <div class="jk-toolbar">
    <label style="font-size:13px; font-weight:600; color:#4C3802; display:flex; align-items:center; gap:8px;">
      School:
      <select id="schoolFilter" class="jk-select"><option value="">All Schools</option></select>
    </label>
    <button id="refreshBtn" class="jk-btn-outline">Refresh</button>
  </div>

  <div class="jk-stat-grid" style="grid-template-columns: repeat(4, minmax(0,1fr));">

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Expected</span>
        <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fa-solid fa-money-bill-wave" style="color:#A17807; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardTotalExpected">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Collected</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fa-solid fa-check" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardTotalPaid">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Outstanding</span>
        <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fa-solid fa-clock" style="color:#B23A2A; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardOutstanding">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Collection Rate</span>
        <div class="jk-stat-icon" style="background:var(--brand-tint);"><i class="fa-solid fa-chart-line" style="color:var(--brand-pri-dark); font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardCollectionRate">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Paid Quotes</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fa-solid fa-circle-check" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardPaidQuotes">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Partial Payments</span>
        <div class="jk-stat-icon" style="background:var(--brand-tint);"><i class="fa-solid fa-triangle-exclamation" style="color:var(--brand-pri-dark); font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardPartialQuotes">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Overdue Payment</span>
        <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fa-solid fa-xmark" style="color:#B23A2A; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardUnpaidQuotes">₦0</span>
    </div>

    <div class="metric-card jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Ongoing Quotes</span>
        <div class="jk-stat-icon" style="background:#F1ECDD;"><i class="fa-solid fa-hourglass-half" style="color:#6E6350; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="cardPendingQuotes">₦0</span>
    </div>

  </div>

  <div class="jk-report-panel">
    <h3>Payment Trends</h3>
    <canvas id="paymentChart" height="90"></canvas>
  </div>

  <div class="jk-toolbar">
    <div class="jk-search-wrap">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8A7B55" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="searchInput" class="jk-search-input" placeholder="Search Invoice, Parent, Student, Training...">
    </div>

    <select id="statusFilter" class="jk-select">
      <option value="">All Status</option>
      <option value="paid">Paid</option>
      <option value="partial">Partial</option>
      <option value="pending">Pending</option>
    </select>

    <select id="paymentFilter" class="jk-select">
      <option value="">Payment Progress</option>
      <option value="paid">Fully Paid</option>
      <option value="balance">Has Balance</option>
      <option value="excess">Excess Payment</option>
    </select>

    <select id="dueFilter" class="jk-select">
      <option value="">Due Date</option>
      <option value="overdue">Overdue</option>
      <option value="today">Due Today</option>
      <option value="upcoming">Upcoming</option>
    </select>
  </div>

  <div class="jk-table-wrap">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Invoice No</th>
          <th>Created Date</th>
          <th>Due Date</th>
          <th>Final Payment</th>
          <th>Parent</th>
          <th>Students</th>
          <th>Training</th>
          <th>Payable</th>
          <th>Paid</th>
          <th>Balance</th>
          <th>Excess</th>
          <th>Status</th>
          <th class="jk-col-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% invoices.forEach(invoice=>{ %>
          <tr
            data-status="<%= invoice.status %>"
            data-parent="<%= invoice.parent_name.toLowerCase() %>"
            data-training="<%= invoice.training_title.toLowerCase() %>"
            data-students="<%= invoice.students.toLowerCase() %>"
            data-balance="<%= invoice.balance %>"
            data-excess="<%= invoice.excess_payment %>"
            data-due="<%= invoice.due_date || '' %>"
          >
            <td><strong><%= invoice.invoice_number %></strong></td>
            <td><%= new Date(invoice.created_at).toLocaleDateString() %></td>
            <td>
              <% if(invoice.due_date){ %><%= new Date(invoice.due_date).toLocaleDateString() %><% }else{ %>—<% } %>
            </td>
            <td>
              <% if(invoice.final_payment_date){ %><%= new Date(invoice.final_payment_date).toLocaleDateString() %><% }else{ %>—<% } %>
            </td>
            <td>
              <div class="jk-row-user">
                <div>
                  <p class="jk-row-name"><%= invoice.parent_name %></p>
                  <p class="jk-row-sub"><%= invoice.phone || "" %></p>
                </div>
              </div>
            </td>
            <td><%= invoice.students %></td>
            <td><%= invoice.training_title %></td>
            <td>₦<%= Number(invoice.payable).toLocaleString() %></td>
            <td>₦<%= Number(invoice.total_paid).toLocaleString() %></td>
            <td>₦<%= Number(invoice.balance).toLocaleString() %></td>
            <td>
              <% if(Number(invoice.excess_payment)>0){ %>
                <span style="color:#1E7A42; font-weight:700;">₦<%= Number(invoice.excess_payment).toLocaleString() %></span>
              <% }else{ %>—<% } %>
            </td>
            <td>
              <% if(invoice.status==="paid"){ %>
                <span class="jk-pill jk-pill--paid">Paid</span>
              <% }else if(invoice.status==="partial"){ %>
                <span class="jk-pill jk-pill--partial">Partial</span>
              <% }else{ %>
                <span class="jk-pill jk-pill--unpaid">Pending</span>
              <% } %>
            </td>
            <td class="jk-col-actions">
              <a href="/admin/parent-invoices/<%= invoice.id %>/download" class="jk-icon-btn" title="Download">
                <i class="fa-solid fa-file-pdf" style="color:#B23A2A;"></i>
              </a>
              <a href="/admin/parent-invoices/<%= invoice.id %>/send" class="jk-icon-btn" title="Send">
                <i class="fa-solid fa-paper-plane" style="color:#2563EB;"></i>
              </a>
              <a href="#" onclick="openPaymentModal('<%= invoice.id %>'); return false;" class="jk-icon-btn" title="Add Payment">
                <i class="fa-solid fa-credit-card" style="color:#1E7A42;"></i>
              </a>
              <a href="#" onclick="viewPayments(<%= invoice.id %>); return false;" class="jk-icon-btn" title="Payment History">
                <i class="fa-solid fa-history" style="color:#6E6350;"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</section>

<div id="createInvoiceModal" class="jk-modal-overlay" style="display:none;">
  <div class="jk-modal jk-modal--wide">
    <div class="jk-modal-head">
      <div>
        <h4>Create Parent Training Invoice</h4>
      </div>
      <button type="button" class="jk-modal-close" onclick="closeModal('createInvoiceModal')">&times;</button>
    </div>

    <form action="/admin/parent-training-invoices/create" method="POST" class="jk-modal-body">

      <label>Parent</label>
      <input type="text" id="parentSearch" class="jk-select" style="width:100%;" placeholder="Type parent name..." autocomplete="off">
      <input type="hidden" name="parent_id" id="parentId">
      <div id="parentSuggestions" class="autocomplete-box"></div>

      <label>Students</label>
      <div id="studentContainer">
        <p style="color:#8A7B55;">Select a parent first.</p>
      </div>

      <label>Training Title</label>
      <input type="text" name="training_title" class="jk-select" style="width:100%;" value="Coding &amp; Robotics Training">

      <label>Agreed Amount</label>
      <input type="number" name="agreed_amount" class="jk-select" style="width:100%;" required>

      <label>Discount</label>
      <input type="number" name="discount" class="jk-select" style="width:100%;" value="0">

      <label>Due Date</label>
      <input type="date" name="due_date" class="jk-select" style="width:100%;">

      <label>Grace Period (Days)</label>
      <input type="number" name="grace_days" class="jk-select" style="width:100%;" value="5" min="0">

      <label>Notes</label>
      <textarea name="notes" rows="4" class="jk-select" style="width:100%;"></textarea>

      <button type="submit" class="jk-btn-dark" style="align-self:flex-start;">Create Invoice</button>

    </form>
  </div>
</div>

<!-- Payment modal -->
<div id="paymentModal" class="jk-modal-overlay" style="display:none;">
  <div class="jk-modal">
    <div class="jk-modal-head">
      <div>
        <h4>💳 Add Payment</h4>
        <p id="quoteInfo"></p>
      </div>
      <button type="button" class="jk-modal-close" onclick="closeModal('paymentModal')">&times;</button>
    </div>

    <form action="/admin/parent-payments" method="POST" class="jk-modal-body">

      <input type="hidden" name="invoice_id" id="invoiceId">

      <label>Payment Method</label>
      <select name="payment_method" class="jk-select" style="width:100%;">
        <option>Cash</option>
        <option>Transfer</option>
        <option>POS</option>
        <option>Online</option>
      </select>

      <label>Amount</label>
      <input type="number" name="amount" class="jk-select" style="width:100%;" required>

      <label>Payment Date</label>
      <input type="date" name="payment_date" class="jk-select" style="width:100%;" value="<%= new Date().toISOString().split('T')[0] %>" required>

      <label>Payment Note</label>
      <textarea name="payment_note" rows="3" class="jk-select" style="width:100%;"></textarea>

      <button type="submit" class="jk-btn-dark" style="align-self:flex-start;">Save Payment</button>

    </form>
  </div>
</div>

<div id="paymentHistoryModal" class="jk-modal-overlay" style="display:none;">
  <div class="jk-modal jk-modal--wide">
    <div class="jk-modal-head">
      <div><h4>Payment History</h4></div>
      <button type="button" class="jk-modal-close" onclick="closeModal('paymentHistoryModal')">&times;</button>
    </div>
    <div class="jk-modal-body">
      <div id="paymentHistoryTable">Loading...</div>
    </div>
  </div>
</div>

<!-- chart script -->
 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trend = <%- JSON.stringify(trend || []) %>;

    if (!trend.length) return;

    const labels = trend.map(t => t.day);
    const data = trend.map(t => Number(t.total || 0));

    const ctx = document.getElementById("paymentChart");

    if (ctx) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            label: "Payments",
            data,
            fill: true,
            tension: 0.3
          }]
        }
      });
    }
  });
</script>

<!-- Analytics script -->
<script>
  const summary = <%- JSON.stringify(summary || {}) %>;

  const totalExpected = Number(summary.total_expected || 0);
  const totalPaid = Number(summary.total_paid || 0);
  const outstanding = Number(summary.outstanding || 0);

  const rate = totalExpected > 0
    ? ((totalPaid / totalExpected) * 100).toFixed(1)
    : 0;

  // Fill cards
  document.getElementById("cardTotalExpected").innerText = "₦" + totalExpected.toLocaleString();
  document.getElementById("cardTotalPaid").innerText = "₦" + totalPaid.toLocaleString();
  document.getElementById("cardOutstanding").innerText = "₦" + outstanding.toLocaleString();
  document.getElementById("cardCollectionRate").innerText = rate + "%";

  document.getElementById("cardPaidQuotes").innerText = summary.paid_quotes || 0;
  document.getElementById("cardPartialQuotes").innerText = summary.partial_quotes || 0;
  document.getElementById("cardUnpaidQuotes").innerText = summary.unpaid_quotes || 0;
  document.getElementById("cardPendingQuotes").innerText = summary.pending_quotes || 0;
</script>

<!-- Payment modal script -->
<script>

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  // optional: close when clicking outside
window.onclick=function(e){

    ["paymentModal","createInvoiceModal"].forEach(id=>{

        const modal=document.getElementById(id);

        if(e.target===modal){

            modal.style.display="none";

        }

    });

}

  function openPaymentModal(invoiceId){

    document.getElementById("invoiceId").value = invoiceId;

    document.getElementById("paymentModal").style.display = "flex";

}
</script>

<script>
    const searchInput = document.getElementById("searchInput");
    const statusFilter = document.getElementById("statusFilter");
    const paymentFilter = document.getElementById("paymentFilter");
    const dueFilter = document.getElementById("dueFilter");

    searchInput.addEventListener("keyup", filterTable);
    statusFilter.addEventListener("change", filterTable);
    paymentFilter.addEventListener("change", filterTable);
    dueFilter.addEventListener("change", filterTable);

    function filterTable(){

        const keyword = searchInput.value.toLowerCase();

        const status = statusFilter.value;

        const payment = paymentFilter.value;

        const due = dueFilter.value;

        const today = new Date();

        today.setHours(0,0,0,0);

        document.querySelectorAll("tbody tr").forEach(row=>{

            let show=true;

            const text=row.innerText.toLowerCase();

            if(keyword && !text.includes(keyword))
                show=false;

            if(status && row.dataset.status!==status)
                show=false;

            const balance=Number(row.dataset.balance);

            const excess=Number(row.dataset.excess);

            if(payment==="paid" && balance>0)
                show=false;

            if(payment==="balance" && balance<=0)
                show=false;

            if(payment==="excess" && excess<=0)
                show=false;

            if(due){

                if(row.dataset.due){

                    const dueDate=new Date(row.dataset.due);

                    dueDate.setHours(0,0,0,0);

                    if(due==="overdue" && dueDate>=today)
                        show=false;

                    if(due==="today" &&
                        dueDate.getTime()!=today.getTime())
                        show=false;

                    if(due==="upcoming" && dueDate<=today)
                        show=false;

                }
                else{

                    show=false;

                }

            }

            row.style.display=show ? "" : "none";

        });

    }
</script>

<script>

function openCreateInvoiceModal(){

    document.getElementById("createInvoiceModal").style.display="flex";

}

const parentInput=document.getElementById("parentSearch");

const suggestionBox=document.getElementById("parentSuggestions");

const parentIdInput=document.getElementById("parentId");

parentInput.addEventListener("keyup",async function(){

    const keyword=this.value.trim();

    if(keyword.length<2){

        suggestionBox.style.display="none";
        return;

    }

    const res=await fetch(`/admin/api/parents/search?keyword=${encodeURIComponent(keyword)}`);

    const parents=await res.json();

    suggestionBox.innerHTML="";

    if(parents.length===0){

        suggestionBox.innerHTML="<div class='autocomplete-item'>No parent found</div>";

        suggestionBox.style.display="block";

        return;

    }

    suggestionBox.style.display="block";

    parents.forEach(parent=>{

        const div=document.createElement("div");

        div.className="autocomplete-item";

        div.innerHTML=`
            <strong>${parent.fullname}</strong><br>
            <small>${parent.email || ""}</small>
        `;

        div.onclick=function(){

            parentInput.value=parent.fullname;

            parentIdInput.value=parent.id;

            suggestionBox.style.display="none";

            loadStudents(parent.id);

        }

        suggestionBox.appendChild(div);

    });

});

</script>

<script>

async function loadStudents(parentId){

    const res = await fetch(`/admin/api/parents/${parentId}/students`);

    const students = await res.json();

    const container = document.getElementById("studentContainer");

    if(students.length === 0){

        container.innerHTML = `
            <div class="alert alert-warning">
                No students are linked to this parent.
            </div>
        `;

        return;

    }

    let html = `
        <table class="table table-bordered">

            <thead>
                <tr>
                    <th width="40">
                        <input
                            type="checkbox"
                            id="selectAllStudents">
                    </th>

                    <th>Student Name</th>

                    <th>Email</th>

                </tr>
            </thead>

            <tbody>
    `;

    students.forEach(student=>{

        html += `

        <tr>

            <td>

                <input
                    type="checkbox"
                    name="student_ids[]"
                    value="${student.id}">

            </td>

            <td>

                ${student.fullname}

            </td>

            <td>

                ${student.email || "-"}

            </td>

        </tr>

        `;

    });

    html += `
            </tbody>

        </table>
    `;

    container.innerHTML = html;

    document.getElementById("selectAllStudents").onclick=function(){

        document.querySelectorAll("input[name='student_ids[]']")
        .forEach(cb=>cb.checked=this.checked);

    }

}
</script>

<script>
    async function viewPayments(invoiceId){

        const res = await fetch(
            `/admin/api/parent-invoices/${invoiceId}/payments`
        );

        const payments = await res.json();

        let html = `
        <table class="jk-table">

        <thead>

        <tr>

        <th>#</th>

        <th>Date</th>

        <th>Amount</th>

        <th>Method</th>

        <th>Receipt</th>

        <th>Reference</th>

        <th>Recorded By</th>

        <th>Note</th>

        </tr>

        </thead>

        <tbody>
        `;

        if(payments.length===0){

            html+=`
            <tr>

            <td colspan="8">

            No payments found

            </td>

            </tr>
            `;

        }

        payments.forEach((p,index)=>{

            html+=`

            <tr>

            <td>${index+1}</td>

            <td>${new Date(p.payment_date).toLocaleDateString()}</td>

            <td>₦${Number(p.amount).toLocaleString()}</td>

            <td>${p.payment_method}</td>

            <td>${p.receipt_number}</td>

            <td>${p.transaction_reference}</td>

            <td>${p.recorded_by||"-"}</td>

            <td>${p.payment_note||"-"}</td>

            </tr>

            `;

        });

        html+=`

        </tbody>

        </table>
        `;

        document.getElementById("paymentHistoryTable").innerHTML=html;

        document.getElementById("paymentHistoryModal").style.display="flex";

    }
</script>
