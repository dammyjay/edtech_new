<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

  <h2>Edit User</h2>
<form action="/admin/users/edit/<%= user.id %>" method="POST">
  <label>Full Name</label><br />
  <input type="text" name="fullname" value="<%= user.fullname %>" required /><br /><br />

  <label>Email</label><br />
  <input type="email" name="email" value="<%= user.email %>" required /><br /><br />

  <label>Phone</label><br />
  <input type="text" name="phone" value="<%= user.phone || '' %>" /><br /><br />

  <label>Gender</label><br />
  <select name="gender" required>
    <!-- <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
    <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option> -->
    <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
    <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>

  </select><br /><br />

  <label>Role</label><br />
  <select name="role" required>
    <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option> 
    <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option> 
    <option value="instructor" <%= role === 'instructor' ? 'selected' : '' %>>Instructor</option> 
    <option value="teacher" <%= role === 'teacher' ? 'selected' : '' %>>Teacher</option> 
    <option value="student" <%= role === 'student' ? 'selected' : '' %>>Student</option> 
    <option value="school_admin" <%= role === 'school_admin' ? 'selected' : '' %>>School Admin</option> 
    <option value="parent" <%= role === 'parent' ? 'selected' : '' %>>Parent</option> 
  </select><br /><br />
  <label>Wallet Balance ($)</label><br />
  <input type="number" step="0.01" name="wallet_balance2" value ="<%= user.wallet_balance2 %>" /><br /><br />
  

  <button type="submit">Update User</button>
</form>

  <a href="/admin/dashboard">Back to Articles</a>

  <!-- script for navbar hamburger -->
    <script>
      function toggleNav() {
        var nav = document.getElementById("main-nav");
        nav.classList.toggle("open");
      }
    </script>
