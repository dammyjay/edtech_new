<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>
<link rel="stylesheet" href="/css/admin-newsletters.css">

<section class="section jk-page">

    <div class="jk-header-card">
        <div>
            <h2>Newsletters</h2>
            <p>Create and send newsletters.</p>
        </div>
        <button class="jk-btn-dark" id="openCreateModal">
            <i class="fa-solid fa-plus"></i>
            New Newsletter
        </button>
    </div>

    <div class="jk-stat-grid" style="grid-template-columns: repeat(4, minmax(0,1fr));">

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Total Newsletters</span>
                <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-envelope-open-text" style="color:#A17807; font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.total || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Drafts</span>
                <div class="jk-stat-icon" style="background:#F1ECDD;"><i class="fas fa-file-alt" style="color:#6E6350; font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.drafts || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Scheduled</span>
                <div class="jk-stat-icon" style="background:var(--brand-tint);"><i class="fas fa-calendar-alt" style="color:var(--brand-pri-dark); font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.scheduled || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Sending</span>
                <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-paper-plane" style="color:#A17807; font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.sending || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Sent</span>
                <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-check-circle" style="color:#1E7A42; font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.sent || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Delivered</span>
                <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-inbox" style="color:#1E7A42; font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.delivered || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Opened</span>
                <div class="jk-stat-icon" style="background:var(--brand-tint);"><i class="fas fa-envelope-open" style="color:var(--brand-pri-dark); font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.opened || 0 %></span>
        </div>

        <div class="jk-stat-card">
            <div class="jk-stat-head">
                <span class="jk-stat-label">Failed</span>
                <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fas fa-times-circle" style="color:#B23A2A; font-size:13px;"></i></div>
            </div>
            <span class="jk-stat-value"><%= stats.failed || 0 %></span>
        </div>

    </div>

    <div class="jk-toolbar">
        <div class="jk-search-wrap">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8A7B55" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="newsletterSearch" class="jk-search-input" placeholder="Search newsletter...">
        </div>

        <select id="newsletterStatusFilter" class="jk-select">
            <option value="">All Status</option>
            <option value="draft">Draft</option>
            <option value="scheduled">Scheduled</option>
            <option value="sending">Sending</option>
            <option value="sent">Sent</option>
        </select>
    </div>

    <div class="jk-table-wrap">
        <table class="jk-table sortable-table">

            <thead>
            <tr>
                <th>Subject</th>
                <th>Audience</th>
                <th>Status</th>
                <th>Recipients</th>
                <th>Created</th>
                <th class="jk-col-actions">Actions</th>
            </tr>
            </thead>

            <tbody id="newsletterTableBody">
            <% newsletters.forEach(newsletter => { %>
                <tr data-subject="<%= newsletter.subject.toLowerCase() %>" data-status="<%= newsletter.status %>">
                    <td><%= newsletter.subject %></td>
                    <td><%= newsletter.recipient_type %></td>
                    <td>
                        <span class="jk-pill <%= newsletter.status === 'sent' ? 'jk-pill--active' : newsletter.status === 'failed' ? 'jk-pill--unpaid' : newsletter.status === 'draft' ? 'jk-pill--inactive' : 'jk-pill--partial' %>">
                            <%= newsletter.status %>
                        </span>
                    </td>
                    <td><%= newsletter.total_recipients %></td>
                    <td><%= new Date(newsletter.created_at).toLocaleDateString() %></td>
                    <td class="jk-col-actions">
                        <button class="jk-icon-btn" title="View" onclick="viewNewsletter(<%= newsletter.id %>)">
                            <i class="fas fa-eye"></i>
                        </button>
                        <% if(newsletter.status !== 'sent'){ %>
                            <button class="jk-icon-btn" title="Edit" onclick="editNewsletter(<%= newsletter.id %>)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="jk-icon-btn" title="Delete" onclick="deleteNewsletter(<%= newsletter.id %>)" style="color:#B23A2A;">
                                <i class="fas fa-trash"></i>
                            </button>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
            </tbody>

        </table>
    </div>

</section>

<!-- Search/filter for the newsletter list table (previously dead UI — the
     search input and status <select> had no id and no wiring at all). -->
<script>
    (function () {
        const search = document.getElementById("newsletterSearch");
        const statusFilter = document.getElementById("newsletterStatusFilter");
        const rows = () => document.querySelectorAll("#newsletterTableBody tr");

        function applyFilters() {
            const keyword = search.value.trim().toLowerCase();
            const status = statusFilter.value;
            rows().forEach((row) => {
                const matchesSearch = !keyword || row.dataset.subject.includes(keyword);
                const matchesStatus = !status || row.dataset.status === status;
                row.style.display = matchesSearch && matchesStatus ? "" : "none";
            });
        }

        search.addEventListener("keyup", applyFilters);
        statusFilter.addEventListener("change", applyFilters);
    })();
</script>

    <!-- ==========================
CREATE NEWSLETTER MODAL
=========================== -->

<div id="createNewsletterModal" class="modal-overlay" style="display:none;">

    <div class="modal-content" style="max-width:900px;">

        <span class="close-btn"
            onclick="closeModal('createNewsletterModal')">

            &times;

        </span>

        <h2>
            <i class="fas fa-envelope-open-text"></i>
            Create Newsletter
        </h2>

        <form
            action="/admin/newsletters/create"
            method="POST"
            enctype="multipart/form-data">

            <label>Subject</label>

            <input
                type="text"
                name="subject"
                required
                placeholder="Newsletter subject">

            <label>Preview Text</label>

            <input
                type="text"
                name="preview_text"
                placeholder="Short email preview">

            <label>Newsletter Banner</label>

            <input
            type="file"
            id="newsletterImage"
            name="image"
            accept="image/*">

            <div class="newsletter-image-preview">

            <img
            id="newsletterPreview"
            style="display:none;">

            </div>

            <label>Audience</label>

            <select
                id="recipientType"
                name="recipient_type"
                required>

                <option value="">Select Audience</option>

                <option value="all">
                    Everyone
                </option>

                <option value="users">
                    All Users
                </option>

                <option value="parents">
                    Parents
                </option>

                <option value="teachers">
                    Teachers
                </option>

                <option value="students">
                    Students
                </option>

                <option value="school_admins">
                    School Admins
                </option>

                <option value="admins">
                    Platform Admins
                </option>

                <option value="schools">
                    Specific Schools
                </option>

                <option value="classrooms">
                    Specific Classrooms
                </option>

                <option value="courses">
                    Course Enrollees
                </option>

                <option value="custom">
                    Custom Users
                </option>

            </select>

            <!-- Dynamic Recipient Area -->

            <div id="recipientSelectionArea"></div>
            <input
            type="hidden"
            id="selectedRecipientIds"
            name="recipient_ids">

            <!-- Stores whether admin selected all users or only selected users -->
            <input
                type="hidden"
                id="recipientSelectionMode"
                name="recipient_selection_mode"
                value="all">

            <label>Message</label>

            <textarea id="newsletterEditor" name="message">

                <h2>Welcome!</h2>
                <p>Hello everyone,</p>
                <p>We are excited to share our latest updates.</p>
                <p>Thank you for being part of <%= (info?.company_name || 'JKT Hub').trim() %>.</p>

            </textarea>


            <label>When should this be sent?</label>

            <select
                name="status"
                id="newsletterStatus">

                <option value="draft">
                    Save as Draft
                </option>

                <option value="sending">
                    Send Immediately
                </option>

                <option value="scheduled">
                    Schedule
                </option>

            </select>

            <div
                id="scheduleBox"
                style="display:none;">

                <label>Schedule Date & Time</label>

                <input
                    type="datetime-local"
                    name="scheduled_at">

            </div>

            <button
                class="btn-pri"
                type="submit">

                <i class="fas fa-paper-plane"></i>

                Save Newsletter

            </button>

        </form>

    </div>

</div>

<!-- ===============================
AUDIENCE SELECTION MODAL
================================ -->

<div
    id="audienceModal"
    class="modal-overlay"
    style="display:none;">

    <div class="modal-content" style="max-width:850px;">

        <span
            class="close-btn"
            onclick="closeAudienceModal()">

            &times;

        </span>

        <h2 id="audienceTitle">
            Select Recipients
        </h2>

        <div class="audience-toolbar">

            <input
                type="text"
                id="audienceSearch"
                placeholder="Search users...">

            <button
                type="button"
                id="selectAllAudience"
                class="btn-pri">

                Select All

            </button>

            <button
                type="button"
                id="clearAudience"
                class="btn-danger">

                Clear

            </button>

        </div>

        <div
            id="audienceUserList"
            class="audience-user-list">

        </div>

        <div
            class="audience-footer">

            <span>

                Selected:
                <strong id="selectedAudienceCount">

                    0

                </strong>

            </span>

            <button
                type="button"
                id="saveAudienceSelection"
                class="btn-pri">

                Done

            </button>

        </div>

    </div>

</div>


<div
id="viewNewsletterModal"
class="modal-overlay"
style="display:none;">

<div
class="modal-content"
style="max-width:900px;">

<span
class="close-btn"
onclick="closeModal('viewNewsletterModal')">

&times;

</span>

<h2 id="viewSubject"></h2>

<div id="viewBody"></div>

</div>

</div>

