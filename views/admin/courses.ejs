<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

    <!-- Create Course Modal -->
    <div id="createModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>
        <h2>Create New Course</h2>
        <form action="/admin/courses" method="POST" enctype="multipart/form-data">
      <div class="container">
        <input
          type="text"
          name="title"
          placeholder="Course Title"
          required
        /><br />
      </div>
      <textarea
        name="description"
        id="content"
        placeholder="Description"
      ></textarea
      ><br />

      <div class="container">
        <select class="gender-details" name="level" required>
          <option value="">Select Level</option>
          <option value="Beginner">Beginner</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Advanced">Advanced</option></select
        ><br />
      </div>

      <div class="container">
        <select class="gender-details" name="career_pathway_id">
          <option value="">-- Career Pathway --</option>
          <% careerPathways.forEach(path => { %>
          <option value="<%= path.id %>"><%= path.title %></option>
          <% }) %></select
        ><br />
      </div>

      <input type="number" name="sort_order" placeholder="Sort Order" /><br />
      <input type="file" name="thumbnail" /><br />

            <input
              type="number"
              name="amount"
              step="0.01"
              placeholder="Amount in ₦"
            /><br />
      <button type="submit">Create Course</button>
    </form>
      </div>
    </div>

    <div class="container2">
        <button onclick="openModal()" class="btn-pri">
        + Create New Course
        </button>
    </div>

    <!-- <form method="GET" action="/admin/courses" style="margin-top: 20px">
      <input
        type="text"
        name="search"
        placeholder="Search by title..."
        value="<%= search || '' %>"
      />
      <button class="btn-sec" type="submit">Search</button>
    </form> -->
    <div style="margin-top:20px;">
      <input
        type="text"
        id="courseSearch"
        placeholder="Search courses..."
      />
    </div>

    <h2>Existing Courses</h2>

<div class="login-tabs">
  <button class="login-tab active" onclick="filterByPathway('All', this)">All Pathways</button>
  <% careerPathways.forEach(path => { %>
    <button class="login-tab" onclick="filterByPathway('<%= path.title %>', this)"><%= path.title %></button>
  <% }) %>
</div>

  <% for (let pathway in groupedCourses) { %>
  <div class="pathway-group" data-pathway="<%= pathway %>">
    <h2 style="margin-top: 2rem; color: goldenrod;"><%= pathway %></h2>

    <% for (let level in groupedCourses[pathway]) { %>
      <div class="course-level-section" data-level="<%= level %>">
        <h3 style="margin-top: 1rem; color: #444;"><%= level %> Level</h3>
        <div class="section">
          <section class="course-scroll-container">
            <% groupedCourses[pathway][level].forEach(course => { %>
              <div
                class="card-thumbnail hoverable scroll-card"
                data-title="<%= course.title.toLowerCase() %>"
                data-pathway="<%= pathway.toLowerCase() %>"
                data-level="<%= level.toLowerCase() %>"
                data-creator="<%= course.created_by.toLowerCase() %>"
              >
                <% if (course.thumbnail_url) { %>
                  <img src="<%= course.thumbnail_url %>" alt="Course Thumbnail"  />
                <% } %>

                <div class="card-content">
                  <h4><%= course.title %></h4>
                  <p style="color: rgb(143, 112, 9);"><strong> created by: </strong><%= course.created_by %></p>
                  <div class="card-body" id="desc-<%= course.id %>" data-full="<%- course.description.replace(/"/g, '&quot;') %>">
                    <%- course.description.substring(0, 100) %>...
                  </div>

                  <p><strong>Price: </strong> ₦ <%= course.amount %></p>
                  <p style="color: rgb(9, 31, 143);"><strong>Created on: </strong><%= course.created_at %></p>
                  <div class="article-buttons">
                    <button class="btn-edit" onclick="openEditModal(<%= course.id %>)">Edit</button>
                    <form action="/admin/courses/<%= course.id %>/regenerate-thumbnail" method="POST" style="display:inline;" onsubmit="return handleConfirmSubmit(event, 'Replace the current thumbnail with a new auto-generated one?')">
                      <input type="hidden" name="redirect_to" value="/admin/courses" />
                      <button type="submit">🖼️ Regenerate Thumbnail</button>
                    </form>
                    <form action="/admin/courses/delete/<%= course.id %>" method="POST" onsubmit="return handleConfirmSubmit(event, 'Delete this course?')">
                      <input type="hidden" name="redirect_to" value="/admin/courses" />
                      <button class="btn-delete" type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              </div>

              <!-- Edit Modal for this course -->
              <div id="editModal-<%= course.id %>" class="modal">
                <div class="modal-content">
                  <span class="close" onclick="closeEditModal(<%= course.id %>)">&times;</span>
                  <h2>Edit Course</h2>
                  <form action="/admin/courses/edit/<%= course.id %>" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="redirect_to" value="/admin/courses" />
                    <input type="text" name="title" value="<%= course.title %>" required /><br />
                    <!-- <textarea id="content" name="description"><%- course.description %></textarea><br /> -->
                    <textarea id="editContent-<%= course.id %>" name="description"><%- course.description %></textarea>

                    <select name="level" required>
                      <option value="">Select Level</option>
                      <option value="Beginner" <%= course.level === 'Beginner' ? 'selected' : '' %>>Beginner</option>
                      <option value="Intermediate" <%= course.level === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
                      <option value="Advanced" <%= course.level === 'Advanced' ? 'selected' : '' %>>Advanced</option>
                    </select><br /><br>

                    <select name="career_pathway_id" required>
                      <option value="">-- Career Pathway --</option>
                      <% careerPathways.forEach(path => { %>
                        <option value="<%= path.id %>" <%= path.id === course.career_pathway_id ? 'selected' : '' %>><%= path.title %></option>
                      <% }) %>
                    </select><br /><br>

                    <label for="">Sort Number</label>
                    <input type="number" name="sort_order" value="<%= course.sort_order %>" /><br />

                    <label for="">Thumbnail (optional — leave blank to keep the current one)</label>
                    <% if (course.thumbnail_url) { %>
                      <div>
                        <img src="<%= course.thumbnail_url %>" width="100" /><br />
                        <span style="font-size:12px; color:#666;">
                          <%= course.thumbnail_source === 'auto' ? 'Currently auto-generated' : (course.thumbnail_source === 'upload' ? 'Currently a custom upload' : '') %>
                        </span>
                      </div>
                    <% } %>
                    <input type="file" name="thumbnail" /><br />
                    <label style="font-weight:normal; font-size:13px;">
                      <input type="checkbox" name="regenerate_thumbnail" value="on">
                      Regenerate an auto thumbnail instead (replaces the current thumbnail above; ignored if you also choose a file to upload)
                    </label><br />
                    <div class="container" id="amountContainer">
                      <input
                        type="number"
                        name="amount"
                        step="0.01"
                        placeholder="Amount in ₦"
                        value="<%= course.amount || '' %>"
                      /><br />
                    </div>
                    
                    <button type="submit">Update Course</button>
                  </form>
                </div>
              </div>

            <% }) %>
          </section>
        </div>
      </div>
    <% } %>
  </div>
<% } %>




    <a href="/admin/dashboard">Back to Dashboard</a>


    <!-- script for ckeditor -->
    <script>
      CKEDITOR.replace("content");
    </script>

    

    <!-- script to toggle navigation menu -->
    <script>
        // Close nav when clicking outside of it
        document.addEventListener("click", function (event) {
          const nav = document.getElementById("main-nav");
          const toggleBtn = document.querySelector(".nav-toggle");

          if (
            nav.classList.toggle("open") &&
            !nav.contains(event.target) &&
            !toggleBtn.contains(event.target)
          ) {
            nav.classList.remove("open");
            }
      });
    </script>

    <!-- Script not to be able to copy content from article body -->
    <script>
      document.querySelectorAll(".article-body").forEach(function (el) {
        el.addEventListener("contextmenu", function (e) {
          e.preventDefault();
        });
        el.addEventListener("copy", function (e) {
          e.preventDefault();
        });
      });
    </script>

    <!-- script to preview image before upload -->
   <script>
      const imageInput =
      document.getElementById("imageInput");

    if(imageInput){

      imageInput.addEventListener("change", function () {

        const preview =
          document.getElementById("imagePreview");

        const file =
          this.files[0];

        if (file) {

          const reader =
            new FileReader();

          reader.onload = function (e) {

            preview.src =
              e.target.result;

            preview.style.display =
              "block";

          };

          reader.readAsDataURL(file);

        }

      });

    }
    </script>

<!-- Filter by Pathway script -->
  <script>
    function filterByPathway(pathway, btn) {
      const groups = document.querySelectorAll(".pathway-group");
      groups.forEach(group => {
        const groupName = group.getAttribute("data-pathway");
        if (pathway === "All" || groupName === pathway) {
          group.style.display = "block";
        } else {
          group.style.display = "none";
        }
      });
      document
          .querySelectorAll(".login-tab")
          .forEach(tab => tab.classList.remove("active"));

        btn.classList.add("active");
    }
  </script>

  <!-- Live Search Script -->
<script>
  document
    .getElementById("courseSearch")
    .addEventListener("input", function () {

      const keyword =
        this.value.toLowerCase().trim();

      const cards =
        document.querySelectorAll(".card-thumbnail");

      cards.forEach(card => {

        const title =
          card.dataset.title || "";

        const pathway =
          card.dataset.pathway || "";

        const level =
          card.dataset.level || "";

        const creator =
          card.dataset.creator || "";

        if (
          title.includes(keyword) ||
          pathway.includes(keyword) ||
          level.includes(keyword) ||
          creator.includes(keyword)
        ) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }

      });

      updateEmptyGroups();

    });
</script>

  <!-- Hide Empty pathway -->
   <script>
    function updateEmptyGroups(){
      document
        .querySelectorAll(".pathway-group")
        .forEach(group => {

          const visibleCards =
            group.querySelectorAll(
              '.card-thumbnail-card:not([style*="display: none"])'
            );

          if(visibleCards.length > 0){
            group.style.display = "block";
          }else{
            group.style.display = "none";
          }

        });

    }

  </script>

<!-- script for opening and closing the modal -->
    <script>
        function openModal() {
          document.getElementById("createModal").style.display = "block";
        }
      
        function closeModal() {
          document.getElementById("createModal").style.display = "none";
        }

        function openEditModal(id) {
          document.getElementById("editModal-" + id).style.display = "block";
        }

        function closeEditModal(id) {
          document.getElementById("editModal-" + id).style.display = "none";
        }
      
        // Close modal when clicking outside the modal content
        // window.onclick = function (event) {
        //   const modal = document.getElementById("createModal");
        //   if (event.target == modal) {
        //     modal.style.display = "none";
        //   }
        // };
        // Close any modal when clicking outside it
        window.onclick = function (event) {
            if (event.target.classList.contains("modal")) {
            event.target.style.display = "none";
            }
        };
      </script>

      <!-- script for ckeditor -->
      <script>
        <% for (let pathway in groupedCourses) { %>
          <% for (let level in groupedCourses[pathway]) { %>
            <% groupedCourses[pathway][level].forEach(course => { %>
              CKEDITOR.replace("editContent-<%= course.id %>");
            <% }) %>
          <% } %>
        <% } %>
      </script>
