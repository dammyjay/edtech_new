<%- include('../partials/adminHeader', { info: info, title: 'Student Enrollments', currentPage: 'students' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div style="display:flex; align-items:center; gap:14px;">
      <div class="jk-avatar" style="width:54px; height:54px; font-size:20px; background:#A17807;"><%= (student.fullname || '?').trim().charAt(0).toUpperCase() %></div>
      <div>
        <h2><%= student.fullname %></h2>
        <p><%= student.email %></p>
      </div>
    </div>
    <a class="jk-btn-outline" style="text-decoration:none;" href="/admin/students">⬅ Back to Students</a>
  </div>

  <div class="jk-stat-grid" style="grid-template-columns: minmax(0,260px);">
    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Enrolled Courses</span>
        <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-book" style="color:#A17807; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= courses.length %></span>
    </div>
  </div>

  <div class="jk-section-head">
    <h3>📚 Course Enrollments</h3>
  </div>

  <% if (courses.length === 0) { %>
    <div class="jk-report-panel" style="text-align:center; color:#8A7B55;">
      This student isn't directly enrolled in any course yet.
    </div>
  <% } else { %>
    <div class="jk-table-wrap">
      <table class="jk-table sortable-table">
        <thead>
          <tr>
            <th>Course</th>
            <th>Enrolled</th>
          </tr>
        </thead>
        <tbody>
          <% courses.forEach(function (c) { %>
            <tr>
              <td>
                <div class="jk-row-user">
                  <% if (c.thumbnail_url) { %><img src="<%= c.thumbnail_url %>" alt="" style="width:34px; height:34px; border-radius:8px; object-fit:cover; flex:0 0 auto;">
                  <% } %>
                  <p class="jk-row-name"><%= c.title %></p>
                </div>
              </td>
              <td><%= c.enrolled_at ? new Date(c.enrolled_at).toLocaleDateString() : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

</section>
