<%- include('../partials/adminHeader', { info: info, title: 'All Students', currentPage: 'students' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div>
      <h2>Students &amp; Parents</h2>
      <p><%= users.length %> student<%= users.length === 1 ? '' : 's' %> · <%= parents.length %> parent<%= parents.length === 1 ? '' : 's' %> on the platform</p>
    </div>
    <button class="jk-btn-dark" onclick="openAddUserModal()" type="button">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Add User
    </button>
  </div>

  <div class="jk-section-head">
    <h3>👩‍🎓 All Students</h3>
  </div>

  <div class="jk-table-wrap" style="margin-bottom:34px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Phone</th>
          <th>Gender</th>
          <th>Registered</th>
          <th class="jk-col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(student => { %>
          <tr>
            <td>
              <div class="jk-row-user">
                <img src="<%= student.profile_picture || '/profile.webp' %>" alt="" style="width:34px; height:34px; border-radius:50%; object-fit:cover; flex:0 0 auto;">
                <div>
                  <p class="jk-row-name"><%= student.fullname %></p>
                  <p class="jk-row-sub"><%= student.email %></p>
                </div>
              </div>
            </td>
            <td><%= student.phone || '—' %></td>
            <td><%= student.gender || '—' %></td>
            <td><%= new Date(student.created_at).toLocaleDateString() %></td>
            <td class="jk-col-actions">
              <button class="jk-icon-btn" title="View &amp; manage <%= student.fullname %>" onclick='openUserModal(<%- JSON.stringify(student) %>)' type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="width:16px; height:16px; flex-shrink:0; display:block;"><circle cx="5" cy="12" r="2.2"/><circle cx="12" cy="12" r="2.2"/><circle cx="19" cy="12" r="2.2"/></svg>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="jk-section-head">
    <h3>👨‍👩‍👧 All Parents</h3>
  </div>

  <div class="jk-table-wrap" style="margin-bottom:34px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Parent</th>
          <th>Phone</th>
          <th>Registered</th>
          <th class="jk-col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% parents.forEach(parent => { %>
          <tr>
            <td>
              <div class="jk-row-user">
                <img src="<%= parent.profile_picture || '/profile.webp' %>" alt="" style="width:34px; height:34px; border-radius:50%; object-fit:cover; flex:0 0 auto;">
                <div>
                  <p class="jk-row-name"><%= parent.fullname %></p>
                  <p class="jk-row-sub"><%= parent.email %></p>
                </div>
              </div>
            </td>
            <td><%= parent.phone || 'N/A' %></td>
            <td><%= new Date(parent.created_at).toLocaleDateString() %></td>
            <td class="jk-col-actions">
              <button class="jk-btn-outline-sm" onclick="openChildrenModal(<%= parent.id %>, '<%= parent.fullname %>')" type="button">View Children</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- CHILDREN MODAL -->
  <div id="childrenModal" class="jk-modal-overlay" hidden>
    <div class="jk-modal">
      <div class="jk-modal-head">
        <h4 id="childrenModalTitle">Parent Children</h4>
        <button class="jk-modal-close" onclick="closeChildrenModal()" type="button">&times;</button>
      </div>
      <div class="jk-modal-body">
        <div class="jk-table-wrap">
          <table class="jk-table sortable-table">
            <thead>
              <tr>
                <th>Student Name</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody id="childrenTableBody">
              <tr><td colspan="2">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Assign Child to Parent -->
  <div class="jk-section-head">
    <h3>👨‍👩‍👧 Assign Child to Parent</h3>
  </div>
  <div class="jk-report-panel">
    <form class="jk-toolbar" action="/admin/assign-child" method="POST" style="align-items:flex-start;">
      <div style="flex:1 1 240px; position:relative;">
        <label style="display:block; font-size:12.5px; font-weight:700; color:#4C3802; margin-bottom:5px;">Parent Email</label>
        <input type="text" name="parentEmail" id="parentEmail" autocomplete="off" required class="jk-search-input" style="padding-left:12px;">
        <div id="parentSuggestions" class="suggestions"></div>
      </div>

      <div style="flex:1 1 240px; position:relative;">
        <label style="display:block; font-size:12.5px; font-weight:700; color:#4C3802; margin-bottom:5px;">Child Email</label>
        <input type="text" name="childEmail" id="childEmail" autocomplete="off" required class="jk-search-input" style="padding-left:12px;">
        <div id="childSuggestions" class="suggestions"></div>
      </div>

      <button type="submit" class="jk-btn-dark" style="margin-top:22px;">Assign Child</button>
    </form>
  </div>

</section>

<div id="addUserModal" class="jk-modal-overlay" hidden>
  <div class="jk-modal">
    <div class="jk-modal-head">
      <h4>Add New User</h4>
      <button class="jk-modal-close" onclick="closeAddUserModal()" type="button">&times;</button>
    </div>
    <form class="jk-modal-body" method="POST" action="/admin/add-user">
      <input type="text" name="fullname" placeholder="Full Name" required />
      <input type="email" name="email" placeholder="Email" required />
      <input type="text" name="phone" placeholder="Phone" />

      <select name="gender" required>
        <option value="">Select Gender</option>
        <option>Male</option>
        <option>Female</option>
      </select>

      <select name="role" required>
        <option value="user">Normal User</option>
        <option value="student">School Student</option>
        <option value="teacher">Teacher</option>
        <option value="school_admin">School Administrator</option>
        <option value="parent">Parent</option>
        <option value="instructor">Instructor</option>
        <option value="admin">System Administrator</option>
      </select>

      <div id="schoolInfoSection" style="display:none;">
        <input name="schoolName" placeholder="School Name">
        <input name="schoolAddress" placeholder="School Address">
        <input name="schoolEmail" placeholder="School Email">
        <input name="schoolPhone" placeholder="School Phone">
      </div>

      <div id="schoolLookupSection" style="display:none;">
        <input id="schoolIdInput" name="schoolId" placeholder="Enter School ID" autocomplete="off">
        <div id="schoolResult"></div>
      </div>

      <p style="font-size:12px; color:#6E6350;">
        Default password: <strong>12345678</strong>
      </p>

      <button type="submit" class="jk-btn-dark" id="createUserBtn" style="width:100%; justify-content:center;">Create User</button>
    </form>
  </div>
</div>

<!-- User details modal (reuse your existing modal logic) -->
<div id="userModal" class="jk-modal-overlay" hidden>
  <div class="jk-modal">
    <div class="jk-modal-head">
      <div style="display:flex; align-items:center; gap:14px;">
        <img id="modalProfilePic" src="" alt="" style="width:54px; height:54px; border-radius:50%; object-fit:cover;">
        <div>
          <h4 id="modalFullName"></h4>
          <p id="modalEmail"></p>
        </div>
      </div>
      <button class="jk-modal-close" onclick="closeUserModal()" type="button">&times;</button>
    </div>
    <div class="jk-modal-body">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px 16px;">
        <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Phone</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalPhone"></p></div>
        <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Date of Birth</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalDOB"></p></div>
        <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Gender</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalGender"></p></div>
        <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Role</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalRole"></p></div>
        <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Date Registered</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalDate"></p></div>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <a id="modalProgressLink" class="jk-btn-outline" style="text-decoration:none; display:inline-flex; align-items:center;" href="#">View Progress</a>
        <a id="modalEnrollmentsLink" class="jk-btn-outline" style="text-decoration:none; display:inline-flex; align-items:center;" href="#">View Enrollments</a>
      </div>
    </div>
  </div>
</div>

<script>
  function openUserModal(user) {
    document.getElementById("modalFullName").textContent = user.fullname;
    document.getElementById("modalEmail").textContent = user.email;
    document.getElementById("modalPhone").textContent = user.phone;
    document.getElementById("modalDOB").textContent = user.dob || "N/A";
    document.getElementById("modalGender").textContent = user.gender;
    document.getElementById("modalRole").textContent = user.role;
    document.getElementById("modalProfilePic").src = user.profile_picture || "/profile.webp";
    document.getElementById("modalDate").textContent = new Date(user.created_at).toLocaleString();
    document.getElementById("modalProgressLink").href = `/admin/students/${user.id}/progress?from=admin`;
    document.getElementById("modalEnrollmentsLink").href = `/admin/students/${user.id}/enrollments`;
    document.getElementById("userModal").hidden = false;
  }

  function closeUserModal() {
    document.getElementById("userModal").hidden = true;
  }
</script>

<!-- Script to open add user modal -->
<script>
  function openAddUserModal() {
    document.getElementById("addUserModal").hidden = false;
  }

  function closeAddUserModal() {
    document.getElementById("addUserModal").hidden = true;
  }

  const roleSelect = document.querySelector('select[name="role"]');
  const schoolInfoSection = document.getElementById("schoolInfoSection");
  const schoolLookupSection = document.getElementById("schoolLookupSection");
  const schoolIdInput = document.getElementById("schoolIdInput");
  const schoolResult = document.getElementById("schoolResult");

  roleSelect.addEventListener("change", function () {
    const role = this.value;

    schoolInfoSection.style.display = "none";
    schoolLookupSection.style.display = "none";

    if (role === "school_admin") {
      schoolInfoSection.style.display = "block";
    }

    if (role === "teacher" || role === "student") {
      schoolLookupSection.style.display = "block";
    }
  });

  schoolIdInput.addEventListener("keyup", async () => {
    const schoolId = schoolIdInput.value.trim();

    if (schoolId.length < 3) {
      schoolResult.innerHTML = "";
      return;
    }

    const res = await fetch(`/admin/check-school/${schoolId}`);
    const data = await res.json();
    const submitBtn = document.getElementById("createUserBtn");

    if (data.found) {
      schoolResult.innerHTML = `<span style="color:green;">✔ ${data.school.name}</span>`;
      submitBtn.disabled = false;
    } else {
      schoolResult.innerHTML = `<span style="color:red;">School not found</span>`;
      submitBtn.disabled = true;
    }
  });
</script>

<!-- script for autocomplete -->
<script>
  async function setupAutocomplete(inputId, suggestionId, role) {
    const input = document.getElementById(inputId);
    const suggestions = document.getElementById(suggestionId);

    input.addEventListener("input", async () => {
      const q = input.value.trim();

      if (!q) {
        suggestions.innerHTML = "";
        return;
      }

      const res = await fetch(`/admin/search-users?q=${encodeURIComponent(q)}&role=${role}`);
      const users = await res.json();

      suggestions.innerHTML = users.map(user => `
        <div class="suggestion-item" onclick="selectSuggestion('${inputId}', '${suggestionId}', '${user.email}')">
          <strong>${user.fullname}</strong><br>
          <small>${user.email}</small>
        </div>
      `).join("");
    });
  }

  function selectSuggestion(inputId, suggestionId, value) {
    document.getElementById(inputId).value = value;
    document.getElementById(suggestionId).innerHTML = "";
  }

  setupAutocomplete("parentEmail", "parentSuggestions", "parent");
  setupAutocomplete("childEmail", "childSuggestions", "user");
</script>

<script>
  async function openChildrenModal(parentId, parentName) {
    document.getElementById("childrenModal").hidden = false;
    document.getElementById("childrenModalTitle").innerText = `${parentName}'s Children`;

    document.getElementById("childrenTableBody").innerHTML = `
      <tr><td colspan="2">Loading...</td></tr>
    `;

    try {
      const res = await fetch(`/admin/parents/${parentId}/children-json`);
      const children = await res.json();

      if (!children.length) {
        document.getElementById("childrenTableBody").innerHTML = `
          <tr><td colspan="2">No children assigned</td></tr>
        `;
        return;
      }

      document.getElementById("childrenTableBody").innerHTML = children.map(child => `
        <tr>
          <td>${child.fullname}</td>
          <td>${child.email}</td>
        </tr>
      `).join("");
    } catch (err) {
      console.error(err);
      document.getElementById("childrenTableBody").innerHTML = `
        <tr><td colspan="2">Error loading children</td></tr>
      `;
    }
  }

  function closeChildrenModal() {
    document.getElementById("childrenModal").hidden = true;
  }
</script>
