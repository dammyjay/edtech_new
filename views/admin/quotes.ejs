    <thead>
      <tr>
        <th>School</th>
        <th>Term</th>
        <th>Students</th>
        <th>Price / Student</th>
        <th>Total Amount</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% quotes.forEach(q => { %>
        <tr>
          <td><%= q.school_name %></td>
          <td><%= q.term_name %></td>
          <td><%= q.total_students %></td>
          <td>₦<%= q.price_per_student %></td>
          <td>₦<%= q.total_amount %></td>
          <td>
            <form action="/admin/quotes/<%= q.id %>/status" method="POST">
              <select name="status" onchange="this.form.submit()">
                <option value="unpaid" <%= q.status === 'unpaid' ? 'selected' : '' %>>❌ Not Paid</option>
                <option value="paid" <%= q.status === 'paid' ? 'selected' : '' %>>✅ Paid</option>
              </select>
            </form>
          </td>
          <td>
            <a href="/admin/quotes/<%= q.id %>/download">📄 PDF</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
