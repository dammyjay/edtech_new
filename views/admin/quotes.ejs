<script>
  const trend = <%- JSON.stringify(trend || []) %>;

  const labels = trend.map(t => t.day);
  const data = trend.map(t => Number(t.total || 0));

  const ctx = document.getElementById("paymentChart");

  if (ctx) {
    new Chart(ctx, {
      type: "line",
      data: {
        labels,
        datasets: [{
          label: "Payments",
          data,
          tension: 0.3,
          fill: true
        }]
      }
    });
  }
</script>

<!-- Analytics script -->
<script>
  const summary = <%- JSON.stringify(summary || {}) %>;

  const totalExpected = Number(summary.total_expected || 0);
  const totalPaid = Number(summary.total_paid || 0);
  const outstanding = Number(summary.outstanding || 0);

  const rate = totalExpected > 0 
    ? ((totalPaid / totalExpected) * 100).toFixed(1)
    : 0;

  // Fill cards
  document.getElementById("cardTotalExpected").innerText = "₦" + totalExpected.toLocaleString();
  document.getElementById("cardTotalPaid").innerText = "₦" + totalPaid.toLocaleString();
  document.getElementById("cardOutstanding").innerText = "₦" + outstanding.toLocaleString();
  document.getElementById("cardCollectionRate").innerText = rate + "%";

  document.getElementById("cardPaidQuotes").innerText = summary.paid_quotes || 0;
  document.getElementById("cardPartialQuotes").innerText = summary.partial_quotes || 0;
  document.getElementById("cardUnpaidQuotes").innerText = summary.unpaid_quotes || 0;
</script>

<!-- Payment modal script -->
<script>

  function openPaymentModal(quoteId, schoolId) {
    document.getElementById('modalQuoteId').value = quoteId;
    document.getElementById('modalSchoolId').value = schoolId;

    document.getElementById('quoteInfo').innerText =
      "Adding payment for Quote #" + quoteId;

    document.getElementById('paymentModal').style.display = 'flex';
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  // optional: close when clicking outside
  window.onclick = function(e) {
    const modal = document.getElementById('paymentModal');
    if (e.target === modal) {
      modal.style.display = 'none';
    }
  }
</script>

<script>
  async function togglePayment(id, currentStatus) {
  const newStatus = currentStatus === 'paid' ? 'unpaid' : 'paid';

  const res = await fetch(`/admin/quotes/${id}/status`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: newStatus })
  });

  if (res.ok) location.reload();
}
</script>

<!-- Script Filter by status -->
 <script>
  document.getElementById("statusFilter").addEventListener("change", function () {
    const value = this.value;
    const rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {
      const status = row.querySelector(".payment-toggle").className;

      if (!value || status.includes(value)) {
        row.style.display = "";
      } else {
        row.style.display = "none";
      }
    });
  });
</script>

<!-- Search script -->
 <script>
  document.getElementById("searchInput").addEventListener("keyup", function () {
    const value = this.value.toLowerCase();
    const rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(value) ? "" : "none";
    });
  });
</script>

<!-- Script for sorting table -->
 <script>
    function sortTable(colIndex) {
      const table = document.querySelector("table tbody");
      const rows = Array.from(table.rows);

      const asc = table.classList.toggle("asc");

      rows.sort((a, b) => {
        let A = a.cells[colIndex].innerText.replace(/[₦,]/g, "");
        let B = b.cells[colIndex].innerText.replace(/[₦,]/g, "");

        A = isNaN(A) ? A : Number(A);
        B = isNaN(B) ? B : Number(B);

        return asc ? (A > B ? 1 : -1) : (A < B ? 1 : -1);
      });

      rows.forEach(row => table.appendChild(row));
    }
</script>


