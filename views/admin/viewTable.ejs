document.getElementById("createForm").addEventListener("submit", async function(e) {
  e.preventDefault();

  const formData = new FormData(this);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch("/admin/db/<%= table %>", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      closeCreateModal();
      loadTable();
    } else {
      const error = await res.text();
      showAlert("Create failed: " + error);
    }

  } catch (err) {
    console.error(err);
    showAlert("Network error");
  }
});

const searchInput = document.getElementById("liveSearch");

if (searchInput) {

  let timeout;

  searchInput.addEventListener("input", function() {
    clearTimeout(timeout);

    timeout = setTimeout(() => {
      const value = this.value.trim();

      if (value === "") {
        loadTable();
        return;
      }

      // fetch(`/admin/db/<%= table %>/data?search=${value}`)
      fetch(`/admin/db/<%= table %>/data?search=${encodeURIComponent(value)}`)
        .then(res => res.json())
        .then(data => {
          renderTable(data);
        });

    }, 300);
  });

}

function loadTable() {
  fetch(`/admin/db/<%= table %>/data`)
    .then(res => res.json())
    .then(data => {
      renderTable(data);
    });
}

function renderTable(rows) {
  const tbody = document.querySelector(".user-table tbody");
  tbody.innerHTML = "";

  rows.forEach(row => {
    let tr = document.createElement("tr");

    // Data columns
    Object.entries(row).forEach(([key, val]) => {
      let td = document.createElement("td");

      if (typeof val === "object" && val !== null) {
        td.innerHTML = `<pre style="max-height:100px; overflow:auto;">
${JSON.stringify(val, null, 2)}
</pre>`;
      } 
      else if (typeof val === "string" && val.length > 10) {
        td.textContent = val.substring(0, 10) + "...";
      } 
      // else {
      //   td.textContent = val ?? "";
      // }

      else {

        if (row[key + "_name"]) {
          td.innerHTML = `${val} — <strong>${row[key + "_name"]}</strong>`;
        } else {
          td.textContent = val ?? "";
        }

      }

      tr.appendChild(td);
    });

    // ✅ ACTION COLUMN
    let actionTd = document.createElement("td");
    actionTd.style.display = "flex";
    actionTd.style.gap = "10px";
    actionTd.style.justifyContent = "center";
    actionTd.style.alignItems = "center";

    actionTd.innerHTML = `
      <a href="#" class="no-bg" onclick='openRowModal(${JSON.stringify(row)}); return false;'>
        <i class="fa-regular fa-eye" style="color:#0000ff;"></i>
      </a>
      <a href="#" class="no-bg" onclick='openEditModal(${JSON.stringify(row)}); return false;'>
        <i class="fa-regular fa-pen-to-square" style="color:rgb(1,156,61);"></i>
      </a>
      ${row.id ? `
      <a href="#" class="no-bg" onclick="confirmDelete('${row.id}'); return false;">
        <i class="fa-regular fa-trash-can" style="color:rgb(252,21,5);"></i>
      </a>
      ` : ''}
    `;

    tr.appendChild(actionTd);

    tbody.appendChild(tr);
  });
}

</script>