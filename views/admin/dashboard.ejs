    <!-- script for delete user -->
    <script>
      async function confirmDelete(userId) {
        if (!(await showConfirm("Archive this user? Their account will be hidden and they won't be able to log in, but nothing is deleted — restore it later from the Archive screen."))) return;

        fetch(`/admin/users/delete/${userId}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            // add CSRF token here if you use one
          },
          body: JSON.stringify({ id: userId }), // optional, since id is in URL
        })
          .then((res) => {
            if (res.ok) {
              showAlert("User deleted successfully").then(() => {
                location.reload(); // reload page to refresh user list
              });
            } else {
              showAlert("Failed to delete user");
            }
          })
          .catch((err) => {
            console.error(err);
            showAlert("Error deleting user");
          });
      }
    </script>

    <script>
      function openUserModal(user) {
        document.getElementById("modalFullName").textContent = user.fullname;
        document.getElementById("modalEmail").textContent = user.email;
