<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<div class="jk-header-card">
  <div>
    <h2>Admin Dashboard</h2>
    <p>Platform-wide overview, business KPIs, learning, schools, finance, engagement and reports.</p>
  </div>
</div>

<div class="login-tabs">

  <button
    class="login-tab active"
    onclick="openDashboardTab('overview-section', this)"
  >
    📊 Overview
  </button>

  <button
    class="login-tab"
    onclick="openDashboardTab('business-section', this)"
  >
    💼 Business KPIs
  </button>

  <button
    class="login-tab"
    onclick="openDashboardTab('learning-section', this)"
  >
    📘 Learning
  </button>

  <button
    class="login-tab"
    onclick="openDashboardTab('schools-section', this)"
  >
    🏫 Schools
  </button>

  <button
    class="login-tab"
    onclick="openDashboardTab('finance-section', this)"
  >
    💰 Finance
  </button>

  <button
    class="login-tab"
    onclick="openDashboardTab('engagement-section', this)"
  >
    📈 Engagement
  </button>

  <button
    class="login-tab"
    onclick="openDashboardTab('reports-section', this)"
  >
    📑 Reports & Pitch Decks
  </button>

</div>

<div id="overview-section" class="jk-page">
    <div class="jk-section-head">
      <h3>All Registered Users</h3>
    </div>

    <div class="jk-stat-grid">

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Total Users</span>
          <div class="jk-stat-icon" style="background:#E9F3FB;"><i class="fas fa-user" style="color:#1F7AC9; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value"><%= totalUsers %></span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">New This Week</span>
          <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-user-plus" style="color:#1E7A42; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value"><%= recentUsers %></span>
        <span class="jk-stat-sub"><%= percentageNew %>% of total</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Total Courses</span>
          <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-book" style="color:#1E7A42; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value" id="totalCourses">0</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Total Schools</span>
          <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-school" style="color:#A17807; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value" id="totalSchools">0</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Enrollments</span>
          <div class="jk-stat-icon" style="background:#F1EAFB;"><i class="fas fa-user-graduate" style="color:#7C4DCC; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value" id="totalEnrollments">0</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Certificates</span>
          <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fas fa-award" style="color:#C9598A; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value" id="certificatesIssued">0</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Total Revenue</span>
          <div class="jk-stat-icon" style="background:#E6F7F4;"><i class="fas fa-money-bill-wave" style="color:#1B8E79; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value" id="totalRevenue">₦0</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Avg Quiz Score</span>
          <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fas fa-chart-line" style="color:#B23A2A; font-size:13px;"></i></div>
        </div>
        <span class="jk-stat-value" id="avgQuiz">0%</span>
      </div>

    </div>

    <form class="jk-toolbar" id="filterForm">
      <div class="jk-search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9A8C66" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" name="email" class="jk-search-input" placeholder="Search by email" value="<%= email || '' %>" />
      </div>

      <select name="gender" class="jk-select">
        <option value="">All Genders</option>
        <option value="Male" <%= gender === 'Male' ? 'selected' : '' %>>Male</option>
        <option value="Female" <%= gender === 'Female' ? 'selected' : '' %>>Female</option>
      </select>

      <select name="role" class="jk-select">
        <option value="All">All Roles</option>
        <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
        <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
        <option value="instructor" <%= role === 'instructor' ? 'selected' : '' %>>Instructor</option>
        <option value="teacher" <%= role === 'teacher' ? 'selected' : '' %>>Teacher</option>
        <option value="student" <%= role === 'student' ? 'selected' : '' %>>Student</option>
        <option value="school_admin" <%= role === 'school_admin' ? 'selected' : '' %>>School Admin</option>
        <option value="parent" <%= role === 'parent' ? 'selected' : '' %>>Parent</option>
      </select>

      <div class="jk-toolbar-spacer"></div>
      <button type="submit" class="jk-btn-dark">Filter</button>
    </form>

    <div class="jk-table-wrap">
      <table class="jk-table sortable-table" id="allUsersTable">
        <thead>
          <tr>
            <th>User</th>
            <th>Phone</th>
            <th>Gender</th>
            <th>Role</th>
            <th>Wallet</th>
            <th class="jk-col-actions"></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
          <tr>
            <td>
              <div class="jk-row-user">
                <img src="<%= user.profile_picture || '/profile.webp' %>" alt="" style="width:34px; height:34px; border-radius:50%; object-fit:cover; flex:0 0 auto;">
                <div>
                  <p class="jk-row-name"><%= user.fullname %></p>
                  <p class="jk-row-sub"><%= user.email %></p>
                </div>
              </div>
            </td>
            <td><%= user.phone %></td>
            <td><%= user.gender %></td>
            <td><span class="jk-pill jk-pill--off" style="text-transform:capitalize;"><%= user.role %></span></td>
            <td>₦<%= user.wallet_balance2 %></td>
            <td class="jk-col-actions">
              <button class="jk-icon-btn" title="View &amp; manage <%= user.fullname %>" onclick='openUserModal(<%- JSON.stringify(user) %>)' type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="width:16px; height:16px; flex-shrink:0; display:block;"><circle cx="5" cy="12" r="2.2"/><circle cx="12" cy="12" r="2.2"/><circle cx="19" cy="12" r="2.2"/></svg>
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- modal to view user  -->
    <div id="userModal" class="jk-modal-overlay" hidden>
      <div class="jk-modal">
        <div class="jk-modal-head">
          <div style="display:flex; align-items:center; gap:14px;">
            <img id="modalProfilePic" src="" alt="" style="width:54px; height:54px; border-radius:50%; object-fit:cover;">
            <div>
              <h4 id="modalFullName"></h4>
              <p id="modalEmail"></p>
            </div>
          </div>
          <button class="jk-modal-close" onclick="closeUserModal()" type="button">&times;</button>
        </div>
        <div class="jk-modal-body">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px 16px;">
            <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Phone</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalPhone"></p></div>
            <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Date of Birth</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalDOB"></p></div>
            <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Gender</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalGender"></p></div>
            <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Role</p><p style="margin:0; font-size:13px; color:#1A1510; text-transform:capitalize;" id="modalRole"></p></div>
            <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Wallet Balance</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalWalletBalance"></p></div>
            <div><p style="margin:0 0 2px; font-size:10.5px; font-weight:700; color:#8A7B55; text-transform:uppercase;">Date Registered</p><p style="margin:0; font-size:13px; color:#1A1510;" id="modalDate"></p></div>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <a id="modalEditBtn" class="jk-btn-outline" style="text-decoration:none; display:inline-flex; align-items:center;" href="#">Edit</a>
            <button id="modalArchiveBtn" class="jk-btn-outline-sm" style="color:#B23A2A; border-color:#F3D4CE;" type="button">Archive</button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div id="business-section" class="jk-page" style="display:none;">
  <div class="jk-section-head">
    <h3>Business KPIs</h3>
  </div>

  <div class="jk-toolbar">
    <select id="businessPeriod" class="jk-select">
        <option value="all">All Time</option>
        <option value="year">Year</option>
        <option value="month">Month</option>
    </select>

    <select id="businessYear" class="jk-select">
    </select>

    <select id="businessMonth" class="jk-select">
        <option value="">All Months</option>
        <option value="1">January</option>
        <option value="2">February</option>
        <option value="3">March</option>
        <option value="4">April</option>
        <option value="5">May</option>
        <option value="6">June</option>
        <option value="7">July</option>
        <option value="8">August</option>
        <option value="9">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
    </select>

    <div class="jk-toolbar-spacer"></div>
    <button class="jk-btn-dark" onclick="loadBusinessDashboard()" type="button">Apply Filter</button>
  </div>

  <div class="jk-stat-grid">

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Revenue</span>
        <div class="jk-stat-icon" style="background:#E6F7F4;"><i class="fas fa-money-bill-wave" style="color:#1B8E79; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="businessRevenue">₦0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Revenue Selected Period</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-calendar-check" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="monthlyRevenue">₦0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Schools Fully Paid</span>
        <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-school" style="color:#A17807; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="paidSchools">0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Terms Paid</span>
        <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-calendar-days" style="color:#A17807; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="paidTermsCount">0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Outstanding Balances</span>
        <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fas fa-triangle-exclamation" style="color:#B23A2A; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="outstandingBalance">₦0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">School Revenue</span>
        <div class="jk-stat-icon" style="background:#E9F3FB;"><i class="fas fa-school" style="color:#1F7AC9; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="schoolRevenue">₦0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Parent Revenue</span>
        <div class="jk-stat-icon" style="background:#F1EAFB;"><i class="fas fa-user-group" style="color:#7C4DCC; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="parentRevenue">₦0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Event Revenue</span>
        <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fas fa-ticket" style="color:#C9598A; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="eventRevenue">₦0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Event Registrations</span>
        <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fas fa-users" style="color:#C9598A; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="eventRegistrations">0</span>
    </div>
  </div>

  <div class="jk-section-head" style="margin-top:28px;"><h3>School Payments</h3></div>
  <div class="jk-table-wrap" style="margin-bottom:26px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>School</th>
          <th>Amount Paid</th>
          <th>Balance</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody id="schoolPaymentsTable"></tbody>
    </table>
  </div>

  <div class="jk-section-head"><h3>Parent Payments</h3></div>
  <div class="jk-table-wrap" style="margin-bottom:26px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Parent Name</th>
          <th>Email</th>
          <th>Training</th>
          <th>Students</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Payment Date</th>
        </tr>
      </thead>
      <tbody id="parentPaymentsTable"></tbody>
    </table>
  </div>

  <div class="jk-section-head"><h3>Event Payments</h3></div>
  <div class="jk-table-wrap" style="margin-bottom:26px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Event</th>
          <th>Registrant Name</th>
          <th>Registrant Email</th>
          <th>Amount Paid</th>
          <th>Payment Status</th>
          <th>Registration Date</th>
        </tr>
      </thead>
      <tbody id="eventPaymentsTable"></tbody>
    </table>
  </div>

  <div class="jk-section-head"><h3>Income Sources</h3></div>
  <div class="jk-table-wrap" style="margin-bottom:26px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Income Source</th>
          <th>Total Received</th>
        </tr>
      </thead>
      <tbody id="incomeBreakdownTable"></tbody>
    </table>
  </div>

</div>

<div id="learning-section" class="jk-page" style="display:none;">
  <div class="jk-section-head">
    <h3>Learning Analytics</h3>
  </div>

  <div class="jk-stat-grid">

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Courses</span>
        <div class="jk-stat-icon" style="background:#E9F3FB;"><i class="fas fa-book" style="color:#1F7AC9; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="learningCourses">0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Modules</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-layer-group" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="learningModules">0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Lessons</span>
        <div class="jk-stat-icon" style="background:#FBF3DD;"><i class="fas fa-chalkboard" style="color:#A17807; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="learningLessons">0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Course Completion Rate</span>
        <div class="jk-stat-icon" style="background:#F1EAFB;"><i class="fas fa-chart-pie" style="color:#7C4DCC; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="completionRate">0%</span>
    </div>

  </div>

  <div class="jk-section-head"><h3>Top Courses</h3></div>
  <div class="jk-table-wrap">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Schools</th>
          <th>Direct Enrollments</th>
          <th>School Learners</th>
          <th>Total Learners</th>
          <th>Modules</th>
          <th>Module Completion</th>
          <th>Lessons</th>
          <th>Lesson Completion</th>
          <th>Certificates</th>
          <th class="jk-col-actions"></th>
        </tr>
      </thead>
      <tbody id="topCoursesTable"></tbody>
    </table>
  </div>

  <div id="courseAnalyticsModal" class="jk-modal-overlay" hidden>
    <div class="jk-modal jk-modal--wide">
      <div class="jk-modal-head">
        <div>
          <h4 id="analyticsCourseTitle">Course Analytics</h4>
        </div>
        <button class="jk-modal-close" onclick="closeCourseAnalytics()" type="button">&times;</button>
      </div>
      <div class="jk-modal-body">

        <div class="jk-stat-grid" style="grid-template-columns: repeat(4, minmax(0,1fr));">

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Students Enrolled</span></div>
            <span class="jk-stat-value" id="analyticsEnrollments">0</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Schools Using Course</span></div>
            <span class="jk-stat-value" id="analyticsSchools">0</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Total Learners</span></div>
            <span class="jk-stat-value" id="analyticsLearners">0</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Modules</span></div>
            <span class="jk-stat-value" id="analyticsModules">0</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Lessons</span></div>
            <span class="jk-stat-value" id="analyticsLessons">0</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Completion Rate</span></div>
            <span class="jk-stat-value" id="analyticsCompletion">0%</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Average Quiz Score</span></div>
            <span class="jk-stat-value" id="analyticsQuiz">0%</span>
          </div>

          <div class="jk-stat-card">
            <div class="jk-stat-head"><span class="jk-stat-label">Certificates Issued</span></div>
            <span class="jk-stat-value" id="analyticsCertificates">0</span>
          </div>

        </div>

        <details open>
          <summary>Top Performing Students</summary>
          <div class="jk-table-wrap">
            <table class="jk-table sortable-table">
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Average Score</th>
                </tr>
              </thead>
              <tbody id="topStudentsTable"></tbody>
            </table>
          </div>
        </details>

        <details open>
          <summary>Students Needing Support</summary>
          <div class="jk-table-wrap">
            <table class="jk-table sortable-table">
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Average Score</th>
                </tr>
              </thead>
              <tbody id="bottomStudentsTable"></tbody>
            </table>
          </div>
        </details>
      </div>
    </div>
  </div>

</div>

<div id="schools-section" class="jk-page" style="display:none;">
  <div class="jk-section-head">
    <h3>Schools Dashboard</h3>
  </div>

  <div class="jk-stat-grid" style="grid-template-columns: repeat(4, minmax(0,1fr));">

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Schools</span>
        <div class="jk-stat-icon" style="background:#E9F3FB;"><i class="fas fa-school" style="color:#1F7AC9; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="schoolCount">0</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Students</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fas fa-user-graduate" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value" id="schoolStudents">0</span>
    </div>

