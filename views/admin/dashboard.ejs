    <!-- script for delete user -->
    <script>
      function confirmDelete(userId) {
        if (!confirm("Delete this user?")) return;

        fetch(`/admin/users/delete/${userId}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            // add CSRF token here if you use one
          },
          body: JSON.stringify({ id: userId }), // optional, since id is in URL
        })
          .then((res) => {
            if (res.ok) {
              alert("User deleted successfully");
              location.reload(); // reload page to refresh user list
            } else {
              alert("Failed to delete user");
            }
          })
          .catch((err) => {
            console.error(err);
            alert("Error deleting user");
          });
      }
    </script>

    <script>
      function openUserModal(user) {
        document.getElementById("modalFullName").textContent = user.fullname;
        document.getElementById("modalEmail").textContent = user.email;
        document.getElementById("modalPhone").textContent = user.phone;
        document.getElementById("modalDOB").textContent = user.dob || 'N/A'; // Assuming dob is optional
        document.getElementById("modalGender").textContent = user.gender;
        document.getElementById("modalRole").textContent = user.role;
        document.getElementById("modalWalletBalance").textContent = `₦${user.wallet_balance2}`;
        document.getElementById("modalProfilePic").src = user.profile_picture || "/profile.webp";
        document.getElementById("modalDate").textContent = user.created_at;

        document.getElementById("userModal").style.display = "block";
      }

      function closeUserModal() {
        document.getElementById("userModal").style.display = "none";
      }
    </script>

    <script>
      const form = document.getElementById("filterForm");
      const tbody = document.querySelector(".user-table tbody");

      let typingTimer;

      // Listen to typing and select changes
      form.addEventListener("input", () => {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(fetchUsers, 300); // debounce typing
      });

      function fetchUsers() {
        const gender = form.gender.value;
        const role = form.role.value;
        const email = form.email.value;

        const params = new URLSearchParams({ gender, role, email });

        fetch(`/admin/users/filter?${params.toString()}`)
          .then(res => res.json())
          .then(users => {
            tbody.innerHTML = "";

            if (users.length === 0) {
              tbody.innerHTML = `
                <tr>
                  <td colspan="8" style="text-align:center;">No users found</td>
                </tr>`;
              return;
            }

            users.forEach(user => {
              tbody.innerHTML += `
                <tr>
                  <td>${user.id}</td>
                  <td>
                    <img src="${user.profile_picture || '/profile.webp'}"
                      style="width:50px;height:50px;border-radius:50%;object-fit:cover;">
                  </td>
                  
                  <td>${user.fullname}</td>
                  <td>${user.email}</td>
                  <td>${user.phone || ''}</td>
                  <td>${user.gender || ''}</td>
                  <td>${user.role}</td>
                  <td>₦${user.wallet_balance2}</td>
                  <td style="display:flex;gap:10px;justify-content:center;">
                    <button class="btn-edit" onclick='openUserModal(${JSON.stringify(user)})'>👁️</button>
                    <button class="btn-edit" onclick="location.href='/admin/users/edit/${user.id}'">Edit</button>
                  </td>
                </tr>
              `;
            });
          });
      }
    </script>

    <script>
      let currentActivityPage = 1;
      const activityLimit = 50;
      async function loadDashboardOverview(){

          const res = await fetch('/admin/dashboard/overview');
          const data = await res.json();
          console.log("Overview Data:", data);

          document.getElementById('totalUsers').innerText =
            data.totalUsers.toLocaleString();

          document.getElementById('totalCourses').innerText =
            data.totalCourses.toLocaleString();

          document.getElementById('totalSchools').innerText =
            data.totalSchools.toLocaleString();

          document.getElementById('totalEnrollments').innerText =
            data.totalEnrollments.toLocaleString();

          document.getElementById('certificatesIssued').innerText =
            data.certificatesIssued.toLocaleString();

          document.getElementById('totalRevenue').innerText =
            '₦' + Number(data.revenue).toLocaleString();

          document.getElementById('avgQuiz').innerText =
            data.avgQuizScore + '%';
      }

      async function loadBusinessDashboard() {

        try {

          const res = await fetch('/admin/dashboard/business');
          const data = await res.json();

          console.log("Business Data:", data);

          document.getElementById('businessRevenue').innerText =
            '₦' + Number(data.totalRevenue || 0).toLocaleString();

          document.getElementById('monthlyRevenue').innerText =
            '₦' + Number(data.monthlyRevenue || 0).toLocaleString();

          document.getElementById('paidSchools').innerText =
            Number(data.paidSchools || 0).toLocaleString();

          document.getElementById('outstandingBalance').innerText =
            '₦' + Number(data.outstandingBalance || 0).toLocaleString();

          const tbody = document.getElementById('schoolPaymentsTable');
          tbody.innerHTML = '';

          (data.schools || []).forEach(school => {

            tbody.innerHTML += `
              <tr>
                <td>${school.school_name}</td>
                <td>₦${Number(school.total_paid || 0).toLocaleString()}</td>
                <td>₦${Number(school.balance || 0).toLocaleString()}</td>
                <td>
                  ${Number(school.balance) <= 0
                    ? 'Paid'
                    : 'Outstanding'}
                </td>
              </tr>
            `;
          });

        } catch(err) {
          console.error('Business dashboard error:', err);
        }
      }

      async function loadLearningDashboard() {

        try {

          const res = await fetch('/admin/dashboard/learning');
          const data = await res.json();
          console.log("Learning Data:", data);

          document.getElementById('learningCourses').innerText =
            Number(data.totalCourses || 0).toLocaleString();

          document.getElementById('learningModules').innerText =
            Number(data.totalModules || 0).toLocaleString();

          document.getElementById('learningLessons').innerText =
            Number(data.totalLessons || 0).toLocaleString();

          document.getElementById('completionRate').innerText =
            `${data.completionRate || 0}%`;

          const tbody = document.getElementById('topCoursesTable');
          tbody.innerHTML = '';

          (data.courses || []).forEach(course => {

            tbody.innerHTML += `
              <tr>

                <td>${course.title}</td>

                <td>${course.schools}</td>

                <td>${course.enrollments}</td>
                <td>${course.school_learners}</td>
                <td>${course.totalLearners}</td>

                <td>${course.modules}</td>

                <td>${course.moduleCompletion}%</td>

                <td>${course.lessons}</td>

                <td>${course.lesson_completions}</td>

                <td>${course.certificates}</td>

                <td>
                  <button
                    onclick="openCourseAnalytics(${course.id})"
                    class="btn-edit">
                    View Analytics
                  </button>
                </td>

              </tr>
            `;
          });

        } catch(err) {
          console.error('Learning dashboard error:', err);
        }
      }

      async function loadSchoolsDashboard() {

        try {

          const res = await fetch('/admin/dashboard/schools');
          const data = await res.json();

          console.log("School Data:", data);

          document.getElementById('schoolCount').innerText =
            Number(data.totalSchools || 0).toLocaleString();

          document.getElementById('schoolStudents').innerText =
            Number(data.totalStudents || 0).toLocaleString();

          document.getElementById('schoolTeachers').innerText =
            Number(data.totalTeachers || 0).toLocaleString();

          document.getElementById('schoolClassrooms').innerText =
            Number(data.totalClassrooms || 0).toLocaleString();

          const tbody = document.getElementById('schoolsTable');
          tbody.innerHTML = '';

          (data.schools || []).forEach(school => {

            tbody.innerHTML += `
              <tr>
                <td>${school.name}</td>
                <td>${school.students}</td>
                <td>${school.teachers}</td>
                <td>${school.courses}</td>
                <td>
                  ${school.last_activity
                    ? new Date(school.last_activity).toLocaleDateString()
                    : '-'}
                </td>
              </tr>
            `;
          });

        } catch(err) {
          console.error('Schools dashboard error:', err);
        }
      }

      async function loadFinanceDashboard() {

        try {

          const res = await fetch('/admin/dashboard/finance');
          const data = await res.json();

          console.log("Finance Data:", data);

          document.getElementById('financeRevenue').innerText =
            '₦' + Number(data.revenue || 0).toLocaleString();

          document.getElementById('financeTransactions').innerText =
            Number(data.totalTransactions || 0).toLocaleString();

          document.getElementById('failedTransactions').innerText =
            Number(data.failedTransactions || 0).toLocaleString();

          const tbody = document.getElementById('transactionsTable');
          tbody.innerHTML = '';

          (data.transactions || []).forEach(tx => {

            tbody.innerHTML += `
              <tr>
                <td>${new Date(tx.created_at).toLocaleDateString()}</td>
                <td>${tx.user_name || tx.email || '-'}</td>
                <td>₦${Number(tx.amount || 0).toLocaleString()}</td>
                <td>${tx.status}</td>
              </tr>
            `;
          });

        } catch(err) {
          console.error('Finance dashboard error:', err);
        }
      }

      async function loadEngagementDashboard(page = 1, append = false) {

        try {

          const action =
            document.getElementById('activityAction')?.value || '';

          const startDate =
            document.getElementById('activityStartDate')?.value || '';

          const endDate =
            document.getElementById('activityEndDate')?.value || '';

          const res = await fetch(
            `/admin/dashboard/engagement?page=${page}&limit=${activityLimit}&action=${encodeURIComponent(action)}&startDate=${startDate}&endDate=${endDate}`
          );

          const data = await res.json();
          console.log(data.activities);
          console.log("Engagement Data:", data);

          document.getElementById('dailyUsers').innerText =
            Number(data.dailyUsers || 0).toLocaleString();

          document.getElementById('weeklyUsers').innerText =
            Number(data.weeklyUsers || 0).toLocaleString();

          document.getElementById('completedLessons').innerText =
            Number(data.completedLessons || 0).toLocaleString();

          document.getElementById('aiQuestions').innerText =
            Number(data.aiQuestions || 0).toLocaleString();

          const tbody =
            document.getElementById('activitiesTable');

          if (!append) {
            tbody.innerHTML = '';
          }

          (data.activities || []).forEach(activity => {

           tbody.innerHTML += `
            <tr>
              <td>${activity.fullname || 'Unknown User'}</td>

              <td>${activity.school_name}</td>

              <td>${activity.role || '-'}</td>

              <td>${activity.action}</td>

              <td>${activity.lesson_title || '-'}</td>

              <td>${activity.course_title || '-'}</td>

              <td>${new Date(activity.created_at).toLocaleString()}</td>

              <td>
                <button
                  class="btn btn-sm btn-primary"
                  onclick="viewUserActivities(${activity.user_id})">
                  View
                </button>
              </td>
            </tr>
            `;
          });

        } catch(err) {

          console.error(
            'Engagement dashboard error:',
            err
          );

        }
      }
      
      function loadMoreActivities() {

        currentActivityPage++;

        loadEngagementDashboard(
          currentActivityPage,
          true
        );

      }

      function loadMoreActivities() {

        currentActivityPage++;

        loadEngagementDashboard(
          currentActivityPage,
          true
        );

      }
    
      async function viewUserActivities(userId) {

        const res = await fetch(
          `/admin/students/${userId}/activities`
        );

        const activities = await res.json();

        const tbody =
          document.getElementById(
            "activityHistoryBody"
          );

        tbody.innerHTML = "";

        activities.forEach(a => {

          tbody.innerHTML += `
            <tr>
              <td>${a.action}</td>
              <td>${a.lesson_title || "-"}</td>
              <td>${a.course_title || "-"}</td>
              <td>${new Date(a.created_at).toLocaleString()}</td>
            </tr>
          `;
        });

        document.getElementById(
          "activityModal"
        ).style.display = "block";
      }

      function closeActivityModal() {
        document.getElementById(
          "activityModal"
        ).style.display = "none";
      }
      
      loadDashboardOverview();
      loadBusinessDashboard();
      loadLearningDashboard();
      loadSchoolsDashboard();
      loadFinanceDashboard();
      loadEngagementDashboard();
      loadDashboardOverview();

    </script>

    <script>
      async function openCourseAnalytics(courseId){

      const res =
        await fetch(`/admin/dashboard/course/${courseId}`);

      const data =
        await res.json();

      document.getElementById(
        "analyticsCourseTitle"
      ).innerText =
        data.course.title;

      document.getElementById(
        "analyticsEnrollments"
      ).innerText =
        data.enrollments;

      document.getElementById(
        "analyticsSchools"
      ).innerText =
        data.schools;

      document.getElementById("analyticsLearners").innerText =
        data.learners;

      document.getElementById("analyticsModules").innerText =
        data.modules;

      document.getElementById("analyticsLessons").innerText =
        data.lessons;

      document.getElementById(
        "analyticsCompletion"
      ).innerText =
        data.completionRate + "%";

      document.getElementById(
        "analyticsQuiz"
      ).innerText =
        data.avgQuiz + "%";

      document.getElementById(
        "analyticsCertificates"
      ).innerText =
        data.certificates;

      const topTable =
        document.getElementById(
          "topStudentsTable"
        );

      topTable.innerHTML = "";

      data.topStudents.forEach(student => {

        topTable.innerHTML += `
          <tr>
            <td>${student.fullname}</td>
            <td>${student.avg_score}%</td>
          </tr>
        `;

      });

      const bottomTable =
        document.getElementById(
          "bottomStudentsTable"
        );

      bottomTable.innerHTML = "";

      data.bottomStudents.forEach(student => {

        bottomTable.innerHTML += `
          <tr>
            <td>${student.fullname}</td>
            <td>${student.avg_score}%</td>
          </tr>
        `;

      });

      document.getElementById(
        "courseAnalyticsModal"
      ).style.display = "block";

    }
    
      function closeCourseAnalytics(){

        document.getElementById(
          "courseAnalyticsModal"
        ).style.display = "none";

      }
    
    </script>

    <script>
      function openDashboardTab(sectionId, btn) {

        const sections = [
          'overview-section',
          'business-section',
          'learning-section',
          'schools-section',
          'finance-section',
          'engagement-section'
        ];

        sections.forEach(id => {
          const section = document.getElementById(id);

          if (section) {
            section.style.display = "none";
          }
        });

        document.getElementById(sectionId).style.display = "block";
        document.getElementById(sectionId).style.width = "100%";

        document.querySelectorAll(".login-tab")
          .forEach(tab => tab.classList.remove("active"));

        btn.classList.add("active");
      }
    </script>

  </body>
</html>
