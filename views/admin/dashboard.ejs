    <script>
      function openDashboardTab(sectionId, btn) {

        // Built fresh on every call (not a module-level constant) — some
        // of these loaders (loadReportHistory in particular) are declared
        // in a LATER <script> block than this one, so capturing them into
        // a static object up here at parse time would freeze in
        // `undefined` for anything not yet defined. By the time a tab is
        // actually clicked, every script block has long since run.
        const dashboardSectionLoaders = {
          "overview-section": loadDashboardOverview,
          "business-section": loadBusinessDashboard,
          "learning-section": loadLearningDashboard,
          "schools-section": loadSchoolsDashboard,
          "finance-section": loadFinanceDashboard,
          "engagement-section": loadEngagementDashboard,
          "reports-section": loadReportHistory,
        };

        const sections = [
          'overview-section',
          'business-section',
          'learning-section',
          'schools-section',
          'finance-section',
          'engagement-section',
          'reports-section'
        ];

        sections.forEach(id => {
          const section = document.getElementById(id);

          if (section) {
            section.style.display = "none";
          }
        });

        document.getElementById(sectionId).style.display = "block";
        document.getElementById(sectionId).style.width = "100%";

        document.querySelectorAll(".login-tab")
          .forEach(tab => tab.classList.remove("active"));

        btn.classList.add("active");

        if (!window.loadedDashboardSections[sectionId]) {
          window.loadedDashboardSections[sectionId] = true;
          const loader = dashboardSectionLoaders[sectionId];
          if (loader) loader();
        }
      }
    </script>

    <script>
      function toggleReportPeriodInputs() {
        const scope = document.getElementById("reportScope").value;
        const monthSelect = document.getElementById("reportMonth");
        monthSelect.style.display = scope === "month" ? "inline-block" : "none";
        // Hiding the select doesn't clear its value — it silently keeps
        // whatever month was last selected (defaulting to "1"/January) and
        // that stray value gets sent with every request regardless of
        // scope. For a yearly report this quietly restricted revenue
        // queries to January only. Explicitly reset it so a yearly/all
        // request never carries a leftover month.
        if (scope !== "month") {
          monthSelect.value = "";
        }
      }

      function populateReportYearSelect() {
        const yearSelect = document.getElementById("reportYear");
        const currentYear = new Date().getFullYear();
        yearSelect.innerHTML = "";
        for (let y = currentYear; y >= 2023; y--) {
          yearSelect.innerHTML += `<option value="${y}">${y}</option>`;
        }
      }

      function getSelectedFormats() {
        const formats = [];
        if (document.getElementById("formatPdf").checked) formats.push("pdf");
        if (document.getElementById("formatExcel").checked) formats.push("excel");
        if (document.getElementById("formatPptx").checked) formats.push("pptx");
        return formats;
      }

      function getReportRequestBody() {
        return {
          scope: document.getElementById("reportScope").value,
          year: document.getElementById("reportYear").value,
          month: document.getElementById("reportMonth").value,
          formats: getSelectedFormats(),
        };
      }

      function downloadBase64File(base64, filename, mimeType) {
        const byteChars = atob(base64);
        const byteNumbers = new Array(byteChars.length);
        for (let i = 0; i < byteChars.length; i++) {
          byteNumbers[i] = byteChars.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: mimeType });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      async function generatePlatformReport() {
        const btn = document.getElementById("generateReportBtn");
        const status = document.getElementById("reportStatus");
        btn.disabled = true;
        status.innerText = "Generating report — this can take up to a minute...";

        try {
          const res = await fetch("/admin/reports/platform/generate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(getReportRequestBody()),
          });
          const data = await res.json();

          if (!data.success) {
            status.innerText = "Failed to generate report: " + (data.message || "Unknown error");
            return;
          }

          data.files.forEach((f) => downloadBase64File(f.base64, f.filename, f.mimeType));
          status.innerText = `Report for ${data.periodLabel} generated (${data.files.length} file(s)).`;
          loadReportHistory();
        } catch (err) {
          console.error(err);
          status.innerText = "Error generating report. Check console.";
        } finally {
          btn.disabled = false;
        }
      }

      async function emailPlatformReportNow() {
        const btn = document.getElementById("emailReportBtn");
        const status = document.getElementById("reportStatus");
        btn.disabled = true;
        status.innerText = "Generating and emailing report...";

        try {
          const res = await fetch("/admin/reports/platform/email-now", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(getReportRequestBody()),
          });
          const data = await res.json();

          status.innerText = data.success
            ? `Report for ${data.periodLabel} emailed to ${data.sentTo}.`
            : "Failed to email report: " + (data.message || "Unknown error");
          loadReportHistory();
        } catch (err) {
          console.error(err);
          status.innerText = "Error emailing report. Check console.";
        } finally {
          btn.disabled = false;
        }
      }

      async function generatePitchDeck() {
        const btn = document.getElementById("generateDeckBtn");
        const status = document.getElementById("deckStatus");
        const audience = document.getElementById("pitchDeckAudience").value;
        btn.disabled = true;
        status.innerText = "Generating pitch deck — this can take up to a minute...";

        try {
          const res = await fetch(`/admin/pitch-decks/download?audience=${audience}`);
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            status.innerText = "Failed to generate pitch deck: " + (data.message || res.statusText);
            return;
          }
          const blob = await res.blob();
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `pitch-deck-${audience}.pptx`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          status.innerText = "Pitch deck generated.";
          loadReportHistory();
        } catch (err) {
          console.error(err);
          status.innerText = "Error generating pitch deck. Check console.";
        } finally {
          btn.disabled = false;
        }
      }

      // ---- Partnership Proposal ----
      // Line-delimited "Title | Description" (or "Question | Answer")
      // textareas are parsed into arrays of objects, and rebuilt the same
      // way when populating the form from a preview response — a plain,
      // readable edit format that doesn't need a dynamic list-builder UI.
      function parsePipeList(text, keys) {
        return String(text || "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const parts = line.split("|").map((p) => p.trim());
            const obj = {};
            keys.forEach((k, i) => { obj[k] = parts[i] || ""; });
            return obj;
          });
      }

      function formatPipeList(items, keys) {
        return (items || []).map((item) => keys.map((k) => item[k] || "").join(" | ")).join("\n");
      }

      let proposalPreviewContent = null;
      let galleryImagesCache = null;
      let curriculumAssetsCache = null;

      async function loadGalleryImagesIfNeeded() {
        if (galleryImagesCache) return galleryImagesCache;
        try {
          const res = await fetch("/admin/pitch-decks/proposal/gallery-images");
          const data = await res.json();
          galleryImagesCache = data.success ? data.images : [];
        } catch (err) {
          console.error("Failed to load gallery images:", err);
          galleryImagesCache = [];
        }
        return galleryImagesCache;
      }

      async function loadCurriculumAssetsIfNeeded() {
        if (curriculumAssetsCache) return curriculumAssetsCache;
        try {
          const res = await fetch("/admin/pitch-decks/proposal/curriculum-assets");
          const data = await res.json();
          curriculumAssetsCache = data.success
            ? { courses: data.courses, careerPathways: data.careerPathways, partnerSchools: data.partnerSchools }
            : { courses: [], careerPathways: [], partnerSchools: [] };
        } catch (err) {
          console.error("Failed to load curriculum assets:", err);
          curriculumAssetsCache = { courses: [], careerPathways: [], partnerSchools: [] };
        }
        return curriculumAssetsCache;
      }

      function imageOptionLabel(img) {
        return [img.title, img.category].filter(Boolean).join(" — ") || "Untitled";
      }

      // Small Cloudinary transform for fast-loading tile thumbnails; falls
      // back to the original URL untouched for non-Cloudinary sources.
      function cldThumb(url) {
        if (!url) return url;
        if (url.includes("res.cloudinary.com") && url.includes("/upload/")) {
          return url.replace("/upload/", "/upload/w_150,h_110,c_fill,q_auto,f_auto/");
        }
        return url;
      }

      // Builds one clickable photo tile for a <select> option — shared by
      // the picker modal grid. Clicking calls onClick, which the caller
      // uses to toggle/set selection on the underlying <select>.
      //
      // "No image" (course/pathway/school with no thumbnail_url/logo_url)
      // is distinct from the real "None" placeholder option used by the
      // single-select pickers (that one has no dataset.title at all) —
      // otherwise an item that simply lacks a photo would misleadingly
      // show the label "None" instead of its actual title.
      function buildPhotoTile(opt, onClick) {
        const tile = document.createElement("div");
        tile.className = "photo-tile" + (opt.selected ? " selected" : "");
        const isRealItem = opt.dataset.title !== undefined;

        if (opt.value) {
          const img = document.createElement("img");
          img.src = cldThumb(opt.value);
          img.loading = "lazy";
          tile.appendChild(img);
          if (opt.selected) {
            const check = document.createElement("span");
            check.className = "tile-check";
            check.innerText = "✓";
            tile.appendChild(check);
          }
        } else {
          const noneIcon = document.createElement("div");
          noneIcon.className = "tile-none-icon";
          noneIcon.innerText = isRealItem ? "No image" : "None";
          tile.appendChild(noneIcon);
        }

        const label = document.createElement("div");
        label.className = "tile-label";
        label.innerText = isRealItem ? (opt.dataset.title || "Untitled") : "None";
        tile.appendChild(label);

        tile.addEventListener("click", onClick);
        return tile;
      }

      // The <select> elements stay the real source of truth (hidden in
      // CSS) so every other function that reads .value/.selectedOptions
      // keeps working unchanged — the modal grid and the compact preview
      // strip both just mirror and toggle that state.
      let photoPickerState = null; // { selectId, multi }

      function openPhotoPicker(selectId, { multi, title }) {
        photoPickerState = { selectId, multi };
        document.getElementById("photoPickerModalTitle").innerText = title || "Choose photo";
        document.getElementById("photoPickerModalHint").innerText = multi
          ? "Click a photo to add or remove it, then close when done."
          : "Click a photo to select it, or choose None.";
        renderPhotoPickerModalGrid();
        document.getElementById("photoPickerModal").style.display = "block";
      }

      function closePhotoPickerModal() {
        document.getElementById("photoPickerModal").style.display = "none";
        photoPickerState = null;
      }

      function renderPhotoPickerModalGrid() {
        if (!photoPickerState) return;
        const { selectId, multi } = photoPickerState;
        const select = document.getElementById(selectId);
        const grid = document.getElementById("photoPickerModalGrid");
        grid.innerHTML = "";
        Array.from(select.options).forEach((opt) => {
          grid.appendChild(
            buildPhotoTile(opt, () => {
              if (multi) {
                opt.selected = !opt.selected;
              } else {
                Array.from(select.options).forEach((o) => (o.selected = o === opt));
              }
              select.dispatchEvent(new Event("change"));
              renderPhotoPickerModalGrid();
              renderPhotoPreview(selectId);
              if (!multi) closePhotoPickerModal();
            })
          );
        });
      }

      // Compact "what's currently picked" strip shown inline on the page
      // next to the "Choose photo(s)" button — small thumbnails, not the
      // full grid, so many photos never overload the page itself. Excludes
      // only the true "None" placeholder (no dataset.title) — a real item
      // with no thumbnail (e.g. a course missing a thumbnail_url) still
      // counts as selected, just shown with its title instead of an image.
      function renderPhotoPreview(selectId) {
        const select = document.getElementById(selectId);
        const preview = document.getElementById(selectId + "Preview");
        if (!select || !preview) return;
        preview.innerHTML = "";
        const selectedOpts = Array.from(select.selectedOptions).filter((o) => o.dataset.title !== undefined);
        if (!selectedOpts.length) {
          const span = document.createElement("span");
          span.className = "photo-picker-empty";
          span.innerText = "None selected";
          preview.appendChild(span);
          return;
        }
        selectedOpts.slice(0, 8).forEach((opt) => {
          if (opt.value) {
            const img = document.createElement("img");
            img.className = "photo-picker-thumb";
            img.src = cldThumb(opt.value);
            img.title = opt.dataset.title || "";
            preview.appendChild(img);
          } else {
            const chip = document.createElement("span");
            chip.className = "photo-picker-more";
            chip.innerText = opt.dataset.title || "Untitled";
            preview.appendChild(chip);
          }
        });
        if (selectedOpts.length > 8) {
          const more = document.createElement("span");
          more.className = "photo-picker-more";
          more.innerText = "+" + (selectedOpts.length - 8) + " more";
          preview.appendChild(more);
        }
      }

      function populateImageSelect(selectId, images, selectedUrl) {
        const select = document.getElementById(selectId);
        select.innerHTML = '<option value="">None</option>';
        images.forEach((img) => {
          const opt = document.createElement("option");
          opt.value = img.image_url || "";
          opt.innerText = imageOptionLabel(img);
          opt.dataset.title = img.title || "";
          opt.dataset.description = img.description || "";
          if (img.image_url === selectedUrl) opt.selected = true;
          select.appendChild(opt);
        });
        renderPhotoPreview(selectId);
        if (photoPickerState && photoPickerState.selectId === selectId) renderPhotoPickerModalGrid();
      }

      // Same as populateImageSelect but for a <select multiple> — no
      // "None" option needed since an empty selection already means none.
      // Also used (with images mapped to {image_url, title, description})
      // for the curriculum course picker and the partner-school logo
      // picker, not just the gallery — an item's own value may be empty
      // (a course with no thumbnail_url) without that meaning "not a real
      // item"; see buildPhotoTile/renderPhotoPreview's isRealItem check.
      function populateMultiImageSelect(selectId, images) {
        const select = document.getElementById(selectId);
        select.innerHTML = "";
        images.forEach((img) => {
          const opt = document.createElement("option");
          opt.value = img.image_url || "";
          opt.innerText = imageOptionLabel(img);
          opt.dataset.title = img.title || "";
          opt.dataset.description = img.description || "";
          select.appendChild(opt);
        });
        renderPhotoPreview(selectId);
        if (photoPickerState && photoPickerState.selectId === selectId) renderPhotoPickerModalGrid();
      }

      // Career pathways carry more metadata than a plain photo/course, so
      // they get their own populate function (still reusing the same tile
      // picker/preview machinery via dataset fields).
      function populatePathwaySelect(selectId, pathways) {
        const select = document.getElementById(selectId);
        select.innerHTML = "";
        pathways.forEach((p) => {
          const opt = document.createElement("option");
          opt.value = p.thumbnail_url || "";
          opt.innerText = p.title || "Untitled";
          opt.dataset.title = p.title || "";
          opt.dataset.description = p.description || "";
          opt.dataset.targetAudience = p.target_audience || "";
          opt.dataset.durationEstimate = p.duration_estimate || "";
          opt.dataset.expectedOutcomes = p.expected_outcomes || "";
          select.appendChild(opt);
        });
        renderPhotoPreview(selectId);
        if (photoPickerState && photoPickerState.selectId === selectId) renderPhotoPickerModalGrid();
      }

      function populateTemplateSelect(templateOptions, selectedKey) {
        const select = document.getElementById("proposalTemplate");
        select.innerHTML = "";
        templateOptions.forEach((tpl) => {
          const opt = document.createElement("option");
          opt.value = tpl.key;
          opt.innerText = tpl.label;
          opt.dataset.description = tpl.description || "";
          if (tpl.key === selectedKey) opt.selected = true;
          select.appendChild(opt);
        });
        updateProposalTemplateDescription();
      }

      function updateProposalTemplateDescription() {
        const select = document.getElementById("proposalTemplate");
        const desc = document.getElementById("proposalTemplateDescription");
        const opt = select.options[select.selectedIndex];
        desc.innerText = opt ? opt.dataset.description || "" : "";
      }

      document.addEventListener("DOMContentLoaded", () => {
        const el = document.getElementById("proposalTemplate");
        if (el) el.addEventListener("change", updateProposalTemplateDescription);
      });

      function getSelectedPhotosWithCaptions(selectId) {
        const select = document.getElementById(selectId);
        return Array.from(select.selectedOptions).map((opt) => ({
          url: opt.value,
          caption: opt.dataset.title || "",
        }));
      }

      function getSelectedCourses(selectId) {
        const select = document.getElementById(selectId);
        return Array.from(select.selectedOptions).map((opt) => ({
          title: opt.dataset.title || "",
          description: opt.dataset.description || "",
          thumbnailUrl: opt.value || null,
        }));
      }

      function getSelectedPathways(selectId) {
        const select = document.getElementById(selectId);
        return Array.from(select.selectedOptions).map((opt) => ({
          title: opt.dataset.title || "",
          description: opt.dataset.description || "",
          targetAudience: opt.dataset.targetAudience || "",
          durationEstimate: opt.dataset.durationEstimate || "",
          expectedOutcomes: opt.dataset.expectedOutcomes || "",
          thumbnailUrl: opt.value || null,
        }));
      }

      function getSelectedPartnerLogos(selectId) {
        const select = document.getElementById(selectId);
        return Array.from(select.selectedOptions).map((opt) => ({
          name: opt.dataset.title || "",
          logoUrl: opt.value || null,
        }));
      }

      function updateProposalImagePreviewLinks() {
        const slots = [
          ["proposalImageAboutUs", "About Us"],
          ["proposalImageTrackRecord", "Track Record"],
          ["proposalImageClosing", "Closing"],
        ];
        const links = slots
          .map(([id, label]) => {
            const url = document.getElementById(id).value;
            return url ? `<a href="${url}" target="_blank">${label} ↗</a>` : null;
          })
          .filter(Boolean);
        document.getElementById("proposalImagePreviewLinks").innerHTML = links.join(" &nbsp;|&nbsp; ") || "No photos selected.";
      }

      ["proposalImageAboutUs", "proposalImageTrackRecord", "proposalImageClosing"].forEach((id) => {
        document.addEventListener("DOMContentLoaded", () => {
          const el = document.getElementById(id);
          if (el) el.addEventListener("change", updateProposalImagePreviewLinks);
        });
      });

      async function generateProposalPreview() {
        const btn = document.getElementById("generateProposalPreviewBtn");
        const status = document.getElementById("proposalPreviewStatus");
        const recipientName = document.getElementById("proposalRecipient").value.trim();

        if (!recipientName) {
          status.innerText = "Please enter a recipient / school name first.";
          return;
        }

        btn.disabled = true;
        status.innerText = "Drafting proposal with AI — this can take up to a minute...";
        document.getElementById("proposalEditArea").style.display = "none";

        try {
          const res = await fetch("/admin/pitch-decks/proposal/preview", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              audience: document.getElementById("proposalAudience").value,
              recipientName,
              focusNotes: document.getElementById("proposalFocusNotes").value.trim(),
            }),
          });
          const data = await res.json();
          if (!data.success) {
            status.innerText = "Failed to generate preview: " + (data.message || "Unknown error");
            return;
          }

          proposalPreviewContent = data.content;

          document.getElementById("proposalTagline").value = data.content.tagline || "";
          document.getElementById("proposalAboutUs").value = data.content.aboutUs || "";
          document.getElementById("proposalTrackRecordQuote").value = data.content.trackRecordQuote || "";
          document.getElementById("proposalStatsPreview").innerText =
            (data.content.trackRecordStats || []).map((s) => `${s.value} ${s.label}`).join("  •  ");
          document.getElementById("proposalPrograms").value = formatPipeList(data.content.programs, ["title", "description"]);
          document.getElementById("proposalBenefits").value = formatPipeList(data.content.benefits, ["title", "description"]);
          document.getElementById("proposalProcessSteps").value = formatPipeList(data.content.processSteps, ["title", "description"]);
          document.getElementById("proposalFaq").value = formatPipeList(data.content.faq, ["question", "answer"]);

          document.getElementById("proposalPriceLabel").innerText = data.content.investmentTitle || "Investment";
          document.getElementById("proposalPriceAmount").value = data.content.pricing.amount || "";
          document.getElementById("proposalPriceValue").value = "";
          document.getElementById("proposalPriceUnit").value = data.content.pricing.unit || "";
          document.getElementById("proposalPriceNote2").value = "";
          document.getElementById("proposalPriceIncludes").value = "";
          document.getElementById("proposalPriceNote").value = "";
          document.getElementById("proposalContacts").value = formatPipeList(data.content.contacts, ["label", "value"]);
          document.getElementById("proposalConnectPreamble").value = "";

          document.getElementById("proposalCurriculumIntro").value = (data.content.curriculum || {}).intro || "";
          document.getElementById("proposalCurriculumLayout").value = (data.content.curriculum || {}).layout || "threePerSlide";
          document.getElementById("proposalCareerPathwayIntro").value = (data.content.careerPathways || {}).intro || "";
          document.getElementById("proposalCompetitionsExhibitions").value = data.content.competitionsExhibitions || "";

          populateTemplateSelect(data.templateOptions || [], data.content.template);

          const galleryImages = await loadGalleryImagesIfNeeded();
          const images = data.content.images || {};
          populateImageSelect("proposalImageAboutUs", galleryImages, images.aboutUs);
          populateImageSelect("proposalImageTrackRecord", galleryImages, images.trackRecord);
          populateImageSelect("proposalImageClosing", galleryImages, images.closingHighlight);
          populateMultiImageSelect("proposalGalleryPhotos", galleryImages);
          populateMultiImageSelect("proposalAppendixPhotos", galleryImages);
          updateProposalImagePreviewLinks();

          const curriculumAssets = await loadCurriculumAssetsIfNeeded();
          populateMultiImageSelect(
            "proposalPartnerLogos",
            curriculumAssets.partnerSchools.map((s) => ({ image_url: s.logo_url, title: s.name }))
          );
          populateMultiImageSelect(
            "proposalCurriculumCourses",
            curriculumAssets.courses.map((c) => ({ image_url: c.thumbnail_url, title: c.title, category: c.level, description: c.description }))
          );
          populatePathwaySelect("proposalCareerPathways", curriculumAssets.careerPathways);

          document.getElementById("proposalEditArea").style.display = "block";
          status.innerText = "Draft ready — review and edit below, then download when you're happy with it.";
        } catch (err) {
          console.error(err);
          status.innerText = "Error generating preview. Check console.";
        } finally {
          btn.disabled = false;
        }
      }

      async function downloadProposal() {
        const btn = document.getElementById("downloadProposalBtn");
        const status = document.getElementById("proposalDownloadStatus");

        if (!proposalPreviewContent) {
          status.innerText = "Generate a preview first.";
          return;
        }

        const priceValue = document.getElementById("proposalPriceValue").value.trim();
        if (!priceValue) {
          status.innerText = "Please set a price before downloading — pricing is never auto-generated.";
          return;
        }

        btn.disabled = true;
        status.innerText = "Building the final deck...";

        const content = {
          ...proposalPreviewContent,
          tagline: document.getElementById("proposalTagline").value.trim(),
          aboutUs: document.getElementById("proposalAboutUs").value.trim(),
          trackRecordQuote: document.getElementById("proposalTrackRecordQuote").value.trim(),
          programs: parsePipeList(document.getElementById("proposalPrograms").value, ["title", "description"]),
          benefits: parsePipeList(document.getElementById("proposalBenefits").value, ["title", "description"]),
          processSteps: parsePipeList(document.getElementById("proposalProcessSteps").value, ["title", "description"]),
          faq: parsePipeList(document.getElementById("proposalFaq").value, ["question", "answer"]),
          pricing: {
            amount: document.getElementById("proposalPriceAmount").value.trim(),
            price: priceValue,
            unit: document.getElementById("proposalPriceUnit").value.trim(),
            note2: document.getElementById("proposalPriceNote2").value.trim(),
            includes: document.getElementById("proposalPriceIncludes").value.split("\n").map((s) => s.trim()).filter(Boolean),
            note: document.getElementById("proposalPriceNote").value.trim(),
          },
          contacts: parsePipeList(document.getElementById("proposalContacts").value, ["label", "value"]),
          connectPreamble: document.getElementById("proposalConnectPreamble").value.trim(),
          images: {
            aboutUs: document.getElementById("proposalImageAboutUs").value || null,
            trackRecord: document.getElementById("proposalImageTrackRecord").value || null,
            closingHighlight: document.getElementById("proposalImageClosing").value || null,
          },
          galleryPhotos: getSelectedPhotosWithCaptions("proposalGalleryPhotos"),
          appendixPhotos: getSelectedPhotosWithCaptions("proposalAppendixPhotos"),
          appendixLayout: document.getElementById("proposalAppendixLayout").value,
          partnerSchoolLogos: getSelectedPartnerLogos("proposalPartnerLogos"),
          curriculum: {
            intro: document.getElementById("proposalCurriculumIntro").value.trim(),
            courses: getSelectedCourses("proposalCurriculumCourses"),
            layout: document.getElementById("proposalCurriculumLayout").value,
          },
          careerPathways: {
            intro: document.getElementById("proposalCareerPathwayIntro").value.trim(),
            pathways: getSelectedPathways("proposalCareerPathways"),
          },
          competitionsExhibitions: document.getElementById("proposalCompetitionsExhibitions").value.trim(),
          template: document.getElementById("proposalTemplate").value,
        };

        try {
          const res = await fetch("/admin/pitch-decks/proposal/download", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ content }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            status.innerText = "Failed to generate proposal: " + (data.message || res.statusText);
            return;
          }
          const blob = await res.blob();
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `partnership-proposal-${content.audience || "schools"}-${(content.recipientName || "draft").replace(/[^\w-]+/g, "_")}.pptx`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          status.innerText = "Proposal downloaded.";
          loadReportHistory();
        } catch (err) {
          console.error(err);
          status.innerText = "Error generating proposal. Check console.";
        } finally {
          btn.disabled = false;
        }
      }

      const REPORT_TYPE_LABELS = {
        platform_analytics: "Analytics Report",
        pitch_deck: "Pitch Deck",
      };

      const AUDIENCE_LABELS = {
        schools: "Schools",
        grants: "Grant Applications",
        investors: "Investors",
        partners: "Partners",
        "proposal-schools": "Proposal — Schools",
        "proposal-grants": "Proposal — Grant Applications",
        "proposal-investors": "Proposal — Investors",
        "proposal-partners": "Proposal — Partners",
      };

      async function loadReportHistory() {
        try {
          const res = await fetch("/admin/reports/platform/history");
          const data = await res.json();
          const tbody = document.getElementById("reportHistoryTable");
          if (!tbody) return;

          tbody.innerHTML = "";
          (data.history || []).forEach((row) => {
            const typeLabel = REPORT_TYPE_LABELS[row.report_type] || row.report_type;
            const detail = row.audience
              ? (AUDIENCE_LABELS[row.audience] || row.audience)
              : (row.period_label || "-");
            const statusPillClass = row.status === "success" ? "jk-pill--paid" : "jk-pill--unpaid";
            const statusTitle = row.error_message ? ` title="${row.error_message.replace(/"/g, "&quot;")}"` : "";

            tbody.innerHTML += `
              <tr>
                <td>${typeLabel}</td>
                <td>${detail}</td>
                <td>${(row.formats_generated || []).join(", ")}</td>
                <td>${row.triggered_by === "cron" ? "Scheduled" : "Admin"}</td>
                <td><span class="jk-pill ${statusPillClass}"${statusTitle}>${row.status}</span></td>
                <td>${new Date(row.created_at).toLocaleString()}</td>
              </tr>
            `;
          });
        } catch (err) {
          console.error("Failed to load report history:", err);
        }
      }

      // populateReportYearSelect/toggleReportPeriodInputs are cheap,
      // local DOM setup (no network call) — safe to run eagerly even
      // though the Reports tab isn't visible by default. loadReportHistory
      // is a real server fetch, so it's deliberately NOT called here —
      // openDashboardTab's lazy loader calls it the first time the
      // Reports tab is actually opened (see dashboardSectionLoaders).
      populateReportYearSelect();
      toggleReportPeriodInputs();
    </script>
