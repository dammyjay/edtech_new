<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

    <section class="section jk-page">

    <div class="jk-header-card">
      <div><h2><%= pathway.title %> — Courses</h2></div>
      <button onclick="openModal()" class="jk-btn-dark">+ Add Course</button>
    </div>

   <!-- COURSE GRID -->
    <div class="card-grid jk-course-grid">
    <% courses.forEach(course => { %>
      <div class="card-thumbnail hoverable jk-course-card">
          <% if (course.thumbnail_url) { %>
              <a href="/admin/courses/<%= course.id %>">
                  <img src="<%= course.thumbnail_url %>"
                    alt="Course Thumbnail"
                  />
              </a>
          <% } %>

        <div class="card-content">
          <h3><%= course.title %></h3>
          <p class="card-body">Course ID: <%= course.id %></p>
          <div class="card-body">
            <p><%- course.description.substring(0, 100) %>...</p>
          </div>
          <small style="color: rgb(143, 112, 9);"><strong> created by: </strong><%= course.created_by %></small>
          <small style="color: rgb(9, 31, 143);"><strong>Created on: </strong><%= course.created_at %></small>
          <div class="article-buttons">
            <button class="btn-edit" onclick="openEditModal(<%= course.id %>)">Edit</button>
            <form action="/admin/courses/<%= course.id %>/regenerate-thumbnail" method="POST" style="display:inline;" onsubmit="return handleConfirmSubmitWithLoading(event, 'Replace the current thumbnail with a new auto-generated one?', '🖼️ Generating… (can take up to a minute)')">
              <input type="hidden" name="redirect_to" value="/admin/pathways/<%= pathway.id %>/courses" />
              <button type="submit">🖼️ Regenerate Thumbnail</button>
            </form>
            <button class="btn-delete" onclick="openDeleteModal(<%= course.id %>)">Delete</button>
          </div>
        </div>

      </div>

      <div id="editModal-<%= course.id %>" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEditModal(<%= course.id %>)">&times;</span>
            <h2>Edit Course</h2>
            <form action="/admin/courses/edit/<%= course.id %>" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="redirect_to" value="/admin/pathways/<%= pathway.id %>/courses" />
            <input type="text" name="title" value="<%= course.title %>" required /><br />

            <textarea id="editContent-<%= course.id %>" name="description"><%- course.description %></textarea><br />

            <select name="level" required>
                <option value="">Select Level</option>
                <option value="Beginner" <%= course.level === 'Beginner' ? 'selected' : '' %>>Beginner</option>
                <option value="Intermediate" <%= course.level === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
                <option value="Advanced" <%= course.level === 'Advanced' ? 'selected' : '' %>>Advanced</option>
            </select><br /><br>

            <select name="career_pathway_id" required>
                <option value="">-- Career Pathway --</option>
                <% careerPathways.forEach(path => { %>
                <option value="<%= path.id %>" <%= path.id === course.career_pathway_id ? 'selected' : '' %>><%= path.title %></option>
                <% }) %>
            </select><br /><br>

            <!-- <label>Curriculum File (PDF or DOCX)</label>
            <% if (course.curriculum_url) { %>
              <p>📎 <a href="<%= course.curriculum_url %>" target="_blank">View current curriculum</a></p>
            <% } %>
            <input type="file" name="curriculum" accept=".pdf,.doc,.docx"> -->

            <label>Course Curriculum</label>
            <textarea id="editCurriculumContent-<%= course.id %>" name="curriculum_content">
              <%= course.curriculum_content %>
            </textarea>


            <label for="">Sort Number</label>
            <input type="number" name="sort_order" value="<%= course.sort_order %>" /><br />

            <% if (course.thumbnail_url) { %>
                <img src="<%= course.thumbnail_url %>" width="100" /><br />
            <% } %>
            <input type="file" name="thumbnail" /><br />

            <div class="container" id="amountContainer">
              <input
                type="number"
                name="amount"
                step="0.01"
                placeholder="Amount in ₦"
                value="<%= course.amount || '' %>"
              /><br />
            </div>

            <button type="submit">Update Course</button>
            </form>
        </div>

        <script>
            <% courses.forEach(course => { %>
                CKEDITOR.replace('editContent-<%= course.id %>');
                CKEDITOR.replace('editCurriculumContent-<%= course.id %>');
            <% }); %>
        </script>

      </div>


      <!-- DELETE MODAL -->
      <div id="deleteModal-<%= course.id %>" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeDeleteModal(<%= course.id %>)">&times;</span>
          <h3>Are you sure you want to archive "<%= course.title %>"? It will be hidden everywhere but can be restored later from the Archive screen.</h3>
          <form action="/admin/courses/delete/<%= course.id %>" method="POST">
            <input type="hidden" name="redirect_to" value="/admin/pathways/<%= pathway.id %>/courses" />
            <button type="submit">Yes, Archive</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>

  </section>

  <!-- CREATE COURSE MODAL -->
  <div id="createModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>
        <h2>Create New Course</h2>
        <form action="/admin/courses" method="POST" enctype="multipart/form-data">
      <div class="container">
        <input
          type="text"
          name="title"
          placeholder="Course Title"
          required
        /><br />
      </div>
      <textarea
        name="description"
        id="content"
        placeholder="Description"
      ></textarea
      ><br />

      <div class="container">
        <select class="gender-details" name="level" required>
          <option value="">Select Level</option>
          <option value="Beginner">Beginner</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Advanced">Advanced</option></select
        ><br />
      </div>

      <div class="container">
        <select class="gender-details" name="career_pathway_id">
          <option value="">-- Career Pathway --</option>
          <% careerPathways.forEach(path => { %>
          <option value="<%= path.id %>"><%= path.title %></option>
          <% }) %></select
        ><br />
      </div>

      <!-- <label>Curriculum File (PDF/DOCX)</label>
      <input type="file" name="curriculum" accept=".pdf,.doc,.docx" /><br /> -->

      <label>Course Curriculum</label>
      <textarea
        name="curriculum_content"
        id="curriculumEditor"
        placeholder="Paste or write the full curriculum here..."
      ></textarea>


      <input type="number" name="sort_order" placeholder="Sort Order" /><br />
      <label style="font-weight:normal; font-size:13px;">Thumbnail (optional — leave blank to auto-generate one)</label>
      <input type="file" name="thumbnail" /><br />

      <div class="container" id="amountContainer">
              <input
                type="number"
                name="amount"
                step="0.01"
                placeholder="Amount in ₦"
              /><br />
            </div>
      <button type="submit">Create Course</button>
    </form>
      </div>
    </div>

  <!-- SCRIPT SECTION -->
  <script>
    function openDeleteModal(id) {
      document.getElementById("deleteModal-" + id).style.display = "block";
    }
    function closeDeleteModal(id) {
      document.getElementById("deleteModal-" + id).style.display = "none";
    }

    CKEDITOR.replaceAll('textarea');
    CKEDITOR.replace('curriculumEditor', {
    height: 300
  });
  </script>

    <a href="/admin/dashboard" class="jk-btn-outline" style="display:inline-flex; text-decoration:none; margin:16px 0 0 24px;">⬅ Back to Dashboard</a>

    <!-- script for ckeditor -->
    <script>
      CKEDITOR.replace("content");
    </script>

    <!-- script to toggle navigation menu -->
    <script>
      // Close nav when clicking outside of it
      document.addEventListener("click", function (event) {
        const nav = document.getElementById("main-nav");
        const toggleBtn = document.querySelector(".nav-toggle");

        if (
          nav.classList.toggle("open") &&
          !nav.contains(event.target) &&
          !toggleBtn.contains(event.target)
        ) {
          nav.classList.remove("open");
        }
      });
    </script>

    <!-- Script not to be able to copy content from article body -->
    <script>
      document.querySelectorAll(".article-body").forEach(function (el) {
        el.addEventListener("contextmenu", function (e) {
          e.preventDefault();
        });
        el.addEventListener("copy", function (e) {
          e.preventDefault();
        });
      });
    </script>

    <!-- script to preview image before upload -->
    <script>
      const imageInput = document.getElementById("imageInput");
      if (imageInput) {
        imageInput.addEventListener("change", function () {
          const preview = document.getElementById("imagePreview");
          const file = this.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
              preview.src = e.target.result;
              preview.style.display = "block";
            };
            reader.readAsDataURL(file);
          } else {
            preview.src = "#";
            preview.style.display = "none";
          }
        });
      }
    </script>

    <!-- script for opening and closing the modal -->
    <script>
      function openModal() {
        document.getElementById("createModal").style.display = "block";
      }

      function closeModal() {
        document.getElementById("createModal").style.display = "none";
      }

      function openEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "block";
      }

      function closeEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "none";
      }

      // Close any modal when clicking outside it
      window.onclick = function (event) {
        if (event.target.classList.contains("modal")) {
          event.target.style.display = "none";
        }
      };
    </script>
