<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Manage Frequently Asked Questions</h2></div>
  </div>

  <div class="jk-toolbar">
    <form method="GET" action="/admin/faqs" style="display:flex; align-items:center; gap:8px;">
      <label for="status" style="font-size:13px; font-weight:600; color:#4C3802;">Filter:</label>
      <select name="filter" class="jk-select" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="published" <%= filter === 'published' ? 'selected' : '' %>>Published</option>
        <option value="answered" <%= filter === 'answered' ? 'selected' : '' %>>Answered</option>
        <option value="unanswered" <%= filter === 'unanswered' ? 'selected' : '' %>>Unanswered</option>
      </select>
    </form>
  </div>

  <% if (faqs.length === 0) { %>
    <div class="jk-report-panel" style="text-align:center; color:#8A7B55;">No FAQs match this filter.</div>
  <% } else { %>
    <% faqs.forEach(faq => { %>
      <div class="jk-report-panel">
        <p style="margin:0 0 8px;"><strong>Q:</strong> <%- faq.question %></p>
        <p style="margin:0 0 10px; color:#4C3802;"><strong>A:</strong> <%- faq.answer || 'No answer yet' %></p>
        <span class="jk-pill <%= faq.is_published ? 'jk-pill--active' : 'jk-pill--inactive' %>"><%= faq.is_published ? 'Published' : 'Not published' %></span>
        <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
          <a href="/admin/faqs/edit/<%= faq.id %>" class="jk-btn-outline-sm" style="text-decoration:none;">✏️ Edit</a>
          <form
            action="/admin/faqs/delete/<%= faq.id %>"
            method="POST"
            style="display:inline;"
            onsubmit="return handleConfirmSubmit(event, 'Are you sure you want to delete this FAQ?')"
          >
            <button type="submit" class="jk-btn-outline-sm">🗑️ Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>

</section>
