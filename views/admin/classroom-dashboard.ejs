<%- include('../partials/adminHeader', { title: classroom.school_name }) %>


<section class="section">
    <div style="background:var(--grey);padding:20px;border-radius:8px;margin-bottom:20px;">
        <img src="<%= classroom.school_logo %>" alt="School Logo" style="width:100px;height:100px;object-fit:cover;">
        <h2><%= classroom.school_name %></h2>
        <p><strong>Email:</strong> <%= classroom.school_email %></p>
        <p><strong>Phone:</strong> <%= classroom.school_phone %></p>
        <p><strong>Address:</strong> <%= classroom.school_address %></p>

        

        <div class="multi-btn">
            <button class="btn-sec" onclick="window.location.href='/admin/schools/<%= classroom.school_id %>'">← Back to School Details</button>
            <button class="btn-pri" onclick="window.location.href='/admin/classrooms/<%= classroom.id %>/dashboard/export<%= selectedTerm ? '?term_id=' + selectedTerm.id : '' %>'">Download Classroom PDF</button>
        </div>

        <% if (terms && terms.length) { %>
        <div style="margin-top:15px;">
            <label for="analyticsTermSelect"><strong>Analytics Term:</strong></label>
            <select id="analyticsTermSelect" onchange="window.location.href='/admin/classrooms/<%= classroom.id %>/dashboard?term_id=' + this.value">
                <% terms.forEach(t => { %>
                <option value="<%= t.id %>" <%= selectedTerm && selectedTerm.id === t.id ? 'selected' : '' %>>
                    <%= t.name %><%= t.is_active ? ' (Active)' : '' %><%= t.is_ended ? ' (Ended)' : '' %>
                </option>
                <% }) %>
            </select>
            <p style="color:#666; font-size:12px; margin-top:6px;">
                Controls the metrics/leaderboard/course breakdown below. Separate from the Report Centre's own term selector further down.
            </p>
        </div>
        <% } %>

        <hr>

        <!-- <div class="report-generator">

            <label><strong>Select Academic Term</strong></label>

