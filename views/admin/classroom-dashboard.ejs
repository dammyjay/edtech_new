                id="generateReportBtn"
                class="btn-pri">

                📄 Generate AI Term Report

            </button>

        </div> -->
    </div>
</section>



<section class="section">

    <h2>📑 Report Centre</h2>

    <div class="report-centre">

        <div class="report-header">

            <label>Academic Term</label>
            <select id="termSelect">

                <% terms.forEach(term=>{ %>

                    <option value="<%= term.id %>">
                        <%= term.name %>
                    </option>

                <% }) %>

            </select>

        </div>

        <br>

        <div class="report-header">

            <label>Student</label>
            <select id="studentSelect">

                <% students.forEach(student=>{ %>

                    <option value="<%= student.id %>">

                        <%= student.fullname %>

                    </option>

                <% }) %>

            </select>

        </div>

        <br>

        <div class="report-actions">

            <button
                id="btnFullReport"
                class="btn-pri">

                📄 Generate Full Class Report

            </button>

            <button
                id="btnStudentReport"
                class="btn-sec">

                👨‍🎓 Generate Student Report

            </button>

            <button class="btn-sec">

                📧 Email Reports

            </button>

            <button class="btn-sec">

                📊 Export Excel

            </button>

        </div>

    </div>

</section>

<h2>📊 <%= classroom.name %> - Classroom Analytics</h2>

<section class="section">
    <div class="engagement-grid">
        <div class="metric-card">
            <div class="card-title blue-bg">
                <p>Total Students</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon blue-bg">
                    <i class="fa-solid fa-users"></i>
                </div>
                <h4><%= totalStudents %></h4>
            </div>
        </div>

        <div class="metric-card">
            <div class="card-title green-bg">
                <p>Average Completion</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon green-bg">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <h4><%= averageCompletion %>%</h4>
            </div>
        </div>

        <div class="metric-card">
            <div class="card-title pink-bg">
                <p>Average Quiz Score</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon pink-bg">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <h4><%= averageQuiz %>%</h4>
            </div>
        </div>
    </div>
</section>


<hr>

<section class="section">
    <h3>📚 Courses This Term</h3>
    <div class="table-responsive">
        <table class="user-table sortable-table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Level</th>
                    <th>Lessons</th>
                    <th>Students Engaged</th>
                    <th>Avg Completion</th>
                    <th>Avg Quiz Score</th>
                </tr>
            </thead>
            <tbody>
            <% if (courseBreakdown && courseBreakdown.length) { %>
                <% courseBreakdown.forEach(course => { %>
                <tr>
                    <td><%= course.title %></td>
                    <td><%= course.level || '-' %></td>
                    <td><%= course.totalLessons %></td>
                    <td><%= course.studentsEngaged %> / <%= course.totalStudents %></td>
                    <td><%= course.avgCompletion %>%</td>
                    <td><%= course.avgQuiz %>%</td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="6" style="text-align:center;">No courses assigned to this classroom yet</td></tr>
            <% } %>
            </tbody>
        </table>
    </div>
</section>

<hr>

<section class="section">
    <h3>📈 Lesson Completion Chart</h3>
    <canvas id="completionChart"></canvas>
</section>

<section class="section">
    <h3>🏆 Leaderboard</h3>
    <div class="table-responsive">
        <table class="user-table sortable-table">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Name</th>
                    <th>Lessons</th>
                    <th>Completion %</th>
                    <th>Quiz Avg</th>
                    <th>Pace</th>
                    <th>Overall</th>
                    <th>Progress</th>
                </tr>
            </thead>
            <tbody>
            <% leaderboard.forEach((student, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= student.fullname %></td>
                    <td>
                        <%= student.completedLessons %> /
                        <%= student.totalLessons %>
                    </td>
                    <td><%= student.completionPercent %>%</td>
                    <td><%= student.quizAvg %>%</td>
                    <td><%= student.avgDaysToComplete !== null ? student.avgDaysToComplete + 'd avg' : '-' %></td>
                    <td><strong><%= student.overallScore %>%</strong></td>
                    <td>
                        <a href="/admin/students/<%= student.id %>/progress?from=admin"
                        class="btn-edit"
                        style="background:green; color:#fff; padding:5px 8px; border-radius:4px; text-decoration:none;">
                        Progress
                        </a>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</section>


<hr>

<section class="section">
  <h3>⚠️ At Risk Students</h3>

  <div class="table-responsive">
    <table class="user-table sortable-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Lessons</th>
          <th>Completion %</th>
          <th>Quiz Avg</th>
          <th>Progress</th>
        </tr>
      </thead>
      <tbody>
        <% if (atRiskStudents.length > 0) { %>
          <% atRiskStudents.forEach(student => { %>
            <tr>
              <td><%= student.fullname %></td>
              <td>
                <%= student.completedLessons %> / 
                <%= student.totalLessons %>
              </td>
              <td style="color:#e74c3c;">
                <%= student.completionPercent %>%
              </td>
              <td style="color:#e74c3c;">
                <%= student.quizAvg %>%
              </td>
                <td>
                    <a href="/admin/students/<%= student.id %>/progress?from=admin"
                    class="btn-edit"
                    style="background:#e74c3c; color:#fff; padding:5px 8px; border-radius:4px; text-decoration:none;">
                    Progress
                    </a>
                </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align:center;">
              ✅ No students at risk
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<% if (selectedTerm && selectedTerm.is_ended) { %>
<hr>

<section class="section">
  <h3>🔒 Locked Students <small style="font-weight:normal; color:#666;">(term ended)</small></h3>
  <p style="color:#666; font-size:13px;">
    This term has ended. Students below have unfinished lessons in it and are locked out of continuing
    until the term is reactivated for them — pay from their wallet (student-initiated), or reactivate here for free.
  </p>

  <% if (!lockedStudents || !lockedStudents.length) { %>
    <p style="color:#666;">✅ No students have unfinished, locked content in this term.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="user-table sortable-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Locked Courses</th>
            <th>Reactivation Price</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% lockedStudents.forEach(stu => { %>
            <tr>
              <td><%= stu.fullname %></td>
              <td>
                <%= stu.priceInfo.courses.map(c => c.title + ' (' + c.completedLessons + '/' + c.totalLessons + ')').join(', ') %>
              </td>
              <td>₦<%= stu.priceInfo.totalPrice.toLocaleString() %></td>
              <td>
                <form method="POST" action="/admin/classrooms/<%= classroom.id %>/terms/<%= selectedTerm.id %>/students/<%= stu.id %>/reactivate">
                  <button type="submit" class="btn-edit" style="background:#2ecc71; color:#fff; padding:5px 8px; border-radius:4px; border:none; cursor:pointer;">
                    🔓 Reactivate
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('completionChart');

new Chart(ctx, {
  type: 'bar',
  data: {
    labels: <%- JSON.stringify(studentMetrics.map(s => s.fullname)) %>,
    datasets: [{
      label: 'Completion %',
      data: <%- JSON.stringify(studentMetrics.map(s => s.completionPercent)) %>
    }]
  }
});
</script>

