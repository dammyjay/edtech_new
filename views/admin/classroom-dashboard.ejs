<section class="section">
  <h3>⚠️ At Risk Students</h3>

  <div class="table-responsive">
    <table class="user-table sortable-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Lessons</th>
          <th>Completion %</th>
          <th>Quiz Avg</th>
          <th>Progress</th>
        </tr>
      </thead>
      <tbody>
        <% if (atRiskStudents.length > 0) { %>
          <% atRiskStudents.forEach(student => { %>
            <tr>
              <td><%= student.fullname %></td>
              <td>
                <%= student.completedLessons %> / 
                <%= student.totalLessons %>
              </td>
              <td style="color:#e74c3c;">
                <%= student.completionPercent %>%
              </td>
              <td style="color:#e74c3c;">
                <%= student.quizAvg %>%
              </td>
                <td>
                    <a href="/admin/students/<%= student.id %>/progress?from=admin"
                    class="btn-edit"
                    style="background:#e74c3c; color:#fff; padding:5px 8px; border-radius:4px; text-decoration:none;">
                    Progress
                    </a>
                </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align:center;">
              ✅ No students at risk
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('completionChart');

new Chart(ctx, {
  type: 'bar',
  data: {
    labels: <%- JSON.stringify(studentMetrics.map(s => s.fullname)) %>,
    datasets: [{
      label: 'Completion %',
      data: <%- JSON.stringify(studentMetrics.map(s => s.completionPercent)) %>
    }]
  }
});
</script>

<script>

document.addEventListener("DOMContentLoaded", () => {

    const btn = document.getElementById("btnFullReport");

    btn.addEventListener("click", () => {

        const termId =
            document.getElementById("termSelect").value;

        const url =
`/admin/reports/<%= classroom.school_id %>/<%= classroom.id %>/${termId}/download`;

        console.log(url);

        window.location.href = url;

    });

});

</script>
