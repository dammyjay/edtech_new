<%- include('../partials/adminHeader', { title: classroom.school_name }) %>


<section class="section">
    <div style="background:var(--grey);padding:20px;border-radius:8px;margin-bottom:20px;">
        <img src="<%= classroom.school_logo %>" alt="School Logo" style="width:100px;height:100px;object-fit:cover;">
        <h2><%= classroom.school_name %></h2>
        <p><strong>Email:</strong> <%= classroom.school_email %></p>
        <p><strong>Phone:</strong> <%= classroom.school_phone %></p>
        <p><strong>Address:</strong> <%= classroom.school_address %></p>

        

        <div class="multi-btn">
            <button class="btn-sec" onclick="window.location.href='/admin/schools/<%= classroom.school_id %>'">← Back to School Details</button>
            <button class="btn-pri" onclick="window.location.href='/admin/classrooms/<%= classroom.id %>/dashboard/export'">Download Classroom PDF</button>
        </div>

        <hr>

        <div class="report-generator">

            <label><strong>Select Academic Term</strong></label>

            <select id="termSelect">

                <% terms.forEach(term=>{ %>

                    <option value="<%= term.id %>">

                        <%= term.name %>

                    </option>

                <% }) %>

            </select>

            <button
                id="generateReportBtn"
                class="btn-pri">

                📄 Generate AI Term Report

            </button>

        </div>
    </div>
</section>

<section class="section">

    <h2>📑 Report Centre</h2>

    <div class="report-centre">

        <div class="report-header">

            <label for="termSelect">
                Academic Term
            </label>

            <select id="termSelect">

                <% terms.forEach(term => { %>

                    <option value="<%= term.id %>">
                        <%= term.name %>
                    </option>

                <% }) %>

            </select>

        </div>

        <div class="report-actions">

            <button id="btnFullReport" class="btn-pri">
                📄 Generate Full Class Report (PDF)
            </button>

            <button class="btn-sec">
                👨‍🎓 Generate Individual Reports
            </button>

            <button class="btn-sec">
                📧 Email Reports to Parents
            </button>

            <button class="btn-sec">
                📊 Export Excel Summary
            </button>

        </div>

    </div>

</section>

<h2>📊 <%= classroom.name %> - Classroom Analytics</h2>

<section class="section">
    <div class="engagement-grid">
        <div class="metric-card">
            <div class="card-title blue-bg">
                <p>Total Students</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon blue-bg">
                    <i class="fa-solid fa-users"></i>
                </div>
                <h4><%= totalStudents %></h4>
            </div>
        </div>

        <div class="metric-card">
            <div class="card-title green-bg">
                <p>Average Completion</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon green-bg">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <h4><%= averageCompletion %>%</h4>
            </div>
        </div>

        <div class="metric-card">
            <div class="card-title pink-bg">
                <p>Average Quiz Score</p>
            </div>
            <div class="metric-card-content">
                <div class="card-icon pink-bg">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <h4><%= averageQuiz %>%</h4>
            </div>
        </div>
    </div>
</section>


<hr>

<section class="section">
    <h3>📈 Lesson Completion Chart</h3>
    <canvas id="completionChart"></canvas>
</section>

<section class="section">
    <h3>🏆 Leaderboard</h3>
    <div class="table-responsive">
        <table class="user-table sortable-table">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Name</th>
                    <th>Lessons</th>
                    <th>Completion %</th>
                    <th>Quiz Avg</th>
                    <th>Overall</th>
                    <th>Progress</th>
                </tr>
            </thead>
            <tbody>
            <% leaderboard.forEach((student, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= student.fullname %></td>
                    <td>
                        <%= student.completedLessons %> / 
                        <%= student.totalLessons %>
                    </td>
                    <td><%= student.completionPercent %>%</td>
                    <td><%= student.quizAvg %>%</td>
                    <td><strong><%= student.overallScore %>%</strong></td>
                    <td>
                        <a href="/admin/students/<%= student.id %>/progress?from=admin"
                        class="btn-edit"
                        style="background:green; color:#fff; padding:5px 8px; border-radius:4px; text-decoration:none;">
                        Progress
                        </a>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
</section>


