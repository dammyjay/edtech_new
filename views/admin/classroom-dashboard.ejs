<%- include('../partials/adminHeader', { title: classroom.school_name }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div style="display:flex; align-items:center; gap:14px;">
      <img src="<%= classroom.school_logo %>" alt="" style="width:64px; height:64px; border-radius:12px; object-fit:cover; background:#FAF8F2;">
      <div>
        <h2><%= classroom.school_name %> — <%= classroom.name %></h2>
        <p><%= classroom.school_email %> · <%= classroom.school_phone %> · <%= classroom.school_address %></p>
      </div>
    </div>
    <div style="display:flex; gap:8px;">
      <button class="jk-btn-outline" onclick="window.location.href='/admin/schools/<%= classroom.school_id %>'" type="button">← Back to School Details</button>
      <button class="jk-btn-dark" onclick="window.location.href='/admin/classrooms/<%= classroom.id %>/dashboard/export<%= selectedTerm ? '?term_id=' + selectedTerm.id : '' %>'" type="button">Download Classroom PDF</button>
    </div>
  </div>

  <% if (terms && terms.length) { %>
  <div class="jk-toolbar" style="margin-bottom:28px;">
    <label style="font-size:12.5px; font-weight:700; color:#4C3802;">Analytics Term:</label>
    <select id="analyticsTermSelect" class="jk-select" onchange="window.location.href='/admin/classrooms/<%= classroom.id %>/dashboard?term_id=' + this.value">
      <% terms.forEach(t => { %>
      <option value="<%= t.id %>" <%= selectedTerm && selectedTerm.id === t.id ? 'selected' : '' %>>
          <%= t.name %><%= t.is_active ? ' (Active)' : '' %><%= t.is_ended ? ' (Ended)' : '' %>
      </option>
      <% }) %>
    </select>
    <span style="color:#8A7B55; font-size:12px;">Controls the metrics/leaderboard/course breakdown below — separate from the Report Centre's own term selector.</span>
  </div>
  <% } %>

  <div class="jk-report-panel">
    <h3>📑 Report Centre</h3>

    <div class="jk-toolbar" style="margin-top:12px;">
      <div>
        <label style="display:block; font-size:12px; font-weight:700; color:#4C3802; margin-bottom:4px;">Academic Term</label>
        <select id="termSelect" class="jk-select">
          <% terms.forEach(term=>{ %>
            <option value="<%= term.id %>"><%= term.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label style="display:block; font-size:12px; font-weight:700; color:#4C3802; margin-bottom:4px;">Student</label>
        <select id="studentSelect" class="jk-select">
          <% students.forEach(student=>{ %>
            <option value="<%= student.id %>"><%= student.fullname %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:14px;">
      <button id="btnFullReport" class="jk-btn-dark" type="button">📄 Generate Full Class Report</button>
      <button id="btnStudentReport" class="jk-btn-outline" type="button">👨‍🎓 Generate Student Report</button>
      <button class="jk-btn-outline" type="button">📧 Email Reports</button>
      <button class="jk-btn-outline" type="button">📊 Export Excel</button>
    </div>
  </div>

  <div class="jk-section-head" style="margin-top:28px;">
    <h3>📊 Classroom Analytics</h3>
  </div>

  <div class="jk-stat-grid" style="grid-template-columns: repeat(3, minmax(0,1fr));">
    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Total Students</span>
        <div class="jk-stat-icon" style="background:#E9F3FB;"><i class="fa-solid fa-users" style="color:#1F7AC9; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= totalStudents %></span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Average Completion</span>
        <div class="jk-stat-icon" style="background:#EAF7EE;"><i class="fa-solid fa-book-open" style="color:#1E7A42; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= averageCompletion %>%</span>
    </div>

    <div class="jk-stat-card">
      <div class="jk-stat-head">
        <span class="jk-stat-label">Average Quiz Score</span>
        <div class="jk-stat-icon" style="background:#FDEEEC;"><i class="fa-solid fa-chart-line" style="color:#C9598A; font-size:13px;"></i></div>
      </div>
      <span class="jk-stat-value"><%= averageQuiz %>%</span>
    </div>
  </div>

  <div class="jk-section-head" style="margin-top:28px;">
    <h3>📚 Courses This Term</h3>
  </div>
  <div class="jk-table-wrap" style="margin-bottom:28px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Level</th>
          <th>Lessons</th>
          <th>Students Engaged</th>
          <th>Avg Completion</th>
          <th>Avg Quiz Score</th>
        </tr>
      </thead>
      <tbody>
      <% if (courseBreakdown && courseBreakdown.length) { %>
        <% courseBreakdown.forEach(course => { %>
        <tr>
          <td><%= course.title %></td>
          <td><%= course.level || '-' %></td>
          <td><%= course.totalLessons %></td>
          <td><%= course.studentsEngaged %> / <%= course.totalStudents %></td>
          <td><%= course.avgCompletion %>%</td>
          <td><%= course.avgQuiz %>%</td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="6" style="text-align:center; color:#8A7B55;">No courses assigned to this classroom yet</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>

  <div class="jk-section-head">
    <h3>📈 Lesson Completion Chart</h3>
  </div>
  <div class="jk-report-panel" style="margin-bottom:28px;">
    <canvas id="completionChart"></canvas>
  </div>

  <div class="jk-section-head">
    <h3>🏆 Leaderboard</h3>
  </div>
  <div class="jk-table-wrap" style="margin-bottom:28px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Rank</th>
          <th>Name</th>
          <th>Lessons</th>
          <th>Completion %</th>
          <th>Quiz Avg</th>
          <th>Pace</th>
          <th>Overall</th>
          <th class="jk-col-actions"></th>
        </tr>
      </thead>
      <tbody>
      <% leaderboard.forEach((student, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= student.fullname %></td>
          <td>
              <%= student.completedLessons %> /
              <%= student.totalLessons %>
          </td>
          <td><%= student.completionPercent %>%</td>
          <td><%= student.quizAvg %>%</td>
          <td><%= student.avgDaysToComplete !== null ? student.avgDaysToComplete + 'd avg' : '-' %></td>
          <td><strong><%= student.overallScore %>%</strong></td>
          <td class="jk-col-actions">
              <a href="/admin/students/<%= student.id %>/progress?from=admin" class="jk-btn-outline-sm" style="text-decoration:none;">Progress</a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>

  <div class="jk-section-head">
    <h3>⚠️ At Risk Students</h3>
  </div>
  <div class="jk-table-wrap" style="margin-bottom:28px;">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Lessons</th>
          <th>Completion %</th>
          <th>Quiz Avg</th>
          <th class="jk-col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% if (atRiskStudents.length > 0) { %>
          <% atRiskStudents.forEach(student => { %>
            <tr>
              <td><%= student.fullname %></td>
              <td>
                <%= student.completedLessons %> /
                <%= student.totalLessons %>
              </td>
              <td style="color:#B23A2A; font-weight:700;">
                <%= student.completionPercent %>%
              </td>
              <td style="color:#B23A2A; font-weight:700;">
                <%= student.quizAvg %>%
              </td>
              <td class="jk-col-actions">
                  <a href="/admin/students/<%= student.id %>/progress?from=admin" class="jk-btn-outline-sm" style="text-decoration:none; color:#B23A2A; border-color:#F3D4CE;">Progress</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align:center; color:#8A7B55;">
              ✅ No students at risk
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (selectedTerm && selectedTerm.is_ended) { %>
  <div class="jk-section-head">
    <h3>🔒 Locked Students <small style="font-weight:normal; color:#8A7B55;">(term ended)</small></h3>
  </div>
  <p style="color:#6E6350; font-size:13px; margin-top:-12px;">
    This term has ended. Students below have unfinished lessons in it and are locked out of continuing
    until the term is reactivated for them — pay from their wallet (student-initiated), or reactivate here for free.
  </p>

  <% if (!lockedStudents || !lockedStudents.length) { %>
    <p style="color:#8A7B55;">✅ No students have unfinished, locked content in this term.</p>
  <% } else { %>
    <div class="jk-table-wrap">
      <table class="jk-table sortable-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Locked Courses</th>
            <th>Reactivation Price</th>
            <th class="jk-col-actions"></th>
          </tr>
        </thead>
        <tbody>
          <% lockedStudents.forEach(stu => { %>
            <tr>
              <td><%= stu.fullname %></td>
              <td>
                <%= stu.priceInfo.courses.map(c => c.title + ' (' + c.completedLessons + '/' + c.totalLessons + ')').join(', ') %>
              </td>
              <td>₦<%= stu.priceInfo.totalPrice.toLocaleString() %></td>
              <td class="jk-col-actions">
                <form method="POST" action="/admin/classrooms/<%= classroom.id %>/terms/<%= selectedTerm.id %>/students/<%= stu.id %>/reactivate">
                  <button type="submit" class="jk-btn-outline-sm" style="color:#1E7A42; border-color:#B6DFC4;">
                    🔓 Reactivate
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <% } %>

</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('completionChart');

new Chart(ctx, {
  type: 'bar',
  data: {
    labels: <%- JSON.stringify(studentMetrics.map(s => s.fullname)) %>,
    datasets: [{
      label: 'Completion %',
      data: <%- JSON.stringify(studentMetrics.map(s => s.completionPercent)) %>
    }]
  }
});
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

    // Sort student dropdown alphabetically
    const studentSelect = document.getElementById("studentSelect");

    const options = Array.from(studentSelect.options);

    options.sort((a, b) =>
        a.text.localeCompare(b.text, undefined, {
            sensitivity: "base"
        })
    );

    studentSelect.innerHTML = "";

    options.forEach(option => studentSelect.appendChild(option));

    // Existing buttons
    const fullBtn = document.getElementById("btnFullReport");
    const studentBtn = document.getElementById("btnStudentReport");

    // Generated reports are persisted (see services/classTermReportStore.js)
    // so the school admin can view them later — regenerating one for the
    // same classroom+term(+student) replaces the stored copy, so check
    // first and confirm before overwriting an existing one.
    async function generateReport(existsUrl, downloadUrl) {
        try {
            const res = await fetch(existsUrl);
            const data = await res.json();
            if (data.exists) {
                const when = data.generatedAt ? new Date(data.generatedAt).toLocaleString() : "earlier";
                if (!(await showConfirm(`A report was already generated on ${when} and is available to the school admin. Generate again and replace it?`))) {
                    return;
                }
            }
        } catch (err) {
            console.error("Could not check for an existing report:", err);
        }
        window.location.href = downloadUrl;
    }

    fullBtn.addEventListener("click", () => {
        const termId = document.getElementById("termSelect").value;
        if (!termId) { showAlert("Select a term first."); return; }

        generateReport(
            `/admin/reports/<%= classroom.school_id %>/<%= classroom.id %>/${termId}/exists`,
            `/admin/reports/<%= classroom.school_id %>/<%= classroom.id %>/${termId}/download`
        );
    });

    studentBtn.addEventListener("click", () => {
        const termId = document.getElementById("termSelect").value;
        const studentId = document.getElementById("studentSelect").value;
        if (!termId || !studentId) { showAlert("Select a term and a student first."); return; }

        generateReport(
            `/admin/reports/<%= classroom.school_id %>/<%= classroom.id %>/${termId}/student/${studentId}/exists`,
            `/admin/reports/<%= classroom.school_id %>/<%= classroom.id %>/${termId}/student/${studentId}/download`
        );
    });

});
</script>
