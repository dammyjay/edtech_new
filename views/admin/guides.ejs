    <%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div>
      <h2>Guides</h2>
      <p>Shared help text shown to students/parents/teachers on the relevant pages.</p>
    </div>
  </div>

<div class="login-tabs">

    <button class="login-tab active"
        onclick="openGuideTab('assignment-section',this)">
        Assignment Guide
    </button>

    <button class="login-tab"
        onclick="openGuideTab('course-section',this)">
        Course Guide
    </button>

    <button class="login-tab"
        onclick="openGuideTab('certificate-section',this)">
        Certificate Guide
    </button>

    <button class="login-tab"
        onclick="openGuideTab('parent-section',this)">
        Parent Guide
    </button>

    <button class="login-tab"
        onclick="openGuideTab('teacher-section',this)">
        Teacher Guide
    </button>

    <button class="login-tab"
        onclick="openGuideTab('external-project-section',this)">
        External Project Guide
    </button>

</div>


<div id="assignment-section" class="jk-report-panel">
<h3 style="margin-top:0;">Assignment Submission Guide</h3>
<p style="color:#8A7B55; font-size:12.5px; max-width:600px;">Shown to every student on their assignment submission page.</p>
<button onclick="openGuideModal('assignment')" class="jk-btn-dark">
    ✏️ Edit Guide
</button>
</div>

<div id="course-section" class="jk-report-panel" style="display:none">
<h3 style="margin-top:0;">Course Guide</h3>
<button onclick="openGuideModal('course')" class="jk-btn-dark">
    ✏️ Edit Guide
</button>
</div>

<div id="certificate-section" class="jk-report-panel" style="display:none">
<h3 style="margin-top:0;">Certificate Guide</h3>
<button onclick="openGuideModal('certificate')" class="jk-btn-dark">
    ✏️ Edit Guide
</button>
</div>

<div id="parent-section" class="jk-report-panel" style="display:none">
<h3 style="margin-top:0;">Parent Guide</h3>
<button onclick="openGuideModal('parent')" class="jk-btn-dark">
    ✏️ Edit Guide
</button>
</div>

<div id="teacher-section" class="jk-report-panel" style="display:none">
<h3 style="margin-top:0;">Teacher Guide</h3>
<button onclick="openGuideModal('teacher')" class="jk-btn-dark">
    ✏️ Edit Guide
</button>
</div>

<div id="external-project-section" class="jk-report-panel" style="display:none">
<h3 style="margin-top:0;">External Project Guide</h3>
<p style="color:#8A7B55; font-size:12.5px; max-width:600px;">
    Shown to every student on every External Project submission page — write it once here
    (how to zip a project, how to share a GitHub link, how to get a shareable video link) instead of
    every instructor re-explaining it per task. sample_submission can hold a worked example of a
    genuinely good submission.
</p>
<button onclick="openGuideModal('external_project')" class="jk-btn-dark">
    ✏️ Edit Guide
</button>
</div>

</section>



<!-- ASSIGNMENT GUIDE MODAL -->

<div id="guideModal"
     class="modal"
     style="display:none;">

<form id="guideForm"
      class="modal-content"
      enctype="multipart/form-data">

<input type="hidden"
       id="guideType"
       name="guide_type">

<input type="hidden"
       id="guideId">

<span class="close" onclick="closeGuideModal()">&times;</span>

<h2 id="guideHeading"></h2>

<label>Title</label>

<input
type="text"
id="guideTitle"
name="title"
required>

<label>Description</label>

<textarea
id="guideDescription"
name="description"></textarea>

<label>YouTube Video</label>

<input
type="text"
id="guideVideo"
name="video_url">

<label>Sample Assignment Question</label>

<textarea
    id="sampleQuestion"
    name="sample_question">
</textarea>

<label>Sample Submission</label>

<textarea
    id="sampleSubmission"
    name="sample_submission">
</textarea>

<div class="modal-actions">

<button type="submit">
Save Guide
</button>

<button
type="button"
onclick="deleteGuide()">
Delete
</button>

<button
type="button"
onclick="closeGuideModal()">
Cancel
</button>

</div>

</form>

</div>

<script>
    
    let editorInitialized = false;

    async function openGuideModal(type){

        document.getElementById("guideModal").style.display = "block";

        document.getElementById("guideType").value = type;

        document.getElementById("guideHeading").innerText =
            type.charAt(0).toUpperCase() + type.slice(1) + " Guide";

        if (!editorInitialized) {

            CKEDITOR.replace("guideDescription");

            CKEDITOR.replace("sampleQuestion");

            CKEDITOR.replace("sampleSubmission");

            editorInitialized = true;
        }

        await loadGuide(type);

    }
        
    function closeGuideModal(){

            document.getElementById("guideModal").style.display="none";

        }

async function loadGuide(type){

    const res = await fetch(`/admin/guides/${type}`);

    const data = await res.json();

   if(!data.success){

        showAlert("Unable to load guide.");

        return;

    }

    document.getElementById("guideTitle").value =
        data.guide?.title || "";

    document.getElementById("guideVideo").value =
        data.guide?.video_url || "";

    CKEDITOR.instances.guideDescription.setData(
        data.guide?.description || ""
    );

    CKEDITOR.instances.sampleQuestion.setData(
        data.guide?.sample_question || ""
    );

    CKEDITOR.instances.sampleSubmission.setData(
        data.guide?.sample_submission || ""
    );

}

async function deleteGuide(){

    const type =
        document.getElementById("guideType").value;

    if(!(await showConfirm("Delete this guide?"))){
        return;
    }

    const res = await fetch(`/admin/guides/${type}`,{

        method:"DELETE"

    });

    const data = await res.json();

    if(data.success){

        showAlert("Guide deleted.").then(() => {

            closeGuideModal();

        });

    }

}

    document.getElementById("guideForm")
.addEventListener("submit", async function(e){

    e.preventDefault();

    CKEDITOR.instances.guideDescription.updateElement();

    CKEDITOR.instances.sampleQuestion.updateElement();

    CKEDITOR.instances.sampleSubmission.updateElement();

    const formData = new FormData(this);

    const res = await fetch("/admin/guides/save",{

        method:"POST",

        body:formData

    });

    const data = await res.json();

    if(data.success){

        showAlert("Guide Saved").then(() => {

            closeGuideModal();

        });

    }

});


    function openGuideTab(sectionId, btn){

        const sections=[
            "assignment-section",
            "course-section",
            "certificate-section",
            "parent-section",
            "teacher-section",
            "external-project-section"
        ];

        sections.forEach(id=>{
            document.getElementById(id).style.display="none";
        });

        document.getElementById(sectionId).style.display="block";

        document.querySelectorAll(".login-tab")
        .forEach(tab=>tab.classList.remove("active"));

        btn.classList.add("active");
    }

    // Close any modal when clicking outside it
    window.onclick = function (event) {
        if (event.target.classList.contains("modal")) {
            event.target.style.display = "none";
        }
    };
</script>
