<div id="guideModal"
     class="modal"
     style="display:none;">

<form id="guideForm"
      class="modal-content"
      enctype="multipart/form-data">

<input type="hidden"
       id="guideType"
       name="guide_type">

<input type="hidden"
       id="guideId">

<h2 id="guideHeading"></h2>

<label>Title</label>

<input
type="text"
id="guideTitle"
name="title"
required>

<label>Description</label>

<textarea
id="guideDescription"
name="description"></textarea>

<label>YouTube Video</label>

<input
type="text"
id="guideVideo"
name="video_url">

<label>Sample Assignment Question</label>

<textarea
    id="sampleQuestion"
    name="sample_question">
</textarea>

<label>Sample Submission</label>

<textarea
    id="sampleSubmission"
    name="sample_submission">
</textarea>

<div class="modal-actions">

<button type="submit">
Save Guide
</button>

<button
type="button"
onclick="deleteGuide()">
Delete
</button>

<button
type="button"
onclick="closeGuideModal()">
Cancel
</button>

</div>

</form>

</div>

<script>
    
    let editorInitialized = false;

    async function openGuideModal(type){

        document.getElementById("guideModal").style.display = "block";

        document.getElementById("guideType").value = type;

        document.getElementById("guideHeading").innerText =
            type.charAt(0).toUpperCase() + type.slice(1) + " Guide";

        if (!editorInitialized) {

            CKEDITOR.replace("guideDescription");

            CKEDITOR.replace("sampleQuestion");

            CKEDITOR.replace("sampleSubmission");

            editorInitialized = true;
        }

        await loadGuide(type);

    }
        
    function closeGuideModal(){

            document.getElementById("guideModal").style.display="none";

        }

async function loadGuide(type){

    const res = await fetch(`/admin/guides/${type}`);

    const data = await res.json();

   if(!data.success){

        showAlert("Unable to load guide.");

        return;

    }

    document.getElementById("guideTitle").value =
        data.guide?.title || "";

    document.getElementById("guideVideo").value =
        data.guide?.video_url || "";

    CKEDITOR.instances.guideDescription.setData(
        data.guide?.description || ""
    );

    CKEDITOR.instances.sampleQuestion.setData(
        data.guide?.sample_question || ""
    );

    CKEDITOR.instances.sampleSubmission.setData(
        data.guide?.sample_submission || ""
    );

}

async function deleteGuide(){

    const type =
        document.getElementById("guideType").value;

    if(!(await showConfirm("Delete this guide?"))){
        return;
    }

    const res = await fetch(`/admin/guides/${type}`,{

        method:"DELETE"

    });

    const data = await res.json();

    if(data.success){

        showAlert("Guide deleted.").then(() => {

            closeGuideModal();

        });

    }

}

    document.getElementById("guideForm")
.addEventListener("submit", async function(e){

    e.preventDefault();

    CKEDITOR.instances.guideDescription.updateElement();

    CKEDITOR.instances.sampleQuestion.updateElement();

    CKEDITOR.instances.sampleSubmission.updateElement();

    const formData = new FormData(this);

    const res = await fetch("/admin/guides/save",{

        method:"POST",

        body:formData

    });

    const data = await res.json();

    if(data.success){

        showAlert("Guide Saved").then(() => {

            closeGuideModal();

        });

    }

});


    function openGuideTab(sectionId, btn){

        const sections=[
            "assignment-section",
            "course-section",
            "certificate-section",
            "parent-section",
            "teacher-section"
        ];

        sections.forEach(id=>{
            document.getElementById(id).style.display="none";
        });

        document.getElementById(sectionId).style.display="block";

        document.querySelectorAll(".login-tab")
        .forEach(tab=>tab.classList.remove("active"));

        btn.classList.add("active");
    }
</script>
