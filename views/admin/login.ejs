<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login — <%= (info?.company_name || 'JKT Hub').trim() %></title>
  <link rel="icon" type="image/x-icon" href="/images/JKT logo bg.png" />

  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/styles2.css" />
  <link rel="stylesheet" href="/css/styles3.css" />

  <% const ogTitle = 'Login — ' + (info?.company_name || 'JKT Hub').trim();
     const ogDescription = 'Access your dashboard, courses, and progress.';
     const ogImage = info?.hero_image_url || info?.logo_url;
     const ogUrl = 'https://acad.jkthub.com/admin/login';
       const ogType = 'website'; %>
  <%- include('../partials/ogMeta', { ogTitle, ogDescription, ogImage, ogUrl, ogType }) %>

 <style>
  /* =========================
    MOBILE
  ========================= */

  /* @media(max-width:768px){

    .login-tabs{
      flex-direction:column;
    }

    .selection-launcher{
      padding:12px;
    }

    .selection-launcher img{
      width:55px;
      height:55px;
    }

    .student-grid{
      grid-template-columns:repeat(2,1fr);
    }

    .selection-grid{
      grid-template-columns:repeat(2,1fr);
    }

  } */

</style>
</head>

<!-- class="signup-body" -->
<body >
<div class="login-container">
  <div class="form-container">

    <!-- <h2>Login</h2> -->
    <p>Select you login method and enter your login details</p>

    <% if (typeof error !== "undefined" && error) { %>
      <p style="color:red;"><%= error %></p>
    <% } %>

    <!-- =========================
      TABS
    ========================== -->

    <div class="login-tabs scroll-tabs">

      <button
        type="button"
        class="login-tab active"
        onclick="switchTab('normal', this)"
      >
        <!-- <div class="tab-icon">🔐</div> -->
        <span>Email Login</span>
      </button>

      <button
        type="button"
        class="login-tab"
        onclick="switchTab('student', this)"
      >
        <!-- <div class="tab-icon">🎓</div> -->
        <span>School Student Login</span>
      </button>

    </div>

    <!-- =========================
      NORMAL LOGIN
    ========================== -->

    <div id="normal-login" class="login-section active">

      <form
        action="/admin/login<%= redirect ? ('?redirect=' + encodeURIComponent(redirect)) : '' %>"
        method="POST"
      >

        <input
          type="email"
          name="email"
          placeholder="Email"
          required
        />

        <br><br>

        <input
          type="password"
          name="password"
          id="password"
          placeholder="Password"
          required
        />

        <br>

        <div style="display:flex;align-items:center;gap:8px;margin-top:10px;">
          <input style="width: fit-content;" type="checkbox" onclick="togglePassword()">
          <label style="width: 100%;">
            Show Password
          </label>
        </div>

        <br><br>

        <p style="text-align:center;">
          <a href="/admin/forgot-password">
            Forgot Password?
          </a>
        </p>

        <button type="submit" style="width:100%;" class="btn-sec">
          Login
        </button>

      </form>

    </div>

    <!-- =========================
      STUDENT LOGIN
    ========================== -->

    <div id="student-login" class="login-section">

      <!-- SCHOOL BUTTON -->

      <div
        class="selection-launcher"
        onclick="openSchoolModal()"
      >
        <img src="/images/school.png" alt="">
        <div>
          <h3>Select School</h3>
          <p id="selectedSchoolText">
            Tap to choose school
          </p>
        </div>
      </div>

      <!-- CLASSROOM BUTTON -->

      <div
        class="selection-launcher"
        onclick="openClassroomModal()"
      >
        <img src="/images/classroom.png" alt="">
        <div>
          <h3>Select Classroom</h3>
          <p id="selectedClassroomText">
            Tap to choose classroom
          </p>
        </div>
      </div>

      <!-- STUDENTS -->

      <div id="studentGrid" class="student-grid"></div>

    </div>

    <p style="text-align:center;margin-top:20px;">
      Don't have an account?
      <a href="/signup">Signup</a>
    </p>

  </div>
  <div class="form-image">

    <% if (info?.logo_url) { %>
    <img
      src="<%= info.logo_url %>"
      alt="Login Illustration"
    >
    <% } %>

    <h2>Welcome Back</h2>

    <p style="color:white">
      Access your dashboard, manage courses,
      students, content, and monitor activities
      from one central location.
    </p>

  </div>
</div>

  <!-- =========================
    SCHOOL MODAL
  ========================== -->
  <div id="schoolModal" class="pin-modal">

    <div class="selection-modal-box">

      <button
        class="pin-close"
        onclick="closeSchoolModal()"
      >
        &times;
      </button>

      <h3>Select School</h3>

      <div
        id="schoolGrid"
        class="selection-grid"
      ></div>

    </div>

  </div>

  <!-- =========================
    CLASSROOM MODAL
  ========================== -->

  <div id="classroomModal" class="pin-modal">

    <div class="selection-modal-box">

      <button
        class="pin-close"
        onclick="closeClassroomModal()"
      >
        &times;
      </button>

      <h3>Select Classroom</h3>

      <div
        id="classroomGrid"
        class="selection-grid"
      ></div>

    </div>

  </div>

  <!-- =========================
    PIN MODAL
  ========================== -->

  <div id="pinModal" class="pin-modal">

    <div class="pin-box">

      <button
        type="button"
        class="pin-close"
        onclick="closePinModal()"
      >
        &times;
      </button>

      <h3 id="studentName"></h3>

      <img
        id="studentAvatar"
        src=""
        width="90"
        height="90"
        style="
          border-radius:50%;
          object-fit:cover;
          margin-top:10px;
        "
      >

      <input
        type="password"
        maxlength="4"
        id="studentPin"
        placeholder="Enter PIN"
      >

      <button onclick="submitStudentLogin()">
        Login
      </button>

    </div>

  </div>

  <!-- =========================
    OTP MODAL
  ========================== -->

  <div
    id="otp-modal"
    class="otp-modal"
    style="display:none;"
  >

    <div>

      <p style="color:#218838">
        Please check your email for verification OTP.
      </p>

      <input
        id="otp-input"
        placeholder="Enter OTP"
      />

      <button
        id="verifyBtn"
        onclick="verifyOtp()"
      >
        Verify OTP
      </button>

      <button id="resendBtn">
        Resend OTP
      </button>

      <span id="resendTimer"></span>

    </div>

  </div>

  <% if (pendingEmail && pendingEmail.length > 0) { %>

    <script>

      localStorage.setItem(
        "pendingEmail",
        "<%= pendingEmail %>"
      );

      document.getElementById("otp-modal")
        .style.display = "flex";

    </script>

  <% } %>

  <!-- =========================
    JAVASCRIPT
  ========================== -->

  <script>

    let selectedStudentId = null;
    let selectedSchoolId = null;
    let selectedClassroomId = null;

    // =========================
    // TAB SWITCH
    // =========================

    function switchTab(type, btn){

      document
        .querySelectorAll(".login-tab")
        .forEach(tab => tab.classList.remove("active"));

      btn.classList.add("active");

      document
        .querySelectorAll(".login-section")
        .forEach(sec => sec.classList.remove("active"));

      if(type === "normal"){
        document
          .getElementById("normal-login")
          .classList.add("active");
      }

      if(type === "student"){
        document
          .getElementById("student-login")
          .classList.add("active");
      }

    }

    // =========================
    // SHOW PASSWORD
    // =========================

    function togglePassword(){

      const pwd =
        document.getElementById("password");

      pwd.type =
        pwd.type === "password"
        ? "text"
        : "password";

    }

    // =========================
    // SCHOOL MODAL
    // =========================

    function openSchoolModal(){
      document.getElementById("schoolModal")
        .style.display = "flex";
    }

    function closeSchoolModal(){
      document.getElementById("schoolModal")
        .style.display = "none";
    }

    // =========================
    // CLASSROOM MODAL
    // =========================

    function openClassroomModal(){

      if(!selectedSchoolId){
        return alert("Please select a school first");
      }

      document.getElementById("classroomModal")
        .style.display = "flex";
    }

    function closeClassroomModal(){
      document.getElementById("classroomModal")
        .style.display = "none";
    }

    // =========================
    // PIN MODAL
    // =========================

    function openPinModal(id, name, avatar){

      selectedStudentId = id;

      document.getElementById("studentName")
        .innerText = name;

      document.getElementById("studentAvatar")
        .src = avatar;

      document.getElementById("studentPin")
        .value = "";

      document.getElementById("pinModal")
        .style.display = "flex";

    }

    function closePinModal(){

      document.getElementById("pinModal")
        .style.display = "none";

      document.getElementById("studentPin")
        .value = "";

    }

    // =========================
    // CLOSE MODALS ON BACKDROP
    // =========================

    window.addEventListener("click", function(e){

      ["schoolModal","classroomModal","pinModal"]
        .forEach(id => {

          const modal =
            document.getElementById(id);

          if(e.target === modal){
            modal.style.display = "none";
          }

        });

    });

    // =========================
    // LOAD SCHOOLS
    // =========================

    async function loadSchools(){

      try{

        const res =
          await fetch("/admin/api/schools");

        const schools =
          await res.json();

        const grid =
          document.getElementById("schoolGrid");

        grid.innerHTML = "";

        schools.forEach(school => {

          grid.innerHTML += `
            <div
              class="selection-card"
              onclick="selectSchool(
                '${school.id}',
                '${school.name}'
              )"
            >

              <img src="/images/school.png">

              <p>${school.name}</p>

            </div>
          `;

        });

      }catch(err){

        console.error(err);

      }

    }

    loadSchools();

    // =========================
    // SELECT SCHOOL
    // =========================

    async function selectSchool(id, name){

      selectedSchoolId = id;

      document.getElementById("selectedSchoolText")
        .innerText = name;

      document.getElementById("selectedClassroomText")
        .innerText = "Tap to choose classroom";

      document.getElementById("studentGrid")
        .innerHTML = "";

      closeSchoolModal();

      try{

        const res =
          await fetch(`/admin/api/schools/${id}/classrooms`);

        const classrooms =
          await res.json();

        const grid =
          document.getElementById("classroomGrid");

        grid.innerHTML = "";

        classrooms.forEach(classroom => {

          grid.innerHTML += `
            <div
              class="selection-card"
              onclick="selectClassroom(
                '${classroom.id}',
                '${classroom.name}'
              )"
            >

              <img src="/images/classroom.png">

              <p>${classroom.name}</p>

            </div>
          `;

        });

      }catch(err){

        console.error(err);

      }

    }

    // =========================
    // SELECT CLASSROOM
    // =========================

    async function selectClassroom(id, name){

      selectedClassroomId = id;

      document.getElementById("selectedClassroomText")
        .innerText = name;

      closeClassroomModal();

      try{

        const res =
          await fetch(`/admin/classrooms/${id}/students`);

        const students =
          await res.json();

        const grid =
          document.getElementById("studentGrid");

        grid.innerHTML = "";

        students.forEach(student => {

          grid.innerHTML += `
            <div
              class="student-card"
              onclick="openPinModal(
                '${student.id}',
                \`${student.fullname}\`,
                '${student.avatar_url || "/profile.webp"}'
              )"
            >

              <img
                src="${student.avatar_url || "/profile.webp"}"
              >

              <p>${student.fullname}</p>

            </div>
          `;

        });

      }catch(err){

        console.error(err);

      }

    }

    // =========================
    // STUDENT LOGIN
    // =========================

    async function submitStudentLogin(){

      const pin =
        document.getElementById("studentPin")
        .value;

      if(!pin){
        return alert("Enter PIN");
      }

      try{

        const res =
          await fetch("/admin/student/avatar-login",{
            method:"POST",
            headers:{
              "Content-Type":"application/json"
            },
            body:JSON.stringify({
              studentId:selectedStudentId,
              pin
            })
          });

        const data =
          await res.json();

        if(data.success){

          window.location.href =
            data.redirect;

        }else{

          alert(data.message || "Login failed");

        }

      }catch(err){

        console.error(err);

        alert("Server error");

      }

    }

    // =========================
    // VERIFY OTP
    // =========================

    async function verifyOtp(){

      const otp =
        document.getElementById("otp-input")
        .value;

      const email =
        localStorage.getItem("pendingEmail");

      if(!email){
        return alert("Email not found");
      }

      try{

        const res =
          await fetch("/verify-otp",{
            method:"POST",
            headers:{
              "Content-Type":"application/json"
            },
            body:JSON.stringify({
              email,
              otp
            })
          });

        const data =
          await res.json();

        alert(data.message);

        if(data.success){

          localStorage.removeItem("pendingEmail");

          window.location.href =
            "/admin/login";

        }

      }catch(err){

        console.error(err);

        alert("OTP verification failed");

      }

    }

    // =========================
    // RESEND OTP
    // =========================

    document
      .getElementById("resendBtn")
      .addEventListener("click", async ()=>{

        const email =
          localStorage.getItem("pendingEmail");

        if(!email) return;

        const res =
          await fetch("/resend-otp",{
            method:"POST",
            headers:{
              "Content-Type":"application/json"
            },
            body:JSON.stringify({ email })
          });

        const data =
          await res.json();

        alert(data.message);

      });

  </script>

</body>

</html>
