<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login</title>

  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/styles2.css" />
  <link rel="stylesheet" href="/css/styles3.css" />

 <style>

  /* =========================
    TABS
  ========================= */

  .login-tabs{
    display:flex;
    gap:15px;
    margin-bottom:25px;
  }

  .login-tab{
    flex:1;
    border:none;
    border-radius:18px;
    padding:18px;
    cursor:pointer;
    background:#f5f5f5;
    transition:.3s;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
    font-weight:bold;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
    color:#000;
  }

  .login-tab:hover{
    transform:translateY(-3px);
  }

  .login-tab.active{
    background:#000;
    color:#fff;
  }

  .tab-icon{
    font-size:30px;
  }

  /* =========================
    LOGIN SECTION
  ========================= */

  .login-section{
    display:none;
  }

  .login-section.active{
    display:block;
  }

  /* =========================
    SELECT BUTTONS
  ========================= */

  .selection-launcher{
    display:flex;
    align-items:center;
    gap:15px;
    background:#fff;
    border-radius:18px;
    padding:15px;
    margin-bottom:18px;
    cursor:pointer;
    transition:.3s;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
  }

  .selection-launcher:hover{
    transform:translateY(-3px);
  }

  .selection-launcher img{
    width:65px;
    height:65px;
    object-fit:cover;
    border-radius:15px;
  }

  .selection-launcher h3{
    margin:0;
    font-size:18px;
    color:#111;
  }

  .selection-launcher p{
    margin-top:4px;
    color:#666;
    font-size:14px;
  }

  /* =========================
    MODALS
  ========================= */

  .pin-modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.6);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:9999;
    padding:20px;
  }

  .selection-modal-box{
    width:100%;
    max-width:700px;
    background:#fff;
    border-radius:25px;
    padding:25px;
    position:relative;
    max-height:85vh;
    overflow-y:auto;
  }

  .selection-modal-box h3{
    margin-bottom:20px;
    text-align:center;
  }

  /* =========================
    SCHOOL & CLASSROOM GRID
  ========================= */

  .selection-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(130px,1fr));
    gap:18px;
  }

  .selection-card{
    background:#f9f9f9;
    border-radius:18px;
    padding:18px 12px;
    text-align:center;
    cursor:pointer;
    transition:.3s;
    border:2px solid transparent;
  }

  .selection-card:hover{
    transform:translateY(-4px);
    border-color:#000;
    background:#fff;
  }

  .selection-card img{
    width:70px;
    height:70px;
    object-fit:cover;
    border-radius:16px;
    margin-bottom:10px;
  }

  .selection-card p{
    font-size:14px;
    font-weight:600;
    color:#222;
    margin:0;
  }

  /* =========================
    STUDENTS
  ========================= */

  .student-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(120px,1fr));
    gap:18px;
    margin-top:25px;
  }

  .student-card{
    background:#fff;
    border-radius:20px;
    padding:18px 10px;
    text-align:center;
    cursor:pointer;
    transition:.3s;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
  }

  .student-card:hover{
    transform:translateY(-4px);
    background:#f9f9f9;
  }

  .student-card img{
    width:80px;
    height:80px;
    border-radius:50%;
    object-fit:cover;
    margin-bottom:10px;
    border:3px solid #eee;
  }

  .student-card p{
    font-size:14px;
    font-weight:600;
    margin:0;
    color:#222;
  }

  /* =========================
    PIN MODAL
  ========================= */

  .pin-box{
    background:#fff;
    padding:30px;
    border-radius:25px;
    width:100%;
    max-width:340px;
    text-align:center;
    position:relative;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
  }

  .pin-box h3{
    margin-bottom:10px;
  }

  .pin-box input{
    width:100%;
    padding:14px;
    margin:20px 0;
    text-align:center;
    font-size:24px;
    letter-spacing:5px;
    border-radius:12px;
    border:1px solid #ddd;
    outline:none;
  }

  .pin-box button:not(.pin-close){
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#000;
    color:#fff;
    font-size:16px;
    cursor:pointer;
  }

  /* =========================
    CLOSE BUTTON
  ========================= */

  .pin-close{
    position:absolute;
    top:10px;
    right:14px;
    background:none;
    border:none;
    font-size:28px;
    cursor:pointer;
    color:#555;
  }

  .pin-close:hover{
    color:red;
  }

  /* =========================
    MOBILE
  ========================= */

  @media(max-width:768px){

    .login-tabs{
      flex-direction:column;
    }

    .selection-launcher{
      padding:12px;
    }

    .selection-launcher img{
      width:55px;
      height:55px;
    }

    .student-grid{
      grid-template-columns:repeat(2,1fr);
    }

    .selection-grid{
      grid-template-columns:repeat(2,1fr);
    }

  }

</style>
</head>

<body class="signup-body">

  <div class="form-container">

    <h2>Login</h2>
    <p>Please enter your login details</p>

    <% if (typeof error !== "undefined" && error) { %>
      <p style="color:red;"><%= error %></p>
    <% } %>

    <!-- =========================
      TABS
    ========================== -->

    <div class="login-tabs">

      <button
        type="button"
        class="login-tab active"
        onclick="switchTab('normal', this)"
      >
        <div class="tab-icon">🔐</div>
        <span>Email Login</span>
      </button>

      <button
        type="button"
        class="login-tab"
        onclick="switchTab('student', this)"
      >
        <div class="tab-icon">🎓</div>
        <span>School Student Login</span>
      </button>

    </div>

    <!-- =========================
      NORMAL LOGIN
    ========================== -->

    <div id="normal-login" class="login-section active">

      <form
        action="/admin/login<%= redirect ? ('?redirect=' + encodeURIComponent(redirect)) : '' %>"
        method="POST"
      >

        <input
          type="email"
          name="email"
          placeholder="Email"
          required
        />

        <br><br>

        <input
          type="password"
          name="password"
          id="password"
          placeholder="Password"
          required
        />

        <br>

        <label>
          <input type="checkbox" onclick="togglePassword()">
          Show Password
        </label>

        <br><br>

        <p style="text-align:center;">
          <a href="/admin/forgot-password">
            Forgot Password?
          </a>
        </p>

        <button type="submit" style="width:100%;">
          Login
        </button>

      </form>

    </div>

    <!-- =========================
      STUDENT LOGIN
    ========================== -->

    <div id="student-login" class="login-section">

      <!-- SCHOOL BUTTON -->

      <div
        class="selection-launcher"
        onclick="openSchoolModal()"
      >
        <img src="/images/school.png" alt="">
        <div>
          <h3>Select School</h3>
          <p id="selectedSchoolText">
            Tap to choose school
          </p>
        </div>
      </div>

      <!-- CLASSROOM BUTTON -->

      <div
        class="selection-launcher"
        onclick="openClassroomModal()"
      >
        <img src="/images/classroom.png" alt="">
        <div>
          <h3>Select Classroom</h3>
          <p id="selectedClassroomText">
            Tap to choose classroom
          </p>
        </div>
      </div>

      <!-- STUDENTS -->

      <div id="studentGrid" class="student-grid"></div>

    </div>

    <p style="text-align:center;margin-top:20px;">
      Don't have an account?
      <a href="/signup">Signup</a>
    </p>

  </div>

  <!-- =========================
    SCHOOL MODAL
  ========================== -->

  <div id="schoolModal" class="pin-modal">

    <div class="selection-modal-box">

      <button
        class="pin-close"
        onclick="closeSchoolModal()"
      >
        &times;
      </button>

      <h3>Select School</h3>

      <div
        id="schoolGrid"
        class="selection-grid"
      ></div>

    </div>

  </div>

  <!-- =========================
    CLASSROOM MODAL
  ========================== -->

  <div id="classroomModal" class="pin-modal">

    <div class="selection-modal-box">

      <button
        class="pin-close"
        onclick="closeClassroomModal()"
      >
        &times;
      </button>

      <h3>Select Classroom</h3>

      <div
        id="classroomGrid"
        class="selection-grid"
      ></div>

    </div>

  </div>

  <!-- =========================
    PIN MODAL
  ========================== -->

  <div id="pinModal" class="pin-modal">

    <div class="pin-box">

      <button
        type="button"
        class="pin-close"
        onclick="closePinModal()"
      >
        &times;
      </button>

      <h3 id="studentName"></h3>

      <img
        id="studentAvatar"
        src=""
        width="90"
        height="90"
        style="
          border-radius:50%;
          object-fit:cover;
          margin-top:10px;
        "
      >

      <input
        type="password"
        maxlength="4"
        id="studentPin"
        placeholder="Enter PIN"
      >

      <button onclick="submitStudentLogin()">
        Login
      </button>

    </div>

  </div>

  <!-- =========================
    OTP MODAL
  ========================== -->

  <div
    id="otp-modal"
    class="otp-modal"
    style="display:none;"
  >

    <div>

      <p style="color:#218838">
        Please check your email for verification OTP.
      </p>

      <input
        id="otp-input"
        placeholder="Enter OTP"
      />

      <button
        id="verifyBtn"
        onclick="verifyOtp()"
      >
        Verify OTP
      </button>

      <button id="resendBtn">
        Resend OTP
      </button>

      <span id="resendTimer"></span>

    </div>

  </div>

  <% if (pendingEmail && pendingEmail.length > 0) { %>

    <script>

      localStorage.setItem(
        "pendingEmail",
        "<%= pendingEmail %>"
      );

      document.getElementById("otp-modal")
        .style.display = "flex";

    </script>

  <% } %>

  <!-- =========================
    JAVASCRIPT
  ========================== -->

  <script>

    let selectedStudentId = null;
    let selectedSchoolId = null;
    let selectedClassroomId = null;

    // =========================
    // TAB SWITCH
    // =========================

    function switchTab(type, btn){

      document
        .querySelectorAll(".login-tab")
        .forEach(tab => tab.classList.remove("active"));

      btn.classList.add("active");

      document
        .querySelectorAll(".login-section")
        .forEach(sec => sec.classList.remove("active"));

      if(type === "normal"){
        document
          .getElementById("normal-login")
          .classList.add("active");
      }

      if(type === "student"){
        document
          .getElementById("student-login")
          .classList.add("active");
      }

    }

    // =========================
    // SHOW PASSWORD
    // =========================

    function togglePassword(){

      const pwd =
        document.getElementById("password");

      pwd.type =
        pwd.type === "password"
        ? "text"
        : "password";

    }

    // =========================
    // SCHOOL MODAL
    // =========================

    function openSchoolModal(){
      document.getElementById("schoolModal")
        .style.display = "flex";
    }

    function closeSchoolModal(){
      document.getElementById("schoolModal")
        .style.display = "none";
    }

    // =========================
    // CLASSROOM MODAL
    // =========================

    function openClassroomModal(){

      if(!selectedSchoolId){
        return alert("Please select a school first");
      }

      document.getElementById("classroomModal")
        .style.display = "flex";
    }

    function closeClassroomModal(){
      document.getElementById("classroomModal")
        .style.display = "none";
    }

    // =========================
    // PIN MODAL
    // =========================

    function openPinModal(id, name, avatar){

      selectedStudentId = id;

      document.getElementById("studentName")
        .innerText = name;

      document.getElementById("studentAvatar")
        .src = avatar;

      document.getElementById("studentPin")
        .value = "";

      document.getElementById("pinModal")
        .style.display = "flex";

    }

    function closePinModal(){

      document.getElementById("pinModal")
        .style.display = "none";

      document.getElementById("studentPin")
        .value = "";

    }

    // =========================
    // CLOSE MODALS ON BACKDROP
    // =========================

    window.addEventListener("click", function(e){

      ["schoolModal","classroomModal","pinModal"]
        .forEach(id => {

          const modal =
            document.getElementById(id);

          if(e.target === modal){
            modal.style.display = "none";
          }

        });

    });

    // =========================
    // LOAD SCHOOLS
    // =========================

    async function loadSchools(){

      try{

        const res =
          await fetch("/admin/api/schools");

        const schools =
          await res.json();

        const grid =
          document.getElementById("schoolGrid");

        grid.innerHTML = "";

        schools.forEach(school => {

          grid.innerHTML += `
            <div
              class="selection-card"
              onclick="selectSchool(
                '${school.id}',
                '${school.name}'
              )"
            >

              <img src="/images/school.png">

              <p>${school.name}</p>

            </div>
          `;

        });

      }catch(err){

        console.error(err);

      }

    }

    loadSchools();

    // =========================
    // SELECT SCHOOL
    // =========================

    async function selectSchool(id, name){

      selectedSchoolId = id;

      document.getElementById("selectedSchoolText")
        .innerText = name;

      document.getElementById("selectedClassroomText")
        .innerText = "Tap to choose classroom";

      document.getElementById("studentGrid")
        .innerHTML = "";

      closeSchoolModal();

      try{

        const res =
          await fetch(`/admin/api/schools/${id}/classrooms`);

        const classrooms =
          await res.json();

        const grid =
          document.getElementById("classroomGrid");

        grid.innerHTML = "";

        classrooms.forEach(classroom => {

          grid.innerHTML += `
            <div
              class="selection-card"
              onclick="selectClassroom(
                '${classroom.id}',
                '${classroom.name}'
              )"
            >

              <img src="/images/classroom.png">

              <p>${classroom.name}</p>

            </div>
          `;

        });

      }catch(err){

        console.error(err);

      }

    }

    // =========================
    // SELECT CLASSROOM
    // =========================

    async function selectClassroom(id, name){

      selectedClassroomId = id;

      document.getElementById("selectedClassroomText")
        .innerText = name;

      closeClassroomModal();

      try{

        const res =
          await fetch(`/admin/classrooms/${id}/students`);

        const students =
          await res.json();

        const grid =
          document.getElementById("studentGrid");

        grid.innerHTML = "";

        students.forEach(student => {

          grid.innerHTML += `
            <div
              class="student-card"
              onclick="openPinModal(
                '${student.id}',
                \`${student.fullname}\`,
                '${student.avatar_url || "/profile.webp"}'
              )"
            >

              <img
                src="${student.avatar_url || "/profile.webp"}"
              >

              <p>${student.fullname}</p>

            </div>
          `;

        });

      }catch(err){

        console.error(err);

      }

    }

    // =========================
    // STUDENT LOGIN
    // =========================

    async function submitStudentLogin(){

      const pin =
        document.getElementById("studentPin")
        .value;

      if(!pin){
        return alert("Enter PIN");
      }

      try{

        const res =
          await fetch("/admin/student/avatar-login",{
            method:"POST",
            headers:{
              "Content-Type":"application/json"
            },
            body:JSON.stringify({
              studentId:selectedStudentId,
              pin
            })
          });

        const data =
          await res.json();

        if(data.success){

          window.location.href =
            data.redirect;

        }else{

          alert(data.message || "Login failed");

        }

      }catch(err){

        console.error(err);

        alert("Server error");

      }

    }

    // =========================
    // VERIFY OTP
    // =========================

    async function verifyOtp(){

      const otp =
        document.getElementById("otp-input")
        .value;

      const email =
        localStorage.getItem("pendingEmail");

      if(!email){
        return alert("Email not found");
      }

      try{

        const res =
          await fetch("/verify-otp",{
            method:"POST",
            headers:{
              "Content-Type":"application/json"
            },
            body:JSON.stringify({
              email,
              otp
            })
          });

        const data =
          await res.json();

        alert(data.message);

        if(data.success){

          localStorage.removeItem("pendingEmail");

          window.location.href =
            "/admin/login";

        }

      }catch(err){

        console.error(err);

        alert("OTP verification failed");

      }

    }

    // =========================
    // RESEND OTP
    // =========================

    document
      .getElementById("resendBtn")
      .addEventListener("click", async ()=>{

        const email =
          localStorage.getItem("pendingEmail");

        if(!email) return;

        const res =
          await fetch("/resend-otp",{
            method:"POST",
            headers:{
              "Content-Type":"application/json"
            },
            body:JSON.stringify({ email })
          });

        const data =
          await res.json();

        alert(data.message);

      });

  </script>

</body>

</html>
