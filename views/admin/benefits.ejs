<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Our Benefits</h2></div>
    <button onclick="openModal()" class="jk-btn-dark">+ Create Benefit</button>
  </div>

  <div id="createModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal()">&times;</span>
      <h2>Create Benefit</h2>
      <form method="POST" action="/admin/benefits" enctype="multipart/form-data">
        <input type="text" name="title" class="jk-select" style="width:100%;" placeholder="Benefit Title" required />
        <textarea name="description" placeholder="Benefit Description" required></textarea>
        <input type="file" name="icon" />
        <button type="submit" class="jk-btn-dark" style="margin-top:10px;">Save</button>
      </form>
    </div>
  </div>

  <div class="card-grid jk-course-grid">
    <% benefits.forEach(benefit => { %>
    <div class="jk-course-card">
      <div class="card-content">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
          <img src="<%= benefit.icon || '/images/default-user.png' %>" alt="Icon" style="width:40px; height:40px; border-radius:8px; object-fit:cover; background:#FAF8F2;" />
          <h4 style="margin:0;"><%= benefit.title %></h4>
        </div>
        <p class="card-body"><%= benefit.description %></p>

        <div class="article-buttons">
          <button class="btn-edit" onclick="openEditModal('<%= benefit.id %>')">Edit</button>
          <form action="/admin/benefits/delete/<%= benefit.id %>" method="POST" style="display:inline;" onsubmit="return handleConfirmSubmit(event, 'Are you sure?')">
            <button class="btn-delete" type="submit">Delete</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Modal Overlay -->
    <div id="editModal-<%= benefit.id %>" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeEditModal('<%= benefit.id %>')">&times;</span>
        <h2>Edit Benefit</h2>
        <form method="POST" action="/admin/benefits/edit/<%= benefit.id %>" enctype="multipart/form-data">
          <input type="text" name="title" class="jk-select" style="width:100%;" value="<%= benefit.title %>" required />
          <textarea name="description" required><%= benefit.description %></textarea>
          <% if (benefit.icon) { %>
          <img src="<%= benefit.icon %>" width="40" style="margin-bottom: 10px; border-radius:8px;" />
          <% } %>
          <input type="file" name="icon" />
          <button type="submit" class="jk-btn-dark" style="margin-top:10px;">Update</button>
        </form>
      </div>
    </div>
    <% }) %>

  </div>

</section>

<!-- Script not to be able to copy content from article body -->
<script>
  document.querySelectorAll(".article-body").forEach(function (el) {
    el.addEventListener("contextmenu", function (e) {
      e.preventDefault();
    });
    el.addEventListener("copy", function (e) {
      e.preventDefault();
    });
  });
</script>

<!-- script for opening and closing the modal -->
<script>
    function openModal() {
      document.getElementById("createModal").style.display = "block";
    }

    function closeModal() {
      document.getElementById("createModal").style.display = "none";
    }

    function openEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "block";
    }

    function closeEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "none";
    }

    // Close any modal when clicking outside it
    window.onclick = function (event) {
        if (event.target.classList.contains("modal")) {
        event.target.style.display = "none";
        }
    };
  </script>
