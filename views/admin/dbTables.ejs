<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<style>
  .db-table-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 4px; }
  .db-table-card {
    display: block; text-decoration: none; background: #fff; border: 1px solid #F1ECDD;
    border-radius: 14px; padding: 16px 18px; transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .db-table-card:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(32,27,18,0.1); }
  .db-table-card .db-table-icon {
    width: 38px; height: 38px; border-radius: 10px; background: #201B12; color: #EDE6D6;
    display: flex; align-items: center; justify-content: center; font-size: 15px; margin-bottom: 12px;
  }
  .db-table-card .db-table-name { font-weight: 800; font-size: 13.5px; color: #1A1510; word-break: break-word; }
  .db-table-card .db-table-count { font-size: 12px; color: #8A7B55; margin-top: 4px; }
  .db-table-search {
    width: 100%; max-width: 360px; padding: 10px 14px; margin: 4px 0 18px; box-sizing: border-box;
    border: 1px solid #F1ECDD; border-radius: 10px; font-size: 13.5px; background: #fff;
  }
  .db-table-search:focus { outline: none; border-color: #C9B77E; }
  .db-table-empty { display: none; color: #8A7B55; font-size: 13px; margin-top: 8px; }
</style>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Database Tables</h2></div>
  </div>

  <input
    type="text"
    id="dbTableSearch"
    class="db-table-search"
    placeholder="Search tables by name..."
    oninput="filterDbTables(this.value)"
  />

  <div class="db-table-grid" id="dbTableGrid">
    <% tables.forEach(table => { %>
      <a href="/admin/db/<%= table.name %>" class="db-table-card" data-table-name="<%= table.name %>">
        <div class="db-table-icon"><i class="fa-solid fa-database"></i></div>
        <div class="db-table-name"><%= table.name %></div>
        <div class="db-table-count"><%= table.count %> Records</div>
      </a>
    <% }) %>
  </div>
  <div class="db-table-empty" id="dbTableEmpty">No tables match that search.</div>

</section>

<script>
  function filterDbTables(query) {
    const needle = query.trim().toLowerCase();
    const cards = document.querySelectorAll('#dbTableGrid .db-table-card');
    let visibleCount = 0;
    cards.forEach((card) => {
      const matches = card.dataset.tableName.toLowerCase().includes(needle);
      card.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    });
    document.getElementById('dbTableEmpty').style.display = visibleCount === 0 ? 'block' : 'none';
  }
</script>