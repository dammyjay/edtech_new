<%- include('../partials/adminHeader', { info: info, currentPage: 'project-gallery' }) %>
<link rel="stylesheet" href="/labs/css/labRunPreview.css" />
<script src="/labs/js/labRunPython.js"></script>

<div class="pgm-page">
  <h2>🖼️ Project Gallery Moderation</h2>

  <div class="pgm-tabs">
    <button type="button" class="pgm-tab active" data-tab="lab">Lab Gallery</button>
    <button type="button" class="pgm-tab" data-tab="external">External Projects</button>
  </div>

  <div id="pgm-tab-lab">
    <p class="pgm-sub">Every project currently published to the platform-wide gallery. Lesson lab tasks never appear here — only students' own freeform Web Lab / Blockly Lab projects can be published.</p>

    <div class="pgm-toolbar">
      <input type="text" id="pgmSearch" placeholder="Search by project or student name…" />
      <select id="pgmLabType">
        <option value="">All lab types</option>
        <option value="web">🌐 Web Lab</option>
        <option value="blockly">🧩 Blockly Lab</option>
        <option value="arduino">🔌 Arduino Lab</option>
        <option value="python">🐍 Python Lab</option>
      </select>
      <label class="pgm-flag-toggle">
        <input type="checkbox" id="pgmFlaggedOnly" /> Flagged only 🚩
      </label>
      <button type="button" id="pgmRefresh">Refresh</button>
    </div>

    <div class="pgm-table-wrap">
      <table class="pgm-table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Student</th>
            <th>Type</th>
            <th>Published</th>
            <th>❤️ Likes</th>
            <th>★ Rating</th>
            <th>🚩 Flags</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="pgmTableBody">
          <tr><td colspan="8" class="pgm-empty">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div id="pgmPreviewModal" class="pgm-modal" style="display:none;">
    <div class="pgm-modal-overlay" id="pgmPreviewOverlay"></div>
    <div class="pgm-modal-card">
      <button type="button" class="pgm-modal-close" id="pgmPreviewClose">✕</button>
      <div id="pgmPreviewBody"></div>
    </div>
  </div>

  <div id="pgm-tab-external" style="display:none;">
    <p class="pgm-sub">Graded (or manually reviewed) External Project submissions. Featuring one here — an admin decision, separate from student self-publishing — shows it in the Labs Gallery to every logged-in platform user, and in the public Showcase teaser IF the student's family has also enabled public sharing.</p>

    <div class="pgm-toolbar">
      <input type="text" id="pgmExtSearch" placeholder="Search by project or student name…" />
      <label class="pgm-flag-toggle">
        <input type="checkbox" id="pgmExtFeaturedOnly" /> Featured only ⭐
      </label>
      <button type="button" id="pgmExtRefresh">Refresh</button>
    </div>

    <div class="pgm-table-wrap">
      <table class="pgm-table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Student</th>
            <th>Status</th>
            <th>Score</th>
            <th>Public sharing?</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="pgmExtTableBody">
          <tr><td colspan="6" class="pgm-empty">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .pgm-page { max-width: 1100px; margin: 0 auto; padding: 24px 20px 60px; }
  .pgm-sub { color: #666; font-size: 13px; margin-top: -8px; margin-bottom: 20px; }

  .pgm-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 16px;
  }
  .pgm-toolbar input[type="text"] {
    flex: 1;
    min-width: 220px;
    padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
  }
  .pgm-toolbar select {
    padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
  }
  .pgm-flag-toggle { font-size: 13px; display: flex; align-items: center; gap: 6px; }
  .pgm-toolbar button {
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    background: #333;
    color: #fff;
    cursor: pointer;
  }

  .pgm-table-wrap {
    overflow-x: auto;
    background: #fff;
    border-radius: 12px;
    border: 1px solid #eee;
  }
  .pgm-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .pgm-table th, .pgm-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #f0f0f0;
    white-space: nowrap;
  }
  .pgm-table th { background: #fafafa; font-weight: 700; color: #444; }
  .pgm-table tr.flagged td { background: #fff5f5; }
  .pgm-empty { text-align: center; color: #999; padding: 30px !important; }

  .pgm-unpublish-btn {
    border: none;
    background: #f1f1f1;
    color: #b02a37;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
  }
  .pgm-unpublish-btn:hover { background: #ffe1e1; }

  .pgm-tabs { display: flex; gap: 8px; margin-bottom: 18px; }
  .pgm-tab {
    border: 1px solid #ddd; background: #fff; color: #444;
    padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600;
  }
  .pgm-tab.active { background: #333; color: #fff; border-color: #333; }

  .pgm-feature-btn {
    border: none; background: #f1f1f1; color: #4a3b00; padding: 6px 12px;
    border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;
  }
  .pgm-feature-btn.featured { background: #fff3cd; color: #856404; }
  .pgm-feature-btn:hover { opacity: 0.85; }

  .pgm-view-btn {
    border: none; background: #eef4ff; color: #2c5fa8; padding: 6px 12px;
    border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600; margin-right: 6px;
  }
  .pgm-view-btn:hover { background: #dce8ff; }

  .pgm-modal { position: fixed; inset: 0; z-index: 100000; }
  .pgm-modal-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
  .pgm-modal-card {
    position: relative; max-width: 700px; margin: 40px auto; max-height: 85vh; overflow-y: auto;
    background: #fff; border-radius: 16px; padding: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .pgm-modal-close {
    position: absolute; top: 14px; right: 14px; border: none; background: #f1f1f1;
    width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 14px;
  }
</style>

<script>
(function () {
  const tbody = document.getElementById("pgmTableBody");
  const search = document.getElementById("pgmSearch");
  const labType = document.getElementById("pgmLabType");
  const flaggedOnly = document.getElementById("pgmFlaggedOnly");
  const refreshBtn = document.getElementById("pgmRefresh");

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str == null ? "" : String(str);
    return div.innerHTML;
  }

  // Same normalize/build pair as public/labs/js/labGallery.js — kept as
  // its own copy rather than a shared module (matching how each lab page
  // already keeps its own showToast/escapeHtml copy).
  function normalizeWebProjectData(raw) {
    if (raw && Array.isArray(raw.pages) && raw.pages.length) {
      const activePage = raw.pages.some((p) => p.name === raw.activePage) ? raw.activePage : raw.pages[0].name;
      const page = raw.pages.find((p) => p.name === activePage) || raw.pages[0];
      return { html: page.html || "", css: raw.css || "", js: raw.js || "" };
    }
    return { html: (raw && raw.html) || "", css: (raw && raw.css) || "", js: (raw && raw.js) || "" };
  }

  function buildWebPreviewSrcdoc(projectData) {
    const { html, css, js } = normalizeWebProjectData(projectData || {});
    return `<!DOCTYPE html><html><head><style>${css}</style></head><body>${html}<script>${js}<\/script></body></html>`;
  }

  async function load() {
    tbody.innerHTML = `<tr><td colspan="8" class="pgm-empty">Loading…</td></tr>`;

    const params = new URLSearchParams();
    if (search.value.trim()) params.set("search", search.value.trim());
    if (labType.value) params.set("labType", labType.value);
    if (flaggedOnly.checked) params.set("flagged", "true");

    try {
      const res = await fetch(`/admin/project-gallery/projects?${params.toString()}`);
      const data = await res.json();

      if (!data.success || !data.projects.length) {
        tbody.innerHTML = `<tr><td colspan="8" class="pgm-empty">No published projects match this filter.</td></tr>`;
        return;
      }

      tbody.innerHTML = data.projects.map((p) => {
        const rating = Number(p.avg_rating) || 0;
        const published = p.published_at ? new Date(p.published_at).toLocaleDateString() : "-";
        return `
          <tr class="${p.flag_count > 0 ? "flagged" : ""}" data-id="${p.id}">
            <td>${escapeHtml(p.project_name || "Untitled project")}</td>
            <td>${escapeHtml(p.student_name)}</td>
            <td>${p.lab_type === "blockly" ? "🧩 Blockly" : p.lab_type === "arduino" ? "🔌 Arduino" : p.lab_type === "python" ? "🐍 Python" : "🌐 Web"}</td>
            <td>${published}</td>
            <td>${p.like_count}</td>
            <td>${rating ? `${rating.toFixed(1)} (${p.review_count})` : "—"}</td>
            <td>${p.flag_count > 0 ? `🚩 ${p.flag_count}` : "—"}</td>
            <td>
              <button type="button" class="pgm-view-btn" data-id="${p.id}">👁️ View</button>
              <button type="button" class="pgm-unpublish-btn" data-id="${p.id}">Unpublish</button>
            </td>
          </tr>
        `;
      }).join("");
    } catch (err) {
      console.error("Moderation load error:", err);
      tbody.innerHTML = `<tr><td colspan="8" class="pgm-empty">Couldn't load projects.</td></tr>`;
    }
  }

  tbody.addEventListener("click", async (e) => {
    const viewBtn = e.target.closest(".pgm-view-btn");
    if (viewBtn) {
      openPreview(viewBtn.dataset.id);
      return;
    }

    const btn = e.target.closest(".pgm-unpublish-btn");
    if (!btn) return;
    const confirmed = window.showConfirm
      ? await window.showConfirm("Remove this project from the public gallery?", { confirmText: "Unpublish" })
      : confirm("Remove this project from the public gallery?");
    if (!confirmed) return;

    btn.disabled = true;
    try {
      const res = await fetch(`/admin/project-gallery/${btn.dataset.id}/unpublish`, { method: "POST" });
      const data = await res.json();
      if (data.success) {
        load();
      } else {
        btn.disabled = false;
      }
    } catch (err) {
      console.error("Unpublish error:", err);
      btn.disabled = false;
    }
  });

  // ---------------- Preview modal (👁️ View) ----------------
  // Admin is a logged-in session too (req.user is set for any role —
  // see app.js), so the exact same student-facing detail endpoint works
  // here without a separate admin-only route. isOwner is always false for
  // admin, which is fine — this modal never renders like/remix/report,
  // only a read-only preview + the existing Unpublish action.
  const previewModal = document.getElementById("pgmPreviewModal");
  const previewBody = document.getElementById("pgmPreviewBody");

  function closePreview() {
    previewModal.style.display = "none";
    previewBody.innerHTML = "";
  }
  document.getElementById("pgmPreviewOverlay").addEventListener("click", closePreview);
  document.getElementById("pgmPreviewClose").addEventListener("click", closePreview);

  async function openPreview(id) {
    previewModal.style.display = "block";
    previewBody.innerHTML = `<p class="pgm-empty">Loading…</p>`;
    try {
      const res = await fetch(`/labs/gallery/projects/${id}`);
      const data = await res.json();
      if (!data.success) {
        previewBody.innerHTML = `<p class="pgm-empty">Couldn't load this project.</p>`;
        return;
      }
      renderPreview(data.project, id);
    } catch (err) {
      console.error("Preview load error:", err);
      previewBody.innerHTML = `<p class="pgm-empty">Couldn't load this project.</p>`;
    }
  }

  function renderPreview(project, id) {
    const icon = project.lab_type === "blockly" ? "🧩" : project.lab_type === "arduino" ? "🔌" : project.lab_type === "python" ? "🐍" : "🌐";
    let body;
    if (project.lab_type === "web") {
      body = `<iframe id="pgmPreviewFrame" style="width:100%; height:380px; border:1px solid #eee; border-radius:10px;" sandbox="allow-scripts"></iframe>`;
    } else if (project.lab_type === "blockly") {
      const code = (project.project_data && project.project_data.generatedCode) || "(No blocks were placed.)";
      body = `<pre class="lrp-code">${escapeHtml(code)}</pre>
        <a class="lrp-open-sim-btn" href="/labs/blockly?viewProjectId=${id}" target="_blank" rel="noopener">🧩 Open in Blocks Editor — Run it</a>`;
    } else if (project.lab_type === "arduino") {
      const pd = project.project_data || {};
      const code = (pd.code && pd.code.trim()) || "(No code was written.)";
      const ccount = (pd.circuit && Array.isArray(pd.circuit.components)) ? pd.circuit.components.length : 0;
      body = `<pre class="lrp-code">${escapeHtml(code)}</pre>
        <p style="font-size:12px; color:#666;">${ccount} component${ccount === 1 ? "" : "s"} wired on the circuit.</p>
        <a class="lrp-open-sim-btn" href="/labs/arduino?viewProjectId=${id}" target="_blank" rel="noopener">🔌 Open in Simulator — Run it</a>`;
    } else if (project.lab_type === "python") {
      body = `<div id="pgmPythonRunner"></div>`;
    } else {
      body = `<p class="pgm-empty">No preview available for this lab type.</p>`;
    }

    previewBody.innerHTML = `
      <h3 style="margin:0 0 4px;">${icon} ${escapeHtml(project.project_name || "Untitled project")}</h3>
      <p style="font-size:13px; color:#666; margin:0 0 16px;">by ${escapeHtml(project.student_name)}</p>
      ${body}
      <button type="button" class="pgm-unpublish-btn" style="margin-top:16px;" data-id="${id}">Unpublish</button>
    `;

    const frame = document.getElementById("pgmPreviewFrame");
    if (frame) {
      frame.srcdoc = buildWebPreviewSrcdoc(project.project_data);
    }
    const pyRunner = document.getElementById("pgmPythonRunner");
    if (pyRunner && window.LabRunPython) {
      window.LabRunPython.render(pyRunner, (project.project_data && project.project_data.code) || "");
    }

    previewBody.querySelector(".pgm-unpublish-btn")?.addEventListener("click", async (e) => {
      const confirmed = window.showConfirm
        ? await window.showConfirm("Remove this project from the public gallery?", { confirmText: "Unpublish" })
        : confirm("Remove this project from the public gallery?");
      if (!confirmed) return;
      e.target.disabled = true;
      try {
        const res = await fetch(`/admin/project-gallery/${id}/unpublish`, { method: "POST" });
        const data = await res.json();
        if (data.success) {
          closePreview();
          load();
        } else {
          e.target.disabled = false;
        }
      } catch (err) {
        console.error("Unpublish error:", err);
        e.target.disabled = false;
      }
    });
  }

  search.addEventListener("keydown", (e) => { if (e.key === "Enter") load(); });
  labType.addEventListener("change", load);
  flaggedOnly.addEventListener("change", load);
  refreshBtn.addEventListener("click", load);

  load();

  // ---------------- Tabs ----------------
  document.querySelectorAll(".pgm-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".pgm-tab").forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      document.getElementById("pgm-tab-lab").style.display = tab.dataset.tab === "lab" ? "block" : "none";
      document.getElementById("pgm-tab-external").style.display = tab.dataset.tab === "external" ? "block" : "none";
      if (tab.dataset.tab === "external") loadExternal();
    });
  });

  // ---------------- External Projects tab ----------------
  const extTbody = document.getElementById("pgmExtTableBody");
  const extSearch = document.getElementById("pgmExtSearch");
  const extFeaturedOnly = document.getElementById("pgmExtFeaturedOnly");
  const extRefreshBtn = document.getElementById("pgmExtRefresh");
  let extLoaded = false;

  async function loadExternal() {
    extTbody.innerHTML = `<tr><td colspan="6" class="pgm-empty">Loading…</td></tr>`;
    const params = new URLSearchParams();
    if (extSearch.value.trim()) params.set("search", extSearch.value.trim());
    if (extFeaturedOnly.checked) params.set("featured", "true");

    try {
      const res = await fetch(`/admin/external-projects/submissions?${params.toString()}`);
      const data = await res.json();
      if (!data.success || !data.submissions.length) {
        extTbody.innerHTML = `<tr><td colspan="6" class="pgm-empty">No submissions match this filter.</td></tr>`;
        return;
      }
      extTbody.innerHTML = data.submissions.map((s) => {
        const statusLabel = s.status === "graded" ? `✅ Graded` : "📥 Submitted (not AI-graded)";
        return `
          <tr data-id="${s.id}">
            <td>${escapeHtml(s.project_title)}</td>
            <td>${escapeHtml(s.student_name)}</td>
            <td>${statusLabel}</td>
            <td>${s.ai_graded ? (s.score ?? "—") : "—"}</td>
            <td>${s.public_profile_enabled ? "✅ Public OK" : "🔒 Gallery only"}</td>
            <td><button type="button" class="pgm-feature-btn ${s.featured ? "featured" : ""}" data-id="${s.id}" data-featured="${s.featured}">${s.featured ? "★ Featured — remove" : "☆ Feature"}</button></td>
          </tr>
        `;
      }).join("");
    } catch (err) {
      console.error("External moderation load error:", err);
      extTbody.innerHTML = `<tr><td colspan="6" class="pgm-empty">Couldn't load submissions.</td></tr>`;
    }
  }

  extTbody.addEventListener("click", async (e) => {
    const btn = e.target.closest(".pgm-feature-btn");
    if (!btn) return;
    const isFeatured = btn.dataset.featured === "true";
    btn.disabled = true;
    try {
      const res = await fetch(`/admin/external-projects/submission/${btn.dataset.id}/${isFeatured ? "unfeature" : "feature"}`, { method: "POST" });
      const data = await res.json();
      if (data.success) loadExternal();
      else btn.disabled = false;
    } catch (err) {
      console.error("Feature toggle error:", err);
      btn.disabled = false;
    }
  });

  extSearch.addEventListener("keydown", (e) => { if (e.key === "Enter") loadExternal(); });
  extFeaturedOnly.addEventListener("change", loadExternal);
  extRefreshBtn.addEventListener("click", loadExternal);
})();
</script>
