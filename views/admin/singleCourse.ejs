<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

    <section class="section jk-page">

    <div class="jk-header-card">
      <div style="display:flex; align-items:center; gap:14px;">
        <% if (course.thumbnail_url) { %>
          <img src="<%= course.thumbnail_url %>" alt="" style="width:54px; height:54px; border-radius:10px; object-fit:cover; flex:0 0 auto; background:#FAF8F2;">
        <% } %>
        <div>
          <h2><%= course.title %></h2>
          <p><%= course.level %> · ₦<%= Number(course.amount || 0).toLocaleString() %></p>
        </div>
      </div>
      <a href="/admin/courses/<%= course.id %>/certificate-preview"
        target="_blank"
        class="jk-btn-outline"
        style="text-decoration:none;">
        🎓 Preview Certificate
      </a>
    </div>

    <div class="login-tabs scroll-tabs">

      <a
        href="?tab=details"
        class="login-tab <%= activeTab === 'details' ? 'active' : '' %>"
      >
        Course Details
      </a>

      <a
        href="?tab=modules"
        class="login-tab <%= activeTab === 'modules' ? 'active' : '' %>"
      >
        Modules
      </a>

      <a
        href="?tab=lessons"
        class="login-tab <%= activeTab === 'lessons' ? 'active' : '' %>"
      >
        Lessons
      </a>

      <a
        href="?tab=assignment"
        class="login-tab <%= activeTab === 'assignment' ? 'active' : '' %>"
      >
        Assignment
      </a>

      <a
        href="?tab=project"
        class="login-tab <%= activeTab === 'project' ? 'active' : '' %>"
      >
        Capstone Project
      </a>

      <a
        href="?tab=external-projects"
        class="login-tab <%= activeTab === 'external-projects' ? 'active' : '' %>"
      >
        External Projects
      </a>

    </div>

    <div class="tab-content">

      <% if (activeTab === 'details') { %> <%- include('../partials/courseDetails',
      { course }) %> <% } else if (activeTab === 'modules') { %> <%-
      include('../partials/modules', { modules, quizzes, lessons, course, assignments: moduleAssignments }) %> <% } else if (activeTab === 'lessons') { %>
  <%- include('../partials/lessons', { lessons, modules, selectedModuleId, page: page || 1, totalPages: totalPages || 0 }) %>
      <% } else if (activeTab === 'assignment') { %> <%-
      include('../partials/courseAssignment', { assignments: moduleAssignments }) %> <% } else if
      (activeTab === 'project') { %> <%- include('../partials/courseProject', {
      projects }) %> <% } else if (activeTab === 'external-projects') { %>
      <%- include('../partials/courseExternalProjects', { externalProjects, modules, lessons, course }) %>
      <% } %>
    </div>

    </section>

    <!-- SCRIPT SECTION -->
    <script>
      function openCreateModal() {
        document.getElementById("createModal").style.display = "block";
      }
      function closeCreateModal() {
        document.getElementById("createModal").style.display = "none";
      }

      function openEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "block";
      }
      function closeEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "none";
      }

      function openDeleteModal(id) {
        document.getElementById("deleteModal-" + id).style.display = "block";
      }
      function closeDeleteModal(id) {
        document.getElementById("deleteModal-" + id).style.display = "none";
      }

      CKEDITOR.replaceAll("textarea");
    </script>

    <a href="/admin/dashboard">Back to Dashboard</a>

    <!-- script for ckeditor -->
    <script>
      CKEDITOR.replace("content");
    </script>

    <!-- script to toggle navigation menu -->
    <script>
      // Close nav when clicking outside of it
      document.addEventListener("click", function (event) {
        const nav = document.getElementById("main-nav");
        const toggleBtn = document.querySelector(".nav-toggle");

        if (
          nav.classList.toggle("open") &&
          !nav.contains(event.target) &&
          !toggleBtn.contains(event.target)
        ) {
          nav.classList.remove("open");
        }
      });
    </script>

    <!-- Script not to be able to copy content from article body -->
    <script>
      document.querySelectorAll(".article-body").forEach(function (el) {
        el.addEventListener("contextmenu", function (e) {
          e.preventDefault();
        });
        el.addEventListener("copy", function (e) {
          e.preventDefault();
        });
      });
    </script>

    <!-- script to preview image before upload -->
    <script>
      const imageInput = document.getElementById("imageInput");
      if (imageInput) {
        imageInput.addEventListener("change", function () {
          const preview = document.getElementById("imagePreview");
          const file = this.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
              preview.src = e.target.result;
              preview.style.display = "block";
            };
            reader.readAsDataURL(file);
          } else {
            preview.src = "#";
            preview.style.display = "none";
          }
        });
      }
    </script>

    <!-- script to filter level for each career pathway -->

    <script>
      function filterByPathway(pathway) {
        const groups = document.querySelectorAll(".pathway-group");
        groups.forEach((group) => {
          const groupName = group.getAttribute("data-pathway");
          if (pathway === "All" || groupName === pathway) {
            group.style.display = "block";
          } else {
            group.style.display = "none";
          }
        });
      }
    </script>

    <!-- script for opening and closing the modal -->
    <script>
      function openModal() {
        document.getElementById("createModal").style.display = "block";
      }

      function closeModal() {
        document.getElementById("createModal").style.display = "none";
      }

      function openEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "block";
      }

      function closeEditModal(id) {
        document.getElementById("editModal-" + id).style.display = "none";
      }

      // Close modal when clicking outside the modal content
      // window.onclick = function (event) {
      //   const modal = document.getElementById("createModal");
      //   if (event.target == modal) {
      //     modal.style.display = "none";
      //   }
      // };
      // Close any modal when clicking outside it
      window.onclick = function (event) {
        if (event.target.classList.contains("modal")) {
          event.target.style.display = "none";
        }
      };
    </script>
