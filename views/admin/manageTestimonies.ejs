<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Manage Testimonies</h2></div>
  </div>

  <% if (testimonies.length === 0) { %>
    <div class="jk-report-panel" style="text-align:center; color:#8A7B55;">No testimonies yet.</div>
  <% } else { %>
    <% testimonies.forEach(t => { %>
      <div class="jk-report-panel">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
          <div class="jk-avatar" style="width:38px; height:38px; font-size:15px; background:#A17807;"><%= (t.name || '?').trim().charAt(0).toUpperCase() %></div>
          <div>
            <p style="margin:0; font-weight:700; color:#1A1510;"><%= t.name %></p>
            <p style="margin:0; font-size:12px; color:#6E6350;"><%= t.email || "Anonymous" %></p>
          </div>
        </div>
        <p style="margin:0 0 10px;"><%= t.message %></p>
        <p style="margin:0 0 10px; font-size:12px; color:#6E6350;">Created: <%= new Date(t.created_at).toLocaleString() %></p>
        <span class="jk-pill <%= t.is_published ? 'jk-pill--active' : 'jk-pill--inactive' %>"><%= t.is_published ? 'Published' : 'Not published' %></span>

        <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
          <form action="/admin/testimonies/toggle/<%= t.id %>" method="POST" style="display:inline;">
            <input type="hidden" name="publish" value="<%= !t.is_published %>">
            <button type="submit" class="jk-btn-outline-sm"><%= t.is_published ? "Unpublish" : "Publish" %></button>
          </form>

          <form action="/admin/testimonies/delete/<%= t.id %>" method="POST" style="display:inline;" onsubmit="return handleConfirmSubmit(event, 'Delete this testimony?')">
            <button type="submit" class="jk-btn-outline-sm" style="color:#B23A2A;">🗑️ Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>

</section>
