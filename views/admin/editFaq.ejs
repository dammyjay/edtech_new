<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Edit FAQ</h2></div>
    <a href="/admin/faqs" class="jk-btn-outline" style="text-decoration:none;">⬅ Cancel</a>
  </div>

  <div class="jk-report-panel">
    <form action="/admin/faqs/update/<%= faq.id %>" method="POST">
      <p><strong>Question:</strong> <%- faq.question %></p>
      <label for="answer">Answer:</label><br />
      <textarea name="answer" id="content" rows="5"><%- faq.answer || '' %></textarea
      ><br /><br />

      <label style="font-weight:normal;">
        <input type="checkbox" name="is_published" <%= faq.is_published ? 'checked' : '' %>> Publish this answer
      </label><br><br>

      <button type="submit" class="jk-btn-dark">💾 Save</button>
    </form>
  </div>

</section>

<script> CKEDITOR.replace('content'); </script>
