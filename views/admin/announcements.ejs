 <%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Announcements</h2></div>
    <button id="newAnnouncementBtn" class="jk-btn-dark">
        <i class="fas fa-plus"></i>
        New Announcement
    </button>
  </div>

  <div class="jk-toolbar">
    <div class="jk-search-wrap">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8A7B55" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="announcementSearch" class="jk-search-input" placeholder="Search announcements...">
    </div>

    <select id="statusFilter" class="jk-select">
        <option value="">All</option>
        <option value="draft">Draft</option>
        <option value="published">Published</option>
        <option value="scheduled">Scheduled</option>
        <option value="expired">Expired</option>
        <option value="archived">Archived</option>
    </select>
  </div>

  <div class="jk-table-wrap">
    <table id="announcementTable" class="jk-table sortable-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Type</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Audience</th>
                <th>Views</th>
                <th>Display Location</th>
                <th class="jk-col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
  </div>

</section>

<!-- Announcement Modal -->
<div id="announcementModal" class="modal">

    <div class="modal-content large-modal">
        <div class="modal-header">
            <h2 id="modalTitle">
                New Announcement
            </h2>

            <span class="closeModal">&times;</span>

        </div>

        <form
            id="announcementForm"
            enctype="multipart/form-data"
        >
            <input
                type="hidden"
                id="announcementId"
            >
            <!-- Continue adding fields -->
            
            <div class="form-group">
                <label>Title</label>
                <input
                    type="text"
                    name="title"
                    id="title"
                    required
                >
            </div>
            <div class="form-group">
                <label>Message</label>
                <textarea
                    id="message"
                    name="message"
                    rows="6"
                    required
                ></textarea>

            </div>

            <div class="form-group">

                <label>Image</label>

                <input
                    type="file"
                    id="image"
                    accept="image/*"
                    name="image"
                >

                <img
                    id="imagePreview"
                    style="
                        display:none;
                        margin-top:10px;
                        max-width:250px;
                        border-radius:8px;
                    "
                >

            </div>

            <div class="form-group">

            <label>Type</label>

            <select id="type" name="type">

            <option value="information">Information</option>

            <option value="event">Event</option>

            <option value="success">Success</option>

            <option value="warning">Warning</option>

            <option value="emergency">Emergency</option>

            <option value="promotion">Promotion</option>

            <option value="maintenance">Maintenance</option>

            <option value="course">Course</option>

            </select>

            </div>

            <div class="form-group">

            <label>Priority</label>

            <select id="priority" name="priority">

                <option value="low">Low</option>

                <option value="normal">Normal</option>

                <option value="high">High</option>

                <option value="critical">Critical</option>

            </select>

            </div>

            <div class="form-group">
                <label>Display Location</label>

                <div class="checkbox-group">

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="homepage"
                        >
                        Homepage
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="dashboard"
                        >
                        Dashboard
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="courses"
                        >
                        Courses
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="lessons"
                        >
                        Lessons
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="profile"
                        >
                        Profile
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="all"
                        >
                        Everywhere
                    </label>

                </div>
            </div>

            <div class="modal-footer">

                <button
                type="submit"
                id="saveAnnouncementBtn"
                class="btn-primary">

                Save Announcement

                </button>

            </div>

        </form>

        
    </div>

</div>

<div id="viewAnnouncementModal" class="modal">

    <div class="modal-content large-modal">

        <div class="modal-header">

            <h2>Announcement Details</h2>

            <span class="closeViewModal">&times;</span>

        </div>

        <div class="modal-body">

            <img
                id="viewImage"
                style="
                    display:none;
                    width:100%;
                    max-height:250px;
                    object-fit:cover;
                    border-radius:8px;
                    margin-bottom:15px;
                "
            >

            <h3 id="viewTitle"></h3>

            <p>
                <strong>Type:</strong>
                <span id="viewType"></span>
            </p>

            <p>
                <strong>Priority:</strong>
                <span id="viewPriority"></span>
            </p>

            <p>
                <strong>Status:</strong>
                <span id="viewStatus"></span>
            </p>

            <p>
                <strong>Audience:</strong>
                <span id="viewAudience"></span>
            </p>

            <p>
                <strong>Display Location:</strong>
                <span id="viewLocations"></span>
            </p>

            <hr>

            <div id="viewMessage"></div>

        </div>

    </div>

</div>

<style>
  /* None of these classes (used by public/js/admin-announcements.js's
     JS-rendered modal structure and table rows) had any CSS anywhere in
     the codebase — this page's modals and action buttons were rendering
     essentially unstyled. Scoped here rather than touching the shared JS. */
  #announcementModal .modal-content.large-modal,
  #viewAnnouncementModal .modal-content.large-modal {
    max-width: 640px;
    width: 100%;
    border-radius: 18px;
    padding: 0;
    overflow: hidden;
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom: 1px solid #F1ECDD;
  }
  .modal-header h2 { margin: 0; font-size: 17px; font-weight: 800; color: #1A1510; }
  .closeModal, .closeViewModal {
    cursor: pointer;
    font-size: 22px;
    color: #6E6350;
    line-height: 1;
  }
  .closeModal:hover, .closeViewModal:hover { color: var(--brand-pri-dark); }
  #announcementForm, #viewAnnouncementModal .modal-body {
    padding: 18px 22px 22px;
    max-height: 70vh;
    overflow-y: auto;
  }
  .form-group { margin-bottom: 14px; }
  .form-group label { display: block; font-size: 12.5px; font-weight: 700; color: #4C3802; margin-bottom: 4px; }
  .form-group input[type="text"],
  .form-group input[type="file"],
  .form-group select,
  .form-group textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 9px 12px;
    border-radius: 9px;
    border: 1px solid #E7E0CE;
    font-family: inherit;
    font-size: 13px;
  }
  .checkbox-group { display: flex; flex-wrap: wrap; gap: 10px 16px; margin-top: 4px; }
  .checkbox-group label { display: flex; align-items: center; gap: 6px; font-weight: 500; font-size: 13px; color: #1A1510; }
  .modal-footer { margin-top: 10px; display: flex; justify-content: flex-end; }
  .modal-footer .btn-primary, #newAnnouncementBtn.btn-primary {
    background: #201B12; color: #EDE6D6; border: none; padding: 9px 18px;
    border-radius: 9px; font-weight: 700; font-size: 13px; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
  }

  .action-buttons { display: flex; gap: 6px; flex-wrap: wrap; }
  .action-buttons button {
    border: none; width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; font-size: 12.5px;
  }
  .btn-view { background: #F6F4EF; color: #4C3802; }
  .btn-edit { background: #FBF3DD; color: #A17807; }
  .btn-success { background: #EAF7EE; color: #1E7A42; }
  .btn-warning { background: var(--brand-tint); color: var(--brand-pri-dark); }
  .btn-danger { background: #FDEEEC; color: #B23A2A; }
  .action-buttons button:hover { opacity: 0.8; }

  .priority, .status {
    display: inline-block; font-size: 11px; font-weight: 700; padding: 3px 9px;
    border-radius: 999px; text-transform: capitalize;
  }
  .priority.low { background: #F1ECDD; color: #6E6350; }
  .priority.normal { background: #F6F4EF; color: #4C3802; }
  .priority.high { background: var(--brand-tint); color: var(--brand-pri-dark); }
  .priority.critical { background: #FDEEEC; color: #B23A2A; }
  .status.draft { background: #F1ECDD; color: #6E6350; }
  .status.published { background: #EAF7EE; color: #1E7A42; }
  .status.scheduled { background: var(--brand-tint); color: var(--brand-pri-dark); }
  .status.expired, .status.archived { background: #FDEEEC; color: #B23A2A; }

  .text-muted { color: #8A7B55; font-size: 12px; }
  .text-center { text-align: center; color: #8A7B55; padding: 20px !important; }
</style>

<script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>

<script src="/js/admin-announcements.js"></script>