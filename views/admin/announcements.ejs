 <%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

 <button id="newAnnouncementBtn" class="btn-primary">
    <i class="fas fa-plus"></i>
    New Announcement
</button>

<input
    type="text"
    id="announcementSearch"
    placeholder="Search announcements..."
>

<select id="statusFilter">
    <option value="">All</option>
    <option value="draft">Draft</option>
    <option value="published">Published</option>
    <option value="scheduled">Scheduled</option>
    <option value="expired">Expired</option>
    <option value="archived">Archived</option>
</select>

<div class="table-responsive">
    <table id="announcementTable" class="user-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Type</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Audience</th>
                <th>Views</th>
                <th>Display Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<!-- Announcement Modal -->
<div id="announcementModal" class="modal">

    <div class="modal-content large-modal">
        <div class="modal-header">
            <h2 id="modalTitle">
                New Announcement
            </h2>

            <span class="closeModal">&times;</span>

        </div>

        <form
            id="announcementForm"
            enctype="multipart/form-data"
        >
            <input
                type="hidden"
                id="announcementId"
            >
            <!-- Continue adding fields -->
            
            <div class="form-group">
                <label>Title</label>
                <input
                    type="text"
                    name="title"
                    id="title"
                    required
                >
            </div>
            <div class="form-group">
                <label>Message</label>
                <textarea
                    id="message"
                    name="message"
                    rows="6"
                    required
                ></textarea>

            </div>

            <div class="form-group">

                <label>Image</label>

                <input
                    type="file"
                    id="image"
                    accept="image/*"
                    name="image"
                >

                <img
                    id="imagePreview"
                    style="
                        display:none;
                        margin-top:10px;
                        max-width:250px;
                        border-radius:8px;
                    "
                >

            </div>

            <div class="form-group">

            <label>Type</label>

            <select id="type" name="type">

            <option value="information">Information</option>

            <option value="event">Event</option>

            <option value="success">Success</option>

            <option value="warning">Warning</option>

            <option value="emergency">Emergency</option>

            <option value="promotion">Promotion</option>

            <option value="maintenance">Maintenance</option>

            <option value="course">Course</option>

            </select>

            </div>

            <div class="form-group">

            <label>Priority</label>

            <select id="priority" name="priority">

                <option value="low">Low</option>

                <option value="normal">Normal</option>

                <option value="high">High</option>

                <option value="critical">Critical</option>

            </select>

            </div>

            <div class="form-group">
                <label>Display Location</label>

                <div class="checkbox-group">

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="homepage"
                        >
                        Homepage
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="dashboard"
                        >
                        Dashboard
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="courses"
                        >
                        Courses
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="lessons"
                        >
                        Lessons
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="profile"
                        >
                        Profile
                    </label>

                    <label>
                        <input
                            type="checkbox"
                            name="display_locations"
                            value="all"
                        >
                        Everywhere
                    </label>

                </div>
            </div>

            <div class="modal-footer">

                <button
                type="submit"
                id="saveAnnouncementBtn"
                class="btn-primary">

                Save Announcement

                </button>

            </div>

        </form>

        
    </div>

</div>

<div id="viewAnnouncementModal" class="modal">

    <div class="modal-content large-modal">

        <div class="modal-header">

            <h2>Announcement Details</h2>

            <span class="closeViewModal">&times;</span>

        </div>

        <div class="modal-body">

            <img
                id="viewImage"
                style="
                    display:none;
                    width:100%;
                    max-height:250px;
                    object-fit:cover;
                    border-radius:8px;
                    margin-bottom:15px;
                "
            >

            <h3 id="viewTitle"></h3>

            <p>
                <strong>Type:</strong>
                <span id="viewType"></span>
            </p>

            <p>
                <strong>Priority:</strong>
                <span id="viewPriority"></span>
            </p>

            <p>
                <strong>Status:</strong>
                <span id="viewStatus"></span>
            </p>

            <p>
                <strong>Audience:</strong>
                <span id="viewAudience"></span>
            </p>

            <p>
                <strong>Display Location:</strong>
                <span id="viewLocations"></span>
            </p>

            <hr>

            <div id="viewMessage"></div>

        </div>

    </div>

</div>

<script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>

<script src="/js/admin-announcements.js"></script>