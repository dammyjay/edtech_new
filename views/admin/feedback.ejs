<%- include('../partials/adminHeader', { info: info, currentPage: 'feedback' }) %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/wordcloud2.js/1.1.2/wordcloud2.min.js"></script>
<style>
    /* ===== GRID RESPONSIVE ===== */
    .feedback-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 18px;
      margin-top: 20px;
    }

    @media (max-width: 600px) {
      .feedback-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ===== CARD ===== */
    .feedback-card {
      background: #fff;
      border: 1px solid #F1ECDD;
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 2px 10px rgba(32,27,18,0.05);
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      animation: fadeInUp 0.3s ease;
    }

    .feedback-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 22px rgba(32,27,18,0.1);
    }

    /* ===== PINNED ===== */
    .feedback-card.pinned {
      border: 2px solid var(--brand-pri);
    }

    .pinned-label {
      position: absolute;
      top: 10px;
      right: 10px;
      background: var(--brand-pri);
      color: #201B12;
      font-size: 10.5px;
      padding: 4px 9px;
      border-radius: 999px;
      font-weight: 800;
    }

    /* ===== HEADER ===== */
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* ===== USER TYPE BADGES ===== */
    .badge {
      padding: 3px 10px;
      font-size: 10.5px;
      border-radius: 999px;
      font-weight: 800;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .badge.student { background:#3D7EDB; }
    .badge.teacher { background:#1E7A42; }
    .badge.parent { background:#1B8B9B; }
    .badge.school_owner { background:#6F4FC1; }
    .badge.organization { background:#C1711F; }

    /* ===== STAR RATING ===== */
    .stars {
      color: var(--brand-pri-dark);
      font-size: 14px;
    }

    /* ===== MESSAGE PREVIEW ===== */
    .message {
      font-size: 13.5px;
      color: #4C3802;
      line-height: 1.45;
      max-height: 60px;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .feedback-card:hover .message {
      max-height: 300px;
    }

    /* ===== SENTIMENT ===== */
    .sentiment {
      font-size: 11.5px;
      font-weight: 700;
    }

    .sentiment.positive { color:#1E7A42; }
    .sentiment.neutral { color:#6E6350; }
    .sentiment.negative { color:#B23A2A; }

    .feedback-card small { color: #8A7B55; font-size: 11.5px; }
    .feedback-card strong { color: #1A1510; font-size: 14px; }

    /* ===== ACTIONS ===== */
    .actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: auto;
    }

    .actions button {
      border: none;
      padding: 6px 11px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
    }

    .view-btn { background:#F6F4EF; color:#4C3802; }
    .publish-btn { background:#EAF7EE; color:#1E7A42; }
    .publish-btn.unpublish { background:#F1ECDD; color:#6E6350; }
    .delete-btn { background:#FDEEEC; color:#B23A2A; }
    .actions button:hover { opacity: 0.8; }

    /* ===== ANIMATION ===== */
    @keyframes fadeInUp {
      from { opacity:0; transform: translateY(16px); }
      to { opacity:1; transform: translateY(0); }
    }

    #pagination { display: flex; gap: 6px; flex-wrap: wrap; }
    #pagination button {
      border: 1px solid #E7E0CE; background: #fff; color: #4C3802;
      padding: 6px 12px; border-radius: 8px; cursor: pointer; font-size: 12.5px; font-weight: 700;
    }
    #pagination button:disabled { background: #201B12; color: #EDE6D6; border-color: #201B12; cursor: default; }
  </style>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Feedback Dashboard</h2></div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <a href="/admin/feedback/export/pdf" class="jk-btn-outline-sm"><i class="fas fa-file-pdf"></i> PDF</a>
      <a href="/admin/feedback/export/excel" class="jk-btn-outline-sm"><i class="fas fa-file-excel"></i> Excel</a>
      <a href="/admin/feedback/export/csv" class="jk-btn-outline-sm"><i class="fas fa-file-csv"></i> CSV</a>
    </div>
  </div>

  <div class="jk-stat-grid">
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Total Feedback</span><span class="jk-stat-icon">💬</span></div>
      <div class="jk-stat-value"><%= feedback.length %></div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Average Rating</span><span class="jk-stat-icon">⭐</span></div>
      <div class="jk-stat-value"><%= feedback.length ? (feedback.reduce((s,f)=>s+(f.rating||0),0)/feedback.length).toFixed(1) : "0.0" %></div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Students</span><span class="jk-stat-icon">🎓</span></div>
      <div class="jk-stat-value"><%= feedback.filter(f=>f.user_type==='student').length %></div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Teachers</span><span class="jk-stat-icon">🧑‍🏫</span></div>
      <div class="jk-stat-value"><%= feedback.filter(f=>f.user_type==='teacher').length %></div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Parents</span><span class="jk-stat-icon">👪</span></div>
      <div class="jk-stat-value"><%= feedback.filter(f=>f.user_type==='parent').length %></div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">School Owners</span><span class="jk-stat-icon">🏫</span></div>
      <div class="jk-stat-value"><%= feedback.filter(f=>f.user_type==='school_owner').length %></div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Organizations</span><span class="jk-stat-icon">🏢</span></div>
      <div class="jk-stat-value"><%= feedback.filter(f=>f.user_type==='organization').length %></div>
    </div>
  </div>

  <!-- FILTERS -->
  <div class="jk-toolbar">
    <select id="filterType" class="jk-select">
      <option value="">All Users</option>
      <option value="parent">Parent</option>
      <option value="student">Student</option>
      <option value="teacher">Teacher</option>
      <option value="school_owner">School Owner</option>
      <option value="organization">Organization</option>
    </select>

    <select id="filterRating" class="jk-select">
      <option value="">Any Rating</option>
      <option value="5">5</option><option value="4">4</option>
      <option value="3">3</option><option value="2">2</option><option value="1">1</option>
    </select>

    <select id="filterPublished" class="jk-select">
      <option value="">Both</option>
      <option value="true">Published</option>
      <option value="false">Unpublished</option>
    </select>

    <div class="jk-search-wrap">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8A7B55" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input id="filterSearch" class="jk-search-input" placeholder="Search feedback...">
    </div>

    <button id="applyFilters" class="jk-btn-dark">Apply</button>
  </div>

  <!-- Feedback Grid -->
  <div id="feedbackCardsWrap" class="feedback-grid"></div>

  <!-- PAGINATION -->
  <div id="pagination" style="margin-top:20px;"></div>

  <!-- MODAL -->
  <div id="feedbackModal" class="jk-modal-overlay" style="display:none;">
    <div class="jk-modal">
      <div class="jk-modal-head">
        <h4>Feedback Details</h4>
        <span onclick="closeFeedbackModal()" class="jk-modal-close">&times;</span>
      </div>
      <div class="jk-modal-body">
        <p><strong>User Type:</strong> <span id="fbType"></span></p>
        <p><strong>Name:</strong> <span id="fbName"></span></p>
        <p><strong>Email:</strong> <span id="fbEmail"></span></p>
        <p><strong>Rating:</strong> <span id="fbRating"></span></p>
        <p><strong>Sentiment:</strong> <span id="fbSentiment"></span></p>
        <p><strong>Message:</strong></p>
        <div id="fbMessage" style="padding:10px; background:#F6F4EF; border-radius:8px;"></div>
        <p><strong>Published:</strong> <span id="fbPublished"></span></p>
      </div>
    </div>
  </div>

</section>

<script>
const fetchJSON = (url) => fetch(url).then(r=>r.json());
let currentPage = 1, perPage = 15;

async function loadFeedback() {
  const qs = new URLSearchParams({
    page: currentPage,
    perPage,
    user_type: filterType.value || "",
    rating: filterRating.value || "",
    published: filterPublished.value || "",
    search: filterSearch.value || ""
  });

  const data = await fetchJSON(`/admin/feedback/api?${qs}`);
  // renderTable(data.rows);
  renderCards(data.rows);

  renderPagination(data.total, data.page);
  renderWordCloud(data.rows);
}

// ===== CARD RENDERING =====
function renderStars(rating = 0) {
  let stars = "";
  for (let i = 1; i <= 5; i++) {
    stars += i <= rating ? "★" : "☆";
  }
  return stars;
}

function sentimentClass(label = "") {
  if (label === "positive") return "positive";
  if (label === "negative") return "negative";
  return "neutral";
}

function renderCards(rows) {
  let html = "";

  rows.forEach(r => {
    html += `
      <div class="feedback-card ${r.is_pinned ? "pinned" : ""}">
        ${r.is_pinned ? `<div class="pinned-label">⭐ Featured</div>` : ""}

        <div class="card-top">
          <span class="badge ${r.user_type}">
            ${r.user_type.replace("_", " ")}
          </span>

          <span class="stars">
            ${renderStars(r.rating)}
          </span>
        </div>

        <strong>${r.name}</strong>
        <small>${r.email || "No email"}</small>

        <div class="message">
          ${r.message}
        </div>

        <div class="sentiment ${sentimentClass(r.sentiment_label)}">
          ${r.sentiment_label || "neutral"} (${r.sentiment_score || 0})
        </div>

        <small>
          ${new Date(r.created_at).toLocaleString()} • 
          Published: ${r.is_published ? "Yes" : "No"}
        </small>

        <div class="actions">
          <button class="view-btn" data-id="${r.id}">View</button>

          <button class="publish-btn ${r.is_published ? "unpublish" : ""}"
            data-id="${r.id}"
            data-status="${r.is_published}">
            ${r.is_published ? "Unpublish" : "Publish"}
          </button>

          <button class="delete-btn" data-id="${r.id}">
            Delete
          </button>
        </div>
      </div>
    `;
  });

  feedbackCardsWrap.innerHTML = html;

  // EVENTS
  document.querySelectorAll(".view-btn").forEach(btn => {
    btn.onclick = () => openFeedbackModal(btn.dataset.id);
  });

  document.querySelectorAll(".publish-btn").forEach(btn => {
    btn.onclick = async () => {
      const id = btn.dataset.id;
      const newStatus = btn.dataset.status === "true" ? false : true;

      await fetch(`/admin/feedback/publish/${id}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: newStatus })
      });

      loadFeedback();
    };
  });

  document.querySelectorAll(".delete-btn").forEach(btn => {
    btn.onclick = async () => {
      if (!(await showConfirm("Delete this feedback?"))) return;

      await fetch(`/admin/feedback/delete/${btn.dataset.id}`, {
        method: "DELETE"
      });

      loadFeedback();
    };
  });
}

// ===== PAGINATION =====
function renderPagination(total, page){
  const pages = Math.ceil(total / perPage);
  let html = "";
  for(let i=1;i<=pages;i++){
    html += `<button onclick="goToPage(${i})" ${i===page?"disabled":""}>${i}</button>`;
  }
  pagination.innerHTML = html;
}
function goToPage(n){ currentPage=n; loadFeedback(); }

// ===== WORD CLOUD =====
function renderWordCloud(rows){
  const words = {};

  rows.forEach(r=>{
    if(r.keywords){
      let k = r.keywords;
      if(typeof k === "string") k = JSON.parse(k);
      k.forEach(w => words[w.word] = (words[w.word]||0) + w.count);
    }
  });

  const list = Object.entries(words).map(([w,c]) => [w,c]);

  if(list.length){
    WordCloud(document.getElementById("wordCloudCanvas"), {
      list,
      gridSize: 10,
      weightFactor: 12,
      backgroundColor: "white"
    });
  }
}

// ===== MODAL VIEW =====
async function openFeedbackModal(id){
  const row = await fetchJSON(`/admin/feedback/detail/${id}`);

  fbType.textContent = row.user_type;
  fbName.textContent = row.name;
  fbEmail.textContent = row.email || "—";
  fbRating.textContent = row.rating || "—";
  fbSentiment.textContent = `${row.sentiment_label} (${row.sentiment_score})`;
  fbMessage.textContent = row.message;
  fbPublished.textContent = row.is_published ? "Yes" : "No";

  feedbackModal.style.display = "flex";
}
function closeFeedbackModal(){
  feedbackModal.style.display = "none";
}

// ===== FILTER BUTTON =====
applyFilters.addEventListener("click", ()=>{currentPage=1; loadFeedback();});

loadFeedback();
</script>
