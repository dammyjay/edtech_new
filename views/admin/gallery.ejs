<%- include('../partials/adminHeader', { info: info, currentPage: 'dashboard' }) %>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>📁 Gallery Management</h2></div>
    <div style="display:flex; gap:8px;">
      <button onclick="openModal('categoryModal')" class="jk-btn-outline">➕ Add Category</button>
      <button onclick="openModal('uploadModal')" class="jk-btn-dark">📤 Upload Image</button>
    </div>
  </div>

  <!-- 🌟 Create Category Modal -->
  <div id="categoryModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal('categoryModal')">&times;</span>
      <h3>Create New Category</h3>
      <form action="/admin/gallery/create-category" method="POST">
        <label>Category Name:</label>
        <input type="text" name="name" required />
        <button type="submit" class="jk-btn-dark" style="margin-top:10px;">➕ Add</button>
      </form>
    </div>
  </div>

  <!-- 🌟 Upload Image Modal -->
  <div id="uploadModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal('uploadModal')">&times;</span>
      <h3>Upload New Image</h3>
      <form
        action="/admin/gallery/upload"
        method="POST"
        enctype="multipart/form-data"
      >
        <label>Image Title:</label>
        <input type="text" name="title" required />

        <label>Category:</label>
        <select name="category_id" required>
          <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>"><%= cat.name %></option>
          <% }) %>
        </select>

        <label>Select Image:</label>
        <input type="file" name="image" accept="image/*" required />

        <button type="submit" class="jk-btn-dark" style="margin-top:10px;">📤 Upload</button>
      </form>
    </div>
  </div>

  <!-- Show Uploaded Images -->
  <div class="jk-section-head" style="margin-top:20px;">
    <h3>🖼 Uploaded Images</h3>
  </div>

  <div class="jk-toolbar">
    <label for="categoryFilter" style="font-size:13px; font-weight:600; color:#4C3802;">Filter by Category:</label>
    <select id="categoryFilter" class="jk-select">
      <option value="all">All Categories</option>
      <% categories.forEach(cat => { %>
      <option value="cat-<%= cat.id %>"><%= cat.name %></option>
      <% }) %>
    </select>
  </div>

  <% categories.forEach(cat => { %>
  <div class="category-section" data-cat="cat-<%= cat.id %>">
    <h4 style="margin-top: 2rem; color:#1A1510;"><%= cat.name %></h4>
    <div class="gallery-grid jk-course-grid">
      <% const catImages = images.filter(img => Number(img.category_id) ===
      Number(cat.id)); if (catImages.length === 0) { %>
      <p style="color: #8A7B55">No images in this category yet.</p>
      <% } %> <% catImages.forEach(img => { %>
      <div class="gallery-card jk-course-card">
        <img
          src="<%= img.image_url %>"
          alt="<%= img.title %>"
          onclick="showModal('<%= img.image_url %>')"
          style="cursor: zoom-in"
        />
        <div class="card-content">
          <p class="card-body" style="font-weight:700; color:#1A1510;"><%= img.title %></p>

          <div class="article-buttons">
            <form
              method="POST"
              action="/admin/gallery/delete-image/<%= img.id %>"
              style="display: inline"
              onsubmit="return handleConfirmSubmit(event, 'Delete this image?')"
            >
              <button class="btn-delete" type="submit">
                🗑 Delete
              </button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% }) %>

  <!-- Show Categories with Delete -->
  <div class="jk-section-head" style="margin-top:30px;">
    <h3>🗂 Categories</h3>
  </div>
  <div class="jk-table-wrap">
    <table class="jk-table sortable-table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="jk-col-actions">Action</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(cat => { %>
        <tr>
          <td><%= cat.name %></td>
          <td class="jk-col-actions">
            <form
              action="/admin/gallery/delete-category/<%= cat.id %>"
              method="POST"
              style="display: inline"
              onsubmit="return handleConfirmSubmit(event, 'Delete this image?')"
            >
              <button
                class="btn-delete"
                type="submit"
              >
                🗑 Delete
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</section>

<!-- 🖼 Modal for Full Image Preview -->
<div id="imgModal" class="img-modal" style="display: none">
  <span class="close-modal" id="closeModal">&times;</span>
  <img class="img-modal-content" id="modalImg" />
</div>

<!-- script for image modal  -->
<script>
  function showModal(url) {
    const modal = document.getElementById("imgModal");
    const modalImg = document.getElementById("modalImg");
    modal.style.display = "flex";
    modalImg.src = url;
  }

  document.getElementById("closeModal").onclick = function () {
    document.getElementById("imgModal").style.display = "none";
    document.getElementById("modalImg").src = "";
  };

  document.getElementById("imgModal").onclick = function (e) {
    if (e.target === this) {
      this.style.display = "none";
      document.getElementById("modalImg").src = "";
    }
  };
</script>

<!-- 🔽 Category Filter Script -->
<script>
  const filterSelect = document.getElementById("categoryFilter");
  const categorySections = document.querySelectorAll(".category-section");

  filterSelect.addEventListener("change", function () {
    const selected = this.value;

    categorySections.forEach((section) => {
      section.style.display =
        selected === "all" || section.dataset.cat === selected
          ? "block"
          : "none";
    });
  });
</script>

<!-- script for upload and create category  -->
<script>
  function openModal(id) {
    document.getElementById(id).style.display = "block";
  }

  function closeModal(id) {
    document.getElementById(id).style.display = "none";
  }

  // Close modal if clicking outside
  window.addEventListener("click", function (event) {
    if (event.target.classList.contains("modal")) {
      event.target.style.display = "none";
    }
  });
</script>
