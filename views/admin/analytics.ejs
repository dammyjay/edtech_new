<%- include('../partials/adminHeader', { info: info, currentPage: 'analytics' }) %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  .analytics-charts { display:flex; gap:16px; margin-top:4px; flex-wrap:wrap; }
  .chart-card { flex:1 1 480px; background:#fff; border: 1px solid #F1ECDD; padding:16px 18px; border-radius:14px; }
  .chart-card h4 { margin: 0 0 12px; font-size: 13.5px; font-weight: 800; color: #1A1510; }
  .table-responsive { margin-top:20px; }
  .table-responsive h3 { font-size: 14.5px; font-weight: 800; color: #1A1510; display:flex; align-items:center; gap:10px; }
  .activity-feed { max-height:360px; overflow:auto; }
</style>

<section class="section jk-page">

  <div class="jk-header-card">
    <div><h2>Admin Analytics</h2></div>
    <button id="exportPdfBtn" class="jk-btn-outline-sm"><i class="fas fa-file-pdf"></i> Export PDF</button>
  </div>

  <div class="jk-toolbar">
    <select id="rangeSelect" class="jk-select">
      <option value="7">Last 7 days</option>
      <option value="30" selected>Last 30 days</option>
      <option value="90">Last 90 days</option>
    </select>

    <select id="schoolFilter" class="jk-select">
      <option value="">All Schools</option>
      <option value="individual">🧑 Individual / Non-School Users Only</option>
      <% (schools || []).forEach(s => { %>
        <option value="<%= s.id %>">🏫 <%= s.name %></option>
      <% }) %>
    </select>

    <button id="refreshBtn" class="jk-btn-dark"><i class="fas fa-rotate"></i> Refresh</button>
  </div>

  <!-- top cards -->
  <div class="jk-stat-grid" id="topCards">
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Active (24h)</span><span class="jk-stat-icon">🟢</span></div>
      <div class="jk-stat-value" id="cardDAU">—</div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Total Users</span><span class="jk-stat-icon">👥</span></div>
      <div class="jk-stat-value" id="cardTotalUsers">—</div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label" id="cardNewLabel">New (30d)</span><span class="jk-stat-icon">📈</span></div>
      <div class="jk-stat-value" id="cardNew7">—</div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Total Courses</span><span class="jk-stat-icon">📚</span></div>
      <div class="jk-stat-value" id="cardCourses">—</div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Avg Quiz Score</span><span class="jk-stat-icon">🧠</span></div>
      <div class="jk-stat-value" id="cardAvgQuiz">—</div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Total Revenue</span><span class="jk-stat-icon">💰</span></div>
      <div class="jk-stat-value" id="cardTotalRevenue">—</div>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label" id="cardRevenueLabel">Revenue (30d)</span><span class="jk-stat-icon">💵</span></div>
      <div class="jk-stat-value" id="cardRevenue30d">—</div>
    </div>
  </div>

  <!-- Always shows the FULL school-vs-individual split, regardless of
       which School filter is selected above — the Range/School dropdowns
       narrow everything else to one slice at a time, but this correlation
       (how much of the platform is school-linked vs independent) needs to
       stay visible no matter what's selected, or the "big picture" is lost. -->
  <div class="chart-card" style="margin-bottom:16px;">
    <h4>🏫 User Base: Schools vs Individual</h4>
    <div style="display:flex; gap:24px; align-items:center; flex-wrap:wrap;">
      <canvas id="userSegmentsChart" height="120" style="max-width:220px;"></canvas>
      <div style="font-size:13px; color:#4C4432;">
        <div><strong id="segSchoolLinked">—</strong> school-linked users (across all schools)</div>
        <div style="margin-top:6px;"><strong id="segIndependent">—</strong> independent / non-school users</div>
        <div style="margin-top:10px; font-size:11.5px; color:#8A7B55;">This card always shows the full platform split — use the School filter above to drill into one school or just independent users.</div>
      </div>
    </div>
  </div>

  <!-- Revenue broken into its 3 genuinely non-overlapping sources — see
       controllers/adminController.js's getRevenueBySource for why these
       three (and not a single "transactions" sum) are the correct model. -->
  <div class="chart-card" style="margin-bottom:16px;">
    <h4>💰 Revenue by Source <span id="revenueRangeNote" style="font-weight:400; color:#8A7B55; font-size:11.5px;"></span></h4>
    <div class="jk-stat-grid" style="grid-template-columns:repeat(3,minmax(0,1fr));">
      <div class="jk-stat-card">
        <div class="jk-stat-head"><span class="jk-stat-label">Wallet &amp; Direct Payments</span></div>
        <div class="jk-stat-value" id="revWalletDirect">—</div>
        <div style="font-size:10.5px; color:#8A7B55;">Wallet top-ups, course purchases, term reactivations, event tickets. Platform-wide only — can't be split by school.</div>
      </div>
      <div class="jk-stat-card">
        <div class="jk-stat-head"><span class="jk-stat-label">School Fees</span></div>
        <div class="jk-stat-value" id="revSchoolFees">—</div>
        <div style="font-size:10.5px; color:#8A7B55;">Term quote payments. Fully filterable by the School dropdown above.</div>
      </div>
      <div class="jk-stat-card">
        <div class="jk-stat-head"><span class="jk-stat-label">Parent Training</span></div>
        <div class="jk-stat-value" id="revParentTraining">—</div>
        <div style="font-size:10.5px; color:#8A7B55;">Instructor-led parent training fees. Always individual money — parents are never school-linked.</div>
      </div>
    </div>
  </div>

  <div class="analytics-charts">
    <div class="chart-card">
      <h4>Users by Role</h4>
      <canvas id="rolesChart" height="150"></canvas>
    </div>

    <div class="chart-card">
      <h4>Top Courses (Enrollments)</h4>
      <canvas id="topCoursesChart" height="150"></canvas>
    </div>

    <div class="chart-card">
      <h4>Quiz Pass/Fail</h4>
      <canvas id="quizPassFailChart" height="150"></canvas>
    </div>

    <div class="chart-card">
      <h4>Recent Activity</h4>
      <div class="activity-feed" id="activityFeed"></div>
    </div>

    <div class="chart-card">
      <h4>Revenue Trend (Last 30d)</h4>
      <canvas id="revenueChart" height="150"></canvas>
    </div>
  </div>

  <!-- table for course details -->
  <div class="table-responsive" id="coursesTableWrap"></div>
  <div class="table-responsive" id="schoolPaymentsTableWrap"></div>
  <div class="table-responsive" id="eventPaymentsSummaryWrap"></div>
  <div class="table-responsive" id="eventPaymentsTableWrap">
    <h3>
      Event Payment Details
      <button onclick="loadEventPaymentDetails()" class="jk-btn-outline-sm">View Details</button>
    </h3>
    <div id="eventPaymentDetails"></div>
  </div>

</section>


  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>

<script>
  // The Range/School dropdowns above used to be decorative — present in
  // the DOM but read by nothing. Every stats fetch now carries both as
  // query params, and every endpoint (controllers/adminController.js)
  // actually scopes its query by them.
  function currentFilterParams() {
    const range = document.getElementById('rangeSelect').value;
    const schoolId = document.getElementById('schoolFilter').value;
    const params = new URLSearchParams({ range });
    if (schoolId) params.set('schoolId', schoolId);
    return params.toString();
  }

  async function fetchJSON(path) {
    const sep = path.includes('?') ? '&' : '?';
    const res = await fetch(`${path}${sep}${currentFilterParams()}`, {credentials: 'same-origin'});
    if (!res.ok) throw new Error('Failed '+path);
    return res.json();
  }

  let rolesChart, topCoursesChart, quizChart, revenueChart, userSegmentsChart;

  function formatNaira(n) {
    return '₦' + (parseFloat(n) || 0).toLocaleString(undefined, { maximumFractionDigits: 0 });
  }

  async function loadOverview() {
    const data = await fetchJSON('/admin/stats/overview');
    document.getElementById('cardTotalUsers').innerText = data.totalUsers;
    document.getElementById('cardDAU').innerText = data.dau;
    document.getElementById('cardNew7').innerText = data.newUsers.new_in_range;
    document.getElementById('cardNewLabel').innerText = `New (${data.newUsers.range}d)`;

    // This always reflects the FULL platform split (see
    // controllers/adminController.js's exports.overview — computed
    // unconditionally, not scoped by the School filter) even while every
    // other card on the page is narrowed to one school/individual slice.
    const seg = data.userSegments || { school_linked: 0, independent: 0 };
    document.getElementById('segSchoolLinked').innerText = seg.school_linked;
    document.getElementById('segIndependent').innerText = seg.independent;
    const segCtx = document.getElementById('userSegmentsChart').getContext('2d');
    if (userSegmentsChart) userSegmentsChart.destroy();
    userSegmentsChart = new Chart(segCtx, {
      type: 'doughnut',
      data: {
        labels: ['School-linked', 'Independent'],
        datasets: [{ data: [seg.school_linked, seg.independent], backgroundColor: ['#4A90D9', '#D9A82C'] }],
      },
      options: { plugins: { legend: { position: 'bottom' } } },
    });
  }

    async function loadFinance() {
    const data = await fetchJSON('/admin/stats/finance');

    // Update cards
    document.getElementById('cardTotalRevenue').innerText = formatNaira(data.revenue.total_revenue);
    document.getElementById('cardRevenue30d').innerText = formatNaira(data.revenue.revenue_range);
    document.getElementById('cardRevenueLabel').innerText = `Revenue (${document.getElementById('rangeSelect').value}d)`;

    // Revenue by source — the 3 genuinely non-overlapping buckets (see
    // controllers/adminController.js's getRevenueBySource).
    const src = data.revenue.by_source || {};
    document.getElementById('revWalletDirect').innerText = formatNaira((src.walletAndDirect || {}).all_time);
    document.getElementById('revSchoolFees').innerText = formatNaira((src.schoolFees || {}).all_time);
    document.getElementById('revParentTraining').innerText = formatNaira((src.parentTraining || {}).all_time);
    document.getElementById('revenueRangeNote').innerText = '(all-time totals — switch Range above for the period figure in the cards up top)';

    // Revenue Chart (simple example: selected range vs earlier)
    const labels = [`Last ${document.getElementById('rangeSelect').value}d`, 'Earlier'];
    const values = [
        parseFloat(data.revenue.revenue_range),
        parseFloat(data.revenue.total_revenue) - parseFloat(data.revenue.revenue_range)
    ];
    const ctx = document.getElementById('revenueChart').getContext('2d');
    if (revenueChart) revenueChart.destroy();
    revenueChart = new Chart(ctx, {
        type: 'bar',
        data: { labels, datasets: [{ label: 'Revenue', data: values, backgroundColor: '#4caf50' }] }
    });

    // Optional: school payments table
    const schoolWrap = document.getElementById('schoolPaymentsTableWrap');
    let html = '<h3>School Payments</h3><table class="user-table"><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody>';
    data.schoolPayments.forEach(p => {
        html += `<tr><td>${p.status}</td><td>${p.count}</td></tr>`;
    });
    html += '</tbody></table>';
    schoolWrap.innerHTML = html;

    // Optional: event payments table
    const eventWrap = document.getElementById('eventPaymentsSummaryWrap');
    html = '<h3>Event Payments</h3><table class="user-table"><thead><tr><th>Status</th><th>Count</th><th>Total Collected</th></tr></thead><tbody>';
    data.eventPayments.forEach(p => {
        html += `<tr><td>${p.payment_status}</td><td>${p.count}</td><td>${p.total_collected}</td></tr>`;
    });
    html += '</tbody></table>';
    eventWrap.innerHTML = html;
    }

  async function loadUsers() {
    const data = await fetchJSON('/admin/stats/users');
    // roles chart
    const labels = data.byRole.map(r => r.role);
    const values = data.byRole.map(r => r.count);
    const ctx = document.getElementById('rolesChart').getContext('2d');
    if (rolesChart) rolesChart.destroy();
    rolesChart = new Chart(ctx, {
      type: 'pie',
      data: { labels, datasets: [{ data: values }] }
    });
  }

async function loadCourses() {
  const data = await fetchJSON('/admin/stats/courses');
  document.getElementById('cardCourses').innerText = data.counts.total_courses;

  // Extract values
  const labels = data.topCourses.map(c => c.title);
  const individual = data.topCourses.map(c => c.individual_enrollments);
  const school = data.topCourses.map(c => c.school_enrollments);

  // Draw stacked bar chart
  const ctx = document.getElementById('topCoursesChart').getContext('2d');
  if (topCoursesChart) topCoursesChart.destroy();
  topCoursesChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [
        { label: 'Individual Students', data: individual, backgroundColor: '#42A5F5' },
        { label: 'School Students', data: school, backgroundColor: '#66BB6A' }
      ]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      plugins: { legend: { position: 'top' } },
      scales: { x: { stacked: true }, y: { stacked: true } }
    }
  });

  // Courses Table (with both student types)
  const wrap = document.getElementById('coursesTableWrap');
  let html = `
    <h3>Top Courses</h3>
    <table class="user-table">
      <thead>
        <tr>
          <th>Course</th>
            <th>Total Lessons</th>
            <th>Avg Completed Lessons</th>
            <th>Individual Students</th>
            <th>School Students</th>
            <th>Total Enrollments</th>
            <th>Avg Progress</th>
        </tr>
      </thead>
      <tbody>
  `;
  data.topCourses.forEach(c => {
    html += `
    <tr>
        <td>${c.title}</td>
        <td>${c.total_lessons}</td>
        <td>${c.avg_completed_lessons}</td>
        <td>${c.individual_enrollments}</td>
        <td>${c.school_enrollments}</td>
        <td>${c.total_enrollments}</td>
        <td>${c.avg_progress}%</td>
    </tr>
    `;
  });
  html += '</tbody></table>';
  wrap.innerHTML = html;
}

  async function loadQuizzes() {
    const data = await fetchJSON('/admin/stats/quizzes');
    document.getElementById('cardAvgQuiz').innerText = data.summary.avg_score || '—';
    const labels = data.passFail.map(r => r.passed ? 'Passed' : 'Failed');
    const values = data.passFail.map(r => r.count);
    const ctx = document.getElementById('quizPassFailChart').getContext('2d');
    if (quizChart) quizChart.destroy();
    quizChart = new Chart(ctx, {
      type: 'doughnut',
      data: { labels, datasets: [{ data: values }] }
    });
  }

  async function loadActivity() {
    const data = await fetchJSON('/admin/stats/activity');
    const feed = document.getElementById('activityFeed');
    feed.innerHTML = data.feed.map(it => `<div style="border-bottom:1px solid #eee;padding:6px 0;"><small style="color:#666">${new Date(it.created_at).toLocaleString()}</small><div><strong>${it.role || 'User'}</strong>: ${it.action}</div><div style="color:#333">${it.details || ''}</div></div>`).join('');
  }

  async function loadEventPaymentDetails() {
  const data = await fetchJSON("/admin/stats/event-payments/details");

  let html = `
    <h4>Event Payment Details</h4>
    <table class="user-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Email</th>
          <th>Event</th>
          <th>Status</th>
          <th>Amount</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
  `;

  data.forEach(row => {
    html += `
      <tr>
        <td>${row.fullname}</td>
        <td>${row.email}</td>
        <td>${row.event_title}</td>
        <td>${row.payment_status}</td>
        <td>${row.amount}</td>
        <td>${new Date(row.created_at).toLocaleString()}</td>
      </tr>
    `;
  });

  html += "</tbody></table>";

  document.getElementById("eventPaymentDetails").innerHTML = html;
}


  async function refreshAll() {
    try {
      document.getElementById('refreshBtn').disabled = true;
      await Promise.all([ loadOverview(), loadUsers(), loadCourses(), loadQuizzes(), loadActivity(), loadFinance() ]);
    } catch (err) {
      console.error(err);
      showAlert('Failed to load analytics: ' + err.message);
    } finally {
      document.getElementById('refreshBtn').disabled = false;
    }
  }

  document.getElementById('refreshBtn').addEventListener('click', refreshAll);
  document.getElementById('rangeSelect').addEventListener('change', refreshAll);
  document.getElementById('schoolFilter').addEventListener('change', refreshAll);

  // initial load
  refreshAll();


document.getElementById("exportPdfBtn").addEventListener("click", () => {
  // Open PDF in a new tab
  window.open("/admin/analytics/export", "_blank");
});


</script>
