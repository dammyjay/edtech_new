
 <%- include('../partials/adminHeader', { title: 'Assign Courses' }) %>

<section class="section jk-page assign-container">

  <div class="jk-header-card page-header">
    <div>
      <h2>Assign Courses to Schools</h2>
      <p>Select courses and assign them to specific schools.</p>
    </div>
    <button type="button" class="jk-btn-outline" onclick="runBackfill(this)">
      🔄 Re-scan Course-Term History
    </button>
  </div>
  <p style="color:#8A7B55; font-size:12px; margin:-14px 0 20px;">
    Confirms which courses were actually worked on in each past term, from real lesson/quiz activity — used by classroom analytics and student course access. Safe to re-run any time.
  </p>
    <% if (schools.length === 0) { %>
    <p>No schools found.</p>
  <% } else if (courses.length === 0) { %>
    <p>No courses available to assign.</p>
  <% } else { %>

  <% schools.forEach(school => { %>
    <div class="school-section">
      <h3>
        <button
          type="button"
          class="collapse-btn"
          onclick="toggleCourses('<%= school.id %>', this)"
        >
          <span><%= school.name %></span>
          <span class="arrow">▼</span>
        </button>
      </h3>

      <div id="courses-<%= school.id %>" class="courses-list" style="display:none; margin-left: 20px;">

        <% const schoolTerms = schoolTermsMap[school.id] || []; %>
        <% if (schoolTerms.length) { %>
        <div style="margin-bottom:15px;">
          <label><strong>Assigning for term:</strong></label>
          <select id="termSelect-<%= school.id %>" class="jk-select" onchange="applyTermSelection('<%= school.id %>')">
            <% schoolTerms.forEach(t => { %>
            <option value="<%= t.id %>" <%= t.is_active ? 'selected' : '' %>><%= t.name %><%= t.is_active ? ' (Active)' : '' %></option>
            <% }) %>
            <option value="">General (no term)</option>
          </select>
          <p style="color:#8A7B55; font-size:12px; margin-top:6px;">
            Courses checked below apply only to the selected term. Switching terms updates which boxes are checked.
          </p>
        </div>
        <% } %>

        <input type="text" placeholder="Search courses..." class="course-search" onkeyup="filterCourses('<%= school.id %>')">

        <form method="POST" action="/admin/school-courses/assign" id="form-<%= school.id %>">
          <input type="hidden" name="school_id" value="<%= school.id %>">
          <input type="hidden" name="term_id" id="termInput-<%= school.id %>" value="<%= schoolTerms.find(t => t.is_active) ? schoolTerms.find(t => t.is_active).id : '' %>">

          <div class="course-grid">
            <% courses.forEach(course => { %>
            <label class="course-item">
              <input
                type="checkbox"
                name="school_<%= school.id %>[]"
                class="course-checkbox-<%= school.id %>"
                value="<%= course.id %>"
              >
              <span><%= course.title %></span>
              <span class="confirmed-badge" style="display:none; margin-left:6px; font-size:11px; font-weight:600; color:#1E7A42; background:#EAF7EE; padding:2px 7px; border-radius:10px; white-space:nowrap;" title="Students have real lesson/quiz activity on this course during this term, but it isn't checked/assigned above.">✓ confirmed activity</span>
            </label>
            <% }) %>
          </div>
          <button type="submit" class="assign-btn">Save Course Assignments</button>
        </form>

        <% if (schoolCoursesByTerm[school.id] && schoolCoursesByTerm[school.id].length) { %>
        <div style="margin-top:25px;">
          <h4 style="margin-bottom:10px; color:#201B12;">📚 Courses by Term</h4>
          <div class="jk-table-wrap">
            <table class="jk-table">
              <thead>
                <tr>
                  <th>Term</th>
                  <th>Courses</th>
                </tr>
              </thead>
              <tbody>
                <% schoolCoursesByTerm[school.id].forEach(row => { %>
                <tr>
                  <td style="white-space:nowrap;"><%= row.termName %></td>
                  <td><%= row.courses.join(', ') %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  <% }) %>

  <% } %>
</section>

<script>
  // schoolId -> termKey ("none" or term id) -> [courseId, ...]
  const schoolCoursesMap = <%- JSON.stringify(schoolCoursesMap) %>;
  // schoolId -> termId -> [courseId, ...] (confirmed via course_term_links; never has a "none" key)
  const schoolConfirmedCoursesMap = <%- JSON.stringify(schoolConfirmedCoursesMap) %>;

  function toggleCourses(schoolId, btn){

    const div =
      document.getElementById(
        "courses-" + schoolId
      );

    const arrow =
      btn.querySelector(".arrow");

    if(div.style.display === "none"){

        div.style.display = "block";
        arrow.textContent = "▲";
        applyTermSelection(schoolId);

    }else{

        div.style.display = "none";
        arrow.textContent = "▼";

    }

}

  function applyTermSelection(schoolId) {
    const select = document.getElementById("termSelect-" + schoolId);
    const termValue = select ? select.value : "";
    const termInput = document.getElementById("termInput-" + schoolId);
    if (termInput) termInput.value = termValue;

    const termKey = termValue ? termValue : "none";
    const assigned = (schoolCoursesMap[schoolId] && schoolCoursesMap[schoolId][termKey]) || [];
    // Confirmed activity only ever exists against a real term (course_term_links
    // always has a term_id), so "General (no term)" never shows a badge.
    const confirmed = (termValue && schoolConfirmedCoursesMap[schoolId] && schoolConfirmedCoursesMap[schoolId][termValue]) || [];

    const checkboxes = document.querySelectorAll(".course-checkbox-" + schoolId);
    checkboxes.forEach(cb => {
      const courseId = Number(cb.value);
      cb.checked = assigned.includes(courseId);

      const badge = cb.closest(".course-item").querySelector(".confirmed-badge");
      if (badge) {
        badge.style.display = (!cb.checked && confirmed.includes(courseId)) ? "inline-block" : "none";
      }
    });
  }

  function runBackfill(btn) {
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = "🔄 Scanning...";
    fetch("/admin/course-term-links/backfill", { method: "POST" })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showAlert(`Done. ${data.total} course-term link(s) confirmed/updated.`);
        } else {
          showAlert("Backfill failed: " + (data.message || "Unknown error"));
        }
      })
      .catch(() => showAlert("Backfill failed."))
      .finally(() => {
        btn.disabled = false;
        btn.textContent = original;
      });
  }

  function filterCourses(schoolId) {
    const input = document.querySelector('#courses-' + schoolId + ' .course-search');
    const filter = input.value.toLowerCase();
    const items = document.querySelectorAll('#courses-' + schoolId + ' .course-item');

    items.forEach(item => {
      const text = item.textContent || item.innerText;
      item.style.display = text.toLowerCase().includes(filter) ? '' : 'none';
    });
  }
</script>

<style>
/* =====================================
   PAGE
===================================== */
.assign-container{
    max-width:1320px;
    width: 100%;
}

.page-header h2{
    font-size:26px;
    margin-bottom:4px;
    color:#201B12;
}

.page-header p{
    color:#8A7B55;
    margin:0;
}
/* =====================================
   SCHOOL CARD
===================================== */
.school-section{
    background:#fff;
    border-radius:14px;
    margin-bottom:18px;
    overflow:hidden;
    border:1px solid #EDE6D6;
}

/* =====================================
   COLLAPSE HEADER
===================================== */

.collapse-btn{
    width:100%;
    border:none;
    background:#fff;
    color:#201B12;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:18px 22px;

    font-size:17px;
    font-weight:700;

    cursor:pointer;
    transition:.2s;
}

.collapse-btn:hover{
    background:#FAF8F2;
}

.collapse-btn .arrow{
    color:#A17807;
}

/* =====================================
   COURSE AREA
===================================== */

.courses-list{
    padding:22px;
    border-top:1px solid #EDE6D6;
}

/* =====================================
   SEARCH
===================================== */

.course-search{
    width:100%;
    padding:12px 16px;
    border:1px solid #E7E0CE;
    border-radius:9px;
    font-size:14px;
    outline:none;
    margin-bottom:18px;
    font-family:inherit;
}

.course-search:focus{
    border-color:#A17807;
}

/* =====================================
   COURSES GRID
===================================== */

.course-grid{
    display:grid;
    grid-template-columns:
      repeat(auto-fill,minmax(250px,1fr));
    gap:12px;
    margin-bottom:22px;
}

/* =====================================
   COURSE ITEM
===================================== */

.course-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:13px 15px;
    background:#FAF8F2;
    border:1px solid #EDE6D6;
    border-radius:10px;
    cursor:pointer;
    transition:.2s;
}

.course-item:hover{
    background:#F3EDDA;
    border-color:#E7D9A8;
}

.course-item input{
    width:18px;
    height:18px;
    cursor:pointer;
    accent-color:#A17807;
}

.course-item span{
    font-size:14px;
    color:#201B12;
}

/* =====================================
   BUTTON
===================================== */

.assign-btn{
    background:#201B12;
    color:#fff;
    border:none;
    border-radius:9px;
    padding:12px 22px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
    transition:.2s;
}

.assign-btn:hover{
    background:#3a311f;
}

/* =====================================
   MOBILE
===================================== */

@media(max-width:768px){

    .page-header h2{
        font-size:22px;
    }

    .collapse-btn{
        font-size:16px;
        padding:16px;
    }

    .course-grid{
        grid-template-columns:1fr;
    }

}
</style>
