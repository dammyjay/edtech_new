        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ studentIds })
      });
      const data = await res.json();
      if (data.success) {
        showAlert(data.message).then(() => location.reload());
      } else {
        showAlert(data.message || "Failed");
      }
