  // Opens the shared roster modal instead of expanding an inline row —
  // kept the function name/signature so every existing caller (the
  // classroom cards below, and the legacy create/edit-classroom success
  // templates) keeps working unchanged.
  async function toggleStudents(classroomId, classroomName) {
    openRosterModal(classroomId, classroomName || "");
  }

  async function openRosterModal(classroomId, classroomName) {
    document.getElementById("rosterModalTitle").textContent = classroomName ? `${classroomName} — Roster` : "Classroom Roster";
    document.getElementById("rosterModalSubtitle").textContent = SELECTED_TERM_ID
      ? "Showing this term's enrolled students"
      : "Showing the live, all-time roster (All Terms)";
    const container = document.getElementById("rosterModalBody");
    container.innerHTML = "<p style='padding:4px 0; color:#6E6350;'>Loading…</p>";
    document.getElementById("rosterModal").hidden = false;

    try {
      const res = await fetch(`/admin/classrooms/${classroomId}/students${SELECTED_TERM_ID ? `?term_id=${SELECTED_TERM_ID}` : ""}`);
      const students = await res.json();

      if (!Array.isArray(students) || students.length === 0) {
        container.innerHTML = "<p style='padding:4px 0; color:#6E6350;'>No students in this classroom" + (SELECTED_TERM_ID ? " for this term." : ".") + "</p>";
        return;
      }

      const palette = ["#A17807", "#1F7AC9", "#7C4DCC", "#2A9D5C", "#C9574A", "#B5720F"];
      const initialsOf = (name) => (name || "?").split(" ").map((p) => p[0]).slice(0, 2).join("").toUpperCase();

      container.innerHTML = students.map((stu) => `
        <div class="jk-roster-row">
          <div class="jk-avatar" style="background:${palette[(stu.fullname || "").length % palette.length]};">${initialsOf(stu.fullname)}</div>
          <div style="flex:1;">
            <p style="margin:0; font-weight:700; font-size:13.5px; color:#1A1510;">${stu.fullname}</p>
            <p style="margin:0; font-size:12px; color:#6E6350;">${stu.email || "—"} · ${stu.gender || "—"} · ${stu.dob ? new Date(stu.dob).toLocaleDateString() : "DOB —"}</p>
          </div>
        </div>
      `).join("");
    } catch (err) {
      container.innerHTML = "<p style='color:#B23A2A;'>Failed to load students.</p>";
    }
  }

  function closeRosterModal() { document.getElementById("rosterModal").hidden = true; }
</script>

