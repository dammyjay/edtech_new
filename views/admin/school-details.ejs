<!-- script for fitler table -->
<script>
  // Reads each row's own data-name/data-email/data-classroom attributes
  // rather than fixed column positions, so the Students and Teachers
  // tables can lay out their cells however their own design calls for
  // (an avatar+name+email combined cell, a single actions button, etc.)
  // without this shared filter breaking.
  function filterUsers(tableId, selectId, searchId) {
    const filterClass = document.getElementById(selectId).value.toLowerCase();
    const searchText = document.getElementById(searchId).value.toLowerCase();
    const table = document.getElementById(tableId);
    const body = table.tBodies[0];
    if (!body) return;

    Array.from(body.rows).forEach((tr) => {
      if (!tr.dataset.name) return; // the "No students/teachers yet" placeholder row
      const nameText = (tr.dataset.name || "").toLowerCase();
      const emailText = (tr.dataset.email || "").toLowerCase();
      const classText = (tr.dataset.classroom || "").toLowerCase();

      const matchClass = (filterClass === "" || classText === filterClass);
      const matchSearch = (nameText.includes(searchText) || emailText.includes(searchText));

      tr.style.display = (matchClass && matchSearch) ? "" : "none";
    });
  }
</script>

