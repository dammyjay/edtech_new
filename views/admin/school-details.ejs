<!-- Script for editing term  -->
 <script>
  function openEditTermModal(id, name, start, end, price, addonPlanIds, addonQuantities, discountType, discountValue, discountReason) {
    document.getElementById("edit_term_id").value = id;
    document.getElementById("edit_term_name").value = name;
    document.getElementById("edit_start_date").value = start;
    document.getElementById("edit_end_date").value = end;
    document.getElementById("edit_price_per_student").value = price || 0;

    const checkedIds = (addonPlanIds || []).map(String);
    document.querySelectorAll("#editTermAddonsContainer .edit-term-addon").forEach((box) => {
      box.checked = checkedIds.includes(box.value);
    });

    const quantities = addonQuantities || {};
    document.querySelectorAll("#editTermAddonsContainer .edit-term-addon-qty").forEach((input) => {
      const planId = input.dataset.planId;
      input.value = quantities[planId] || "";
    });

    const discountTypeEl = document.getElementById("edit_discount_type");
    if (discountTypeEl) discountTypeEl.value = discountType || "none";
    const discountValueEl = document.getElementById("edit_discount_value");
    if (discountValueEl) discountValueEl.value = discountValue || "";
    const discountReasonEl = document.getElementById("edit_discount_reason");
    if (discountReasonEl) discountReasonEl.value = discountReason || "";

    openModal("editTermModal");
  }

  document.getElementById("editTermForm").onsubmit = async (e) => {
    e.preventDefault();

    const id = document.getElementById("edit_term_id").value;

    const addonPlanIds = Array.from(
      document.querySelectorAll("#editTermAddonsContainer .edit-term-addon:checked")
    ).map((box) => box.value);

    const addonQuantities = {};
    document.querySelectorAll("#editTermAddonsContainer .edit-term-addon-qty").forEach((input) => {
      const qty = Number(input.value) || 0;
      if (qty > 0) {
        addonPlanIds.push(input.dataset.planId);
        addonQuantities[input.dataset.planId] = qty;
      }
    });

    const discountTypeEl = document.getElementById("edit_discount_type");
    const discountValueEl = document.getElementById("edit_discount_value");
    const discountReasonEl = document.getElementById("edit_discount_reason");

    const res = await fetch(`/admin/terms/${id}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: document.getElementById("edit_term_name").value,
        start_date: document.getElementById("edit_start_date").value,
        end_date: document.getElementById("edit_end_date").value,
        price_per_student: Number(document.getElementById("edit_price_per_student").value),
        addon_plan_ids: addonPlanIds,
        addon_quantities: addonQuantities,
        discount_type: discountTypeEl ? discountTypeEl.value : "none",
        discount_value: discountValueEl ? Number(discountValueEl.value) || 0 : 0,
        discount_reason: discountReasonEl ? discountReasonEl.value : "",
      })
    });

    if (res.ok) {
      showAlert("✅ Updated").then(() => {
        location.reload();
      });
    } else {
      showAlert("❌ Failed");
    }
  };
</script>

