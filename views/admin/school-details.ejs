<!-- script for term analytics  -->
<script>
  async function loadAnalytics() {
    const schoolId = "<%= school.id %>";

    const res = await fetch(`/admin/schools/${schoolId}/term-analytics`);
    const data = await res.json();

    let html = `
      <h3>📊 Analytics</h3>

      <p><strong>Total Unique Students:</strong> ${data.totals.total_unique_students}</p>
      <p><strong>Total Enrollments:</strong> ${data.totals.total_enrollments}</p>
      <p><strong>Retained Students:</strong> ${data.retention.retained_students}</p>

      <h4>Growth Per Term</h4>
      <ul>
    `;

    data.growth.forEach(term => {
      html += `<li>${term.name}: ${term.total_students} students</li>`;
    });

    html += `</ul>`;

    document.getElementById("analyticsBox").innerHTML = html;
  }
</script>

<!-- Script for editing term  -->
 <script>
  function openEditTermModal(id, name, start, end, price) {
    document.getElementById("edit_term_id").value = id;
    document.getElementById("edit_term_name").value = name;
    document.getElementById("edit_start_date").value = start;
    document.getElementById("edit_end_date").value = end;
    document.getElementById("edit_price_per_student").value = price || 0; // ✅ ADD

    openModal("editTermModal");
  }

  document.getElementById("editTermForm").onsubmit = async (e) => {
    e.preventDefault();

    const id = document.getElementById("edit_term_id").value;

    const res = await fetch(`/admin/terms/${id}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: document.getElementById("edit_term_name").value,
        start_date: document.getElementById("edit_start_date").value,
        end_date: document.getElementById("edit_end_date").value,
        price_per_student: Number(document.getElementById("edit_price_per_student").value) // ✅ ADD THIS
      })
    });

    if (res.ok) {
      alert("✅ Updated");
      location.reload();
    } else {
      alert("❌ Failed");
    }
  };
</script>

<!-- Script for deleting term -->
<script>
  async function deleteTerm(termId) {
    if (!confirm("Delete this term?")) return;

    const res = await fetch(`/admin/terms/${termId}`, {
      method: "DELETE"
    });

    if (res.ok) {
      alert("🗑 Deleted");
      location.reload();
    } else {
      alert("❌ Failed");
    }
  }
</script>

<!-- script for filter student in a classroom to be selectd -->
<script>
   document.querySelector("#assignTermModal select[name='classroom_id']")
  .addEventListener("change", function () {

    const selectedClass = this.value;

    document.querySelectorAll("#assignTermModal .student-item").forEach(item => {
      const studentClass = item.dataset.classroom;

      // Show all if "All Classrooms"
      if (!selectedClass) {
        item.style.display = "block";
        return;
      }

      // Show only matching classroom
      if (String(studentClass) === String(selectedClass)) {
        item.style.display = "block";
      } else {
        item.style.display = "none";
      }
    });

  });
</script>


<!-- script for removing student from term  -->
 <script>
  async function removeStudentFromTerm(termId, studentId) {
    if (!confirm("Remove this student from term?")) return;

    const res = await fetch(`/admin/terms/${termId}/students/${studentId}`, {
      method: "DELETE"
    });

    if (res.ok) {
      alert("Removed");
      location.reload();
    }
  }
</script>


<!-- script for toggling payment status -->

<script>
async function togglePayment(quoteId, currentStatus) {
  const newStatus = currentStatus === 'paid' ? 'unpaid' : 'paid';

  const res = await fetch(`/admin/quotes/${quoteId}/status`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: newStatus })
  });

  if (res.ok) {
    location.reload(); // simple refresh
  } else {
    alert('Failed to update');
  }
}
</script>