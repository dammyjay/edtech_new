  async function editSession(id) {
    openModal("editAttendanceModal");

    const res = await fetch(`/admin/attendance/session/full/${id}`);
    const data = await res.json();

    document.getElementById("editSessionId").value = id;
    document.getElementById("editStatus").value = data.session.session_status;
    document.getElementById("editWeek").value = data.session.week_number;
    document.getElementById("editDate").value = data.session.date;
    document.getElementById("editNote").value = data.session.note || "";

    let html = "";

    // ✅ CASE 1: records exist
    if (data.records.length > 0) {
      data.records.forEach(r => {
        html += `
          <div class="student-row">
            <input type="hidden" value="${r.id}" class="record-id" />
            <span>${r.fullname}</span>
            <select class="record-status">
              <option value="present" ${r.status === "present" ? "selected" : ""}>Present</option>
              <option value="absent" ${r.status === "absent" ? "selected" : ""}>Absent</option>
              <option value="late" ${r.status === "late" ? "selected" : ""}>Late</option>
            </select>
          </div>
        `;
      });

    } else {
      // ✅ CASE 2: no records → fetch students
      const res2 = await fetch(`/admin/attendance/students?term_id=${data.session.term_id}&classroom_id=${data.session.classroom_id}`);
      const students = await res2.json();

      students.forEach(s => {
        html += `
          <div class="student-row">
            <input type="hidden" value="" class="record-id" />
            <span>${s.fullname}</span>
            <select class="record-status">
              <option value="present">Present</option>
              <option value="absent">Absent</option>
              <option value="late">Late</option>
            </select>
          </div>
        `;
      });
    }

    document.getElementById("editStudentList").innerHTML = html;
  }

  document.getElementById("editStatus").addEventListener("change", async function () {
    const status = this.value;
    const id = document.getElementById("editSessionId").value;

    if (status !== "held") {
      document.getElementById("editStudentList").innerHTML =
        "<p>No attendance required</p>";
      return;
    }

    // reload students
    editSession(id);
  });

  document.getElementById("editAttendanceForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const id = document.getElementById("editSessionId").value;

    // update session
    await fetch(`/admin/attendance/session/${id}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        session_status: document.getElementById("editStatus").value,
        week_number: document.getElementById("editWeek").value,
        date: document.getElementById("editDate").value,
        note: document.getElementById("editNote").value
      })
    });

    // update students
    const updates = [];

    document.querySelectorAll(".student-row").forEach(row => {
      updates.push({
        id: row.querySelector(".record-id").value,
        status: row.querySelector(".record-status").value
      });
    });

    for (const u of updates) {
      await fetch(`/admin/attendance/record/${u.id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: u.status })
      });
    }

    showAlert("Updated successfully").then(() => {
      closeModal("editAttendanceModal");
      loadAttendanceHistory();
    });
  });

