     same /admin/classrooms/:id/assign-courses endpoint as the Assign
     Courses tab's school-wide form, scoped to one classroom. ===== -->
<div id="assignCourseModal" class="jk-modal-overlay" hidden>
  <div class="jk-modal">
    <div class="jk-modal-head">
      <div>
        <h4 id="assignCourseModalTitle">Assign Courses</h4>
        <p>Replaces this classroom's current course list with your selection.</p>
      </div>
      <button class="jk-modal-close" onclick="closeAssignCourseModal()" aria-label="Close">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="jk-modal-body">
      <form id="assignCourseModalForm">
        <select id="assignCourseModalSelect" class="jk-select-multi" multiple size="8">
          <% school.courses.forEach(course => { %>
            <option value="<%= course.id %>"><%= course.title %> - Level <%= course.level || '—' %></option>
          <% }) %>
        </select>
        <button type="submit" class="jk-btn-dark" style="margin-top:10px; width:100%;">Save Courses</button>
      </form>
    </div>
  </div>
</div>
<script>
  let assignCourseModalClassroomId = null;
  function openAssignCourseModal(classroomId, classroomName) {
    assignCourseModalClassroomId = classroomId;
    document.getElementById("assignCourseModalTitle").textContent = "Assign Courses — " + classroomName;
    document.getElementById("assignCourseModal").hidden = false;
  }
  function closeAssignCourseModal() { document.getElementById("assignCourseModal").hidden = true; }
  document.getElementById("assignCourseModalForm").onsubmit = async (e) => {
    e.preventDefault();
    const selected = Array.from(document.getElementById("assignCourseModalSelect").selectedOptions).map((o) => o.value);
    if (selected.length === 0) return showAlert("⚠️ Select at least one course.");
    try {
      const res = await fetch(`/admin/classrooms/${assignCourseModalClassroomId}/assign-courses`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ course_ids: selected }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || "Failed to assign courses.");
      await loadClassroomCoursesById(assignCourseModalClassroomId);
      closeAssignCourseModal();
      showAlert("✅ Courses assigned!");
    } catch (err) {
      showAlert("❌ " + (err.message || "Request failed. Try again."));
    }
  };
</script>

