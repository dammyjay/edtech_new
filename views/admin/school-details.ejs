<%- include('../partials/adminHeader', { title: school.name }) %>

<!-- Chart.js — used by the Attendance tab's weekly bar chart
     (loadAttendanceStats()). Was missing entirely, so that chart threw
     "Chart is not defined" the moment it ran and the whole Attendance
     tab silently never rendered anything past the static placeholder. -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
.nav-tabs {
  display: flex;
  justify-content: start;
  gap: 10px;
  margin: 20px 0;
  border-bottom: 2px solid #ddd;
  flex-wrap: wrap;
}

.tab-btn {
  background: #f0f0f0;
  border: none;
  padding: 10px 20px;
  cursor: pointer;
  font-weight: 600;
  border-radius: 6px 6px 0 0;
  transition: background 0.3s, color 0.3s;
  color: black;
}

.tab-btn:hover {
  background: #e1e1e1;
}

.tab-btn.active {
  background: #3498db;
  color: white;
  border-bottom: 2px solid white;
}

.status-held { color: green; font-weight: bold; }
.status-holiday { color: orange; font-weight: bold; }
.status-cancelled { color: red; font-weight: bold; }
.status-no_class { color: gray; font-weight: bold; }

.actions-col {
  display: flex;
  gap: 12px;
  align-items: center;
}

.action-icon {
  cursor: pointer;
  font-size: 16px;
  color: #333;
  transition: 0.2s;
}

.action-icon:hover {
  color: #007bff;
  transform: scale(1.2);
}

/* ===== School Details redesign (stat cards, classroom cards, pills,
   modals) — reuses the platform's existing --brand-pri tokens from
   style.css rather than inventing a new palette. ===== */
.jk-page { max-width: 1320px; margin: 0 auto; }
.jk-header-card { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; padding: 20px 24px; margin-bottom: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
.jk-header-card h2 { margin: 0 0 4px; font-size: 22px; font-weight: 800; color: #1A1510; }
.jk-header-card p { margin: 0; color: #6E6350; font-size: 13.5px; }
.jk-term-filter { display: flex; align-items: center; gap: 10px; background: #FAF8F2; border: 1px solid #E7E0CE; border-radius: 12px; padding: 8px 8px 8px 14px; }
.jk-term-filter select { border: none; background: none; font-family: inherit; font-size: 13px; font-weight: 600; color: var(--brand-pri-dark); padding: 4px; }
.jk-stat-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 14px; margin-bottom: 16px; }
@media (max-width: 1100px) { .jk-stat-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
.jk-stat-card { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
.jk-stat-card .jk-stat-head { display: flex; align-items: center; justify-content: space-between; }
.jk-stat-label { font-size: 11.5px; font-weight: 700; color: #8A7B55; text-transform: uppercase; letter-spacing: 0.04em; }
.jk-stat-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.jk-stat-value { font-size: 25px; font-weight: 800; color: #1A1510; }
.jk-stat-sub { font-size: 12px; color: #6E6350; }
.jk-stat-card--warn { background: var(--brand-tint); border-color: #F0C98A; cursor: pointer; text-align: left; }
.jk-stat-card--warn .jk-stat-label, .jk-stat-card--warn .jk-stat-sub { color: #9A6B1E; }
.jk-stat-card--warn .jk-stat-value { color: #9A5B14; }
.jk-completeness { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; padding: 14px 20px; margin-bottom: 26px; display: flex; align-items: center; gap: 16px; }
.jk-ring { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.jk-ring-inner { width: 38px; height: 38px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 11.5px; font-weight: 800; color: var(--brand-pri-dark); }
.jk-completeness p { margin: 0; }
.jk-completeness .jk-ctitle { font-weight: 700; font-size: 13.5px; color: #1A1510; margin-bottom: 2px; }
.jk-completeness .jk-csub { font-size: 12px; color: #6E6350; }
.jk-btn-fix { background: var(--brand-tint); color: var(--brand-pri-dark); border: none; padding: 9px 16px; border-radius: 9px; font-weight: 700; font-size: 12.5px; cursor: pointer; white-space: nowrap; margin-left: auto; }

.jk-section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
.jk-section-head h3 { margin: 0; font-size: 16px; font-weight: 800; color: #1A1510; }
.jk-btn-dark { background: #201B12; color: #EDE6D6; border: none; padding: 9px 16px; border-radius: 9px; font-weight: 700; font-size: 12.5px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
.jk-btn-gold { background: var(--brand-tint); color: var(--brand-pri-dark); border: none; padding: 9px 14px; border-radius: 9px; font-weight: 700; font-size: 12.5px; cursor: pointer; }
.jk-btn-outline { background: #fff; color: var(--brand-pri-dark); border: 1px solid #E7E0CE; padding: 9px 14px; border-radius: 9px; font-weight: 700; font-size: 12.5px; cursor: pointer; }
.jk-btn-outline-sm { background: #fff; color: var(--brand-pri-dark); border: 1px solid #E7E0CE; padding: 7px 10px; border-radius: 8px; font-weight: 700; font-size: 11.5px; cursor: pointer; }
.jk-icon-btn { background: none; border: none; cursor: pointer; width: 30px; height: 30px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: #6E6350; }
.jk-icon-btn:hover { background: #F6F4EF; }

.jk-classroom-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; margin-bottom: 30px; }
.jk-classroom-card { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
.jk-classroom-card .jk-cc-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.jk-classroom-card .jk-cc-name { margin: 0 0 3px; font-weight: 800; font-size: 15px; color: #1A1510; }
.jk-classroom-card .jk-cc-courses { margin: 0; font-size: 12px; color: #6E6350; }
.jk-flag-pill { background: var(--brand-tint); color: #9A5B14; font-size: 10.5px; font-weight: 700; padding: 4px 8px; border-radius: 999px; white-space: nowrap; }
.jk-stat-pills { display: flex; gap: 8px; }
.jk-stat-pill { flex: 1; background: #FAF8F2; border-radius: 9px; padding: 8px 6px; text-align: center; }
.jk-stat-pill b { display: block; font-size: 16px; font-weight: 800; color: #1A1510; }
.jk-stat-pill span { font-size: 10px; color: #8A7B55; font-weight: 600; }
.jk-cc-actions { display: flex; flex-wrap: wrap; gap: 6px; }
.jk-cc-actions button { flex: 1 1 auto; }

.jk-modal-overlay { position: fixed; inset: 0; background: rgba(26,21,16,0.55); display: flex; align-items: center; justify-content: center; z-index: 200; padding: 24px; }
.jk-modal-overlay[hidden] { display: none; }
.jk-modal { background: #fff; border-radius: 18px; width: 520px; max-width: 100%; max-height: 86vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
.jk-modal-head { padding: 20px 22px; display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid #F1ECDD; }
.jk-modal-head h4 { margin: 0; font-weight: 800; font-size: 15.5px; color: #1A1510; }
.jk-modal-head p { margin: 3px 0 0; font-size: 12px; color: #6E6350; }
.jk-modal-body { padding: 18px 22px 22px; display: flex; flex-direction: column; gap: 14px; }
.jk-modal-close { background: #F6F4EF; border: none; width: 28px; height: 28px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--brand-pri-dark); flex: 0 0 auto; }
.jk-roster-row { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; }
.jk-roster-row:hover { background: #FAF8F2; }
.jk-avatar { width: 32px; height: 32px; border-radius: 50%; color: #fff; font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.jk-unassigned-row { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid #F1ECDD; border-radius: 10px; margin-bottom: 8px; }
.jk-select-multi { width: 100%; border: 1px solid #E7E0CE; border-radius: 9px; padding: 8px; font-family: inherit; font-size: 13px; }
.jk-checklist { max-height: 220px; overflow-y: auto; border: 1px solid #E7E0CE; border-radius: 9px; padding: 6px; }
.jk-checklist label { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; font-size: 13px; cursor: pointer; }
.jk-checklist label:hover { background: #FAF8F2; }

/* Pill-style tab bar, replacing the plain gray login-tabs look */
.login-tabs { display: flex; gap: 4px; border-bottom: 1.5px solid #E7E0CE; margin: 22px 0; overflow-x: auto; }
.login-tab { background: none; border: none; cursor: pointer; padding: 11px 16px; font-weight: 700; font-size: 13.5px; white-space: nowrap; color: #9A8C66; border-bottom: 2.5px solid transparent; margin-bottom: -1.5px; font-family: inherit; }
.login-tab.active { color: var(--brand-pri-dark); border-bottom-color: var(--brand-pri); }
.login-tab:hover:not(.active) { color: var(--brand-pri-dark); }

/* ===== Students/Teachers table toolbar + list (Phase 2) ===== */
.jk-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; }
.jk-toolbar-spacer { flex: 1 1 auto; }
.jk-search-wrap { position: relative; flex: 1 1 240px; max-width: 320px; }
.jk-search-wrap svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); pointer-events: none; }
.jk-search-input { width: 100%; padding: 9px 12px 9px 34px; border-radius: 9px; border: 1px solid #E7E0CE; font-size: 13px; font-family: inherit; background: #fff; }
.jk-select { padding: 9px 12px; border-radius: 9px; border: 1px solid #E7E0CE; font-size: 13px; font-family: inherit; background: #fff; }
.jk-dropdown { position: relative; display: inline-block; }
.jk-dropdown-menu { position: absolute; top: calc(100% + 6px); right: 0; z-index: 60; background: #fff; border: 1px solid #E7E0CE; border-radius: 11px; box-shadow: 0 10px 28px rgba(0,0,0,0.16); padding: 6px; width: 240px; }
.jk-dropdown-menu[hidden] { display: none; }
.jk-dropdown-item { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left; padding: 9px 10px; border: none; border-radius: 8px; background: none; color: #332A18; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; }
.jk-dropdown-item:hover { background: #FAF8F2; }
.jk-selected-bar { display: flex; align-items: center; gap: 10px; background: var(--brand-tint); border: 1px solid #F0C98A; border-radius: 11px; padding: 10px 14px; margin-bottom: 14px; }
.jk-selected-bar span { font-size: 12.5px; color: #8A5A0C; font-weight: 700; }

.jk-table-wrap { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; overflow: hidden; overflow-x: auto; }
.jk-table { width: 100%; border-collapse: collapse; }
.jk-table thead th { text-align: left; padding: 12px 16px; background: #FAF8F2; font-size: 11px; font-weight: 700; color: #8A7B55; text-transform: uppercase; letter-spacing: 0.03em; white-space: nowrap; }
.jk-table tbody td { padding: 11px 16px; border-top: 1px solid #F1ECDD; font-size: 13px; color: #332A18; vertical-align: middle; }
.jk-table tbody tr:hover { background: #FBFAF6; }
/* Keeps the row-actions column visible without horizontal scrolling —
   on a narrow window/zoom level the other columns (esp. the student
   name+email) can add up to more than the viewport, and without this
   the action button silently scrolls out of view past the right edge
   instead of just being reachable by scrolling the table. */
.jk-table .jk-col-actions { position: sticky; right: 0; background: #fff; box-shadow: -6px 0 6px -6px rgba(26,21,16,0.12); }
.jk-table thead .jk-col-actions { background: #FAF8F2; }
.jk-row-user { display: flex; align-items: center; gap: 10px; }
.jk-row-name { margin: 0; font-weight: 700; font-size: 13.5px; color: #1A1510; }
.jk-row-sub { margin: 0; font-size: 12px; color: #6E6350; }
.jk-pill { display: inline-block; font-size: 11.5px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
.jk-pill--active { background: #EAF7EE; color: #1E7A42; }
.jk-pill--inactive { background: #F1ECDD; color: #6E6350; }
.jk-pill--on { background: #FBF3DD; color: var(--brand-pri-dark); }
.jk-pill--off { background: #F1ECDD; color: #8A7B55; }
.jk-pill--paid { background: #EAF7EE; color: #1E7A42; }
.jk-pill--partial { background: var(--brand-tint); color: var(--brand-pri-dark); }
.jk-pill--unpaid { background: #FDEEEC; color: #B23A2A; }

/* ===== Terms tab (Phase 4) ===== */
.jk-term-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; margin-bottom: 20px; }
.jk-term-card { background: #fff; border: 1px solid #EDE7D6; border-radius: 14px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
.jk-term-card .jk-tc-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.jk-term-card .jk-tc-name { margin: 0 0 3px; font-weight: 800; font-size: 15px; color: #1A1510; }
.jk-term-card .jk-tc-period { margin: 0; font-size: 12px; color: #6E6350; }
.jk-tc-pricing { background: #FAF8F2; border-radius: 10px; padding: 10px 12px; font-size: 12.5px; color: #4C3802; display: flex; flex-direction: column; gap: 3px; }
.jk-tc-pricing .jk-tc-total { font-weight: 800; font-size: 14px; color: #1A1510; }
.jk-tc-actions { display: flex; flex-wrap: wrap; gap: 6px; }

/* Light restyle of the existing create/edit term forms -- structure and
   field ids/names untouched, this only changes how they look. */
.jk-term-modal { max-width: 460px; }
.jk-term-modal h2 { font-size: 16px; font-weight: 800; color: #1A1510; margin: 0 0 16px; }
.jk-term-modal .close-btn { cursor: pointer; color: #4C3802; font-size: 20px; }
.jk-term-modal input[type="text"], .jk-term-modal input[type="date"], .jk-term-modal input[type="number"], .jk-term-modal select {
  width: 100%; padding: 9px 12px; margin-bottom: 10px; border-radius: 9px; border: 1px solid #E7E0CE;
  font-family: inherit; font-size: 13px; box-sizing: border-box; background: #fff;
}
.jk-term-modal label { font-weight: 600; font-size: 12.5px; color: #4C3802; }
</style>


<section class="section jk-page">

    <div class="jk-header-card">
      <div>
        <h2><%= school.name %></h2>
        <p><%= school.address || 'No address on file' %> · <%= school.email || 'No email' %> · <%= school.phone || 'No phone' %></p>
      </div>
      <div class="jk-term-filter">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#A17807" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <select id="globalTermFilter" onchange="changeGlobalTerm(this.value)">
          <option value="" <%= !selectedTermId ? 'selected' : '' %>>All Terms</option>
          <% school.terms.forEach(term => { %>
            <option value="<%= term.term_id %>" <%= selectedTermId === term.term_id ? 'selected' : '' %>>
              <%= term.term_name %> <%= term.status === 'active' ? '(active)' : '' %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>
    <% if (selectedTermId) { %>
      <p style="color:#6E6350; font-size:12.5px; margin:-10px 0 16px;">Students, classrooms and counts below are scoped to this term.</p>
    <% } %>
    <script>
      // The page-wide selected term (null = "All Terms") — read by the
      // classroom "view students" modal below so it matches the term
      // scoping already applied to the classroom list's student_count.
      const SELECTED_TERM_ID = <%- JSON.stringify(selectedTermId) %>;
      // Reloads the page with ?term_id= set, preserving whichever tab
      // was open (openTab()'s sections aren't otherwise reflected in the
      // URL) so switching terms doesn't bounce the admin back to the
      // Overview view.
      function changeGlobalTerm(termId) {
        const url = new URL(window.location.href);
        // Always keep term_id PRESENT in the URL, even as "" for "All
        // Terms" — the server only clears its session-persisted filter
        // when the query param is explicitly present (see
        // getSchoolDetails's `req.query.term_id !== undefined` check).
        // Deleting the param outright used to make the server fall back
        // to whatever term was already in session, so picking "All
        // Terms" silently did nothing.
        url.searchParams.set("term_id", termId || "");
        const openSection = document.querySelector('[id$="-section"][style*="display: block"], [id$="-section"][style*="display:block"]');
        if (openSection) url.searchParams.set("tab", openSection.id);
        window.location.href = url.toString();
      }
      document.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const tab = params.get("tab");
        if (tab) {
          const btn = document.querySelector(`[onclick*="openTab('${tab}'"]`);
          if (btn) openTab(tab, btn);
        }
      });
    </script>

    <% const jkUnassignedTotal = (unassignedStudents ? unassignedStudents.length : 0) + (unassignedClassrooms ? unassignedClassrooms.length : 0); %>
    <% const jkTermedStudents = school.totals.total_students - (unassignedStudents ? unassignedStudents.length : 0); %>
    <% const jkCompletenessPct = school.totals.total_students > 0 ? Math.round((jkTermedStudents / school.totals.total_students) * 100) : 100; %>

    <div class="jk-stat-grid">
      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Students</span>
          <div class="jk-stat-icon" style="background:#FBF3DD;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#A17807" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
        </div>
        <span class="jk-stat-value"><%= school.totals.total_students %></span>
        <span class="jk-stat-sub"><%= selectedTermId ? 'this term' : 'all time' %></span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Teachers</span>
          <div class="jk-stat-icon" style="background:#E9F3FB;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1F7AC9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"/></svg>
          </div>
        </div>
        <span class="jk-stat-value"><%= school.totals.total_teachers %></span>
        <span class="jk-stat-sub"><%= school.classrooms.length %> classrooms</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Instructors</span>
          <div class="jk-stat-icon" style="background:#F1EAFB;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7C4DCC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
          </div>
        </div>
        <span class="jk-stat-value"><%= school.totals.total_instructors %></span>
        <span class="jk-stat-sub">Platform-assigned</span>
      </div>

      <div class="jk-stat-card">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Classrooms</span>
          <div class="jk-stat-icon" style="background:#EAF7EE;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2A9D5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-7h6v7"/></svg>
          </div>
        </div>
        <span class="jk-stat-value"><%= school.classrooms.length %></span>
        <span class="jk-stat-sub"><%= school.terms.length %> terms on record</span>
      </div>

      <button class="jk-stat-card jk-stat-card--warn" onclick="openUnassignedPanel()" type="button">
        <div class="jk-stat-head">
          <span class="jk-stat-label">Needs a Term</span>
          <div class="jk-stat-icon" style="background:#F7E2C0;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B5720F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
          </div>
        </div>
        <span class="jk-stat-value"><%= jkUnassignedTotal %></span>
        <span class="jk-stat-sub">students &amp; classrooms · view →</span>
      </button>
    </div>

    <div class="jk-completeness">
      <div class="jk-ring" style="background: conic-gradient(var(--brand-pri) 0% <%= jkCompletenessPct %>%, #EDE7D6 <%= jkCompletenessPct %>% 100%);">
        <div class="jk-ring-inner"><%= jkCompletenessPct %>%</div>
      </div>
      <div>
        <p class="jk-ctitle">Term enrollment completeness</p>
        <p class="jk-csub"><%= jkTermedStudents %> of <%= school.totals.total_students %> students have a term on record.</p>
      </div>
      <button class="jk-btn-fix" onclick="openUnassignedPanel()" type="button">Fix this →</button>
    </div>

    <div class="jk-section-head">
      <div>
        <button class="jk-btn-outline" onclick="window.location.href='/admin/schools/<%= school.id %>/download-progress'">📄 Download School Summary</button>
      </div>
      <div style="display:flex; align-items:center; gap:8px;">
        <select id="loginCardsTermFilter" class="jk-select-multi" style="width:auto;">
          <option value="">All students</option>
          <% school.terms.forEach(term => { %>
            <option value="<%= term.term_id %>" <%= term.status === 'active' ? 'selected' : '' %>>
              <%= term.term_name %> <%= term.status === 'active' ? '(active)' : '' %>
            </option>
          <% }) %>
        </select>
        <button class="jk-btn-gold" onclick="downloadLoginCards()">📥 Login Cards</button>
        <button class="jk-btn-outline-sm" style="color:#B23A2A;" onclick="archiveSchool()">🗄️ Archive School</button>
      </div>
    </div>

    <script>
      async function archiveSchool() {
        if (!(await showConfirm("Archive this school? It will be hidden from listings and its School ID won't be usable for new signups, but nothing is deleted — restore it later from the Archive screen."))) return;
        const res = await fetch(`/admin/schools/<%= school.id %>/archive`, {
          method: "POST",
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          showAlert("School archived.").then(() => { window.location.href = "/admin/schools"; });
        } else {
          showAlert(data.message || "Could not archive this school.");
        }
      }
    </script>

</section>

