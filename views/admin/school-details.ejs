<!-- script for attendance modal -->
 <script>
  function openAttendanceModal() {
    openModal("attendanceModal");
    loadStudentsForAttendance();
  }
// submit attendance
    async function loadStudentsForAttendance() {
      const status = document.getElementById("sessionStatus").value;
      const container = document.getElementById("attendanceStudentList");

      // 🚫 If not held → stop here
      if (status !== "held") {
        container.innerHTML = "<p>⚠️ No attendance required for this session</p>";
        return;
      }

      const classroomId = document.getElementById("attendanceClassroom").value;
      const termId = document.querySelector('[name="term_id"]').value;

      const res = await fetch(`/admin/attendance/students?term_id=${termId}&classroom_id=${classroomId}`);
      const students = await res.json();

      container.innerHTML = "";

      students.forEach(s => {
        container.innerHTML += `
          <div class="student-row">
            <span>${s.fullname}</span>
            <select data-id="${s.id}">
              <option value="present">✅ Present</option>
              <option value="absent">❌ Absent</option>
              <option value="late">⏰ Late</option>
            </select>
          </div>
        `;
      });
    }

    async function loadAttendanceStats() {
      const termId = document.getElementById("attendanceFilterTerm").value;

      const res = await fetch(`/admin/attendance/stats/weekly?term_id=${termId}`);
      const data = await res.json();

      const labels = data.map(d => `Week ${d.week_number}`);
      const present = data.map(d => d.present);
      const absent = data.map(d => d.absent);
      const percent = data.map(d => d.attendance_percent);

      new Chart(document.getElementById("attendanceChart"), {
        type: "bar",
        data: {
          labels,
          datasets: [
            { label: "Present", data: present },
            { label: "Absent", data: absent }
          ]
        }
      });

      let avg = percent.reduce((a,b)=>a+b,0)/percent.length;

      document.getElementById("attendanceSummary").innerHTML = `
        <h3>Average Attendance: ${avg.toFixed(1)}%</h3>
      `;
    }

    document.getElementById("attendanceForm").addEventListener("submit", async (e) => {
      e.preventDefault();

      const form = e.target;

      const records = [];

      document.querySelectorAll("#attendanceStudentList select").forEach(sel => {
        records.push({
          student_id: sel.dataset.id,
          status: sel.value
        });
      });

      const payload = {
        school_id: form.school_id.value,
        term_id: form.term_id.value,
        classroom_id: form.classroom_id.value,
        date: form.date.value,
        week_number: form.week_number.value,
        session_status: document.getElementById("sessionStatus").value, // ✅ ADD
        note: document.getElementById("note").value || "",
        records
      };

      const res = await fetch("/admin/attendance/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (data.success) {
        alert("Attendance saved!");
        closeModal("attendanceModal");
      }
    });
 
async function toggleAttendanceDetails(sessionId) {
  const row = document.getElementById(`attendance-row-${sessionId}`);
  const container = document.getElementById(`attendance-details-${sessionId}`);

  if (!row || !container) return; // ✅ prevents crash

  if (row.style.display === "none") {
    row.style.display = "table-row";

    if (!container.dataset.loaded) {
      const res = await fetch(`/admin/attendance/session/${sessionId}`);
      const data = await res.json();

      if (data.length === 0) {
        container.innerHTML = "<p>No attendance records</p>";
      } else {
        let html = `
          <table class="user-table" style="margin-top:10px;">
            <thead>
              <tr>
                <th>Student</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
        `;

        data.forEach(s => {
          html += `
            <tr>
              <td>${s.fullname}</td>
              <td>${formatSessionStatus(s.status)}</td>
            </tr>
          `;
        });

        html += "</tbody></table>";
        container.innerHTML = html;
      }

      container.dataset.loaded = "true";
    }

  } else {
    row.style.display = "none";
  }
}

async function loadAttendanceHistory() {
    const termId = document.getElementById("attendanceFilterTerm").value;
    const classroomId = document.getElementById("attendanceFilterClassroom").value;

    const res = await fetch(`/admin/attendance/history?term_id=${termId}&classroom_id=${classroomId}`);
    const data = await res.json();

    const tbody = document.getElementById("attendanceTableBody");
    tbody.innerHTML = "";

    if (data.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;">No attendance found</td></tr>`;
      return;
    }

    data.forEach(a => {
      tbody.innerHTML += `
        <tr>
          <td>${new Date(a.date).toDateString()}</td>
          <td>${a.classroom}</td>
          <td>${formatSession(a.session_status)}</td>
          <td>${a.taken_by || '-'}</td>

          <!-- ✅ ADD THIS -->
          <td>${a.student_count || 0} students</td>

          <td class="actions-col">
            <i class="fa fa-eye action-icon" style="cursor:pointer; color:blue;" onclick="toggleAttendanceDetails(${a.id})"></i>
            <i class="fa fa-eye action-icon" style="cursor:pointer; color:green;" onclick="viewAttendance(${a.id})"></i>
            <i class="fa fa-edit action-icon" style="cursor:pointer; color:orange;" onclick="editSession(${a.id})"></i>
            <i class="fa fa-trash action-icon" style="cursor:pointer; color:red;" onclick="deleteSession(${a.id})"></i>
            <a href="/admin/attendance/export/pdf/${a.id}" target="_blank">
              <i class="fa fa-file-pdf action-icon" style="cursor:pointer; color:red;"></i>
            </a>
            <i class="fa fa-file-excel action-icon" style="cursor:pointer; color:green;" onclick="exportExcel()"></i>
          </td>
        </tr>

         <tr id="attendance-row-${a.id}" style="display:none;">
            <td colspan="6">
              <div id="attendance-details-${a.id}"></div>
            </td>
          </tr>
      `;
    });
  }

