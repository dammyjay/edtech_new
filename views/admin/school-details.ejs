  // Picking a rate-card plan pre-fills the price field as a convenience —
  // the field stays a normal, freely-editable number input either way,
  // so a negotiated/custom price still works exactly as before.
  function applyTermPlanPrice(select) {
    const opt = select.options[select.selectedIndex];
    const planIdField = document.getElementById("createTermPlanId");
    const priceField = document.getElementById("createTermPrice");
    if (opt.value) {
      if (planIdField) planIdField.value = opt.value;
      if (priceField) priceField.value = opt.dataset.price;
    } else if (planIdField) {
      planIdField.value = "";
    }
  }

  // 🔹 Open edit modal and prefill
  function openEditClassroom(id, name, teacherIds) {
    document.getElementById("edit_classroom_id").value = id;
    document.getElementById("edit_name").value = name;

    const teacherSelect = document.getElementById("edit_teacher_ids");
    Array.from(teacherSelect.options).forEach(opt => {
      opt.selected = teacherIds.includes(parseInt(opt.value));
    });

    openModal('editClassroomModal');
  }

  // ✅ Create Classroom
  document.getElementById("createClassroomForm").onsubmit = async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target);
    const payload = Object.fromEntries(formData.entries());

    // Handle multi-select teachers
    if (formData.getAll("teacher_id").length > 0) {
      payload.teacher_id = formData.getAll("teacher_id");
    }

    const res = await fetch("/admin/classrooms/new", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    const data = await res.json();
    if (data.success) {
      // Reload rather than patch the DOM by hand — the classroom grid
      // (card-based, not the old table) needs the full set of fields
      // (course tags, term-scoped counts, flagged state) a fresh render
      // computes server-side anyway, and every other create/assign flow
      // on this page already reloads on success the same way.
      showAlert("✅ Classroom created!").then(() => {
        window.location.reload();
      });
    } else {
      showAlert("❌ " + data.message);
    }
  };

  // ✅ Edit Classroom
  document.getElementById("editClassroomForm").onsubmit = async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target);
    const payload = Object.fromEntries(formData.entries());
    const classroomId = payload.id;

    if (formData.getAll("teacher_ids").length > 0) {
      payload.teacher_ids = formData.getAll("teacher_ids");
    }

    const res = await fetch(`/admin/classrooms/${classroomId}/edit`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    const data = await res.json();
    if (data.success) {
      showAlert("✏ Classroom updated!").then(() => {
        window.location.reload();
      });
    } else {
      showAlert("❌ " + data.message);
    }
  };

  // 🔹 Helper: Add classroom to dropdowns
  function addClassroomToDropdowns(classroom) {
    const dropdownIds = ["teacherClassFilter", "studentClassFilter", "assignClassroom"];
    dropdownIds.forEach(id => {
      const select = document.getElementById(id);
      if (select) {
        const opt = document.createElement("option");
        opt.value = classroom.id;
        opt.textContent = classroom.name;
        select.appendChild(opt);
      }
    });
  }

  // 🔹 Helper: Update classroom name in dropdowns
  function updateClassroomInDropdowns(classroom) {
    const dropdownIds = ["teacherClassFilter", "studentClassFilter", "assignClassroom"];
    dropdownIds.forEach(id => {
      const select = document.getElementById(id);
      if (select) {
        const opt = select.querySelector(`option[value="${classroom.id}"]`);
        if (opt) opt.textContent = classroom.name;
      }
    });
  }

  // ✏️ Edit Classroom
async function updateClassroom(id) {
  const name = prompt("Enter new classroom name:");
  if (!name) return showAlert("Classroom name is required.");

  try {
    const res = await fetch(`/admin/classrooms/${id}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name }),
    });

    if (res.ok) {
      showAlert("✅ Classroom updated successfully!").then(() => {
        location.reload();
      });
    } else {
      const data = await res.json();
      showAlert("❌ " + data.message);
    }
  } catch (err) {
    console.error(err);
    showAlert("⚠️ Network or server error.");
  }
}

// 🗑️ Archive Classroom
async function deleteClassroom(id) {
  if (!(await showConfirm("Archive this classroom? It will be hidden everywhere but can be restored later from the Archive screen."))) return;

  try {
    const res = await fetch(`/admin/classrooms/${id}`, {
      method: "DELETE",
    });

    if (res.ok) {
      showAlert("🗄️ Classroom archived successfully!").then(() => {
        location.reload();
      });
    } else {
      const data = await res.json();
      showAlert("❌ " + data.message);
    }
  } catch (err) {
    console.error(err);
    showAlert("⚠️ Error archiving classroom.");
  }
}


