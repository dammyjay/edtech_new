<!-- script for assigning students to classroom -->

  <script>
    // Assign multiple students to a classroom in ONE request
    async function assignUsers(e, classroomId, role) {
      e.preventDefault();
      const select = document.getElementById(`${role}MultiSelect-${classroomId}`);
      const selected = Array.from(select.options)
        .filter(o => o.selected)
        .map(o => parseInt(o.value, 10));

      if (selected.length === 0) {
        return showAlert(`Please select at least one ${role}.`);
      }

      // The term these candidates were actually drawn from (see
      // loadClassroomCandidates) — passed through so the server syncs
      // student_term_enrollments for THIS term specifically, instead of
      // guessing "whichever term is_active" (which can disagree with
      // what's shown here when a term's is_active flag and its
      // date-computed "(active)" label don't match).
      const termSelectEl = document.getElementById("classroomAssignTermFilter");
      const termId = termSelectEl ? termSelectEl.value : "";

      try {
        const res = await fetch(`/admin/classrooms/${classroomId}/assign`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_ids: selected, role, term_id: termId || undefined })
        });

        const data = await res.json();
        if (data.success) {
          showAlert(`✅ ${selected.length} ${role}(s) assigned successfully!`);

          // 🔄 Refresh list inline
          if (role === "student") {
            await refreshStudents(classroomId);
          }

          // 🔄 Update the count cell
          const countCell = document.getElementById(`${role}-count-${classroomId}`);
          if (countCell) {
            let currentCount = parseInt(countCell.textContent || "0", 10);
            countCell.textContent = currentCount + selected.length;
          }

          // 🔄 Rebuild dropdowns. For students, re-fetch the term-scoped
          // candidate list (a student just assigned to THIS classroom
          // needs to disappear from every OTHER classroom's picker too,
          // which data.unassigned alone can't do since it isn't
          // term-aware). Instructors aren't exclusive to one classroom
          // (the same instructor can teach several), so "unassigned"
          // isn't a meaningful concept here — just close the modal.
          if (role === "student") {
            await loadClassroomCandidates();
          } else if (role === "instructor") {
            closeAssignInstructorsModal();
          } else {
            select.innerHTML = "";
            if (data.unassigned && data.unassigned.length > 0) {
              data.unassigned.forEach(u => {
                const opt = document.createElement("option");
                opt.value = u.id;
                opt.textContent = `${u.full_name || u.fullname} (${u.email})`;
                select.appendChild(opt);
              });
            } else {
              const opt = document.createElement("option");
              opt.disabled = true;
              opt.textContent = `No unassigned ${role}s available`;
              select.appendChild(opt);
            }
          }
        } else {
          showAlert("❌ Failed: " + data.message);
        }
      } catch (err) {
        console.error(err);
        showAlert("❌ Request failed.");
      }
    }

    // Populates every classroom's "Assign Multiple Students" picker from
    // the term selected in #classroomAssignTermFilter — active students
    // enrolled in that term. By default only students not already in any
    // classroom (see adminController.js's getClassroomCandidates); with
    // #includeAssignedStudents checked, also includes students already
    // assigned elsewhere (labeled with their current classroom) so they
    // can be deliberately moved — otherwise a term where every student
    // already has a classroom (e.g. reorganizing into a newly-created
    // section) would show no candidates at all.
    async function loadClassroomCandidates() {
      const termSelect = document.getElementById("classroomAssignTermFilter");
      const includeAssigned = document.getElementById("includeAssignedStudents")?.checked;
      const selects = document.querySelectorAll(".classroom-candidate-select");
      if (!termSelect || !termSelect.value) {
        selects.forEach(sel => {
          sel.innerHTML = "";
          const opt = document.createElement("option");
          opt.disabled = true;
          opt.textContent = "No term selected";
          sel.appendChild(opt);
        });
        return;
      }

      try {
        const url = `/admin/schools/<%= school.id %>/terms/${termSelect.value}/classroom-candidates` +
          (includeAssigned ? "?include_assigned=true" : "");
        const res = await fetch(url);
        const data = await res.json();
        const students = (data.success && data.students) || [];

        selects.forEach(sel => {
          sel.innerHTML = "";
          if (students.length === 0) {
            const opt = document.createElement("option");
            opt.disabled = true;
            opt.textContent = includeAssigned
              ? "No students in this term"
              : "No unassigned students in this term — try \"also show students already in another classroom\" above";
            sel.appendChild(opt);
            return;
          }
          students.forEach(s => {
            const opt = document.createElement("option");
            opt.value = s.id;
            opt.textContent = s.current_classroom_name
              ? `${s.fullname} (${s.email}) — currently in ${s.current_classroom_name}`
              : `${s.fullname} (${s.email})`;
            sel.appendChild(opt);
          });
        });
      } catch (err) {
        console.error("loadClassroomCandidates error:", err);
      }
    }

    document.addEventListener("DOMContentLoaded", loadClassroomCandidates);


    // Refresh only this classroom's student list
    async function refreshStudents(classroomId) {
      const container = document.getElementById(`students-container-${classroomId}`);
      try {
        const res = await fetch(`/admin/classrooms/${classroomId}/students${SELECTED_TERM_ID ? `?term_id=${SELECTED_TERM_ID}` : ""}`);
        const students = await res.json();

        if (students.length === 0) {
          container.innerHTML = "<p>No students in this classroom.</p>";
        } else {
          let html = `
            <div class="table-responsive">
              <table class="user-table sortable-table" style="width:100%; margin-top:10px; background:#f9f9f9;">
                <thead>
                  <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>DOB</th>
                  </tr>
                </thead>
                <tbody>
          `;
          students.forEach(stu => {
            html += `
              <tr>
                <td>${stu.fullname}</td>
                <td>${stu.email || "—"}</td>
                <td>${stu.phone || "—"}</td>
                <td>${stu.gender || "—"}</td>
                <td>${stu.dob ? new Date(stu.dob).toLocaleDateString() : "—"}</td>
              </tr>
            `;
          });
          html += "</tbody></table></div>";
          container.innerHTML = html;
        }
      } catch (err) {
        container.innerHTML = "<p style='color:red;'>Failed to refresh students.</p>";
      }
    }
  

    function openAssignModal(userId, role, currentClassroomId = null) {
      document.getElementById("assignUserId").value = userId;
      document.getElementById("assignRole").value = role;
      document.getElementById("assignTitle").innerText = `Assign ${role} to Classroom`;

      const select = document.getElementById("assignClassroom");

      if (role === "instructor") {
        select.setAttribute("multiple", "multiple"); // allow many classes
        select.value = "";
      } else {
        select.removeAttribute("multiple"); // only one class
        if (currentClassroomId) {
          select.value = currentClassroomId;
        } else {
          select.value = "";
        }
      }

      document.getElementById("assignModal").style.display = "block";
    }


    function closeAssignModal() {
      document.getElementById("assignModal").style.display = "none";
    }

    document.getElementById("assignForm").onsubmit = async (e) => {
      e.preventDefault();
      const userId = document.getElementById("assignUserId").value;
      const role = document.getElementById("assignRole").value;
      const classroomId = document.getElementById("assignClassroom").value;
      const schoolId = "<%= school.id %>";

      if (!classroomId) return showAlert("Please select a classroom");

      // This modal has no term picker of its own — fall back to the
      // page-wide term filter (see SELECTED_TERM_ID above) so the
      // server still has a specific term to sync, when one's selected.
      const res = await fetch(`/admin/classrooms/${classroomId}/assign`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ user_ids: [parseInt(userId)], role, term_id: SELECTED_TERM_ID || undefined })
      });

      const data = await res.json();
      if (data.success) {
        showAlert(`✅ ${role} assigned successfully!`).then(() => {
          closeAssignModal();
          location.reload(); // reload to reflect classroom assignment
        });
      } else {
        showAlert("❌ Failed: " + data.message);
      }
    };
  
  </script>

<!-- script for creating & editing classroom -->
<script>
  function openModal(id) {
