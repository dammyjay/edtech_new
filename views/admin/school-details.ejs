<!-- Terms Section  -->
<div id="terms-section" style="display:none;">

  <div class="jk-section-head">
    <h3>Academic Terms</h3>
    <div style="display:flex; gap:8px;">
      <button class="jk-btn-outline" onclick="openModal('assignTermModal')" type="button">Assign Students</button>
      <button class="jk-btn-dark" onclick="openModal('createTermModal')" type="button">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Create Term
      </button>
    </div>
  </div>

  <% if (school.terms.length === 0) { %>
    <p style="color:#6E6350;">No terms created yet.</p>
  <% } else { %>
    <div class="jk-term-grid">
      <% school.terms.forEach(term => { %>
        <%
          const statusPillClass = term.is_ended ? 'jk-pill--inactive' : (term.status === 'active' ? 'jk-pill--active' : 'jk-pill--off');
          const paymentClass = !term.quote ? '' : (term.quote.status === 'paid' ? 'jk-pill--paid' : (term.quote.status === 'partial' ? 'jk-pill--partial' : 'jk-pill--unpaid'));
          const paymentLabel = !term.quote ? '' : (term.quote.status === 'paid' ? '✅ Paid' : (term.quote.status === 'partial' ? '⚠️ Part Payment' : '❌ Not Paid'));
        %>
        <div class="jk-term-card">
          <div class="jk-tc-head">
            <div>
              <p class="jk-tc-name"><%= term.term_name %></p>
              <p class="jk-tc-period"><%= term.start_date %> → <%= term.end_date %></p>
            </div>
            <span class="jk-pill <%= statusPillClass %>"><%= term.is_ended ? ('Ended ' + new Date(term.ended_at).toLocaleDateString()) : term.statusLabel %></span>
          </div>

          <div class="jk-stat-pills">
            <div class="jk-stat-pill"><b><%= term.student_count %></b><span>Students</span></div>
          </div>

          <div class="jk-tc-pricing">
            <div>Price/Student: ₦<%= term.quote?.price_per_student || 0 %><% if (term.quote?.plan_name) { %> (<%= term.quote.plan_name %> plan)<% } %></div>
            <% if (term.quote?.addon_labels && term.quote.addon_labels.length) { %>
              <% term.quote.addon_labels.forEach(label => { %><div>+ <%= label %></div><% }) %>
            <% } %>
            <div class="jk-tc-total">Total: ₦<%= term.quote?.total_amount || 0 %></div>
            <% if (term.quote?.discount_amount > 0) { %>
              <div style="color:#1E7A42; font-weight:600;">
                <% if (term.quote.discount_type === 'addons_included') { %>
                  Modules included — no extra charge
                <% } else { %>
                  Discount: <%= term.quote.discount_type === 'percent' ? Number(term.quote.discount_value) + '%' : '₦' + Number(term.quote.discount_value).toLocaleString() + ' flat' %>
                <% } %>
                (−₦<%= Number(term.quote.discount_amount).toLocaleString() %>)
                <% if (term.quote.discount_reason) { %><br><%= term.quote.discount_reason %><% } %>
              </div>
              <div>Before discount: ₦<%= Number(term.quote.subtotal).toLocaleString() %></div>
            <% } %>
            <% if (term.quote) { %>
              <button class="jk-pill <%= paymentClass %>" style="border:none; cursor:pointer; width:fit-content; margin-top:4px;" onclick="togglePayment('<%= term.quote.id %>', '<%= term.quote.status %>')" type="button"><%= paymentLabel %></button>
            <% } %>
          </div>

          <div class="jk-tc-actions">
            <button class="jk-btn-outline-sm" onclick="openTermRosterModal('<%= term.term_id %>', '<%= term.term_name.replace(/'/g, "\\'") %>')" type="button">View Students</button>
            <button class="jk-btn-outline-sm" onclick="openEditTermModal(
              '<%= term.term_id %>',
              '<%= term.term_name %>',
              '<%= term.start_date ? new Date(term.start_date).toISOString().slice(0,10) : "" %>',
              '<%= term.end_date ? new Date(term.end_date).toISOString().slice(0,10) : "" %>',
              <%= term.quote?.price_per_student || 0 %>,
              <%- JSON.stringify(term.quote?.addon_plan_ids || []).replace(/"/g, '&quot;') %>,
              <%- JSON.stringify(term.quote?.addon_quantities || {}).replace(/"/g, '&quot;') %>,
              '<%= term.quote?.discount_type || "none" %>',
              <%= term.quote?.discount_value || 0 %>,
              '<%= (term.quote?.discount_reason || "").replace(/'/g, "\\'") %>'
            )" type="button">Edit</button>
            <a class="jk-btn-outline-sm" style="text-decoration:none; display:inline-flex; align-items:center;" href="/admin/terms/<%= term.term_id %>/export-excel">Export</a>
            <% if (term.quote) { %>
              <a class="jk-btn-outline-sm" style="text-decoration:none; display:inline-flex; align-items:center;" href="/admin/quotes/<%= term.quote.id %>/download">Quote PDF</a>
            <% } %>
            <button id="endTermBtn-<%= term.term_id %>" class="jk-btn-outline-sm endterm-btn"
               data-term-id="<%= term.term_id %>"
               data-generation-status="<%= term.report_generation_status || 'idle' %>"
               data-is-ended="<%= term.is_ended %>"
               title="<%= term.is_ended ? 'Regenerate all reports for this term' : 'Mark term ended and generate all reports' %>"
               onclick="endTerm(event, '<%= term.term_id %>', <%= term.is_ended %>)" type="button">
              <% if (term.report_generation_status === 'in_progress') { %>
                ⏳ <%= term.report_generation_completed || 0 %>/<%= term.report_generation_total || 0 %>
              <% } else { %>
                🏁 <%= term.is_ended ? 'Regenerate Reports' : 'End Term' %>
              <% } %>
            </button>
            <button class="jk-icon-btn" title="Archive" onclick="deleteTerm('<%= term.term_id %>')" type="button">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B23A2A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<!-- ===== Shared Term Roster modal (replaces the old inline-expanding
     row) — same /admin/terms/:id/students endpoint, same
     removeStudentFromTerm() action, unchanged. ===== -->
<div id="termRosterModal" class="jk-modal-overlay" hidden>
  <div class="jk-modal">
    <div class="jk-modal-head">
      <h4 id="termRosterModalTitle">Term Roster</h4>
      <button class="jk-modal-close" onclick="closeTermRosterModal()" aria-label="Close">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="jk-modal-body" id="termRosterModalBody"></div>
  </div>
</div>
<script>
  let termRosterModalTermId = null;
  async function openTermRosterModal(termId, termName) {
    termRosterModalTermId = termId;
    document.getElementById("termRosterModalTitle").textContent = termName + " — Roster";
    const container = document.getElementById("termRosterModalBody");
    container.innerHTML = "<p style='padding:4px 0; color:#6E6350;'>Loading…</p>";
    document.getElementById("termRosterModal").hidden = false;
    await refreshTermRosterModal();
  }
  async function refreshTermRosterModal() {
    const termId = termRosterModalTermId;
    const container = document.getElementById("termRosterModalBody");
    try {
      const res = await fetch(`/admin/terms/${termId}/students`);
      const students = await res.json();
      if (!Array.isArray(students) || students.length === 0) {
        container.innerHTML = "<p style='padding:4px 0; color:#6E6350;'>No students assigned to this term.</p>";
        return;
      }
      const palette = ["#A17807", "#1F7AC9", "#7C4DCC", "#2A9D5C", "#C9574A", "#B5720F"];
      const initialsOf = (name) => (name || "?").split(" ").map((p) => p[0]).slice(0, 2).join("").toUpperCase();
      container.innerHTML = students.map((s) => `
        <div class="jk-roster-row">
          <div class="jk-avatar" style="background:${palette[(s.fullname || "").length % palette.length]};">${initialsOf(s.fullname)}</div>
          <div style="flex:1;">
            <p style="margin:0; font-weight:700; font-size:13.5px; color:#1A1510;">${s.fullname}</p>
            <p style="margin:0; font-size:12px; color:#6E6350;">${s.email || "—"} · ${s.classroom || "No classroom"}</p>
          </div>
          <button class="jk-btn-outline-sm" style="color:#B23A2A; border-color:#F3D4CE;" onclick="removeStudentFromTermModal('${termId}', '${s.id}')" type="button">Remove</button>
        </div>
      `).join("");
    } catch (err) {
      container.innerHTML = "<p style='color:#B23A2A;'>Failed to load students.</p>";
    }
  }
  function closeTermRosterModal() { document.getElementById("termRosterModal").hidden = true; }

  // Same confirm + DELETE as removeStudentFromTerm(), but refreshes this
  // modal in place instead of reloading the whole page (removeStudentFromTerm
  // is still used by anything else that might call it unchanged).
  async function removeStudentFromTermModal(termId, studentId) {
    if (!(await showConfirm("Remove this student from term?"))) return;
    const res = await fetch(`/admin/terms/${termId}/students/${studentId}`, { method: "DELETE" });
    if (res.ok) {
      await refreshTermRosterModal();
    } else {
      showAlert("❌ Failed to remove student.");
    }
  }
</script>

