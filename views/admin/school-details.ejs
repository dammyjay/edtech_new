  };

  document.getElementById("adminBulkUploadForm").addEventListener("submit", async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const schoolId = "<%= school.id %>"; // VERY IMPORTANT

    try {
      const res = await fetch(`/admin/schools/${schoolId}/bulk-add-users`, {
        method: "POST",
