<div id="createTermModal" class="modal-overlay" style="display:none;">
  <div class="modal-content jk-term-modal">
    <span class="close-btn" onclick="closeModal('createTermModal')">&times;</span>

    <h2>Create Term</h2>

    <form action="/admin/terms/create" method="POST">
      <input type="hidden" name="school_id" value="<%= school.id %>" />

      <input type="text" name="name" placeholder="2024/2025 - Term 1" required />
      <input type="date" name="start_date" required />
      <input type="date" name="end_date" required />

      <% if (typeof schoolPlans !== 'undefined' && schoolPlans.length) { %>
        <select id="createTermPlanPicker" onchange="applyTermPlanPrice(this)">
          <option value="">Rate card: custom / negotiated price</option>
          <% schoolPlans.forEach(plan => { %>
            <option value="<%= plan.id %>" data-price="<%= plan.price_amount %>"><%= plan.name %> — ₦<%= Number(plan.price_amount).toLocaleString() %>/student</option>
          <% }) %>
        </select>
        <input type="hidden" name="plan_id" id="createTermPlanId" />
      <% } %>
      <input type="number" name="price_per_student" id="createTermPrice" placeholder="Price per student" required />

      <% if (typeof schoolAddonPlans !== 'undefined' && schoolAddonPlans.length) { %>
        <div style="margin: 8px 0; font-size: 13px;">
          <div style="color:#888; font-size:11px; margin-bottom:4px;">Add-ons (stack as many as apply):</div>
          <% schoolAddonPlans.forEach(addon => { %>
            <% if (addon.is_quantity_based) { %>
              <label style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                <%= addon.name %> — <%= addon.free_quantity %> free, then ₦<%= Number(addon.price_per_extra_unit).toLocaleString() %>/extra:
                <input type="number" name="addon_qty_<%= addon.id %>" placeholder="0 = none" min="0" style="width:70px;" />
              </label>
            <% } else { %>
              <label style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                <input type="checkbox" name="addon_plan_ids" value="<%= addon.id %>" />
                <%= addon.name %> — ₦<%= Number(addon.price_amount).toLocaleString() %>
              </label>
            <% } %>
          <% }) %>
        </div>
      <% } %>

      <div style="margin: 8px 0; font-size: 13px;">
        <div style="color:#888; font-size:11px; margin-bottom:4px;">Discount (optional — applied on top of price + add-ons):</div>
        <select name="discount_type">
          <option value="none">No discount</option>
          <option value="percent">Percentage (%)</option>
          <option value="flat">Flat amount (₦)</option>
          <option value="addons_included">Modules included — no extra charge (auto)</option>
        </select>
        <input type="number" name="discount_value" placeholder="Discount value (not needed for Modules Included)" min="0" step="0.01" />
        <input type="text" name="discount_reason" placeholder="Reason (e.g. Loyalty partner discount)" maxlength="150" />
      </div>

      <button class="jk-btn-dark" style="width:100%; margin-top:6px;" type="submit">Create</button>
    </form>
  </div>
</div>

