<!-- Script for ending a term (bulk-generates + persists every report) -->
<script>
  // Generation runs as a background job on the server (see
  // adminController.js's endTerm/runEndTermJob) — this just starts it
  // and polls for progress instead of holding one request open for
  // however long every classroom + student report takes to render.
  async function endTerm(event, termId, alreadyEnded) {
    const message = alreadyEnded
      ? "This term was already marked ended. Regenerate every class and student report for it? This can take a while for a school with many classrooms."
      : "Mark this term ended? This generates a full-class report and an individual report for every enrolled student, and makes them all visible to the school admin. This can take a while for a school with many classrooms.";

    if (!(await showConfirm(message))) return;

    const btn = event.currentTarget;
    const originalHTML = btn.innerHTML;

    try {
      const res = await fetch(`/admin/terms/${termId}/end`, { method: "POST" });
      const data = await res.json();

      if (!data.success) {
        showAlert("❌ " + (data.message || "Failed to start report generation"));
        return;
      }

      pollEndTermStatus(termId, btn, originalHTML);
    } catch (err) {
      console.error(err);
      showAlert("❌ Failed to start report generation");
      btn.innerHTML = originalHTML;
    }
  }

  async function pollEndTermStatus(termId, btn, originalHTML) {
    try {
      const res = await fetch(`/admin/terms/${termId}/end-status`);
      const data = await res.json();

      if (!data.success) {
        btn.innerHTML = originalHTML;
        showAlert("❌ " + (data.message || "Failed to check progress"));
        return;
      }

      if (data.status === "in_progress") {
        btn.innerHTML = `⏳ ${data.completed}/${data.total}`;
        setTimeout(() => pollEndTermStatus(termId, btn, originalHTML), 3000);
        return;
      }

      if (data.status === "done") {
        let summary = `✅ Report generation finished (${data.completed}/${data.total}).`;
        if (data.errors && data.errors.length) {
          summary += `\n\n⚠️ ${data.errors.length} failed:\n` + data.errors.join("\n");
        }
        showAlert(summary).then(() => {
          location.reload();
        });
        return;
      }

      if (data.status === "failed") {
        btn.innerHTML = originalHTML;
        showAlert("❌ Report generation failed: " + (data.errors && data.errors[0] ? data.errors[0] : "Unknown error"));
        return;
      }

      // status === "idle" shouldn't happen right after a successful
      // start, but don't leave the button stuck spinning if it does.
      btn.innerHTML = originalHTML;
    } catch (err) {
      console.error(err);
      // Transient network hiccup while polling — keep trying rather than
      // abandoning a job that may still be running server-side.
      setTimeout(() => pollEndTermStatus(termId, btn, originalHTML), 3000);
    }
  }

  // The generation job survives a page refresh (it's a detached
  // server-side function, not tied to the request or the browser) —
  // but the in-browser polling loop above doesn't. Without this, a
  // refresh mid-generation would show the button as if nothing had been
  // triggered at all, with no sign a job is still running. On load,
  // resume polling for any term whose row still says "in_progress".
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll('.endterm-btn[data-generation-status="in_progress"]').forEach((btn) => {
      const termId = btn.dataset.termId;
      const isEnded = btn.dataset.isEnded === "true";
      const fallbackHTML = `<i class="fa-solid fa-flag-checkered" style="color: ${isEnded ? '#c0762a' : '#333'};"></i>`;
      pollEndTermStatus(termId, btn, fallbackHTML);
    });
  });
</script>

<!-- Populates #assignTermModal's student checklist for the selected term -->
<script>
  // Active students at this school not already enrolled in the term
  // selected above — see adminController.js's getTermCandidates. Was
  // previously every student in the school (no active-status or
  // already-enrolled filtering), paired with a "Select Classroom" filter
  // that never worked (student.classroom_id was always undefined) — that
  // dropdown has been removed rather than fixed, see the HTML comment
  // above the student list.
  async function loadTermCandidates() {
    const termSelect = document.getElementById("assignTermSelect");
    const container = document.getElementById("studentList");
    if (!container) return;

    if (!termSelect || !termSelect.value) {
      container.innerHTML = "<em>No term selected</em>";
      return;
    }

    try {
      const res = await fetch(`/admin/schools/<%= school.id %>/terms/${termSelect.value}/term-candidates`);
      const data = await res.json();
      const students = (data.success && data.students) || [];

      if (students.length === 0) {
        container.innerHTML = "<em>No students available to add to this term.</em>";
        return;
      }

      container.innerHTML = students.map(s => `
        <label class="student-item" style="display:block;">
          <input type="checkbox" name="student_ids[]" value="${s.id}" />
          ${s.fullname}
        </label>
      `).join("");
    } catch (err) {
      console.error("loadTermCandidates error:", err);
      container.innerHTML = "<em>Failed to load students.</em>";
    }
  }

  document.addEventListener("DOMContentLoaded", loadTermCandidates);
</script>


