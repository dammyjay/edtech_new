// submit attendance
    async function loadStudentsForAttendance() {
      const status = document.getElementById("sessionStatus").value;
      const container = document.getElementById("attendanceStudentList");

      // 🚫 If not held → stop here
      if (status !== "held") {
        container.innerHTML = "<p>⚠️ No attendance required for this session</p>";
        return;
      }

      const classroomId = document.getElementById("attendanceClassroom").value;
      const termId = document.querySelector('[name="term_id"]').value;

      const res = await fetch(`/admin/attendance/students?term_id=${termId}&classroom_id=${classroomId}`);
      const students = await res.json();

      container.innerHTML = "";

      students.forEach(s => {
        container.innerHTML += `
          <div class="student-row">
            <span>${s.fullname}</span>
            <select data-id="${s.id}">
              <option value="present">✅ Present</option>
              <option value="absent">❌ Absent</option>
              <option value="late">⏰ Late</option>
            </select>
          </div>
        `;
      });
    }

    let attendanceChartInstance = null;

    async function loadAttendanceStats() {
      const termId = document.getElementById("attendanceFilterTerm").value;
      if (!termId) {
        document.getElementById("attendanceSummary").innerHTML =
          "<p>No term selected yet — create a term for this school to see attendance stats.</p>";
        return;
      }

      let data;
      try {
        const res = await fetch(`/admin/attendance/stats/weekly?term_id=${termId}`);
        if (!res.ok) throw new Error("Request failed");
        data = await res.json();
      } catch (err) {
        document.getElementById("attendanceSummary").innerHTML =
          "<p style='color:#c00;'>Couldn't load attendance stats — please try again.</p>";
        return;
      }

      const labels = data.map(d => `Week ${d.week_number}`);
      const present = data.map(d => d.present);
      const absent = data.map(d => d.absent);
      const percent = data.map(d => Number(d.attendance_percent) || 0);

      // Chart.js throws "Canvas is already in use" if a new Chart is created
      // on a canvas that already has one — destroy the previous instance
      // first (this function can now be called repeatedly: tab reopen,
      // Filter button, View History button).
      if (attendanceChartInstance) {
        attendanceChartInstance.destroy();
      }
      attendanceChartInstance = new Chart(document.getElementById("attendanceChart"), {
        type: "bar",
        data: {
          labels,
          datasets: [
            { label: "Present", data: present },
            { label: "Absent", data: absent }
          ]
        }
      });

      if (!percent.length) {
        document.getElementById("attendanceSummary").innerHTML =
          "<h3>No attendance sessions recorded for this term yet.</h3>";
        return;
      }

      let avg = percent.reduce((a,b)=>a+b,0)/percent.length;

      document.getElementById("attendanceSummary").innerHTML = `
        <h3>Average Attendance: ${avg.toFixed(1)}%</h3>
      `;
    }

    document.getElementById("attendanceForm").addEventListener("submit", async (e) => {
      e.preventDefault();

      const form = e.target;

      const records = [];

      document.querySelectorAll("#attendanceStudentList select").forEach(sel => {
        records.push({
          student_id: sel.dataset.id,
          status: sel.value
        });
      });

      const payload = {
        school_id: form.school_id.value,
        term_id: form.term_id.value,
        classroom_id: form.classroom_id.value,
        date: form.date.value,
        week_number: form.week_number.value,
        session_status: document.getElementById("sessionStatus").value, // ✅ ADD
        note: document.getElementById("note").value || "",
        records
      };

      const res = await fetch("/admin/attendance/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (data.success) {
        showAlert("Attendance saved!").then(() => {
          closeModal("attendanceModal");
        });
      }
    });
 
async function toggleAttendanceDetails(sessionId) {
  const row = document.getElementById(`attendance-row-${sessionId}`);
  const container = document.getElementById(`attendance-details-${sessionId}`);

  if (!row || !container) return; // ✅ prevents crash

  if (row.style.display === "none") {
    row.style.display = "table-row";

    if (!container.dataset.loaded) {
      const res = await fetch(`/admin/attendance/session/${sessionId}`);
      const data = await res.json();

      if (data.length === 0) {
        container.innerHTML = "<p>No attendance records</p>";
      } else {
        let html = `
          <table class="user-table sortable-table" style="margin-top:10px;">
            <thead>
              <tr>
                <th>Student</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
        `;

        data.forEach(s => {
          html += `
            <tr>
              <td>${s.fullname}</td>
              <td>${formatSessionStatus(s.status)}</td>
            </tr>
          `;
        });

        html += "</tbody></table>";
        container.innerHTML = html;
      }

      container.dataset.loaded = "true";
    }

  } else {
    row.style.display = "none";
  }
}

