<script>
  function filterInstructors() {
    const searchText = document.getElementById("instructorSearch").value.toLowerCase();
    Array.from(document.querySelectorAll("#instructorsTable tbody tr")).forEach((tr) => {
      if (!tr.dataset.name) return;
      const match = tr.dataset.name.toLowerCase().includes(searchText) || (tr.dataset.email || "").toLowerCase().includes(searchText);
      tr.style.display = match ? "" : "none";
    });
  }
</script>

<!-- ===== "Manage Classrooms" modal for an instructor — picks several
     classrooms for ONE instructor, the inverse of the Classrooms tab's
     "Assign Instructor(s)" (several instructors for one classroom).
     Both correctly support multiple at once; classroom_instructors has
     no "remove" endpoint yet, so unchecking an already-assigned
     classroom here is a no-op, same as before this redesign. ===== -->
<div id="manageInstructorModal" class="jk-modal-overlay" hidden>
  <div class="jk-modal">
    <div class="jk-modal-head">
      <div>
        <h4 id="manageInstructorModalTitle">Manage Classrooms</h4>
        <p>Check any classrooms to add this instructor to them.</p>
      </div>
      <button class="jk-modal-close" onclick="closeManageInstructorClassrooms()" aria-label="Close">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="jk-modal-body">
      <div class="jk-checklist" id="manageInstructorChecklist">
        <% school.classrooms.forEach(c => { %>
          <label>
            <input type="checkbox" class="manage-instructor-classroom-cb" value="<%= c.id %>">
            <%= c.name %>
          </label>
        <% }) %>
      </div>
      <button class="jk-btn-dark" style="width:100%; margin-top:12px;" onclick="submitManageInstructorClassrooms()" type="button">Save</button>
    </div>
  </div>
</div>
<script>
  let manageInstructorId = null;
  let manageInstructorAlreadyIn = [];
  function openManageInstructorClassrooms(instructorId, instructorName, classroomIds) {
    manageInstructorId = instructorId;
    manageInstructorAlreadyIn = (classroomIds || []).map((id) => String(id));
    document.getElementById("manageInstructorModalTitle").textContent = "Manage Classrooms — " + instructorName;
    document.querySelectorAll(".manage-instructor-classroom-cb").forEach((cb) => {
      cb.checked = manageInstructorAlreadyIn.includes(cb.value);
    });
    document.getElementById("manageInstructorModal").hidden = false;
  }
  function closeManageInstructorClassrooms() { document.getElementById("manageInstructorModal").hidden = true; }

  async function submitManageInstructorClassrooms() {
    const checked = Array.from(document.querySelectorAll(".manage-instructor-classroom-cb:checked")).map((cb) => cb.value);
    const newlyChecked = checked.filter((id) => !manageInstructorAlreadyIn.includes(id));
    if (newlyChecked.length === 0) {
      closeManageInstructorClassrooms();
      return;
    }
    try {
      await Promise.all(newlyChecked.map((classroomId) =>
        fetch(`/admin/classrooms/${classroomId}/assign`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_ids: [manageInstructorId], role: "instructor" }),
        })
      ));
      showAlert(`✅ Added to ${newlyChecked.length} classroom(s)!`).then(() => location.reload());
    } catch (err) {
      console.error(err);
      showAlert("❌ Something went wrong.");
    }
  }
</script>


