<script>
  async function generateStudentAvatar(userId) {

    try {

      const res = await fetch(
        `/admin/students/${userId}/generate-avatar`,
        {
          method: "POST"
        }
      );

      const data = await res.json();

      if (data.success) {

        showAlert("Avatar generated successfully").then(() => {
          location.reload();
        });

      } else {

        showAlert(data.message || "Failed");

      }

    } catch (err) {

      console.error(err);
      showAlert("Something went wrong");

    }
  }

  async function bulkGenerateAvatars() {

    const confirmBulk = await showConfirm(
      "Generate avatars for all students?"
    );

    if (!confirmBulk) return;

    try {

      const schoolId = "<%= school.id %>";

      const res = await fetch(
        `/admin/schools/${schoolId}/generate-avatars`,
        {
          method: "POST"
        }
      );

      const data = await res.json();

      if (data.success) {

        showAlert(data.message).then(() => {
          location.reload();
        });

      } else {

        showAlert(data.message || "Failed");

      }

    } catch (err) {

      console.error(err);

      showAlert("Something went wrong");

    }
  }
</script>

<script>
  
  async function toggleAvatarLogin(userId, el) {
    const res = await fetch(`/admin/users/${userId}/toggle-avatar-login`, {
      method: "POST"
    });

    const data = await res.json();

    if (data.success) {
      showAlert(
        data.enabled
          ? `Avatar Login ENABLED\nPIN: ${data.user.pin}`
          : "Avatar Login DISABLED"
      ).then(() => {
        location.reload();
      });
    } else {
      showAlert(data.message);
    }
  }

  // Login cards: "All students" (default, whole-school) or a specific
  // term — either way, inactive students are excluded server-side.
  function downloadLoginCards() {
    const termId = document.getElementById("loginCardsTermFilter").value;
    const url = `/admin/schools/<%= school.id %>/download-login-cards` + (termId ? `?term_id=${termId}` : "");
    window.location.href = url;
  }

  // Marks a student inactive (graduated/left) or reactivates them —
  // inactive students are excluded from classroom/term assignment
  // pickers and login-card downloads (see adminController.js's
  // toggleUserActiveStatus). Updates the row in place rather than
  // reloading the whole page.
  async function toggleActiveStatus(studentId, currentlyActive) {
    if (currentlyActive) {
      if (!(await showConfirm("Mark this student inactive? They'll be hidden from classroom/term assignment lists and login-card downloads until reactivated."))) return;
    }

    try {
      const res = await fetch(`/admin/schools/<%= school.id %>/users/${studentId}/toggle-active`, {
        method: "POST"
      });
      const data = await res.json();
      if (!data.success) {
        return showAlert("❌ " + (data.message || "Failed to update status."));
      }

      const isActive = data.is_active;
      const statusCell = document.getElementById(`student-status-${studentId}`);
      if (statusCell) {
        statusCell.innerHTML = isActive
          ? '<span class="jk-pill jk-pill--active">Active</span>'
          : '<span class="jk-pill jk-pill--inactive">Inactive</span>';
      }

      // The classroom-candidate list depends on active status, so refresh
      // it in case this student is currently shown/hidden there.
      if (typeof loadClassroomCandidates === "function") loadClassroomCandidates();
    } catch (err) {
      console.error("toggleActiveStatus error:", err);
      showAlert("❌ Request failed.");
    }
  }

  async function bulkEnableAvatarLogin() {
    const schoolId = "<%= school.id %>";

    if (!(await showConfirm("Enable avatar login for ALL students in this school?"))) return;

    const res = await fetch(`/admin/schools/${schoolId}/bulk-enable-avatar-login`, {
      method: "POST"
    });

    const data = await res.json();

    if (data.success) {
      showAlert(data.message).then(() => {
        location.reload();
      });
    } else {
      showAlert(data.message);
    }
  }

  // Checkbox selection for the Students table — the "(Selected)" actions
  // below act only on whichever rows are checked, unlike the "(All
  // Students)" buttons above which always act on the whole school.
  function getSelectedStudentIds() {
    return Array.from(document.querySelectorAll(".student-select-cb:checked")).map((cb) => cb.value);
  }

  function toggleSelectAllStudents(checkbox) {
    document.querySelectorAll(".student-select-cb").forEach((cb) => { cb.checked = checkbox.checked; });
    updateSelectedStudentCount();
  }

  function updateSelectedStudentCount() {
    const count = getSelectedStudentIds().length;
    const label = document.getElementById("selectedStudentCount");
    if (label) label.textContent = `${count} selected`;

    const total = document.querySelectorAll(".student-select-cb").length;
    const selectAll = document.getElementById("selectAllStudents");
    if (selectAll) selectAll.checked = total > 0 && count === total;
  }

  async function bulkGenerateAvatarsSelected() {
    const studentIds = getSelectedStudentIds();
    if (!studentIds.length) return showAlert("Select at least one student first.");
    if (!(await showConfirm(`Generate avatars for ${studentIds.length} selected student(s)?`))) return;

    try {
      const schoolId = "<%= school.id %>";
