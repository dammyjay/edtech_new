<script>
  const sidenav = document.getElementById("sidenav");
  const toggleBtn = document.getElementById("toggleBtn");

  // Toggle open/close
  toggleBtn.addEventListener("click", function(e) {
    e.stopPropagation(); // prevent closing immediately
    sidenav.classList.toggle("active");
  });

  // Close when clicking a link inside sidenav
  sidenav.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      if (window.innerWidth <= 768) { // only on mobile
        sidenav.classList.remove("active");
      }
    });
  });

  // Close when clicking outside sidenav
  document.addEventListener("click", (e) => {
    if (
      window.innerWidth <= 768 && // only mobile
      sidenav.classList.contains("active") && 
      !sidenav.contains(e.target) && 
      e.target !== toggleBtn
    ) {
      sidenav.classList.remove("active");
    }
  });

  // Optional: close if window resized to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth > 768) {
      sidenav.classList.remove("active");
    }
  });
</script>


<script>
  function openStudentModal() {
    document.getElementById("studentModal").style.display = "block";
  }

  function closeStudentModal() {
    document.getElementById("studentModal").style.display = "none";
  }

  function openAssignClassroomModal(studentId, studentName) {
  document.getElementById("modalStudentId").value = studentId;
  document.getElementById("modalStudentName").textContent = studentName;
  document.getElementById("assignClassroomModal").style.display = "block";
}

function closeAssignClassroomModal() {
  document.getElementById("assignClassroomModal").style.display = "none";
}

// Close when clicking outside
window.onclick = function(event) {
  const modal = document.getElementById("assignClassroomModal");
  if (event.target === modal) {
    modal.style.display = "none";
  }
};

// Handle form submission — #assignClassForm lives inside partials/students.ejs,
// an AJAX-loaded section swapped in via loadSection()'s plain innerHTML=
// (no script re-execution), so a direct addEventListener here at initial
// page load would attach before the form ever exists. Delegating from
// document works regardless of when that section loads.
document.addEventListener("submit", async function(e) {
  if (e.target.id !== "assignClassForm") return;
  e.preventDefault();
  const studentId = document.getElementById("modalStudentId").value;
  const classroomId = document.getElementById("modalClassroomSelect").value;

  if (!classroomId) return showAlert("Please select a classroom.");

  try {
    const res = await fetch(`/school-admin/students/${studentId}/assign-classroom`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ classroom_id: classroomId })
    });

    const data = await res.json();

    if (data.success) {
      showAlert(`${data.student.fullname} assigned to ${data.classroom.name}`);
      closeAssignClassroomModal();
      // Optionally update the table dynamically:
      const row = document.querySelector(`tr[data-student-id='${studentId}'] td[data-classroom]`);
      if(row) row.textContent = data.classroom.name;
    } else {
      showAlert(data.message || "Failed to assign classroom.");
    }
  } catch (err) {
    console.error(err);
    showAlert("Server error while assigning classroom.");
  }
});

  // Close when clicking outside
  window.onclick = function(event) {
    const modal = document.getElementById("studentModal");
    if (event.target === modal) {
      modal.style.display = "none";
    }
  };
</script>