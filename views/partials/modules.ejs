<h3>Create Module</h3>
<form action="/admin/modules/create" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="course_id" value="<%= course.id %>" />

  <label>Title</label>
  <input type="text" name="title" placeholder="Module Title" required />

  <label>Description</label>
  <textarea name="description" id="ckeditor"></textarea>

  <label>Objectives</label>
  <textarea name="objectives" id="ckeditor1"></textarea>

  <label>Learning Outcomes</label>
  <textarea name="learning_outcomes" id="ckeditor2"></textarea>

  <label>Thumbnail (optional — leave blank to auto-generate one)</label>
  <input type="file" name="thumbnail">

  <label>Badge Image (optional — leave blank to auto-generate one)</label>
  <input type="file" name="badge_image" accept="image/*">

  <label>Order Number</label>
  <input type="number" name="order_number" required>

  <button type="submit">Create</button>
</form>


