
<% const rolePrefix = (typeof role !== 'undefined' && role === 'instructor') ? '/instructor' : '/admin'; %>
<% const flashcardCountsSafe = typeof flashcardCounts !== 'undefined' ? flashcardCounts : {}; %>

  <div class="jk-header-card" style="margin-top:16px;">
    <div><h3 style="margin:0;">Modules</h3></div>
    <button onclick="openModal('createModuleModal')" class="jk-btn-dark">+ Add Module</button>
  </div>

<div id="createModuleModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal('createModuleModal')">&times;</span>
    <h3>Create Module</h3>
    <form action="/admin/modules/create" method="POST">
      <input type="hidden" name="course_id" value="<%= course.id %>" />
      <input type="text" name="title" placeholder="Module Title" required />
      <button type="submit">Create</button>
    </form>
  </div>
</div>


<!-- Existing modules are listed below: -->


<section class="article-grid2 jk-course-grid">
  <% modules.forEach(module => { %>
    <div class="article-card2 jk-course-card">
      <div class="card-images" style="display: flex; gap:10px; padding:12px 12px 0;">
        <div>
          <p style="font-size:11px; color:#8A7B55; margin:0 0 4px;">Thumbnail
            <% if (module.thumbnail_source === 'auto') { %>
              <span style="font-size:11px; color:#666;">(auto-generated)</span>
            <% } else if (module.thumbnail_source === 'upload') { %>
              <span style="font-size:11px; color:#666;">(custom upload)</span>
            <% } %>
          </p>
          <img src="<%= module.thumbnail || '/images/JKT logo bg.png' %>" alt="" style="width:100px; height:70px; object-fit:cover; border-radius:8px; background:#FAF8F2;">
        </div>
        <!-- Badge Image -->
        <% if (module.badge_image) { %>
          <div>
            <p style="font-size:11px; color:#8A7B55; margin:0 0 4px;">🏅 Badge
              <% if (module.badge_source === 'auto') { %>
                <span style="font-size:11px; color:#666;">(auto-generated)</span>
              <% } else if (module.badge_source === 'upload') { %>
                <span style="font-size:11px; color:#666;">(custom upload)</span>
              <% } %>
            </p>
            <img src="<%= module.badge_image %>" alt="Badge" style="width:70px; height:70px; object-fit:contain; border-radius:8px; background:#FAF8F2;">
          </div>
        <% } else { %>
          <p style="font-size:11px; color:#8A7B55;">No badge assigned</p>
        <% } %>
      </div>
      <div class="card-content">
        <h4><%= module.title %></h4>
        <p class="card-body">Module ID: <%= module.id %></p>
        <p class="card-body">Created At: <%= module.created_at.toDateString() %></p>

        <% const moduleCurriculum = module.curriculum_content || module.description; %>
        <% if (moduleCurriculum) { %>
          <div id="moduleOverviewData-<%= module.id %>" hidden><%- moduleCurriculum %></div>
        <% } %>

        <!-- Edit Button triggers modal -->
         <div class="article-buttons">
          <button class="btn-edit" onclick="openEditModal('<%= module.id %>')">✏️ Edit</button>
          <% if (moduleCurriculum) { %>
            <button type="button" class="overview-trigger-btn"
              data-kind="Module"
              data-title="<%= module.title %>"
              data-thumbnail="<%= module.thumbnail || '' %>"
              data-content-id="moduleOverviewData-<%= module.id %>"
            >📦 View Curriculum</button>
          <% } %>

          <!-- Flashcards -->
          <button type="button" class="flashcard-manage-btn" data-module-id="<%= module.id %>" data-module-title="<%= module.title %>">
            📇 <%= flashcardCountsSafe[module.id] ? `Flashcards (${flashcardCountsSafe[module.id]})` : 'Generate Flashcards' %>
          </button>

          <!-- Regenerate Thumbnail -->
          <form action="/admin/modules/<%= module.id %>/regenerate-thumbnail" method="POST" style="display:inline;">
            <button type="submit" onclick="var btn = this; showConfirm('Replace the current thumbnail with a new auto-generated one?').then(function(ok) { if (ok) { setButtonLoading(btn, '🖼️ Generating… (can take up to a minute)'); btn.closest('form').submit(); } }); return false;">🖼️ Regenerate Thumbnail</button>
          </form>

          <!-- Regenerate Badge -->
          <form action="/admin/modules/<%= module.id %>/regenerate-badge" method="POST" style="display:inline;">
            <button type="submit" onclick="var btn = this; showConfirm('Replace the current badge with a new auto-generated one?').then(function(ok) { if (ok) { setButtonLoading(btn, '🏅 Generating… (can take up to a minute)'); btn.closest('form').submit(); } }); return false;">🏅 Regenerate Badge</button>
          </form>

          <!-- Archive Form -->
          <form action="/admin/modules/delete/<%= module.id %>" method="POST" style="display:inline;">
            <button class="btn-delete" type="submit" onclick="showConfirm('Archive this module? It will be hidden everywhere but can be restored later from the Archive screen.').then(function(ok) { if (ok) { event.target.closest('form').submit(); } }); return false;">🗑️ Archive</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</section>
    <% modules.forEach(module => { %>
<!-- Edit Modal -->
      <div id="editModal-<%= module.id %>" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeEditModal('<%= module.id %>')">&times;</span>
          <h3>Edit Module</h3>
          <form action="/admin/modules/edit/<%= module.id %>" method="POST" enctype="multipart/form-data">
            <label for="">Title</label>
            <input type="text" name="title" value="<%= module.title %>" required />
            <label for="">Short Description</label>
            <textarea name="description" id="editckeditor-<%= module.id %>"><%= module.description %></textarea>
            <label for="">Module Curriculum</label>
            <textarea name="curriculum_content" id="editckeditorCurriculum-<%= module.id %>"><%= module.curriculum_content || '' %></textarea>
            <label for="">Objectives</label>
            <textarea name="objectives" id="editckeditor1-<%= module.id %>"><%= module.objectives %></textarea>
            <label for="">Learning Outcomes</label> 
            <textarea name="learning_outcomes" id="editckeditor2-<%= module.id %>"><%= module.learning_outcomes %></textarea>
            
            <label for="">Thumbnail (optional — leave blank to keep the current one)</label>
            <% if (module.thumbnail) { %>
              <div>
                <img src="<%= module.thumbnail %>" alt="Thumbnail" width="120">
                <span style="font-size:12px; color:#666;">
                  <%= module.thumbnail_source === 'auto' ? 'Currently auto-generated' : (module.thumbnail_source === 'upload' ? 'Currently a custom upload' : '') %>
                </span>
              </div>
            <% } %>
            <input type="file" name="thumbnail" placeholder="Thumbnail">
            <label style="font-weight:normal;">
              <input type="checkbox" name="regenerate_thumbnail" value="on">
              Regenerate an auto thumbnail instead (replaces the current thumbnail above; ignored if you also choose a file to upload)
            </label>

            <label>Badge Image (optional — leave blank to keep the current one)</label>
            <% if (module.badge_image) { %>
              <div>
                <img src="<%= module.badge_image %>" alt="Badge" width="80">
                <span style="font-size:12px; color:#666;">
                  <%= module.badge_source === 'auto' ? 'Currently auto-generated' : (module.badge_source === 'upload' ? 'Currently a custom upload' : '') %>
                </span>
              </div>
            <% } %>
            <input type="file" name="badge_image" accept="image/*">
            <label style="font-weight:normal;">
              <input type="checkbox" name="regenerate_badge" value="on">
              Regenerate an auto badge instead (replaces the current badge above; ignored if you also choose a file to upload)
            </label>

            <label for="">Order Number</label>
            <input type="number" name="order_number" value="<%= module.order_number %>" required>
            <input type="hidden" name="course_id" value="<%= course.id %>" />
            <button type="submit">Update Module</button>
            <!-- <button type="submit">Save Changes</button> -->
          </form>
        </div>
      </div>
    <% }) %>

<div class="jk-report-panel" style="margin-top:20px;">
<h3 style="margin-top:0;">Create Module</h3>
<form action="/admin/modules/create" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="course_id" value="<%= course.id %>" />

  <label>Title</label>
  <input type="text" name="title" class="jk-select" style="width:100%;" placeholder="Module Title" required />

  <label>Short Description</label>
  <textarea name="description" id="ckeditor"></textarea>

  <label>Module Curriculum</label>
  <textarea name="curriculum_content" id="ckeditorCurriculum"></textarea>

  <label>Objectives</label>
  <textarea name="objectives" id="ckeditor1"></textarea>

  <label>Learning Outcomes</label>
  <textarea name="learning_outcomes" id="ckeditor2"></textarea>

  <label>Thumbnail (optional — leave blank to auto-generate one)</label>
  <input type="file" name="thumbnail">

  <label>Badge Image (optional — leave blank to auto-generate one)</label>
  <input type="file" name="badge_image" accept="image/*">

  <label>Order Number</label>
  <input type="number" name="order_number" class="jk-select" style="width:100%;" required>

  <button type="submit" class="jk-btn-dark" style="margin-top:10px;">Create</button>
</form>
</div>


<script>
 function openModal(id) {
    const modal = document.getElementById(id);
    if (!modal) {
      console.error("Modal not found:", id);
      return;
    }
    modal.style.display = "block";
  }

  function closeModal(id) {
    const modal = document.getElementById(id);
    if (!modal) {
      console.error("Modal not found:", id);
      return;
    }
    modal.style.display = "none";
  }

  window.onclick = function (event) {
    if (event.target.classList.contains("modal")) {
      event.target.style.display = "none";
    }
  };
</script>

<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<script>
  // Initialize CKEditor for all with class "ckeditor"
  window.onload = function () {
    CKEDITOR.replaceAll("ckeditor");
  };
</script>


<script>
  CKEDITOR.replace("ckeditor");
  CKEDITOR.replace("ckeditorCurriculum");
  CKEDITOR.replace("ckeditor1");
  CKEDITOR.replace("ckeditor2");
</script>

<script>
  <% modules.forEach(module => { %>
    CKEDITOR.replace("editckeditor-<%= module.id %>");
    CKEDITOR.replace("editckeditorCurriculum-<%= module.id %>");
    CKEDITOR.replace("editckeditor1-<%= module.id %>");
    CKEDITOR.replace("editckeditor2-<%= module.id %>");
  <% }) %>
</script>

<!-- ===== Flashcards modal — AI generate (preview, editable) then save.
     Same preview-then-save shape as the lesson quiz AI generator
     (views/partials/lessons.ejs), just scoped to a whole module. One
     modal reused for every module card; data-module-id on the trigger
     button tells it which module it's working on. ===== -->
<div id="flashcardModal" class="modal">
  <div class="modal-content" style="max-width:700px;">
    <span class="close" onclick="closeModal('flashcardModal')">&times;</span>
    <h3 id="flashcardModalTitle">📇 Flashcards</h3>
    <p style="font-size:12.5px; color:#8A7B55; margin-top:-6px;">Study cards drawn from this module's lessons — each tagged with the lesson it came from.</p>

    <!-- Existing cards: edit/delete individually, or add one manually. -->
    <div id="flashcardManageState" style="display:none;">
      <div id="flashcardManageList" style="max-height:45vh; overflow-y:auto; margin:10px 0;"></div>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <button type="button" class="jk-btn-outline-sm" onclick="addBlankManageCard()">➕ Add Card</button>
        <button type="button" class="jk-btn-outline-sm" onclick="showFlashcardState('flashcardIdleState')">🔁 Replace Entire Set</button>
      </div>
    </div>

    <!-- Generate (AI) or batch-upload (CSV) a whole new set. -->
    <div id="flashcardIdleState" style="display:none;">
      <div style="display:flex; gap:20px; flex-wrap:wrap;">
        <div style="flex:1; min-width:220px;">
          <label style="font-size:12.5px; font-weight:700;">🧠 Generate with AI</label>
          <p style="font-size:11.5px; color:#8A7B55; margin:4px 0;">Number of cards</p>
          <input type="number" id="flashcardCount" value="20" min="5" max="30" style="width:80px; display:block; margin-bottom:10px; padding:6px 8px; border-radius:6px; border:1px solid #ddd;" />
          <button type="button" class="jk-btn-dark" onclick="generateFlashcardsPreview()">🧠 Generate with AI</button>
        </div>
        <div style="flex:1; min-width:220px; border-left:1px solid #EDE7D6; padding-left:20px;">
          <label style="font-size:12.5px; font-weight:700;">⬆️ Batch Upload (CSV)</label>
          <p style="font-size:11.5px; color:#8A7B55; margin:4px 0 10px;">
            Columns: <code>front, back, lesson_title</code> (lesson_title optional).
            <a href="/samples/flashcard-upload-sample.csv" download>Download sample format</a>.
          </p>
          <input type="file" id="flashcardCsvFile" accept=".csv" style="display:block; margin-bottom:10px; font-size:12.5px;" />
          <button type="button" class="jk-btn-outline" onclick="uploadFlashcardsCsv()">⬆️ Upload &amp; Replace</button>
        </div>
      </div>
      <p id="flashcardBackToManageWrap" style="margin-top:14px; display:none;">
        <a href="javascript:void(0)" onclick="loadFlashcardManageList()">← Back to existing cards</a>
      </p>
    </div>

    <div id="flashcardLoadingState" style="display:none; padding:30px 0; text-align:center; color:#666;">
      ⏳ Working on it… this can take up to a minute.
    </div>

    <div id="flashcardPreviewState" style="display:none;">
      <p style="font-size:12.5px; color:#A83232; font-weight:700;">⚠️ Saving this will replace the module's entire current flashcard set.</p>
      <div id="flashcardPreviewList" style="max-height:45vh; overflow-y:auto; margin:10px 0;"></div>
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
        <button type="button" class="jk-btn-outline" onclick="generateFlashcardsPreview()">🔁 Regenerate</button>
        <button type="button" class="jk-btn-dark" onclick="saveFlashcards()">💾 Save Flashcards</button>
      </div>
    </div>
  </div>
</div>
<style>
  .flashcard-manage-btn { background:#F6F4EF; color:#4C3802; border:1px solid #EDE7D6; border-radius:8px; padding:6px 10px; font-size:11.5px; font-weight:700; cursor:pointer; }
  .flashcard-preview-card { background:#FAF8F2; border:1px solid #EDE7D6; border-radius:10px; padding:12px; margin-bottom:10px; }
  .flashcard-preview-card label { display:block; font-size:11px; font-weight:700; color:#6E6350; margin:6px 0 3px; }
  .flashcard-preview-card textarea { width:100%; box-sizing:border-box; padding:6px 8px; border-radius:6px; border:1px solid #ddd; font-family:inherit; font-size:13px; resize:vertical; }
  .flashcard-preview-card select { width:100%; box-sizing:border-box; padding:6px 8px; border-radius:6px; border:1px solid #ddd; font-family:inherit; font-size:12.5px; }
  .flashcard-preview-card .fc-row-actions { display:flex; gap:8px; margin-top:8px; }
</style>
<script>
  let flashcardModuleId = null;
  let flashcardLessons = [];

  document.querySelectorAll(".flashcard-manage-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      flashcardModuleId = btn.dataset.moduleId;
      document.getElementById("flashcardModalTitle").textContent = "📇 Flashcards — " + btn.dataset.moduleTitle;
      ["flashcardManageState", "flashcardIdleState", "flashcardLoadingState", "flashcardPreviewState"].forEach(
        (id) => (document.getElementById(id).style.display = "none")
      );
      document.getElementById("flashcardBackToManageWrap").style.display = "none";
      document.getElementById("flashcardCsvFile").value = "";
      openModal("flashcardModal");
      loadFlashcardManageList();
    });
  });

  function showFlashcardState(id) {
    ["flashcardManageState", "flashcardIdleState", "flashcardLoadingState", "flashcardPreviewState"].forEach(
      (sid) => (document.getElementById(sid).style.display = sid === id ? "block" : "none")
    );
  }

  // Fetches the module's existing cards. Cards found → management list
  // (edit/delete); none yet → straight to the generate/upload state,
  // since there's nothing to manage.
  async function loadFlashcardManageList() {
    showFlashcardState("flashcardLoadingState");
    try {
      const res = await fetch(`<%= rolePrefix %>/modules/${flashcardModuleId}/flashcards/list`);
      const data = await res.json();
      flashcardLessons = data.lessons || [];
      if (!res.ok || !data.ok) {
        showAlert(data.error || "Failed to load flashcards.");
        showFlashcardState("flashcardIdleState");
        return;
      }
      if (!data.flashcards.length) {
        document.getElementById("flashcardBackToManageWrap").style.display = "none";
        showFlashcardState("flashcardIdleState");
        return;
      }
      renderFlashcardManageList(data.flashcards);
      document.getElementById("flashcardBackToManageWrap").style.display = "block";
      showFlashcardState("flashcardManageState");
    } catch (err) {
      showAlert("Failed to load flashcards: " + err.message);
      showFlashcardState("flashcardIdleState");
    }
  }

  function manageCardTemplate(card) {
    const id = card.id ?? "";
    const lessonOptions = flashcardLessons
      .map((l) => `<option value="${l.id}">${(l.title || "").replace(/</g, "&lt;")}</option>`)
      .join("");
    return `
      <div class="flashcard-preview-card" data-id="${id}">
        <label>Front (question/prompt)</label>
        <textarea rows="2" class="fc-front">${(card.front_text || "").replace(/</g, "&lt;")}</textarea>
        <label>Back (answer)</label>
        <textarea rows="2" class="fc-back">${(card.back_text || "").replace(/</g, "&lt;")}</textarea>
        <label>From lesson</label>
        <select class="fc-lesson-id">
          <option value="">— Not linked to a lesson —</option>
          ${lessonOptions}
        </select>
        <div class="fc-row-actions">
          <button type="button" class="jk-btn-outline-sm" onclick="saveManageCard(this)">💾 ${id ? "Save" : "Add"}</button>
          ${id ? `<button type="button" class="jk-btn-outline-sm" onclick="deleteManageCard(this)">🗑️ Delete</button>` : `<button type="button" class="jk-btn-outline-sm" onclick="this.closest('.flashcard-preview-card').remove()">Cancel</button>`}
        </div>
      </div>
    `;
  }

  function renderFlashcardManageList(cards) {
    const list = document.getElementById("flashcardManageList");
    list.innerHTML = cards.map(manageCardTemplate).join("");
    // Select each card's current lesson now that the <select> exists —
    // can't be done via the "selected" attribute above since the value
    // needs to match dynamically per card.
    list.querySelectorAll(".flashcard-preview-card").forEach((row, i) => {
      if (cards[i].lesson_id) row.querySelector(".fc-lesson-id").value = cards[i].lesson_id;
    });
  }

  function addBlankManageCard() {
    showFlashcardState("flashcardManageState");
    const list = document.getElementById("flashcardManageList");
    list.insertAdjacentHTML("afterbegin", manageCardTemplate({ id: null, front_text: "", back_text: "", lesson_id: null, lesson_title: null }));
  }

  async function saveManageCard(btn) {
    const row = btn.closest(".flashcard-preview-card");
    const id = row.dataset.id;
    const front = row.querySelector(".fc-front").value.trim();
    const back = row.querySelector(".fc-back").value.trim();
    const lessonId = row.querySelector(".fc-lesson-id").value || null;
    if (!front || !back) {
      showAlert("Front and back are both required.");
      return;
    }
    const url = id
      ? `<%= rolePrefix %>/flashcards/${id}/edit`
      : `<%= rolePrefix %>/modules/${flashcardModuleId}/flashcards/create`;
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ front, back, lesson_id: lessonId }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showAlert(data.error || "Failed to save card.");
        return;
      }
      showAlert(id ? "Card updated." : "Card added.", "success");
      loadFlashcardManageList();
    } catch (err) {
      showAlert("Failed to save card: " + err.message);
    }
  }

  async function deleteManageCard(btn) {
    const row = btn.closest(".flashcard-preview-card");
    const id = row.dataset.id;
    const ok = await showConfirm("Delete this flashcard?");
    if (!ok) return;
    try {
      const res = await fetch(`<%= rolePrefix %>/flashcards/${id}/delete`, { method: "POST" });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showAlert(data.error || "Failed to delete card.");
        return;
      }
      row.remove();
    } catch (err) {
      showAlert("Failed to delete card: " + err.message);
    }
  }

  async function uploadFlashcardsCsv() {
    const fileInput = document.getElementById("flashcardCsvFile");
    if (!fileInput.files.length) {
      showAlert("Choose a CSV file first.");
      return;
    }
    const ok = await showConfirm("This will replace this module's entire flashcard set with what's in the file. Continue?");
    if (!ok) return;

    showFlashcardState("flashcardLoadingState");
    const formData = new FormData();
    formData.append("file", fileInput.files[0]);
    try {
      const res = await fetch(`<%= rolePrefix %>/modules/${flashcardModuleId}/flashcards/upload`, {
        method: "POST",
        body: formData,
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showAlert(data.error || "Failed to import flashcards.");
        showFlashcardState("flashcardIdleState");
        return;
      }
      const skippedNote = data.skipped ? ` (${data.skipped} row(s) skipped — missing front/back)` : "";
      showAlert(`Imported ${data.count} flashcards!${skippedNote}`, "success").then(() => location.reload());
    } catch (err) {
      showAlert("Failed to import flashcards: " + err.message);
      showFlashcardState("flashcardIdleState");
    }
  }

  async function generateFlashcardsPreview() {
    const numCards = document.getElementById("flashcardCount").value || 20;
    showFlashcardState("flashcardLoadingState");
    try {
      const res = await fetch(`<%= rolePrefix %>/modules/${flashcardModuleId}/flashcards/ai-preview`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ numCards }),
      });
      const data = await res.json();
      if (!res.ok || !data.preview) {
        showFlashcardState("flashcardIdleState");
        showAlert(data.error || "Failed to generate flashcards.");
        return;
      }
      flashcardLessons = data.lessons || [];
      renderFlashcardPreview(data.preview);
      showFlashcardState("flashcardPreviewState");
    } catch (err) {
      showFlashcardState("flashcardIdleState");
      showAlert("Failed to generate flashcards: " + err.message);
    }
  }

  function renderFlashcardPreview(cards) {
    const lessonOptions = flashcardLessons
      .map((l) => `<option value="${l.title.replace(/"/g, "&quot;")}">${l.title}</option>`)
      .join("");
    const list = document.getElementById("flashcardPreviewList");
    list.innerHTML = cards
      .map(
        (c, i) => `
      <div class="flashcard-preview-card" data-index="${i}">
        <label>Front (question/prompt)</label>
        <textarea rows="2" class="fc-front">${(c.front || "").replace(/</g, "&lt;")}</textarea>
        <label>Back (answer)</label>
        <textarea rows="2" class="fc-back">${(c.back || "").replace(/</g, "&lt;")}</textarea>
        <label>From lesson</label>
        <select class="fc-lesson">
          <option value="">— Not linked to a lesson —</option>
          ${lessonOptions}
        </select>
        <button type="button" class="jk-btn-outline-sm" style="margin-top:8px;" onclick="this.closest('.flashcard-preview-card').remove()">Remove card</button>
      </div>
    `
      )
      .join("");
    // Select the AI's chosen lesson for each card now that the <select> exists.
    list.querySelectorAll(".flashcard-preview-card").forEach((card, i) => {
      const sel = card.querySelector(".fc-lesson");
      if (cards[i].lesson_title) sel.value = cards[i].lesson_title;
    });
  }

  async function saveFlashcards() {
    const cards = Array.from(document.querySelectorAll("#flashcardPreviewList .flashcard-preview-card")).map((card) => ({
      front: card.querySelector(".fc-front").value.trim(),
      back: card.querySelector(".fc-back").value.trim(),
      lesson_title: card.querySelector(".fc-lesson").value || null,
    })).filter((c) => c.front && c.back);

    if (!cards.length) {
      showAlert("Add at least one flashcard before saving.");
      return;
    }

    try {
      const res = await fetch(`<%= rolePrefix %>/modules/${flashcardModuleId}/flashcards/ai-save`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ flashcards: cards }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showAlert(data.error || "Failed to save flashcards.");
        return;
      }
      showAlert(`Saved ${data.count} flashcards!`, "success").then(() => location.reload());
    } catch (err) {
      showAlert("Failed to save flashcards: " + err.message);
    }
  }
</script>

