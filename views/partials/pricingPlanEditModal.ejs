<!-- Per-plan edit modal for views/admin/pricingPlans.ejs — one instance per
     plan row, matching the existing per-row edit-modal convention already
     used by views/admin/benefits.ejs. -->
<div id="editModal-<%= plan.id %>" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeEditModal('<%= plan.id %>')">&times;</span>
    <h2>Edit <%= plan.name %></h2>
    <form method="POST" action="/admin/pricing-plans/edit/<%= plan.id %>">
      <input type="text" name="name" value="<%= plan.name %>" required />
      <label style="font-size:11px; color:#888; display:block; margin:4px 0 2px;">
        Price (₦)<%= plan.is_addon ? " — flat per term" : plan.segment === "school" ? " — per student per term" : "" %>
      </label>
      <input type="number" name="price_amount" value="<%= plan.price_amount %>" min="0" required />
      <% if (plan.segment === 'instructor_led') { %>
        <label style="font-size:11px; color:#888; display:block; margin:4px 0 2px;">Price ($, optional)</label>
        <input type="number" name="price_usd" value="<%= plan.price_usd || '' %>" min="0" step="0.01" />
        <label style="font-size:11px; color:#888; display:block; margin:4px 0 2px;">Schedule</label>
        <input type="text" name="schedule_text" value="<%= plan.schedule_text || '' %>" placeholder="e.g. Saturdays, 1 hour" maxlength="150" />
        <select name="billing_cycle">
          <option value="" <%= !plan.billing_cycle ? 'selected' : '' %>>No recurring cycle</option>
          <option value="monthly" <%= plan.billing_cycle === 'monthly' ? 'selected' : '' %>>Monthly</option>
          <option value="annual" <%= plan.billing_cycle === 'annual' ? 'selected' : '' %>>Annual</option>
        </select>
      <% } %>
      <textarea name="description"><%= plan.description || '' %></textarea>
      <textarea name="features"><%= (Array.isArray(plan.features) ? plan.features : []).join('\n') %></textarea>
      <input type="number" name="sort_order" value="<%= plan.sort_order %>" />
      <label style="display:flex; align-items:center; gap:6px; margin-top:8px;">
        <input type="checkbox" name="is_active" <%= plan.is_active ? 'checked' : '' %> />
        Active
      </label>
      <label style="display:flex; align-items:center; gap:6px; margin-top:6px;">
        <input type="checkbox" name="is_featured" <%= plan.is_featured ? 'checked' : '' %> />
        ✨ Mark as "Most Popular"
      </label>
      <% if (plan.is_addon) { %>
        <label style="display:flex; align-items:center; gap:6px; margin-top:6px;">
          <input type="checkbox" name="show_publicly" <%= plan.show_publicly ? 'checked' : '' %> />
          🌍 Show on /for-schools (name &amp; description only — no price)
        </label>
        <label style="display:flex; align-items:center; gap:6px; margin-top:6px;">
          <input type="checkbox" name="is_quantity_based" <%= plan.is_quantity_based ? 'checked' : '' %> />
          🔢 Quantity-based (a free allowance, then a price per extra unit requested)
        </label>
        <label style="font-size:11px; color:#888; display:block; margin:4px 0 2px;">Free quantity per term</label>
        <input type="number" name="free_quantity" value="<%= plan.free_quantity || 0 %>" min="0" />
        <label style="font-size:11px; color:#888; display:block; margin:4px 0 2px;">Price per extra unit (₦)</label>
        <input type="number" name="price_per_extra_unit" value="<%= plan.price_per_extra_unit || 0 %>" min="0" />
      <% } %>
      <button type="submit">Update</button>
    </form>
  </div>
</div>
