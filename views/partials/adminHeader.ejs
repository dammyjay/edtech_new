        <% } %>
        <div class="dropdown">
            <button class="dropbtn" onclick="toggleDropdown('resourceMenu')">
              Resource ▾
            </button>
            <div class="dropdown-content" id="resourceMenu">
              <a href="/admin/pathways">Pathways</a>
              <a href="/admin/courses">Courses</a>
              <a href="/admin/guides">Guides</a>
            </div>
          </div>
        


        <% if (role === 'admin') { %>
          <div class="dropdown">
            <button class="dropbtn" onclick="toggleDropdown('galleryMenu')">
              Gallery ▾
            </button>
            <div class="dropdown-content" id="galleryMenu">
              <a href="/admin/gallery">Gallery</a>
            </div>
          </div>

          <div class="dropdown">
            <button
              class="dropbtn"
              onclick="toggleDropdown('ministryMenu')"
