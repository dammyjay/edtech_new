<h2>💳 Payments</h2>

<div class="table-responsive">
    <table class="user-table" border="1" cellpadding="8" cellspacing="0" style="width:100%; border-collapse:collapse;">
    <thead>
        <tr>
        <th>Term</th>
        <th>Amount</th>
        <th>Adjustments</th>
        <th>Total</th>
        <th>Quote Status</th>
        <th>Payment Date</th>
        <th>Receipt</th>
        </tr>
    </thead>
    <tbody>
        <% if (payments.length > 0) { %>
        <% payments.forEach(p => { %>
            <tr>
            <td><%= p.term_name || '-' %></td>
            <td>₦<%= p.base_amount %></td>
            <td>₦<%= p.adjustments_total %></td>
            <td>₦<%= p.total_amount %></td>
            <td><%= p.quote_status || '-' %></td>
            <td><%= p.payment_date ? new Date(p.payment_date).toLocaleDateString() : new Date(p.created_at).toLocaleDateString() %></td>
            <td><a href="/school-admin/payments/<%= p.id %>/receipt" class="btn-sec">📄 Receipt</a></td>
            </tr>
        <% }) %>
        <% } else { %>
        <tr><td colspan="7" style="text-align:center;">No payments recorded yet.</td></tr>
        <% } %>
    </tbody>
    </table>
</div>
