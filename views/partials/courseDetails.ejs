
<button class="jk-btn-dark" onclick="openEditModal('course')">✏️ Edit Course</button>

<div id="editModal-course" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeEditModal('course')">&times;</span>
    <h3>Edit Course</h3>

    <form action="/admin/courses/<%= course.id %>/edit" method="POST" enctype="multipart/form-data">
      <label>Title</label>
      <input type="text" name="title" value="<%= course.title %>" required>

      <label>Description</label>
      <textarea id="content" name="description"><%= course.description %></textarea>

      <label>Thumbnail</label>
      <img src="<%= course.thumbnail_url %>" alt="" style="width:100px; height:100px; object-fit:contain;">
      <input type="file" name="thumbnail" accept="image/*">

      <label>Course Curriculum</label>
        <textarea id="editCurriculumContent-<%= course.id %>" name="curriculum_content">
          <%= course.curriculum_content %>
        </textarea>

      <label>Level</label>
      <select name="level">
        <option value="Beginner" <%= course.level === "Beginner" ? "selected" : "" %>>Beginner</option>
        <option value="Intermediate" <%= course.level === "Intermediate" ? "selected" : "" %>>Intermediate</option>
        <option value="Advanced" <%= course.level === "Advanced" ? "selected" : "" %>>Advanced</option>
      </select>

      <label>Amount (₦)</label>
      <input type="number" name="amount" value="<%= course.amount || 0 %>" step="0.01">

     


      <button type="submit" class="btn-save">💾 Save Changes</button>
    </form>
  </div>
</div>


<div class="course-details jk-report-panel" style="margin-top:16px;">
  <% if (course.thumbnail_url) { %>
    <img src="<%= course.thumbnail_url %>" style="width: 220px; height:150px; object-fit: cover; border-radius:10px; background:#FAF8F2;" alt="">
  <% } %>

  <div class="jk-stat-grid" style="grid-template-columns: repeat(4, minmax(0,1fr)); margin-top:16px;">
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Course ID</span></div>
      <span class="jk-stat-value" style="font-size:18px;"><%= course.id %></span>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Level</span></div>
      <span class="jk-stat-value" style="font-size:18px;"><%= course.level %></span>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Price</span></div>
      <span class="jk-stat-value" style="font-size:18px;">₦<%= Number(course.amount || 0).toLocaleString() %></span>
    </div>
    <div class="jk-stat-card">
      <div class="jk-stat-head"><span class="jk-stat-label">Sort Order</span></div>
      <span class="jk-stat-value" style="font-size:18px;"><%= course.sort_order %></span>
    </div>
  </div>

  <p style="color:#6E6350; font-size:12.5px; margin-top:14px;">Created <%= course.created_at.toDateString() %></p>

  <h3 style="margin-top:10px;"><strong>Description</strong></h3>
  <div><%- course.description %></div>

   <h3 style="margin-top:18px;">Course Curriculum</h3>
      <div class="curriculum-content">
        <%- course.curriculum_content %>
      </div>

    <a
      href="/admin/courses/<%= course.id %>/curriculum/download"
      class="jk-btn-outline"
      style="margin-top:15px; display:inline-flex; text-decoration:none;"
    >
      📥 Download Curriculum (PDF)
    </a>

  <% if (course.certificate_url) { %>
  <p style="margin-top:18px;"><strong>Certificate Template:</strong></p>
  <% if (course.certificate_url.endsWith('.pdf')) { %>
    <a href="<%= course.certificate_url %>" target="_blank">📄 View Certificate PDF</a>
  <% } else { %>
    <img src="<%= course.certificate_url %>" style="max-width:300px; border-radius:8px;">
  <% } %>
  <% } else { %>
    <p style="margin-top:18px; color:#8A7B55;">No certificate file uploaded.</p>
  <% } %>
</div>

<script>
  function openEditModal(id) {
  document.getElementById("editModal-" + id).style.display = "block";
}

function closeEditModal(id) {
  document.getElementById("editModal-" + id).style.display = "none";
}

</script>

<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

<!-- script for ckeditor -->
    <script>
      CKEDITOR.replace("content");
      CKEDITOR.replace('editCurriculumContent-<%= course.id %>');
    </script>

 