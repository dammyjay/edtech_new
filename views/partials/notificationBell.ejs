<!-- Locals-free by design: this partial is included from 3 different shell
     files (adminHeader.ejs, header.ejs, teacher_sidenav.ejs) that each pass
     different/inconsistent EJS locals — everything here is driven by
     client-side fetch() against /notifications/* instead. -->
<div class="notif-bell-wrap">
  <button type="button" id="notifBellBtn" class="notif-bell-btn" aria-label="Notifications">
    🔔
    <span id="notifBadge" class="notif-badge" style="display:none;">0</span>
  </button>
  <div id="notifDropdown" class="notif-dropdown" style="display:none;">
    <div class="notif-dropdown-header">
      <span>Notifications</span>
      <button type="button" id="notifMarkAllBtn" class="notif-markall-btn">Mark all read</button>
    </div>
    <div id="notifList" class="notif-list">
      <div class="notif-empty">Loading…</div>
    </div>
  </div>
</div>

<style>
  .notif-bell-wrap { position: relative; display: inline-block; vertical-align: middle; }
  .notif-bell-btn {
    position: relative;
    background: none;
    border: none;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 8px;
    border-radius: var(--radius-sm, 8px);
  }
  .notif-bell-btn:hover { background: var(--brand-tint, #FBF3DD); }
  .notif-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--error, #dc3545);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    border-radius: 999px;
    line-height: 1;
  }
  .notif-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 320px;
    max-width: 90vw;
    max-height: 420px;
    background: var(--bg-primary, #fff);
    border: 1px solid var(--border-light, #e0e0e0);
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-md, 0 4px 16px rgba(0,0,0,0.08));
    z-index: 10000;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--text-primary, #222);
  }
  .notif-dropdown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    font-weight: 700;
    font-size: 13.5px;
    border-bottom: 1px solid var(--border-light, #e0e0e0);
  }
  .notif-markall-btn {
    background: none;
    border: none;
    color: var(--brand-pri, #A17807);
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
  }
  .notif-markall-btn:hover { text-decoration: underline; }
  .notif-list { overflow-y: auto; }
  .notif-empty {
    padding: 24px 14px;
    text-align: center;
    color: var(--text-secondary, #666);
    font-size: 13px;
  }
  .notif-item {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-light, #e0e0e0);
    cursor: pointer;
  }
  .notif-item:hover { background: var(--bg-secondary, #f8f9fa); }
  .notif-item.unread { background: var(--brand-tint, #FBF3DD); }
  .notif-item-title { font-size: 13px; font-weight: 700; margin-bottom: 2px; }
  .notif-item-message { font-size: 12px; color: var(--text-secondary, #666); margin-bottom: 4px; }
  .notif-item-time { font-size: 10.5px; color: var(--text-secondary, #666); }
</style>

<script>
(function () {
  var POLL_MS = 25000;
  var pollTimer = null;
  var dropdownOpen = false;

  var bellBtn = document.getElementById("notifBellBtn");
  var badge = document.getElementById("notifBadge");
  var dropdown = document.getElementById("notifDropdown");
  var list = document.getElementById("notifList");
  var markAllBtn = document.getElementById("notifMarkAllBtn");
  if (!bellBtn || !dropdown) return;

  function escapeHtml(str) {
    var div = document.createElement("div");
    div.textContent = str || "";
    return div.innerHTML;
  }

  function timeAgo(iso) {
    var diffMs = Date.now() - new Date(iso).getTime();
    var mins = Math.floor(diffMs / 60000);
    if (mins < 1) return "just now";
    if (mins < 60) return mins + "m ago";
    var hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + "h ago";
    return Math.floor(hrs / 24) + "d ago";
  }

  function refreshUnreadCount() {
    fetch("/notifications/unread-count")
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        if (!data) return;
        if (data.count > 0) {
          badge.textContent = data.count > 99 ? "99+" : String(data.count);
          badge.style.display = "flex";
        } else {
          badge.style.display = "none";
        }
      })
      .catch(function () {});
  }

  function loadList() {
    list.innerHTML = '<div class="notif-empty">Loading…</div>';
    fetch("/notifications")
      .then(function (res) { if (!res.ok) throw new Error("failed"); return res.json(); })
      .then(function (items) {
        if (!items.length) {
          list.innerHTML = '<div class="notif-empty">No notifications yet</div>';
          return;
        }
        list.innerHTML = items.map(function (n) {
          return (
            '<div class="notif-item' + (n.is_read ? "" : " unread") + '" data-id="' + n.id + '" data-url="' + escapeHtml(n.url || "") + '">' +
              '<div class="notif-item-title">' + escapeHtml(n.title) + "</div>" +
              (n.message ? '<div class="notif-item-message">' + escapeHtml(n.message) + "</div>" : "") +
              '<div class="notif-item-time">' + timeAgo(n.created_at) + "</div>" +
            "</div>"
          );
        }).join("");
      })
      .catch(function () {
        list.innerHTML = '<div class="notif-empty">Couldn\'t load notifications</div>';
      });
  }

  function closeDropdown() {
    dropdown.style.display = "none";
    dropdownOpen = false;
  }

  bellBtn.addEventListener("click", function (e) {
    e.stopPropagation();
    dropdownOpen = !dropdownOpen;
    dropdown.style.display = dropdownOpen ? "flex" : "none";
    if (dropdownOpen) loadList();
  });

  document.addEventListener("click", function (e) {
    if (dropdownOpen && !dropdown.contains(e.target) && e.target !== bellBtn) closeDropdown();
  });

  list.addEventListener("click", function (e) {
    var item = e.target.closest(".notif-item");
    if (!item) return;
    var id = item.dataset.id;
    var url = item.dataset.url;
    fetch("/notifications/" + id + "/read", { method: "POST" }).finally(function () {
      if (url) window.location.href = url;
      else refreshUnreadCount();
    });
  });

  if (markAllBtn) {
    markAllBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      fetch("/notifications/read-all", { method: "POST" }).then(function () {
        refreshUnreadCount();
        loadList();
      });
    });
  }

  function startPolling() {
    if (pollTimer) return;
    refreshUnreadCount();
    pollTimer = setInterval(refreshUnreadCount, POLL_MS);
  }
  function stopPolling() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  }
  document.addEventListener("visibilitychange", function () {
    if (document.hidden) stopPolling();
    else startPolling();
  });
  startPolling();

  // ---- Service worker registration + push subscribe ----
  // Moved here from views/layout.ejs, which almost nothing actually
  // rendered through — this partial is what's included on every real
  // dashboard page load across all 6 roles instead.
  function urlBase64ToUint8Array(base64String) {
    var padding = "=".repeat((4 - (base64String.length % 4)) % 4);
    var base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
    var raw = atob(base64);
    return new Uint8Array([].map.call(raw, function (c) { return c.charCodeAt(0); }));
  }

  if ("serviceWorker" in navigator && "PushManager" in window) {
    navigator.serviceWorker.register("/sw.js").then(function (registration) {
      registration.pushManager.getSubscription().then(function (subscription) {
        (subscription
          ? Promise.resolve(subscription)
          : fetch("/vapid-public-key")
              .then(function (res) { return res.text(); })
              .then(function (vapidKey) {
                return registration.pushManager.subscribe({
                  userVisibleOnly: true,
                  applicationServerKey: urlBase64ToUint8Array(vapidKey),
                });
              })
        ).then(function (sub) {
          // Always POST — the server upserts by endpoint (see
          // routes/userRoutes.js POST /subscribe), which is what keeps a
          // shared device's subscription pointed at whoever is actually
          // logged in right now instead of whoever subscribed first.
          return fetch("/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(sub),
          });
        }).catch(function () {});
      });
    }).catch(function () {});
  }
})();
</script>
