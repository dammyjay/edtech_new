<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<script>
/* ---------------- CREATE LESSON ---------------- */

function openLessonModal() {
    document.getElementById('lessonModal').style.display = 'block';
    if (!CKEDITOR.instances['createLessonContent']) CKEDITOR.replace('createLessonContent');
    if (!CKEDITOR.instances['createLessonPlan']) CKEDITOR.replace('createLessonPlan');
  }

function closeLessonModal() {
  document.getElementById('lessonModal').style.display = 'none';
}

/* ---------------- EDIT LESSON ---------------- */
async function openEditLessonModal(lessonId) {
  try {
    const res = await fetch(`/admin/lessons/${lessonId}/json`);
    
    const lesson = await res.json();
    if (!lesson) return showAlert("Failed to load lesson");

    const form = document.getElementById('editLessonForm');
    form.action = `/admin/lessons/${lesson.id}/edit`;

    document.getElementById('editLessonTitle').value = lesson.title;
    document.getElementById('editLessonOrder').value = lesson.order_number || '';
    document.getElementById('editLessonVideo').value = lesson.video_url || '';

    const currentFileDiv = document.getElementById('editLessonCurrentFile');
    currentFileDiv.innerHTML = lesson.lesson_file_url
      ? `Current file: <a href="${lesson.lesson_file_url}" target="_blank" rel="noopener">View current slide deck</a>`
      : 'No slide deck uploaded yet.';

    /* ✅ MODULE SELECT (DO NOT REMOVE THIS) */
    let moduleSelect = document.getElementById('editLessonModule');
    if (!moduleSelect) {
      moduleSelect = document.createElement('select');
      moduleSelect.name = 'module_id';
      moduleSelect.id = 'editLessonModule';
      moduleSelect.required = true;
      form.insertBefore(moduleSelect, form.children[1]);
    }

    moduleSelect.innerHTML = '';
    window.modules.forEach(mod => {
      const opt = document.createElement('option');
      opt.value = mod.id;
      opt.textContent = mod.title;
      if (lesson.module_id == mod.id) opt.selected = true;
      moduleSelect.appendChild(opt);
    });

    /* ✅ CKEDITOR: CONTENT */
    if (!CKEDITOR.instances.editLessonContent) {
      CKEDITOR.replace('editLessonContent');
    }

    /* ✅ CKEDITOR: LESSON PLAN */
    if (!CKEDITOR.instances.editLessonPlan) {
      CKEDITOR.replace('editLessonPlan');
    }

    setTimeout(() => {
      CKEDITOR.instances.editLessonContent.setData(lesson.content || '');
      CKEDITOR.instances.editLessonPlan.setData(lesson.lesson_plan || '');
    }, 200);

    document.getElementById('editLessonModal').style.display = 'block';

  } catch (err) {
    console.error(err);
    showAlert("Error loading lesson");
  }
}

function closeEditLessonModal() {
  document.getElementById('editLessonModal').style.display = 'none';
}

/* ---------------- FORM SUBMISSION ---------------- */
const MAX_SLIDE_FILE_MB = 10;

document.addEventListener('submit', function (e) {
  for (let instance in CKEDITOR.instances) {
    CKEDITOR.instances[instance].updateElement();
  }

  const content = e.target.querySelector('textarea[name="content"]');
  const plan = e.target.querySelector('textarea[name="lesson_plan"]');
  const slideFileInput = e.target.querySelector('input[name="slide_file"]');

  if (content && !content.value.trim()) {
    e.preventDefault();
    showAlert("Lesson content is required");
    return false;
  }

  if (plan && !plan.value.trim()) {
    e.preventDefault();
    showAlert("Teacher lesson plan is required");
    return false;
  }

  if (slideFileInput && slideFileInput.files[0] && slideFileInput.files[0].size > MAX_SLIDE_FILE_MB * 1024 * 1024) {
    e.preventDefault();
    showAlert(`That slide deck is larger than ${MAX_SLIDE_FILE_MB}MB, which is the maximum this app currently accepts. Try compressing the images in the presentation and upload again.`);
    return false;
  }
});
</script>

<!-- LAB MODAL logic — mirrors openQuizModal/closeQuizModal's fetch-populate-save shape -->
<script>
let currentLabLessonId = null;

function openLabModal(lessonId) {
  currentLabLessonId = lessonId;
  document.getElementById('lab_lesson_id').value = lessonId;

  fetch(`/admin/lesson/${lessonId}/lab`)
    .then(res => res.json())
    .then(data => {
      const lab = data.success ? data.lab : null;
      document.getElementById('lab_type').value = lab?.lab_type || 'web';
      document.getElementById('lab_title').value = lab?.title || '';
      document.getElementById('lab_description').value = lab?.description || '';
      document.getElementById('lab_instructions').value = lab?.instructions || '';
      document.getElementById('lab_points').value = lab?.points ?? 10;
      document.getElementById('labModal').style.display = 'block';
    })
    .catch(err => console.error('openLabModal error:', err));
}

function closeLabModal() {
  document.getElementById('labModal').style.display = 'none';
}

document.getElementById('labForm').addEventListener('submit', function (e) {
  e.preventDefault();
  if (!currentLabLessonId) return;

  const formData = new FormData(e.target);

  fetch(`/admin/lesson/${currentLabLessonId}/lab`, {
    method: 'POST',
    body: formData,
  })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        showAlert('Lab task saved.');
        closeLabModal();
      } else {
        showAlert(data.message || 'Failed to save lab task.');
      }
    })
    .catch(err => {
      console.error('saveLessonLab error:', err);
      showAlert('Failed to save lab task.');
    });
});

function deleteLessonLab() {
  if (!currentLabLessonId) return;
  showConfirm('Remove the lab task from this lesson?').then(function (ok) {
    if (!ok) return;
    fetch(`/admin/lesson/${currentLabLessonId}/lab/delete`, { method: 'POST' })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showAlert('Lab task removed.');
          closeLabModal();
        } else {
          showAlert(data.message || 'Failed to remove lab task.');
        }
      })
      .catch(err => console.error('deleteLessonLab error:', err));
  });
}
</script>

