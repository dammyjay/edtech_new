<!-- <pre><%= JSON.stringify(course, null, 2) %></pre> -->

<div class="jk-header-card" style="margin-top:16px;">
  <div><h3 style="margin:0;">Lessons</h3></div>
  <button onclick="openLessonModal()" class="jk-btn-dark">+ Add Lesson</button>
</div>

<div class="jk-toolbar">
  <form method="GET" action="" style="display:flex; align-items:center; gap:8px;">
    <input type="hidden" name="tab" value="lessons">
    <label style="font-size:13px; font-weight:600; color:#4C3802;">Filter by Module:</label>
    <select name="module" class="jk-select" onchange="this.form.submit()">
      <option value="all" <%= selectedModuleId === 'all' ? 'selected' : '' %>>All Modules</option>
      <% modules.forEach(mod => { %>
        <option value="<%= mod.id %>" <%= selectedModuleId == mod.id ? 'selected' : '' %>><%= mod.title %></option>
      <% }) %>
    </select>
  </form>
</div>

<div class="article-grid jk-course-grid">
  <% lessons.forEach(lesson => { %>
      <div class="article-card jk-course-card" data-course-id="<%= lesson.course_id %>" data-lesson-id="<%= lesson.id %>">
      <div class="card-content">
      <h3><%= lesson.title %></h3>
      <p class="card-body">Lesson ID: <%= lesson.id %></p>
      <p class="card-body"><strong>Module:</strong> <%= lesson.module_title %></p>
      <div class="article-buttons">
        <button class="btn-edit" onclick="openEditLessonModal(<%= lesson.id %>)">Edit</button>

        <form method="POST" action="/admin/lessons/<%= lesson.id %>/delete" style="display:inline;">
          <input type="hidden" name="course_id" value="<%= course.id %>">
          <button class="btn-delete" type="submit" onclick="showConfirm('Archive this lesson? It will be hidden everywhere but can be restored later from the Archive screen.').then(function(ok) { if (ok) { event.target.closest('form').submit(); } }); return false;">Archive</button>
        </form>
        <button class="btn-view" type="button" onclick="openQuizModal(<%= lesson.id %>)">Manage Quiz</button>
        <button class="btn-view" type="button" onclick="openLabModal(<%= lesson.id %>)">Manage Lab</button>

      </div>
      </div>
    </div>

  <% }) %>
</div>

<div class="pagination">
  <% if (page > 1) { %>
    <a href="?module=<%= selectedModuleId %>&page=<%= page - 1 %>" class="page-link">Prev</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?module=<%= selectedModuleId %>&page=<%= i %>" 
       class="page-link <%= page === i ? 'active' : '' %>">
       <%= i %>
    </a>
  <% } %>

  <% if (page < totalPages) { %>
    <a href="?module=<%= selectedModuleId %>&page=<%= page + 1 %>" class="page-link">Next</a>
  <% } %>
</div>




<!-- CREATE LESSON MODAL -->
<div id="lessonModal" class="modal">
  <form method="POST" action="/admin/lessons/create" class="modal-content" enctype="multipart/form-data">
    <h2>Create Lesson</h2>
    <input type="text" name="course_id" value="<%= course.id %>">

    <label>Module</label>
    <select name="module_id" required>
      <% modules.forEach(mod => { %>
        <option value="<%= mod.id %>"><%= mod.title %></option>
      <% }) %>
    </select>

    <label>Title</label>
    <input type="text" name="title" required>

    <label>Order Number</label>
    <input type="number" name="order_number" min="1" required>

    <label>Content</label>
    <textarea name="content" id="createLessonContent"></textarea>

    <label>Teacher Lesson Plan</label>
    <textarea name="lesson_plan" id="createLessonPlan"></textarea>

    <label>Video Link (YouTube/Vimeo)</label>
    <input type="url" name="video_url" placeholder="https://www.youtube.com/...">

    <label>Slide Deck (PPT/PPTX, optional)</label>
    <input type="file" name="slide_file" accept=".ppt,.pptx,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation">

    <div class="modal-actions">
      <button type="submit">Save</button>
      <button type="button" onclick="closeLessonModal()">Cancel</button>
    </div>
  </form>
</div>


<!-- EDIT LESSON MODAL -->
<div id="editLessonModal" class="modal" style="display:none;">
  <form id="editLessonForm" method="POST" class="modal-content" enctype="multipart/form-data">
    <h2>Edit Lesson</h2>

    <!-- Hidden input for course_id -->

    <label>Title</label>
    <input type="text" name="title" id="editLessonTitle" required>

    <label>Order Number</label>
    <input type="number" name="order_number" id="editLessonOrder" min="1" required>

    <label>Content</label>
    <textarea name="content" id="editLessonContent"></textarea>

    <label>Teacher Lesson Plan</label>
    <textarea name="lesson_plan" id="editLessonPlan"></textarea>

    <label>Video Link (YouTube/Vimeo)</label>
    <input type="url" name="video_url" id="editLessonVideo" placeholder="https://www.youtube.com/...">

    <label>Slide Deck (PPT/PPTX, optional)</label>
    <div id="editLessonCurrentFile" style="margin-bottom:6px;"></div>
    <input type="file" name="slide_file" accept=".ppt,.pptx,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation">
    <small>Leave empty to keep the current file (if any). Uploading a new one replaces it.</small>

    <div class="modal-actions">
      <button type="submit">Update</button>
      <button type="button" onclick="closeEditLessonModal()">Cancel</button>
    </div>
  </form>
</div>


<!-- QUIZ MODAL -->
<div id="quizModal" class="qm-overlay" style="display:none;">
  <div class="qm-panel">
    <div class="qm-header">
      <h2>📝 Manage Quiz</h2>
      <button type="button" class="qm-close" onclick="closeQuizModal()" aria-label="Close">&times;</button>
    </div>

    <div class="qm-body">
      <div class="qm-list-head">
        <label class="qm-checkbox-label">
          <input type="checkbox" id="qmSelectAll" onchange="toggleSelectAllQuestions(this)">
          <span id="qmQuestionCount">0 questions</span>
        </label>
      </div>

      <div id="quizQuestions" class="qm-question-list"></div>

      <!-- Sticky bulk-action bar — only shown once ≥1 question is checked -->
      <div class="qm-bulkbar" id="qmBulkBar" hidden>
        <span id="qmSelectedCount">0 selected</span>
        <div class="qm-bulkbar-actions">
          <button type="button" class="qm-btn qm-btn-outline" onclick="clearQuestionSelection()">Clear</button>
          <button type="button" class="qm-btn qm-btn-danger" onclick="bulkDeleteSelectedQuestions()">Delete Selected</button>
        </div>
      </div>

      <details class="qm-import">
        <summary>Import from JSON</summary>
        <div class="qm-import-body">
          <input type="file" id="quizFile" accept=".json" />
          <textarea id="quizJson" rows="6" placeholder="Paste JSON here..."></textarea>
          <button type="button" class="qm-btn qm-btn-outline" onclick="importQuizJson()">Import JSON</button>
        </div>
      </details>

      <hr class="qm-divider">

      <form id="quizForm" class="qm-form">
        <input type="hidden" name="quiz_id" id="quiz_id">
        <h3 id="qmFormTitle" class="qm-form-title">Add a Question</h3>

        <label>Question</label>
        <textarea name="question" rows="2" required></textarea>

        <label>Question Image (optional)</label>
        <div class="qm-image-slot" id="qmQuestionImageSlot" tabindex="0" onclick="triggerImageSlotFile(this)">
          <input type="hidden" name="question_image_url">
          <input type="file" accept="image/*" class="qm-image-slot-file" hidden>
          <div class="qm-image-slot-empty">📷 Click, paste, or drop an image</div>
          <div class="qm-image-slot-preview" hidden>
            <img src="" alt="Question image">
            <button type="button" class="qm-image-remove" onclick="event.stopPropagation(); clearImageSlot(this.closest('.qm-image-slot'))">✕ Remove</button>
          </div>
        </div>

        <div class="qm-form-row">
          <div class="qm-form-col">
            <label>Question Type</label>
            <select name="question_type" id="question_type" onchange="toggleOptions()">
              <option value="multiple_choice">Multiple Choice</option>
              <option value="true_false">True/False</option>
              <option value="short_answer">Short Answer</option>
            </select>
          </div>
          <div class="qm-form-col">
            <label>Correct Answer</label>
            <input type="text" name="correct_option" required>
          </div>
        </div>

        <div id="options_container" class="qm-options"></div>

        <div class="qm-form-actions">
          <button type="submit" class="qm-btn qm-btn-primary" id="qmSubmitBtn">Add Question</button>
          <button type="button" class="qm-btn qm-btn-outline" id="qmCancelEditBtn" onclick="resetQuizForm()" hidden>Cancel Edit</button>
        </div>
      </form>
    </div>

    <div class="qm-footer">
      <button type="button" class="qm-btn qm-btn-outline" onclick="closeQuizModal()">Close</button>
    </div>
  </div>
</div>

