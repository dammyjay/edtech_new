function escapeHtml(str) {
  return String(str ?? "").replace(/[&<>"']/g, (c) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
  }[c]));
}

const QUESTION_TYPE_LABELS = {
  multiple_choice: "Multiple Choice",
  true_false: "True/False",
  short_answer: "Short Answer",
};

// ---- Generic image slot (question image + each option's image) ----
// One shared implementation for click-to-browse, paste, and drag-drop,
// wired onto any .qm-image-slot element — the question's slot is
// static markup, option slots are regenerated by toggleOptions(), so
// this is re-run (idempotently, via the data-wired guard) every time
// new slots appear instead of once on page load.
function triggerImageSlotFile(slotEl) {
  slotEl.querySelector('.qm-image-slot-file').click();
}

function setImageSlotPreview(slotEl, url) {
  slotEl.querySelector('input[type="hidden"]').value = url || '';
  const img = slotEl.querySelector('.qm-image-slot-preview img');
  const preview = slotEl.querySelector('.qm-image-slot-preview');
  const empty = slotEl.querySelector('.qm-image-slot-empty');
  if (url) {
    img.src = url;
    preview.hidden = false;
    empty.hidden = true;
  } else {
    img.src = '';
    preview.hidden = true;
    empty.hidden = false;
  }
}

function clearImageSlot(slotEl) {
  setImageSlotPreview(slotEl, null);
}

async function uploadImageToSlot(slotEl, file) {
  if (!file || !file.type || !file.type.startsWith('image/')) return;
  const empty = slotEl.querySelector('.qm-image-slot-empty');
  const originalText = empty.textContent;
  const hadUrl = slotEl.querySelector('input[type="hidden"]').value || null;
  empty.textContent = 'Uploading…';
  empty.hidden = false;
  slotEl.querySelector('.qm-image-slot-preview').hidden = true;

  try {
    const formData = new FormData();
    formData.append('quiz_image', file);
    const res = await fetch('/admin/quiz-question/upload-image', { method: 'POST', body: formData });
    const data = await res.json();
    if (data.success) {
      setImageSlotPreview(slotEl, data.url);
    } else {
      showAlert(data.message || 'Image upload failed.');
      setImageSlotPreview(slotEl, hadUrl);
    }
  } catch (err) {
    console.error(err);
    showAlert('Server error uploading image.');
    setImageSlotPreview(slotEl, hadUrl);
  } finally {
    empty.textContent = originalText;
  }
}

function initImageSlots(root) {
  root.querySelectorAll('.qm-image-slot').forEach((slot) => {
    if (slot.dataset.wired) return;
    slot.dataset.wired = "1";

    slot.querySelector('.qm-image-slot-file').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) uploadImageToSlot(slot, file);
      e.target.value = '';
    });

    slot.addEventListener('paste', (e) => {
      const item = Array.from(e.clipboardData?.items || []).find((i) => i.type.startsWith('image/'));
      if (item) uploadImageToSlot(slot, item.getAsFile());
    });

    slot.addEventListener('dragover', (e) => { e.preventDefault(); slot.classList.add('qm-image-slot-drag'); });
    slot.addEventListener('dragleave', () => slot.classList.remove('qm-image-slot-drag'));
    slot.addEventListener('drop', (e) => {
      e.preventDefault();
      slot.classList.remove('qm-image-slot-drag');
      const file = e.dataTransfer?.files?.[0];
      if (file) uploadImageToSlot(slot, file);
    });
  });
}

initImageSlots(document.getElementById('quizModal'));

// Render quiz questions
function renderQuestions(questions) {
  currentQuestions = questions || [];
  selectedQuestionIds.clear();

  const container = document.getElementById('quizQuestions');
  const countEl = document.getElementById('qmQuestionCount');
  countEl.textContent = `${currentQuestions.length} question${currentQuestions.length === 1 ? "" : "s"}`;

  if (currentQuestions.length === 0) {
    container.innerHTML = '<p class="qm-empty">No questions yet — add one below.</p>';
    updateQuestionSelectionUI();
    return;
  }

  container.innerHTML = currentQuestions.map((q, i) => `
    <div class="qm-question-card" data-id="${q.id}">
      <label class="qm-card-check">
        <input type="checkbox" class="qm-question-cb" value="${q.id}" onchange="updateQuestionSelectionUI()">
      </label>
      <div class="qm-card-body">
        <div class="qm-card-top">
          <span class="qm-qnum">Q${i + 1}</span>
          <span class="qm-type-badge">${QUESTION_TYPE_LABELS[q.question_type] || q.question_type || ""}</span>
        </div>
        <p class="qm-question-text">${escapeHtml(q.question)}</p>
        ${q.question_image_url ? `<img class="qm-thumb" src="${escapeHtml(q.question_image_url)}" alt="">` : ''}
        ${q.options && q.options.length ? `
          <div class="qm-options-preview">
            ${q.options.map((opt, idx) => `
              <span class="qm-option-chip">
                ${(q.option_images && q.option_images[idx]) ? `<img class="qm-thumb qm-thumb-xs" src="${escapeHtml(q.option_images[idx])}" alt="">` : ''}${escapeHtml(opt)}
              </span>
            `).join('')}
          </div>
        ` : ''}
        <p class="qm-answer">Answer: ${escapeHtml(q.correct_option)}</p>
      </div>
      <div class="qm-card-actions">
        <button class="qm-icon-btn" type="button" onclick='editQuestion(${JSON.stringify(q)})'>Edit</button>
        <button class="qm-icon-btn qm-icon-btn-danger" type="button" onclick="deleteQuestion(${q.id})">Delete</button>
      </div>
    </div>
  `).join('');

  updateQuestionSelectionUI();
}

function toggleSelectAllQuestions(checkbox) {
  document.querySelectorAll('.qm-question-cb').forEach((cb) => { cb.checked = checkbox.checked; });
  updateQuestionSelectionUI();
}

function clearQuestionSelection() {
  document.querySelectorAll('.qm-question-cb').forEach((cb) => { cb.checked = false; });
  document.getElementById('qmSelectAll').checked = false;
  updateQuestionSelectionUI();
}

// Keeps selectedQuestionIds, the bulk bar, the "N selected" count, the
// select-all checkbox, and each card's highlight all in sync whenever
// any individual checkbox changes.
function updateQuestionSelectionUI() {
  selectedQuestionIds.clear();
  document.querySelectorAll('.qm-question-cb:checked').forEach((cb) => selectedQuestionIds.add(cb.value));

  document.querySelectorAll('.qm-question-card').forEach((card) => {
    card.classList.toggle('qm-selected', selectedQuestionIds.has(card.dataset.id));
  });

  const bulkBar = document.getElementById('qmBulkBar');
  const total = currentQuestions.length;
  const selected = selectedQuestionIds.size;

  bulkBar.hidden = selected === 0;
  document.getElementById('qmSelectedCount').textContent = `${selected} selected`;

  const selectAll = document.getElementById('qmSelectAll');
  selectAll.checked = total > 0 && selected === total;
  selectAll.indeterminate = selected > 0 && selected < total;
}

async function bulkDeleteSelectedQuestions() {
  const ids = Array.from(selectedQuestionIds);
  if (!ids.length) return;

  if (!(await showConfirm(`Delete ${ids.length} selected question${ids.length === 1 ? "" : "s"}? This can't be undone.`))) return;

  try {
    const res = await fetch('/admin/quiz-questions/bulk-delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ quiz_id: document.getElementById('quiz_id').value, ids }),
    });
    const data = await res.json();
    if (data.success) {
      renderQuestions(data.questions);
      showAlert(`Deleted ${ids.length} question${ids.length === 1 ? "" : "s"}.`);
    } else {
      showAlert(data.message || "Couldn't delete those questions.");
    }
  } catch (err) {
    console.error(err);
    showAlert("Server error deleting questions.");
  }
}

// Fill form with existing question data for editing
function editQuestion(q) {
  isEditing = true;
  editingQuestionId = q.id;

  document.querySelector('#quizForm textarea[name="question"]').value = q.question;
  document.querySelector('#quizForm select[name="question_type"]').value = q.question_type;
  document.querySelector('#quizForm input[name="correct_option"]').value = q.correct_option;
  setImageSlotPreview(document.getElementById('qmQuestionImageSlot'), q.question_image_url || null);

  toggleOptions();

  // Fill options (and their images) if applicable
  if (q.question_type === "multiple_choice" && q.options) {
    const optionInputs = document.querySelectorAll('#options_container input[name="options"]');
    const optionImageSlots = document.querySelectorAll('#options_container .qm-image-slot');
    q.options.forEach((opt, idx) => {
      if (optionInputs[idx]) optionInputs[idx].value = opt;
      if (optionImageSlots[idx]) setImageSlotPreview(optionImageSlots[idx], (q.option_images && q.option_images[idx]) || null);
    });
  }

  document.getElementById('qmFormTitle').textContent = "Edit Question";
  document.getElementById('qmSubmitBtn').textContent = "Update Question";
  document.getElementById('qmCancelEditBtn').hidden = false;
}

// Reset form to add mode
function resetQuizForm() {
  isEditing = false;
  editingQuestionId = null;
  document.getElementById('quizForm').reset();
  // toggleOptions() below rebuilds #options_container's image slots from
  // scratch, but the question image slot is static markup — .reset()
  // clears its hidden input's value natively, but not the <img>/preview
  // DOM state, so that needs clearing explicitly.
  setImageSlotPreview(document.getElementById('qmQuestionImageSlot'), null);
  toggleOptions();
  document.getElementById('qmFormTitle').textContent = "Add a Question";
  document.getElementById('qmSubmitBtn').textContent = "Add Question";
  document.getElementById('qmCancelEditBtn').hidden = true;
}

// Toggle options fields based on type
function imageSlotHtml(extraClass) {
  return `
    <div class="qm-image-slot ${extraClass || ''}" tabindex="0" onclick="triggerImageSlotFile(this)">
      <input type="hidden" name="option_images">
      <input type="file" accept="image/*" class="qm-image-slot-file" hidden>
      <div class="qm-image-slot-empty">📷</div>
      <div class="qm-image-slot-preview" hidden>
        <img src="" alt="Option image">
        <button type="button" class="qm-image-remove" onclick="event.stopPropagation(); clearImageSlot(this.closest('.qm-image-slot'))">✕</button>
      </div>
    </div>
  `;
}

function toggleOptions() {
  let type = document.getElementById('question_type').value;
  let container = document.getElementById('options_container');

  if (type === 'multiple_choice') {
    container.innerHTML = `
      <label>Options (add an image to any of them if you like)</label>
      ${[1, 2, 3, 4].map((n) => `
        <div class="qm-option-row">
          <input type="text" name="options" placeholder="Option ${n}">
          ${imageSlotHtml('qm-image-slot-sm')}
        </div>
      `).join('')}
    `;
  } else if (type === 'true_false') {
    container.innerHTML = `
      <input type="hidden" name="options" value="True">
      <input type="hidden" name="options" value="False">
      <p>True / False are fixed</p>
    `;
  } else {
    container.innerHTML = '';
  }
  initImageSlots(container);
}

// Handle create/update via AJAX
document.getElementById('quizForm').addEventListener('submit', function(e) {
  e.preventDefault();

  const formData = new FormData(this);
  const url = isEditing
    ? `/admin/quiz-question/${editingQuestionId}/edit`
    : '/admin/quiz-question/create';

  fetch(url, {
    method: 'POST',
    body: formData
  })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        renderQuestions(data.questions);
        resetQuizForm();
      } else {
        showAlert('Error saving question');
      }
    })
    .catch(err => console.error(err));
});

// Delete a question via AJAX
// Was calling openQuizModal(quiz_id) here — but openQuizModal expects a
// LESSON id, and #quiz_id holds the QUIZ's id (a different id space
// entirely). That fetched /admin/lesson/{quizId}/quiz, which happened
// to hit some unrelated lesson (from any course) that coincidentally
// shares that numeric id, and rendered THEIR questions instead — "a
// question from another course shows up." The delete endpoint already
// returns the real, correct remaining list for this quiz; just render
// that directly instead of re-deriving a lesson id at all.
async function deleteQuestion(id) {
  if (!(await showConfirm('Delete this question?'))) return;

  fetch(`/admin/quiz-question/${id}/delete`, { method: 'POST' })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        renderQuestions(data.questions);
      } else {
        showAlert(data.message || "Couldn't delete that question.");
      }
    })
    .catch(err => console.error(err));
}
</script>

