<div style="margin: 1rem 0; display:flex; gap:10px; flex-wrap:wrap;">
  <button class="btn-sec" onclick="loadSchoolAdminAnalytics()">📊 View Term Analytics</button>
  <button class="btn-sec" onclick="window.location.href='/school-admin/download-progress'">📄 Download School Summary</button>
</div>
<div id="schoolAdminAnalyticsBox"></div>

<script>
  async function loadSchoolAdminAnalytics() {
    const box = document.getElementById("schoolAdminAnalyticsBox");
    box.innerHTML = "<p>Loading...</p>";
    try {
      const res = await fetch("/school-admin/term-analytics");
      const data = await res.json();

      let html = `
        <div class="report-panel" style="background:#fff; border-radius:12px; padding:16px; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,.06);">
          <h3>📊 Term Analytics</h3>
          <p><strong>Total Unique Students (across all terms):</strong> ${data.totals.total_unique_students}</p>
          <p><strong>Total Term Enrollments:</strong> ${data.totals.total_enrollments}</p>
          <p><strong>Retained Students (enrolled in 2+ terms):</strong> ${data.retention.retained_students}</p>
          <h4>Growth Per Term</h4>
          <ul>
      `;
      data.growth.forEach((term) => {
        html += `<li>${term.name}: ${term.total_students} students</li>`;
      });
      html += `</ul></div>`;

      box.innerHTML = html;
    } catch (err) {
      box.innerHTML = "<p>Error loading analytics.</p>";
    }
  }
</script>

