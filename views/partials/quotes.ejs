<h2>💡 Quotes</h2>

<p style="color:#666; font-size:14px;">
  A quote is created automatically for every academic term you set up, priced per student —
  see the <strong>Terms</strong> tab to create one. The totals and balance below update live
  as students are enrolled and payments come in.
</p>

<div class="table-responsive">
    <table class="user-table" border="1" cellpadding="8" cellspacing="0" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr>
        <th>Term</th>
        <th>Price / Student</th>
        <th>Students</th>
        <th>Total Amount</th>
        <th>Paid</th>
        <th>Balance</th>
        <th>Status</th>
        <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% if (quotes.length > 0) { %>
        <% quotes.forEach(q => { %>
            <tr>
            <td><%= q.term_name %></td>
            <td>₦<%= q.price_per_student %></td>
            <td><%= q.total_students %></td>
            <td>₦<%= q.total_amount %></td>
            <td>₦<%= q.total_paid %></td>
            <td>₦<%= q.balance %></td>
            <td><%= q.status %></td>
            <td>
                <div class="article-buttons">
                <a href="/school-admin/quotes/<%= q.id %>/download" class="btn-sec" style="display:inline-block;">📄 Download</a>
                <!-- <form action="/school-admin/quotes/delete/<%= q.id %>" method="POST" style="display:inline;">
                <button class="btn-delete" type="submit">🗑️ Delete</button>
                </form> -->
                </div>
            </td>
            </tr>
        <% }) %>
        <% } else { %>
        <tr>
            <td colspan="8" style="text-align:center;">No quotes yet — create a term to get one.</td>
        </tr>
        <% } %>
    </tbody>
    </table>
</div>
