<style>
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
  }

  .modal-content {
    background: #fff;
    padding: 20px;
    width: 400px;
    margin: 8% auto;
    border-radius: 10px;
  }

  .close {
    float: right;
    font-size: 20px;
    cursor: pointer;
  }
</style>


<button onclick="openStudentModal()">➕ Add Student</button>

<!-- MODAL -->
<div id="studentModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeStudentModal()">&times;</span>

    <h3>Add Student</h3>

    <form action="/school-admin/add-student" method="POST">
      <input type="text" name="fullname" placeholder="Full Name" required />

      <select name="gender" required>
        <option value="">Select Gender</option>
        <option value="male">Male</option>
        <option value="female">Female</option>
      </select>

      <button type="submit">Add Student</button>
    </form>

    <hr>

    <h3>Bulk Upload (CSV)</h3>

    <form action="/school-admin/bulk-add-students" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" accept=".csv" required />
      <button type="submit">Upload CSV</button>
    </form>
  </div>
</div>

<h2>🎓 Approved Students</h2>
<div class="table-responsive">
  <table class="user-table">
    <thead>
      <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Gender</th>
        <th>Classroom</th>
        <th>Joined On</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length) { %>
        <% students.forEach(s => { %>
          <tr>
            <td><%= s.fullname %></td>
            <td><%= s.email %></td>
            <td><%= s.gender %></td>
            <td><%= s.classroom_name %></td>
            <td><%= new Date(s.joined_at).toDateString() %></td>
            <td>
              <button class="btn-edit" onclick="openAssignClassroomModal(<%= s.id %>, '<%= s.fullname %>')">➕ Add to Classroom</button>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="3" style="text-align:center;">No students yet</td></tr>
      <% } %>
    </tbody>
  </table>
</div>


<div id="assignClassroomModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeAssignClassroomModal()">&times;</span>

    <h3>Assign <span id="modalStudentName"></span> to Classroom</h3>

    <form id="assignClassForm">
      <input type="hidden" name="student_id" id="modalStudentId">

      <select name="classroom_id" id="modalClassroomSelect" required>
        <option value="">-- Select Classroom --</option>
        
        <% if (typeof classrooms !== 'undefined' && classrooms.length) { %>
          <% classrooms.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        <% } %>
      </select>

      <button type="submit" class="btn-edit">Assign</button>
    </form>
  </div>
</div>


<div id="assignSuccessModal" class="modal">
  <div class="modal-content" style="text-align:center;">
    <h3>✅ Success</h3>
    <p>Student assigned to classroom successfully!</p>
    <button onclick="closeAssignSuccessModal()" class="btn-edit">OK</button>
  </div>
</div>