<h2>🏫 Classrooms</h2>
<button class="btn-edit" onclick="openModal('createClassroomModal')">➕ Create Classroom</button>

<div class="classroom-list">
  <% if (classrooms.length) { %>
    <% classrooms.forEach(c => { %>
      <div class="classroom-card">
        <div class="classroom-header" onclick="toggleCollapse('classroom-<%= c.id %>')">
          <h3><%= c.name %></h3>
          <p>👨‍🏫 <%= c.teacher_names %></p>
          <p>🎓 <%= c.student_count %> students</p>
        </div>

        <div id="classroom-<%= c.id %>" class="classroom-body collapsible-content">
          <!-- CRUD Buttons -->
          <div class="classroom-actions">
            <div class="article-buttons">
            <a class="btn-sec" href="/school-admin/classrooms/<%= c.id %>/dashboard">📊 View Analytics</a>
            <button class="btn-edit" onclick="openEditModal(<%= c.id %>, '<%= c.name %>', <%- JSON.stringify(c.teacher_ids || []) %>)">✏ Edit Classroom</button>
            <form method="POST" action="/school-admin/classrooms/<%= c.id %>/delete" onsubmit="return handleConfirmSubmit(event, 'Delete this classroom?')">
              <button type="submit" class="btn-delete">🗑 Delete Classroom</button>
            </form>
            </div>
          </div>

          <!-- Students Table -->
          <h4>Students</h4>
          <div class="table-responsive">
            <table class="user-table">
                <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Joined On</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                <% if (c.students.length) { %>
                    <% c.students.forEach(s => { %>
                    <tr>
                        <td><%= s.fullname %></td>
                        <td><%= s.email %></td>
                        <td><%= new Date(s.joined_at).toDateString() %></td>
                        <td style="display: inline; align-items: center;">
                            <div class="article-buttons">
                                <!-- CRUD for student -->
                                <form method="POST" action="/school-admin/students/<%= s.id %>/delete" style="display:inline;" onsubmit="return handleConfirmSubmit(event, 'Remove this student?')">
                                    <button class="btn-delete">🗑 Remove</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="4" style="text-align:center;">No students in this class</td></tr>
                <% } %>
                </tbody>
            </table>
        </div>


        <!-- Add student form -->
        <!-- <form method="POST" action="/school-admin/classrooms/<%= c.id %>/add-student"> -->
        <form onsubmit="addStudent(event, <%= c.id %>)">
        
        <input type="text" 
                placeholder="🔍 Search by email..." 
                onkeyup="filterStudents('<%= c.id %>', this.value)" 
                class="student-search">

        
        <select name="student_id" id="student-select-<%= c.id %>" size="5" required>
            <option value="">-- Select Student --</option>
            <% c.availableStudents.forEach(st => { %>
            <option value="<%= st.id %>"><%= st.fullname %> (<%= st.email %>)</option>
            <% }) %>
        </select>

        <button type="submit" class="btn-edit">➕ Add Student</button>
        </form>

        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p>No classrooms yet</p>
  <% } %>
</div>

<!-- <div id="studentAlert" class="alert-overlay">Student added successfully ✅</div> -->

<div id="studentSuccessModal" class="modal">
  <div class="modal-content" style="text-align:center;">
    <h3>✅ Success</h3>
    <p>Student added to classroom successfully!</p>
    <button onclick="closeStudentSuccessModal()" class="btn-edit">OK</button>
  </div>
</div>


