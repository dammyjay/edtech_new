<!-- toggle lesson sidebar -->
<script>
  const lessonsidebar = document.getElementById("lessonSidebar");
  const handle = document.getElementById("sidebarHandle");

  function isMobile() {
    return window.innerWidth <= 600;
  }

  // Restore saved desktop state only
  if (!isMobile()) {
    const isSavedCollapsed = localStorage.getItem("lessonSidebarCollapsed") === "true";

    if (isSavedCollapsed) {
      lessonsidebar.classList.add("collapsed");
      handle.innerHTML = "❯";
    }
  }

  handle.addEventListener("click", () => {

    if (isMobile()) {
      // MOBILE BEHAVIOR (overlay slide)
      lessonsidebar.classList.toggle("mobile-open");

    } else {
      // DESKTOP BEHAVIOR (collapse width)
      lessonsidebar.classList.toggle("collapsed");

      const isCollapsed = lessonsidebar.classList.contains("collapsed");
      handle.innerHTML = isCollapsed ? "❯" : "❮";

      localStorage.setItem("lessonSidebarCollapsed", isCollapsed);
    }

  });

  // Optional: Auto close sidebar after clicking lesson on mobile
  document.addEventListener("click", function(e) {
    if (isMobile()) {
      if (e.target.closest(".lesson-toggle") || 
          e.target.closest(".module-toggle") || 
          e.target.closest(".assignment-btn")) {

        lessonsidebar.classList.remove("mobile-open");
      }
    }
  });

  // Handle window resize (important)
  window.addEventListener("resize", () => {
    if (!isMobile()) {
      lessonsidebar.classList.remove("mobile-open");
    }
  });

</script>

