<!-- script for loading, submiting reviewing quiz -->
<script>

  let quizQuestions = [];
let quizAnswers = {};
let currentQuestionIndex = 0;
let currentQuizLessonId = null;

let reviewQuestions = [];
let reviewIndex = 0;

  function toggleModule(moduleId) {
    const el = document.getElementById(`module-${moduleId}`);
    el.style.display = (el.style.display === "none" || !el.style.display) ? "block" : "none";
  }

  function submitQuizWizard(){

  if(
    !quizAnswers[
      quizQuestions[currentQuestionIndex].id
    ]
  ){
    showAlert("Please select an answer.");
    return;
  }

  submitQuizAnswers(
    currentQuizLessonId
  );
}

  // Shared rendering for a locked-quiz response (term ended, or a
  // previous-classroom course) — used both when loading a quiz and
  // when a submit attempt gets rejected server-side.
  function renderQuizLockNotice(container, data) {
    if (data.locked === "term_ended" && data.termId) {
      container.innerHTML = `
        <div style="padding:20px; background:#fff8e1; border:1px solid #f0d060; border-radius:8px;">
          <h3 style="margin-top:0;">🔒 Term Ended</h3>
          <p>${data.message || "The term you were enrolled in has ended."}</p>
          <a href="/student/terms/${data.termId}/reactivate" class="btn-view" style="text-decoration:none; display:inline-block; margin-top:10px;">
            🔓 Reactivate This Term
          </a>
        </div>`;
    } else {
      container.innerHTML = `<p>🔒 ${data.message || "This content is locked."}</p>`;
    }
  }

  function loadQuizInline(lessonId) {
    showLoading();
    fetch(`/student/lessons/${lessonId}/quiz`)
      .then(res => res.json())
      .then(data => {
        const container = document.getElementById("lessonMainArea");

        if (!data.success) {
          if (data.locked) {
            renderQuizLockNotice(container, data);
          } else {
            container.innerHTML = "<p>No quiz available.</p>";
          }
          hideLoading();
          return;
        }

        // ✅ If already submitted, show review
        if (data.alreadySubmitted) {
          window.quizReviewData = Array.isArray(data.reviewData)
            ? data.reviewData
            : [];

          window.currentReviewLesson = lessonId;
          // Reviewing an already-graded quiz later, not a fresh
          // submission — no "next lesson just unlocked" moment to show.
          window.lastQuizNextInfo = null;

          reviewQuestions =
            data.reviewData || [];

          reviewIndex = 0;

          renderReviewQuestion();
          // Render review if available
          if (window.quizReviewData.length > 0) {
            reviewQuestions =
              data.reviewData || [];

            reviewIndex = 0;

            renderQuizSummary();
          } else {
            document.getElementById(`quiz-review-${lessonId}`).innerHTML =
              "<p>No detailed review available.</p>";
          }

          return; // 🚀 stop here
        }

        quizQuestions = Array.isArray(data.questions)
          ? data.questions
          : [];

        if (quizQuestions.length === 0) {
          container.innerHTML =
            "<p>No quiz questions available.</p>";
          hideLoading();
          return;
        }

        quizAnswers = {};
        currentQuestionIndex = 0;
        currentQuizLessonId = lessonId;

        hideLoading();

        renderQuestion();
      })
      
      .catch(err => {
        console.error("❌ loadQuizInline error:", err);
        document.getElementById("lessonMainArea").innerHTML =
          "<p>Error loading quiz.</p>";
      });

  }

  function renderQuestion() {

    if (!quizQuestions.length) {
      document.getElementById("lessonMainArea").innerHTML =
        "<p>No quiz questions found.</p>";
      return;
    }

    const q =
      quizQuestions[currentQuestionIndex];

  const total =
    quizQuestions.length;

  const progress =
    ((currentQuestionIndex + 1) / total) * 100;

  const selectedAnswer =
    quizAnswers[q.id];

  const container =
    document.getElementById("lessonMainArea");

  container.innerHTML = `

  <div class="quiz-container">

    <div class="quiz-progress">
      <div
        class="quiz-progress-bar"
        style="width:${progress}%">
      </div>
    </div>

    <p>
      Question ${currentQuestionIndex + 1}
      of ${total}
    </p>

    <h2 class="quiz-question-title">
      ${q.question}
    </h2>

    <button
      onclick='speakQuestionWithOptions(
        ${JSON.stringify(q.question)},
        ${JSON.stringify(q.options)}
      )'
    >
      🔊 Read Question
    </button>

    <div class="quiz-options">

      ${q.options.map(option => `

        <div
          class="quiz-option ${
            selectedAnswer === option
              ? "selected"
              : ""
          }"

          onclick="selectAnswer(
            ${q.id},
            '${option.replace(/'/g, "\\'")}'
          )"

        >
          ${option}
        </div>

      `).join("")}

    </div>

    <div class="quiz-nav">

      <button
        class="quiz-btn quiz-btn-secondary"
        onclick="previousQuestion()"
        ${currentQuestionIndex === 0
          ? "disabled"
          : ""}
      >
        Previous
      </button>

      ${
        currentQuestionIndex === total - 1
        ?
        `
        <button
          class="quiz-btn quiz-btn-primary"
          onclick="submitQuizWizard()"
        >
          Submit Quiz
        </button>
        `
        :
        `
        <button
          class="quiz-btn quiz-btn-primary"
          onclick="nextQuestion()"
        >
          Next
        </button>
        `
      }

    </div>

  </div>
  `;
}

function renderQuizSummary() {

  const totalQuestions = reviewQuestions.length;

  const correctCount =
    reviewQuestions.filter(q => q.isCorrect).length;

  const wrongCount =
    totalQuestions - correctCount;

  const score =
    Math.round(
      (correctCount / totalQuestions) * 100
    );

  const lessonMain =
    document.getElementById("lessonMainArea");

  // Where "Next Lesson"/"Next Module" below should point — set by
  // submitQuizAnswers/submitQuizInline right after a fresh submission,
  // straight from the server's own unlock logic. Cleared before a later
  // read-only review of an already-graded quiz, so no stale button
  // shows there.
  const nextInfo = window.lastQuizNextInfo || {};

  const moduleUnlockedBanner = nextInfo.nextModuleUnlocked ? `
    <div style="background:linear-gradient(135deg, var(--brand-pri, #A17807), var(--brand-pri-dark, #4C3802)); color:#fff; border-radius:var(--radius-lg, 16px); padding:16px 20px; margin-bottom:18px; text-align:center; font-weight:700;">
      🎉 Module Complete — the next module is unlocked!
    </div>
  ` : "";

  const nextActionButton = nextInfo.nextModuleUnlocked
    ? `<button class="quiz-btn quiz-btn-primary" onclick="goToNextModule(${nextInfo.nextModuleId})">🎉 Next Module</button>`
    : nextInfo.nextLessonId
      ? `<button class="quiz-btn quiz-btn-primary" onclick="loadLessonPart(${nextInfo.nextLessonId}, 'content')">➡️ Next Lesson</button>`
      : "";

  lessonMain.innerHTML = `

  <div class="quiz-summary-container">

    ${moduleUnlockedBanner}

    <h2>📊 Quiz Summary</h2>

    <div class="quiz-summary-stats">

      <div class="summary-card">
        <h3>${score}%</h3>
        <p>Score</p>
      </div>

      <div class="summary-card">
        <h3>${correctCount}</h3>
        <p>Correct</p>
      </div>

      <div class="summary-card">
        <h3>${wrongCount}</h3>
        <p>Wrong</p>
      </div>

    </div>

    <h3>Question Map</h3>

    <div class="question-grid">
      ${reviewQuestions.map((q,index)=>{

        let cls = "wrong-box";

        if(!q.yourAnswer){
          cls = "skipped-box";
        }
        else if(q.isCorrect){
          cls = "correct-box";
        }

        return `
          <div
            class="question-box ${cls}"
            onclick="goToReviewQuestion(${index})"
          >
            ${index + 1}
          </div>
        `;
      }).join("")}

    </div>

    <div class="quiz-nav">

      <button
        class="quiz-btn quiz-btn-primary"
        onclick="startReview()"
      >
        Start Review
      </button>

      ${nextActionButton}

      <button
        class="quiz-btn quiz-btn-secondary"
        onclick="loadLessonPart(${currentQuizLessonId}, 'content')"
      >
        Back To Lesson
      </button>

    </div>

  </div>

  `;
}

// Full navigation (not an in-place fetch) — the target module's whole
// module+lesson sidebar needs a fresh server render to reflect the
// unlock that just happened, same as any other section=module load.
function goToNextModule(moduleId) {
  window.location.href = "/student/dashboard?section=module&moduleId=" + moduleId;
}

function selectAnswer(questionId, answer){

  quizAnswers[questionId] = answer;

  renderQuestion();
}

function startReview(){

  reviewIndex = 0;

  renderReviewQuestion();
}

function goToReviewQuestion(index){

  reviewIndex = index;

  renderReviewQuestion();
}

function nextQuestion(){

  const currentQuestion =
    quizQuestions[currentQuestionIndex];

  if(
    !quizAnswers[currentQuestion.id]
  ){
    showAlert(
      "Please select an answer."
    );
    return;
  }

  currentQuestionIndex++;

  renderQuestion();
}

function previousQuestion(){

  if(currentQuestionIndex > 0){

    currentQuestionIndex--;

    renderQuestion();
  }
}

function submitQuizAnswers(lessonId){
  sendLessonDuration(); // save previous
  showLoading(); // ⬅️ Start loading animation
  console.log("Submitting answers:", quizAnswers);

    fetch(`/student/lessons/${lessonId}/quiz/submit`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      lessonId: lessonId,
      answers: quizAnswers

    })
  })
    .then(async res => {
      // Parse the body regardless of status — a 403 (e.g. term ended)
      // still carries a real JSON message/locked payload we want to show,
      // not just a generic failure.
      let body;
      try {
        body = await res.json();
      } catch (e) {
        body = { success: false, message: "Server did not respond correctly." };
      }
      return body;
    })
    .then(result => {
      // ⭐ Small delay ensures backend finishes grading before displaying
      return new Promise(resolve => setTimeout(() => resolve(result), 300));
    })
    .then(result => {
      hideLoading(); // ⬅️ Stop loading animation

      const quizContainer =
        document.getElementById(`quiz-area-${lessonId}`) ||
        document.getElementById("lessonMainArea");

      if (!result.success) {
        if (result.locked) {
          renderQuizLockNotice(quizContainer, result);
        } else {
          quizContainer.innerHTML =
            `<p class="error">❌ Quiz submission failed. ${result.message || ""}</p>`;
        }
        return;
      }

      showQuizCelebration(result.score, result.xpEarned);

      if (result.levelUp) {
        setTimeout(() => {
          showLevelUpCelebration(result.newLevelName);
        }, 900);
      }

      if (result.badgeAwarded) {
        setTimeout(() => {
          showBadgeCelebration(result.badgeName, result.badgeImage);
        }, 1200);
      }

    // 🎓 Course Certificate
    if (result.certificateAwarded) {
      setTimeout(() => {
        showCertificateCelebration(
          result.certificateUrl
        );
      }, 1500);
    }

    // 💭 Reflection prompt — last in the chain, entirely optional (Skip
    // closes it with no request sent; the endpoint itself also treats
    // both fields as optional either way).
    setTimeout(() => {
      showReflectionPrompt(lessonId);
    }, 1800);

      // The submission itself is already fully saved server-side at this
      // point — everything from here down is just building the follow-up
      // UI (review screen, next-lesson button, etc.), which used to be
      // inside the SAME try as the fetch. A DOM/rendering hiccup in here
      // would throw, get caught by the .catch() below, and overwrite the
      // screen with "Error submitting quiz" — misleading, since the quiz
      // had already submitted successfully (confirmed by the celebration
      // modal above already showing). Isolated in its own try/catch so a
      // display problem can never masquerade as a failed submission.
      try {
        // Save review data globally
        window.quizReviewData = result.reviewData;
        window.currentReviewLesson = lessonId;
        // Where "Next Lesson"/"Next Module" in the summary screen below
        // should point — comes straight from the server's unlock logic
        // (submitLessonQuiz), not guessed client-side.
        window.lastQuizNextInfo = {
          nextLessonId: result.nextLessonId || null,
          nextModuleUnlocked: !!result.nextModuleUnlocked,
          nextModuleId: result.nextModuleId || null,
        };
        if (result.nextLessonId) {
          unlockSidebarLesson(result.nextLessonId);
        }

        quizContainer.innerHTML = `
          <h3>Quiz Results</h3>
          <p><strong>Score:</strong> ${result.score}%</p>
          <p><strong>Status:</strong> ${result.passed ? "✅ Passed" : "❌ Failed"}</p>
          <div class="ai-feedback"><strong>🤖 AI Feedback Summary:</strong> ${result.feedback}</div>
          <hr>
          <h3>Detailed Review</h3>
          <div id="quiz-review-${lessonId}"></div>
          <button onclick="loadLessonPart(${lessonId}, 'content')">⬅ Back to Lesson</button>
        `;

        reviewQuestions = result.reviewData || [];
        reviewIndex = 0;

        renderQuizSummary();

        if (result.feedback) {
          pushMsg("AI Quiz Feedback: " + result.feedback, "bot");
        }
      } catch (renderErr) {
        console.error("Quiz saved, but the results screen failed to render:", renderErr);
      }
    })
    .catch(err => {
      hideLoading(); // ⬅️ Make sure spinner stops
      console.error("❌ Error submitting quiz:", err);

      const quizContainer =
        document.getElementById(`quiz-area-${lessonId}`) ||
        document.getElementById("lessonMainArea");

      quizContainer.innerHTML =
        `<p class="error">Error submitting quiz. Please try again.</p>`;
    });


}

function renderReviewQuestion(){

  const q =
    reviewQuestions[reviewIndex];

  const total =
    reviewQuestions.length;

  const lessonMain =
    document.getElementById(
      "lessonMainArea"
    );

  lessonMain.innerHTML = `

  <div class="quiz-container">

    <div class="quiz-progress">
      <div
        class="quiz-progress-bar"
        style="width:${
          ((reviewIndex + 1)
          / total) * 100
        }%">
      </div>
    </div>

    <h2>
      Review
      ${reviewIndex + 1}
      of
      ${total}
    </h2>

    <div class="quiz-question-card">

      <h3>
        ${q.question}
      </h3>

      <p>
        <strong>
          Your Answer:
        </strong>
        ${q.yourAnswer || "No answer"}
      </p>

      <p>
        <strong>
          Correct Answer:
        </strong>
        ${q.correctAnswer}
      </p>

      <p class="${
        q.isCorrect
          ? "correct"
          : "wrong"
      }">

        ${
          q.isCorrect
            ? "✅ Correct"
            : "❌ Wrong"
        }

      </p>

      <div class="ai-feedback">
        ${q.feedback || ""}
      </div>

    </div>

    <div class="quiz-nav">

      <button
        class="quiz-btn quiz-btn-secondary"
        onclick="renderQuizSummary()"
      >
        Quiz Summary
      </button>

      <button
        class="quiz-btn quiz-btn-secondary"
        onclick="prevReviewQuestion()"
        ${reviewIndex === 0
          ? "disabled"
          : ""}
      >
        Previous
      </button>

      <button
        class="quiz-btn quiz-btn-primary"
        onclick="nextReviewQuestion()"
        ${
          reviewIndex === total - 1
          ? "disabled"
          : ""
        }
      >
        Next
      </button>

    </div>

  </div>
  `;
}
 
function nextReviewQuestion(){

  if(
    reviewIndex <
    reviewQuestions.length - 1
  ){

    reviewIndex++;

    renderReviewQuestion();
  }
}

function prevReviewQuestion(){

  if(reviewIndex > 0){

    reviewIndex--;

    renderReviewQuestion();
  }
}

function speakQuestionWithOptions(question, options) {
    const fullText =
      question + ". Options are: " + options.join(", ");

    speakText(fullText);
  }


  function speakText(text) {
    if (!("speechSynthesis" in window)) {
      showAlert("Text-to-speech is not supported in this browser.");
      return;
    }

    // Stop any ongoing speech
    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = "en-US"; // change if needed
    utterance.rate = 1;      // 0.5–2
    utterance.pitch = 1.5;

    window.speechSynthesis.speak(utterance);
  }

let currentPendingAssignments = [];

