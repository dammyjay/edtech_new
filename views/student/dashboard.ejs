<%- include('../partials/header', { title: 'Dashboard' }) %>
<%- include("../partials/announcementPopup") %>

<button id="toggleSidebar" class="hamburger" style="margin-bottom: 20px">
  ☰
</button>

<div class="dashboard-container">

<aside class="sidebar">
  <div class="logo-title">
    <% if (info?.logo_url) { %>
      <a href="/"><img src="<%= info.logo_url %>" alt="Logo" /></a>
    <% } %>
    <p><%= (info?.company_name || 'JKT Hub').trim() %></p>
  </div>

  <hr>

  <div class="sidebar-header">
    <% if (profilePic) { %>
      <img src="<%= profilePic %>" alt="Profile Picture" class="profile-pic" />
    <% } else { %>
      <img src="/images/profile male.png" alt="Default Profile Picture" class="profile-pic" />
    <% } %>
    <h2 style="font-size: 14px;"><%= student.fullname %></h2>
  </div>

  <div class="dash-sect" style="border: #555; border-width: 1px; border-style: solid;">
    <h2 style="font-size: 14px; color: #e5f0ff; margin-bottom:2px;">🪙 Xp: <%= student.xp %> points</h2>
    <p style="font-size:12px; color:var(--brand-pri-light,#D9A82C); margin:0 0 4px; font-weight:700;">
      <%= levelInfo.name %> · Level <%= levelInfo.level %>
    </p>
    <% if (levelInfo.xpForNextLevel) { %>
      <div class="progress-bar" style="margin:0 0 10px; background:rgba(255,255,255,0.15);">
        <div class="filled" style="width: <%= levelInfo.progressPercent %>%;"></div>
      </div>
    <% } %>
    <h2 style="font-size: 14px; color: #e5f0ff;">
      <%= streak.currentStreak > 0 ? "🔥" : "💤" %> Streak: <%= streak.currentStreak %> day<%= streak.currentStreak === 1 ? "" : "s" %>
    </h2>
    <h2 style="font-size: 14px; color: #e5f0ff;">Wallet: ₦<%= walletBalance.toLocaleString() %></h2>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard">🏠 Dashboard</a></h2>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=profile">👤 My Profile</a></h2>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=progress">📊 My Progress</a></h2>
    <% if (role === 'student' && classroom) { %>
      <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=leaderboard">🏆 Leaderboard</a></h2>
      <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=peer-review">🔍 Peer Review</a></h2>
    <% } %>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=skill-tree">🗺️ Skill Tree</a></h2>
  </div>


    <div class="dash-sect" style="border: #555; border-width: 1px; border-style: solid;">
      <!-- Collapsible: School Info -->
      <% if (student.role === 'student' && school) { %>
          <button class="dropdown-btn">🏫 School Info ▾</button>
          <div class="dropdown-container">
            <% if (school.logo_url) { %>
              <img src="<%= school.logo_url %>" alt="School Logo" style="height:50px; margin-bottom:10px;">
            <% } %>
            <p><strong>School:</strong> <%= school.name %></p>
            <p><strong>Classroom:</strong> <%= classroom?.name || 'Not assigned yet' %></p>
            <p><strong>Teacher:</strong> <%= teacher?.fullname || 'Unassigned' %></p>
            <div style="margin-top:10px; display:flex; gap:10px; flex-wrap:wrap;">
              <a href="/student/dashboard?section=classroom" class="btn-view">👥 Classmates</a>
              <a href="/student/dashboard?section=teacher" class="btn-edit">👨‍🏫 Your Teacher</a>
              <a href="/student/dashboard?section=instructors" class="btn-edit">🧑🏽‍🔧 Instructors</a>
            </div>
          </div>
      <% } %>

      <!-- Collapsible: Parents -->

        <button class="dropdown-btn">👨‍👩‍👧 Parents ▾</button>
        <div class="dropdown-container">
          <% if (parents && parents.length > 0) { %>
            <ul>
              <% parents.forEach(parent => { %>
                <li><strong><%= parent.fullname %></strong> (<%= parent.email %>)</li>
              <% }) %>
            </ul>
          <% } else { %>
            <p>No parent linked yet.</p>
          <% } %>

          <% if (parentRequests && parentRequests.length > 0) { %>
            <h4>📩 Requests</h4>
            <ul>
              <% parentRequests.forEach(req => { %>
                <li>
                  <strong><%= req.parent_name %></strong> (<%= req.parent_email %>)
                  <form action="/student/parent-request/respond" method="POST" style="display:inline-flex; gap:6px;">
                    <input type="hidden" name="requestId" value="<%= req.id %>">
                    <button type="submit" name="action" value="approve">✅</button>
                    <button type="submit" name="action" value="reject">❌</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
   

      <!-- Collapsible: Pathways -->
  
      <button class="dropdown-btn">📂 My Pathways ▾</button>
      <!-- <h2><a class="dropdown-btn" href="">📂 My Pathways ▾</a></h2> -->
      <ul class="dropdown-container">
        <% Object.keys(pathwayCourses).forEach(pathway => { %>
          <li>
            <a href="/student/dashboard?pathway=<%= encodeURIComponent(pathway) %>">
              <%= pathway %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>

  <h2><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/admin/logout">🚪 Logout</a></h2>


</aside>

<!-- QUIZ CELEBRATION MODAL -->
<div id="quizCelebration" class="celebration-modal">
  <div class="celebration-content">
    <div class="confetti"></div>

    <h2>🎉 Congratulations!</h2>
    <p id="celebrationMessage"></p>

    <div class="xp-box">
      <h3>⭐ XP Earned</h3>
      <p id="xpEarnedText"></p>
    </div>

    <button onclick="closeCelebration()">Continue Learning ➜</button>
  </div>
</div>

<!-- QUIZ CELEBRATION MODAL -->
<div id="quizCelebration" class="celebration-modal">
  <div class="celebration-content">
    <div class="confetti"></div>

    <h2>🎉 Congratulations!</h2>
    <p id="celebrationMessage"></p>

    <div class="xp-box">
      <h3>⭐ XP Earned</h3>
      <p id="xpEarnedText"></p>
    </div>

    <button onclick="closeCelebration()">Continue Learning ➜</button>
  </div>
</div>

<!-- LEVEL UP MODAL -->
<div id="levelUpCelebration" class="celebration-modal">
  <div class="celebration-content badge-mode">
    <div class="confetti"></div>
    <h2>⬆️ Level Up!</h2>
    <div style="font-size:48px; margin:10px 0;">🎉</div>
    <h3 id="levelUpName"></h3>
    <button onclick="closeLevelUpCelebration()">Keep Going! 🚀</button>
  </div>
</div>

<!-- BADGE AWARD MODAL -->
<div id="badgeCelebration" class="celebration-modal">
  <div class="celebration-content badge-mode">
    <h2>🏅 Badge Unlocked!</h2>

    <div id="badgeVisual"></div>
    <h3 id="badgeName"></h3>

    <button onclick="closeBadgeCelebration()">Awesome! 🚀</button>
  </div>
</div>

<!-- CERTIFICATE CELEBRATION MODAL -->
<div id="certificateCelebration" class="celebration-modal">
  <div class="celebration-content certificate-mode">

    <div class="confetti"></div>

    <h2>🎓 Certificate Unlocked!</h2>

    <p id="certificateMessage">
      Congratulations! You have successfully completed this course.
    </p>

    <img id="certificatePreviewImg" src="" alt="Your certificate"
         style="max-width:100%; max-height:280px; object-fit:contain; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.15); margin:12px 0; cursor:pointer;"
         onclick="openCertificateLightbox(window.certificateUrl)" />

    <button onclick="openCertificateLightbox(window.certificateUrl)">
      🔍 View Full Certificate
    </button>

    <button onclick="closeCertificateCelebration()">
      Continue Learning
    </button>

  </div>
</div>

<!-- REFLECTION PROMPT MODAL — last in the post-quiz celebration chain,
     entirely optional (Skip sends nothing). -->
<div id="reflectionPrompt" class="celebration-modal">
  <div class="celebration-content" style="text-align:left;">
    <h2 style="text-align:center;">💭 Quick Reflection</h2>
    <p style="text-align:center; color:#666; font-size:13.5px;">Totally optional — takes 10 seconds.</p>
    <label style="font-size:13px; font-weight:600; display:block; margin:10px 0 4px;">What clicked for you?</label>
    <textarea id="reflectionWhatClicked" rows="2" style="width:100%; padding:8px; border-radius:8px; border:1px solid #ddd; font-family:inherit;"></textarea>
    <label style="font-size:13px; font-weight:600; display:block; margin:12px 0 4px;">What's still fuzzy?</label>
    <textarea id="reflectionStillFuzzy" rows="2" style="width:100%; padding:8px; border-radius:8px; border:1px solid #ddd; font-family:inherit;"></textarea>
    <div style="display:flex; gap:10px; margin-top:16px; justify-content:center;">
      <button onclick="closeReflectionPrompt()" style="background:#eee; color:#333;">Skip</button>
      <button onclick="submitReflectionPrompt()">Submit</button>
    </div>
  </div>
</div>

<!-- CERTIFICATE LIGHTBOX — a properly-sized, downloadable view. Both
     this modal AND the "My Certificates" grid thumbnails open it,
     instead of the old behavior of firing window.open() on the raw
     3504x2480px certificate image directly, which just dumped a huge
     image into a new tab that the browser auto-shrinks — unreadable
     without manually zooming in. -->
<div id="certificateLightbox" class="modal-overlay">
  <div class="modal-content" style="max-width:900px; text-align:center;">
    <span class="close" onclick="closeCertificateLightbox()">&times;</span>
    <img id="certificateLightboxImg" src="" alt="Certificate"
         style="width:100%; height:auto; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.15);" />
    <a id="certificateLightboxDownload" href="" download
       class="btn-view" style="display:inline-block; text-decoration:none; margin-top:16px;">
      ⬇️ Download Certificate
    </a>
  </div>
</div>

<!-- Pending Assignment modal -->

<div id="assignmentReminderModal" class="modal">
  <div class="modal-content">

    <h2>📘 Assignment Reminder</h2>

    <div id="assignmentList"></div>

    <div class="modal-buttons">
      <button onclick="goToAssignment()">
        Open Assignment
      </button>

      <button onclick="closeReminderModal()">
        Continue Lesson
      </button>
    </div>

  </div>
</div>

 <main class="main-content">
  
  <% if (section === 'profile') { %>
    <!-- 👤 PROFILE SECTION -->
    <div class="profile-container">
      <h2>👤 My Profile</h2>

      <div class="profile-card">
        <img src="<%= profilePic || '/images/profile male.png' %>" class="profile-pic-large" />
        <p><strong>Full Name:</strong> <%= student.fullname %></p>
        <p><strong>Gender:</strong> <%= student.gender %></p>
        <p><strong>Date of Birth:</strong> <%= student.dob ? student.dob.toISOString().split('T')[0] : 'N/A' %></p>
        <p style="color: rgb(0, 0, 0);">💰 Wallet: ₦<%= walletBalance.toLocaleString() %></p>
        <button class="btn-create" onclick="openEditModal('profile')">✏️ Edit Profile</button>
      </div>

      <!-- 🏅 Achievements -->
        <h3>🏅 Achievements</h3>
        <div class="achievements">
          <div class="achievement-item">
            <h4>🪙 XP Points</h4>
            <p><%= student.xp || 0 %> points</p>
          </div>

          <div class="achievement-item">
            <h4>📘 Courses Completed</h4>
            <p><%= completedCourses || 0 %></p>
          </div>

          <div class="achievement-item">
            <h4>📜 Certificates</h4>
            <p><%= certificatesCount || 0 %></p>
          </div>
        </div>

        <!-- 📜 Certificates Section -->
        <div class="certificates-section">
          <h3>📜 My Certificates</h3>

          <% if (certificates && certificates.length > 0) { %>
            <div class="certificates-grid">
              <% certificates.forEach(cert => { %>
                <div class="certificate-card">

                  <% if (cert.certificate_url) { %>
                    <img src="<%= cert.certificate_url %>"
                        alt="<%= cert.course_title %>"
                        class="certificate-img"
                        style="cursor:pointer;"
                        onclick="openCertificateLightbox('<%= cert.certificate_url %>')" />
                  <% } %>

                  <p class="certificate-title"><%= cert.course_title %></p>

                  <p class="certificate-date">
                    Issued: <%= new Date(cert.issued_at).toLocaleDateString() %>
                  </p>

                </div>

              <% }) %>
            </div>
          <% } else { %>
            <p class="no-certificates">
              No certificates yet. Complete courses to earn yours! 🎓
            </p>
          <% } %>
        </div>

      <div class="badges-section">
        <h3>🎖️ Badges Earned</h3>

        <% if (badges && badges.length > 0) { %>
          <div class="badges-grid">
            <% badges.forEach(b => { %>
              <div class="badge-card">
                <!-- Show badge image if exists -->
                <% if (b.badge_image) { %>
                  <a href="<%= b.badge_image %>" target="_blank">
                    <img src="<%= b.badge_image %>" alt="<%= b.badge_name %>" class="badge-img" />
                  </a>
                  
                <% } else { %>
                  <div class="badge-placeholder">🎖️</div>
                <% } %>

                <p class="badge-name"><%= b.badge_name %></p>
                <% if (b.module_title) { %>
                    <p class="badge-module">
                      📘 <strong>Module:</strong> <%= b.module_title %>
                    </p>
                <% } %>

                  <% if (b.course_title) { %>
                    <p class="badge-course">
                      🎓 <strong>Course:</strong> <%= b.course_title %>
                    </p>
                  <% } %>
                <p class="badge-date">Awarded: <%= new Date(b.awarded_at).toLocaleDateString() %></p>

                <!-- Optional: show module title that earned this badge -->
                <% if (b.module_title) { %>
                  <p class="badge-module">Module: <%= b.module_title %></p>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="no-badges">No badges earned yet. Keep learning! 🚀</p>
        <% } %>
      </div>

      <!-- 🚀 Projects Section -->
      <div class="projects-section">
        <h3>🚀 My Projects</h3>

        <% 
          const hasProjects = Object.keys(courseProjects || {}).length > 0;
        %>

        <% if (hasProjects) { %>
          
          <div class="projects-grid">

            <% Object.keys(courseProjects).forEach(courseId => { %>

              <% courseProjects[courseId].forEach(project => { 
                  const submission = projectSubmissions[project.id];
              %>

                <div class="project-card">

                  <h4><%= project.title %></h4>

                  <% if (submission) { %>
                    <p class="project-status completed">
                      ✅ Submitted on 
                      <%= new Date(submission.submitted_at).toLocaleDateString() %>
                    </p>

                    <% if (submission.file_url) { %>
                      <a href="<%= submission.file_url %>" 
                        target="_blank" 
                        class="btn-view">
                        👁 View Submission
                      </a>
                    <% } %>

                  <% } else { %>
                    <p class="project-status pending">
                      ⏳ Not Submitted Yet
                    </p>
                  <% } %>

                </div>

              <% }) %>

            <% }) %>

          </div>

        <% } else { %>
          <p>No projects assigned yet. Keep learning! 🚀</p>
        <% } %>
      </div>


    </div>

    <!-- Student edit profile modal -->
    <div id="editModal-profile" class="modal" style="display:none;">
      <div class="modal-content">

        <span class="close-modal" onclick="closeEditModal('profile')">&times;</span>

        <h2>Edit Profile</h2>

        <form action="/student/profile/edit" method="POST" enctype="multipart/form-data">

          <input type="hidden" name="student_id" value="<%= student.id %>" />

          <label>Full Name:</label>
          <input type="text" name="fullname" value="<%= student.fullname %>" disabled>

          <label>Gender:</label>
          <select name="gender" required>
            <option value="">Select Gender</option>
            <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= student.gender === 'Other' ? 'selected' : '' %>>Other</option>
          </select>

          <label>Date of Birth:</label>
          <input type="date" name="dob"
          value="<%= student.dob ? student.dob.toISOString().split('T')[0] : '' %>">

          <label>Profile Picture:</label>
          <input type="file" name="profile_picture" accept=".jpg,.jpeg,.png">

          <hr>

          <h3>🔑 Change Password</h3>

          <label>Current Password</label>
          <input type="password" name="current_password">

          <label>New Password</label>
          <input type="password" name="new_password">

          <label>Confirm New Password</label>
          <input type="password" name="confirm_password">

          <button type="submit">Update Profile</button>

        </form>

      </div>
    </div>


  <% } else if (section === 'progress') { %>

    <div class="progress-container">

      <h2>📊 My Learning Progress</h2>

      <!-- SUMMARY CARDS -->
      <div class="stats-boxes">
        <div class="stat-box light-blue">
          <h4>📘 Courses</h4>
          <p><%= enrolledCourses.length %></p>
        </div>

        <div class="stat-box light-green">
          <h4>✅ Completed</h4>
          <p><%= completedCourses %></p>
        </div>

        <div class="stat-box light-yellow" onclick="openBadgeModal()">
          <h4>🏅 Badges</h4>
          <p><%= badges.length %></p>
          <small style="cursor:pointer;">View All ➜</small>
        </div>

        <div class="stat-box light-grey" onclick="openCertificateModal()">
          <h4>📜 Certificates</h4>
          <p><%= certificatesCount %></p>
          <small style="cursor:pointer;">View All ➜</small>
        </div>

        <% if (typeof progressDetail !== 'undefined' && progressDetail && progressDetail.quizAvg !== null) { %>
          <div class="stat-box light-pink">
            <h4>🧠 Quiz Average</h4>
            <p><%= progressDetail.quizAvg %>%</p>
          </div>
        <% } %>

        <% if (typeof progressDetail !== 'undefined' && progressDetail && progressDetail.assignmentAvg !== null) { %>
          <div class="stat-box light-blue">
            <h4>📝 Assignment Average</h4>
            <p><%= progressDetail.assignmentAvg %>%</p>
          </div>
        <% } %>
      </div>

          <!-- BADGE MODAL -->
        <div id="badgeModal" class="modal">
          <div class="modal-content">
            <span class="close" onclick="closeBadgeModal()">&times;</span>
            <h3>🏅 Your Badges</h3>

            <% if (badges && badges.length > 0) { %>
              <div class="badges-grid">
                <% badges.forEach(b => { %>
                  <div class="badge-card">
                    <div class="badge-icon">
                      <% if (b.badge_name === 'Beginner') { %> 🥉
                      <% } else if (b.badge_name === 'Intermediate') { %> 🥈
                      <% } else if (b.badge_name === 'Advanced') { %> 🥇
                      <% } else if (b.badge_name === 'Master') { %> 👑
                      <% } else { %> 🎖️
                      <% } %>
                    </div>
                    <p class="badge-name"><%= b.badge_name %></p>
                    <p class="badge-date">Awarded: <%= new Date(b.awarded_at).toLocaleDateString() %></p>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p>You haven’t earned any badges yet. Keep learning! 🚀</p>
            <% } %>
          </div>
        </div>

            <!-- Certificate MODAL -->
        <div id="certificateModal" class="modal">
          <div class="modal-content">
            <span class="close" onclick="closeCertificateModal()">&times;</span>
            <h3>🏅 Your Certificate</h3>

            <% if (certificates && certificates.length > 0) { %>
              <div class="certificates-grid">
                <% certificates.forEach(cert => { %>
                  <div class="certificate-card">
                    <% if (cert.certificate_url) { %>
                      <img src="<%= cert.certificate_url %>"
                          alt="<%= cert.course_title %>"
                          class="certificate-img"
                          style="cursor:pointer;"
                          onclick="openCertificateLightbox('<%= cert.certificate_url %>')" />
                    <% } %>

                    <p class="certificate-title"><%= cert.course_title %></p>

                    <p class="certificate-date">
                      Issued: <%= new Date(cert.issued_at).toLocaleDateString() %>
                    </p>

                  </div>

                <% }) %>
              </div>
            <% } else { %>
              <p class="no-certificates">
                No certificates yet. Complete courses to earn yours! 🎓
              </p>
            <% } %>
          </div>
        </div>

        <!-- PROJECT MODAL -->
        <div id="projectModal" class="modal">
          <div class="modal-content">
            <span class="close" onclick="closeProjectModal()">&times;</span>
            <h3>🚀 Your Course Projects</h3>

            <% 
              const hasProjects = Object.keys(courseProjects || {}).length > 0;
            %>

            <% if (hasProjects) { %>

              <% Object.keys(courseProjects).forEach(courseId => { %>
                
                <div class="project-course-section">
                  <% const projects = courseProjects[courseId]; %>

                  <% projects.forEach(project => { 
                      const submission = projectSubmissions[project.id];
                  %>

                    <div class="project-card">
                      <h4><%= project.title %></h4>
                      <!-- <p><%- project.description %></p>  -->

                      <% if (project.resource_url) { %>
                        <a href="<%= project.resource_url %>" target="_blank" class="btn-view">
                          📎 View Instructions
                        </a>
                      <% } %>

                      <% if (submission) { %>
                        <div class="project-submitted">
                          <p>✅ Submitted on 
                            <%= new Date(submission.submitted_at).toLocaleDateString() %>
                          </p>

                          <% if (submission.file_url) { %>
                            <a href="<%= submission.file_url %>" target="_blank" class="btn-view">
                              👁 View Submission
                            </a>
                          <% } %>

                          <% if (submission.notes) { %>
                            <p class="submission-notes">
                              📝 <%= submission.notes %>
                            </p>
                          <% } %>
                        </div>
                      <% } else { %>
                        <p class="not-submitted">❌ Not submitted yet</p>
                      <% } %>

                    </div>

                  <% }) %>

                </div>

              <% }) %>

            <% } else { %>
              <p>No projects assigned yet. Keep progressing! 🎯</p>
            <% } %>

          </div>
        </div>

      <!-- COURSE PROGRESS -->
      <div class="course-grid">

        <% enrolledCourses.forEach(course => { %>
          <a href="/student/dashboard?section=module&courseId=<%= course.id %>"
             class="course-card3" style="flex-direction: column; align-items: stretch;">

            <img src="<%= course.thumbnail_url || '/images/default-course.png' %>" style="width:100%; height:110px; border-radius: var(--radius, 10px);" />
            <div>
              <h4><%= course.title %></h4>
              <p><%= course.progress %>% complete</p>
            </div>

            <div class="progress-bar">
              <div class="filled" style="width: <%= course.progress %>%"></div>
            </div>

            <!-- Child-friendly encouragement, as a little badge/chip -->
            <% if (course.progress == 100) { %>
              <span style="display:inline-block; margin-top:8px; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; background:#eafaf1; color:#1e7e42; align-self:flex-start;">🎉 Course complete!</span>
            <% } else if (course.progress >= 50) { %>
              <span style="display:inline-block; margin-top:8px; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; background:#fff4e5; color:#b5651d; align-self:flex-start;">🔥 Doing great!</span>
            <% } else { %>
              <span style="display:inline-block; margin-top:8px; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; background:var(--brand-tint, #FBF3DD); color:var(--brand-pri-dark, #4C3802); align-self:flex-start;">💪 Keep going!</span>
            <% } %>

            <span class="btn-view" style="text-decoration:none; text-align:center; margin-top:12px; border-radius: var(--radius, 10px);">
              📖 View Course
            </span>

          </a>
        <% }) %>

      </div>

      <% if (typeof progressDetail !== 'undefined' && progressDetail && progressDetail.courses.length > 0) { %>
        <hr style="margin:30px 0;">
        <h3>🎮 My Learning Journey</h3>
        <p style="color:var(--text-secondary,#666); font-size:13px;">
          Tap a course, then a module, to see how each lesson went.
        </p>

        <div class="progress-breakdown">
          <% progressDetail.courses.forEach(course => { %>
            <details class="progress-course-card">
              <summary class="progress-course-header">
                <div class="progress-ring" style="--pct: <%= course.percent %>;">
                  <div class="progress-ring-inner"><%= course.percent %>%</div>
                </div>
                <div class="progress-course-info">
                  <span class="progress-course-title"><%= course.title %></span>
                  <span class="progress-course-sub">
                    <% if (course.totalModules > 0 && course.modulesComplete === course.totalModules) { %>
                      🏆 All modules mastered!
                    <% } else { %>
                      🧩 <%= course.modulesComplete %>/<%= course.totalModules %> modules mastered
                    <% } %>
                  </span>
                </div>
                <a class="report-download-btn" href="/student/courses/<%= course.id %>/report/download" onclick="event.stopPropagation()" title="Download course report">⬇️ PDF</a>
              </summary>

              <% if (course.modules.length > 0) { %>
                <div class="progress-module-list">
                  <% course.modules.forEach(mod => { %>
                    <details class="progress-module-card">
                      <summary class="progress-module-header">
                        <span class="progress-module-icon">
                          <%= mod.percent === 100 ? '🏆' : (mod.percent > 0 ? '📖' : '⭕') %>
                        </span>
                        <span class="progress-module-title"><%= mod.title %></span>
                        <span class="progress-module-percent"><%= mod.percent %>%</span>
                        <a class="report-download-btn report-download-btn-sm" href="/student/modules/<%= mod.id %>/report/download" onclick="event.stopPropagation()" title="Download module report">⬇️</a>
                      </summary>

                      <% if (mod.lessons.length > 0) { %>
                        <div class="progress-lesson-list">
                          <% mod.lessons.forEach(lesson => { %>
                            <div class="progress-lesson-row">
                              <span class="progress-lesson-status"><%= lesson.completed ? '✅' : '⭕' %></span>
                              <span class="progress-lesson-title"><%= lesson.title %></span>
                              <% if (lesson.quiz) { %>
                                <button type="button"
                                  class="progress-score-chip <%= lesson.quiz.score >= 80 ? 'score-great' : (lesson.quiz.score >= 60 ? 'score-good' : 'score-try-again') %>"
                                  onclick="openQuizResultModal(<%= lesson.quiz.submissionId %>)">
                                  <%= lesson.quiz.score >= 80 ? '🌟' : (lesson.quiz.score >= 60 ? '👍' : '💪') %> <%= lesson.quiz.score %>%
                                </button>
                              <% } %>
                            </div>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <p style="padding:8px 16px; color:var(--text-secondary,#666); font-size:12.5px;">No lessons yet in this module.</p>
                      <% } %>
                    </details>
                  <% }) %>
                </div>
              <% } else { %>
                <p style="padding:10px 16px; color:var(--text-secondary,#666); font-size:13px;">No modules yet for this course.</p>
              <% } %>
            </details>
          <% }) %>
        </div>
      <% } %>

      <!-- QUIZ RESULT MODAL -->
      <div id="quizResultModal" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeQuizResultModal()">&times;</span>
          <div id="quizResultBody">
            <p>Loading your result... ⏳</p>
          </div>
        </div>
      </div>

      <% if (typeof pastCourses !== 'undefined' && pastCourses.length > 0) { %>
        <hr style="margin:30px 0;">
        <h3>📚 Previous Courses <small style="font-weight:normal; color:#666;">(from an earlier term — view only)</small></h3>
        <p style="color:#666; font-size:13px;">
          These are courses from a classroom you were in before. Anything you already completed stays viewable — you just can't start anything new in them.
        </p>
        <div class="course-grid">
          <% pastCourses.forEach(course => { %>
            <div class="course-card3" style="flex-direction: column; opacity:0.85;">
              <img src="<%= course.thumbnail_url || '/images/default-course.png' %>" />
              <div>
                <h4>🔒 <%= course.title %></h4>
                <p><%= course.progress %>% completed</p>
              </div>

              <div class="progress-bar">
                <div class="filled" style="width: <%= course.progress %>%; background:#999;"></div>
              </div>

              <div>
                <p style="color:#888; font-size:13px;">Previous term — view only</p>
                <a href="/student/past-courses/<%= course.id %>" class="btn-view" style="text-decoration: none;">
                  👁 View What You Completed
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (typeof lockedTerms !== 'undefined' && lockedTerms.length > 0) { %>
        <hr style="margin:30px 0;">
        <h3>🔒 Locked Terms <small style="font-weight:normal; color:#666;">(term ended)</small></h3>
        <p style="color:#666; font-size:13px;">
          These terms have ended. Anything you already completed stays viewable, but unfinished lessons/quizzes are locked until the term is reactivated — pay from your wallet, or ask your school to reactivate it for you.
        </p>
        <% lockedTerms.forEach(term => { %>
          <div class="course-card3" style="flex-direction: column; opacity:0.9; margin-bottom:15px;">
            <div>
              <h4>🔒 <%= term.termName %></h4>
              <p style="color:#888; font-size:13px;">
                <%= term.courses.length %> course<%= term.courses.length === 1 ? '' : 's' %> with unfinished lessons
              </p>
              <ul style="margin:8px 0; padding-left:20px; font-size:13px; color:#555;">
                <% term.courses.forEach(course => { %>
                  <li><%= course.title %> — <%= course.completedLessons %>/<%= course.totalLessons %> lessons done</li>
                <% }) %>
              </ul>
              <p><strong>Reactivation price: ₦<%= term.totalPrice.toLocaleString() %></strong></p>
            </div>
            <div>
              <a href="/student/terms/<%= term.termId %>/reactivate" class="btn-view" style="text-decoration: none;">
                🔓 Reactivate This Term
              </a>
            </div>
          </div>
        <% }) %>
      <% } %>

    </div>


  <% } else if (section === 'classroom' && classroom) { %>
  <h2>👥 Your Classmates in <%= classroom.name %></h2>
  <% if (classmates.length > 0) { %>
    <div class="table-responsive">
      <table class="user-table sortable-table">
        <thead>
          <tr>
            <th>Profile</th>
            <th>Full Name</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% classmates.forEach(c => { %>
            <tr>
              <td>
                <img src="<%= c.profile_picture || '/images/profile male.png' %>" 
                    alt="Profile" 
                    style="width:40px; height:40px; border-radius:50%;">
              </td>
              <td><%= c.fullname %></td>
              <td><%= c.email %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div>
      <h3>💬 Class Chat</h3>

      <div id="classChatBox"
        style="border:1px solid #ccc;
        height:300px;
        overflow-y:auto;
        padding:10px;
        background:#fafafa;">
      </div>

      <textarea id="classMessage"
        placeholder="Message the class..."
        style="width:80%;margin-top:10px;">
      </textarea>

      <button onclick="sendClassMessage()">Send</button>

      <div id="warningModal" class="modal">
      <div class="modal-content">
        <h3>⚠ Message Blocked</h3>
        <p id="warningText"></p>
        <button onclick="closeWarning()">OK</button>
      </div>
    </div>
    </div>
  <% } else { %>
    <p>No classmates found in this classroom.</p>
  <% } %>

  <% } else if (section === 'teacher' && classroom) { %>
  <h2>👨‍🏫 Your Teacher(s) for <%= classroom.name %></h2>
  <% if (teachers.length > 0) { %>
    <div class="card-container">
      <% teachers.forEach(t => { %>
        <div class="card">
          <div class="card-header">
            <img src="<%= t.profile_picture || '/images/profile male.png' %>" 
                 alt="Teacher" 
                 class="card-avatar" style=" object-fit:contain;">
            <h3><%= t.fullname %></h3>
          </div>
          
          <div class="card-body">
            <p><strong>Email:</strong> <%= t.email %></p>
            <p><strong>Role:</strong> Teacher</p>

            <!-- 💬 Chat Button -->
            <button class="btn-chat" onclick="openChat('<%= t.id %>', '<%= t.fullname %>')">💬 Chat</button>

           
          </div>

        </div>
         <!-- Chat Modal -->
            <div id="chatModal-<%= t.id %>" class="chat-modal">
              <div class="chat-content">
                <span class="close-chat" onclick="closeChat('<%= t.id %>')">&times;</span>
                <h3>Chat with <%= t.fullname %></h3>
                <div class="chat-messages" id="chatMessages-<%= t.id %>"></div>
                <div class="chat-input">
                  <input type="text" id="chatInput-<%= t.id %>" placeholder="Type a message..." />
                  <button onclick="sendChat('<%= t.id %>')">Send</button>
                </div>
              </div>
            </div>
      <% }) %>
    </div>
  <% } else { %>
    <p>No teacher assigned to this classroom yet.</p>
  <% } %>

  <% } else if (section === 'instructors' && classroom) { %>
  <h2>🧑🏽‍🔧 Your Instructors for <%= classroom.name %></h2>
  <% if (instructors.length > 0) { %>
    <div class="card-container">
      <% instructors.forEach(i => { %>
        <div class="card">
          <div class="card-header">
            <img src="<%= i.profile_picture || '/images/profile male.png' %>" 
                 alt="Instructor" 
                 class="card-avatar" style="object-fit:contain;">
            <h3><%= i.fullname %></h3>
          </div>
        
           <div class="card-body">
              <p><strong>Email:</strong> <%= i.email %></p>
              <p><strong>Role:</strong> Instructor</p>

              <!-- 💬 Chat Button -->
              <button class="btn-chat" onclick="openChat('<%= i.id %>', '<%= i.fullname %>')">💬 Chat</button>

             
            </div>
        </div>
         <!-- Chat Modal -->
              <div id="chatModal-<%= i.id %>" class="chat-modal">
                <div class="chat-content">
                  <span class="close-chat" onclick="closeChat('<%= i.id %>')">&times;</span>
                  <h3>Chat with <%= i.fullname %></h3>
                  <div class="chat-messages" id="chatMessages-<%= i.id %>"></div>
                  <div class="chat-input">
                    <input type="text" id="chatInput-<%= i.id %>" placeholder="Type a message..." />
                    <button onclick="sendChat('<%= i.id %>')">Send</button>
                  </div>
                </div>
              </div>
      <% }) %>
    </div>
  <% } else { %>
    <p>No instructor assigned to this classroom yet.</p>
  <% } %>


  <% } else if (section === 'module') { %>
  <% if (moduleInfo) { %>
  <!-- LEARNING VIEW -->
  <div class="learning-container" id="learningContainer">
    <!-- Mini Sidebar -->


  <aside class="lesson-sidebar" id="lessonSidebar">
    <!-- Toggle Handle -->
    <div id="sidebarHandle" class="sidebar-handle">❮</div>

    <button id="focusModeBtn" class="focus-mode-btn" onclick="toggleFocusMode()">🎯 Focus Mode</button>
    <a href="/student/dashboard?section=module&courseId=<%= moduleInfo.course_id %>" style="display:inline-block; margin-bottom:10px; font-size:13px; text-decoration:none; color:var(--text-secondary,#666);">← Back to All Modules</a>
    <% Object.keys(courseModules).forEach(courseId => { %>
      <% courseModules[courseId].forEach(module => { %>
        <div class="module-block">
          <button style="text-align: left;" class="module-toggle no-bg" onclick="toggleModule(<%= module.id %>)">
           <span>📦 Module <%= module.order_number %> </span> <%= module.title %> ▾
          </button>

          <ul id="module-<%= module.id %>" class="lesson-list" style="display:none;">
            <% (moduleLessons[module.id] || []).forEach(lesson => { %>
              <li>
                

                <button id="lesson-toggle-<%= lesson.id %>" class="lesson-toggle no-bg"
                        onclick="handleLessonClick(<%= lesson.id %>, <%= lesson.unlocked %>, <%= !!lesson.termLocked %>)"
                        data-term-locked="<%= !!lesson.termLocked %>"
                        style="text-align: left; <%= lesson.unlocked ? '' : 'opacity:0.5; cursor:not-allowed;' %>">
                  <span id="lesson-icon-<%= lesson.id %>"><%= lesson.unlocked ? "📚" : "🔒" %></span> Lesson <%= lesson.order_number %>: <%= lesson.title.replace(/^lesson\s+\d+\s*[:.\-]?\s*/i, '') %><% if (lesson.termLocked) { %> <span style="color:#e67e22; font-size:12px;">⏳ term ended</span><% } %> ▾
                </button>

                <ul id="lesson-menu-<%= lesson.id %>" style="display:none; padding-left:15px;">
                  <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'video')">🎥 Video</button></li>
                  <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'content')">📝 Lesson Note</button></li>
                  <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'presentation')">📊 Slide Deck</button></li>
                  <li><button class="no-bg" onclick="loadLessonPart(<%= lesson.id %>, 'quiz')">📝 Quiz</button></li>
                </ul>

              </li>
            <% }) %>
            <h3>Assignments</h3>
            <% (moduleAssignments[module.id] || []).forEach(assign => { %>
              <li>
                <button 
                  class="no-bg assignment-btn"
                  data-id="<%= assign.id %>"
                  <%= assign.unlocked 
                        ? '' 
                        : 'disabled style="opacity:0.5; cursor:not-allowed;"' %>>
                  <%= assign.unlocked ? "📑" : "🔒" %> <%= assign.title %>
                </button>
              </li>
            <% }) %>
          </ul>

        </div>
      <% }) %>
    <% }) %>

  <h3>🏁 Final Project</h3>
  <% enrolledCourses.forEach(course => { %>
    <% if (courseFinalUnlocked[course.id]) { %>
      <% const projects = courseProjects[course.id] || []; %>
      <% projects.forEach(project => { %>
        <button onclick="loadProject(<%= project.id %>)">
          🎯 <%= project.title %>
        </button>
      <% }) %>
    <% } else { %>
      <p style="opacity:0.5;">🔒 Complete all modules to unlock the final project for <%= course.title %></p>
    <% } %>
  <% }) %>

  <% if (nextModuleId) { %>
    <a href="/student/dashboard?section=module&courseId=<%= moduleInfo.course_id %>&moduleId=<%= nextModuleId %>"
       class="btn-view" style="display:block; text-align:center; text-decoration:none; margin-top:16px;">
      ➡️ Next Module
    </a>
  <% } %>

  </aside>
    <!-- Lesson Content Area -->

 <div class="lesson-main-area" id="lessonMainArea">
  <p>Select a lesson to start learning.</p>

  </div>
<!-- Project Area (hidden by default) -->
  <div id="projectArea" style="display:none; padding: 15px;">
    <% enrolledCourses.forEach(course => { %>
      <h3>🏁 Projects for <%= course.title %></h3>

      <% const projects = courseProjects[course.id] || []; %>

      <% if (projects.length > 0) { %>
        <% projects.forEach(project => { %>
          <div class="project-card" style="padding: 15px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 8px;">
            <h4>🎯 <%= project.title %></h4>
            <p><%= project.description || "Complete this project after finishing all modules." %></p>
            <% if (project.due_date) { %>
              <p>⏰ Due: <%= new Date(project.due_date).toLocaleDateString() %></p>
            <% } %>

            <% 
              // Check if student has submitted this project
              const submission = projectSubmissions[project.id] || projectSubmissions[course.id];
            %>

            <% if (submission) { %>
              <p>✅ You submitted this project on <%= new Date(submission.submitted_at).toLocaleDateString() %></p>
              <a href="<%= submission.file_url %>" target="_blank">View Submission</a>
            <% } else { %>
              <form id="projectForm-<%= project.id %>" enctype="multipart/form-data" method="POST" action="/student/projects/submit">
                <input type="hidden" name="courseId" value="<%= course.id %>">
                <input type="hidden" name="projectId" value="<%= project.id %>">

                <label>Upload Project File:</label>
                <input type="file" name="projectFile" required />

                <label>Notes (optional):</label>
                <textarea name="notes" placeholder="Add any notes about your project"></textarea>

                <button type="submit" class="btn-submit">Submit Project</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <p>No projects available for this course yet.</p>
      <% } %>

    <% }) %>
  </div>



  <!-- AI TUTOR BOX -->
  <div id="ai-tutor" class="ai-tutor" style="display:none;">
    <div class="ai-tutor-header">
      🤖 <%= (info?.company_name || 'JKT Hub').trim() %> AI Tutor
      <div class="ai-controls">
        <button id="ai-fullscreen" class="ai-circle-btn">⛶</button>
        <button id="ai-toggle" class="ai-circle-btn">–</button>
      </div>
    </div>

    <div id="ai-messages" class="ai-messages"></div>

    <div class="ai-input-row">
      <input id="ai-question" type="text" placeholder="Ask about your lesson…" />
      <button id="ai-send">Send</button>
    </div>
  </div>

  <!-- FLOATING MINIMIZED ICON -->
  <div id="ai-float" class="ai-float" title="Open AI Tutor">🤖</div>

  </div>

  <% } else if (moduleGridModules && moduleGridModules.length) { %>
    <!-- MODULE GRID: every module in this course, pick one to open -->
    <div class="module-grid-view" style="padding:20px;">
      <a href="/student/dashboard?section=progress" style="display:inline-block; margin-bottom:14px; font-size:13px; text-decoration:none; color:var(--text-secondary,#666);">← Back to My Courses</a>
      <h2>📦 <%= moduleGridCourseTitle %> — All Modules</h2>
      <div class="course-grid">
        <% moduleGridModules.forEach(mod => { %>
          <% if (mod.unlocked) { %>
          <a href="/student/dashboard?section=module&courseId=<%= moduleGridCourseId %>&moduleId=<%= mod.id %>"
             class="course-card3" style="flex-direction:column; align-items:stretch;">
          <% } else { %>
          <div class="course-card3" style="flex-direction:column; align-items:stretch; opacity:0.6;">
          <% } %>
            <img src="<%= mod.thumbnail || '/images/JKT logo bg.png' %>" style="width:100%; height:100px; object-fit:contain; border-radius:var(--radius,10px); background:var(--brand-tint,#FBF3DD);" />
            <div>
              <h4>📦 Module <%= mod.order_number %>: <%= mod.title %></h4>
              <p><%= mod.progress %>% complete</p>
            </div>
            <div class="progress-bar"><div class="filled" style="width:<%= mod.progress %>%"></div></div>
            <% if (mod.unlocked) { %>
              <span class="btn-view" style="text-decoration:none; text-align:center; margin-top:12px; border-radius:var(--radius,10px);">📖 View Lessons</span>
            <% } else { %>
              <span class="btn-view" style="text-decoration:none; text-align:center; margin-top:12px; border-radius:var(--radius,10px); background:#999;">🔒 Locked</span>
            <% } %>
          <% if (mod.unlocked) { %></a><% } else { %></div><% } %>
        <% }) %>
      </div>
    </div>
  <% } else { %>
    <p style="padding:20px;">No modules found for this course yet.</p>
  <% } %>

  <% } else if (section === 'peer-review') { %>
    <div style="padding:20px; max-width:900px; margin:0 auto;">
      <h2>🔍 Peer Review</h2>
      <p style="color:var(--text-secondary,#666); font-size:14px;">Review your classmates' submitted projects, and see the reviews you've received.</p>

      <h3 style="margin-top:24px;">📥 Projects to Review</h3>
      <div id="reviewableProjectsList">
        <p style="color:#888;">Loading...</p>
      </div>

      <h3 style="margin-top:32px;">⭐ Reviews You've Received</h3>
      <div id="myReviewsList">
        <p style="color:#888;">Loading...</p>
      </div>
    </div>

  <% } else if (section === 'skill-tree') { %>
    <div style="padding:20px; max-width:1000px; margin:0 auto;">
      <h2>🗺️ Skill Tree</h2>
      <p style="color:var(--text-secondary,#666); font-size:14px;">Your path through each pathway, staged from Beginner to Advanced. Any course can be started anytime — this is just a map of where you've been and what's next.</p>

      <% if (!skillTreeData || !Object.keys(skillTreeData).length) { %>
        <p style="color:#888;">No pathways available yet.</p>
      <% } else { %>
        <% Object.keys(skillTreeData).forEach(pathwayTitle => { %>
          <div class="skill-tree-pathway">
            <h3 style="margin:28px 0 4px;"><%= pathwayTitle %></h3>
            <% ['Beginner', 'Intermediate', 'Advanced'].forEach((level, levelIdx) => {
                const stageCourses = skillTreeData[pathwayTitle][level];
                if (!stageCourses.length) return;
            %>
              <div class="skill-tree-stage">
                <div class="skill-tree-stage-label">
                  <span class="skill-tree-stage-dot"></span>
                  <%= level %>
                </div>
                <div class="skill-tree-nodes">
                  <% stageCourses.forEach(c => { %>
                    <a href="/courses/<%= c.id %>" class="skill-tree-node skill-tree-node--<%= c.state %>">
                      <% if (c.thumbnail_url) { %>
                        <img src="<%= c.thumbnail_url %>" alt="" class="skill-tree-node-thumb" />
                      <% } %>
                      <span class="skill-tree-node-title"><%= c.title %></span>
                      <% if (c.state === 'completed') { %>
                        <span class="skill-tree-node-badge">✅ Completed</span>
                      <% } else if (c.state === 'in-progress') { %>
                        <span class="skill-tree-node-badge"><%= c.progress %>% done</span>
                      <% } else if (c.state === 'not-started') { %>
                        <span class="skill-tree-node-badge">▶️ Start</span>
                      <% } else { %>
                        <span class="skill-tree-node-badge skill-tree-node-badge--muted">Not enrolled</span>
                      <% } %>
                    </a>
                  <% }) %>
                </div>
              </div>
              <% if (levelIdx < 2) { %>
                <div class="skill-tree-connector"></div>
              <% } %>
            <% }) %>
          </div>
        <% }) %>
      <% } %>
    </div>

    <style>
      .skill-tree-stage { display:flex; align-items:flex-start; gap:16px; }
      .skill-tree-stage-label {
        min-width:110px; display:flex; align-items:center; gap:6px;
        font-weight:700; font-size:13px; color:var(--brand-pri,#1c4e8a); padding-top:10px;
      }
