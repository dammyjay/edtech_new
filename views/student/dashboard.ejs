function showReflectionPrompt(lessonId) {
  reflectionLessonId = lessonId;
  document.getElementById("reflectionWhatClicked").value = "";
  document.getElementById("reflectionStillFuzzy").value = "";
  document.getElementById("reflectionPrompt").style.display = "flex";
}

function closeReflectionPrompt() {
  document.getElementById("reflectionPrompt").style.display = "none";
}

async function submitReflectionPrompt() {
  const what_clicked = document.getElementById("reflectionWhatClicked").value.trim();
  const still_fuzzy = document.getElementById("reflectionStillFuzzy").value.trim();
  closeReflectionPrompt();
  if (!what_clicked && !still_fuzzy) return; // nothing to save
  try {
    await fetch(`/student/lessons/${reflectionLessonId}/reflect`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ what_clicked, still_fuzzy }),
    });
  } catch (err) {
    console.error("Failed to save reflection:", err);
  }
}

async function loadReviewableProjects() {
  const container = document.getElementById("reviewableProjectsList");
  if (!container) return;
  try {
    const res = await fetch("/labs/peer-review/reviewable");
    const data = await res.json();
    if (!data.success || !data.projects.length) {
      container.innerHTML = "<p style='color:#888;'>No projects to review right now.</p>";
      return;
    }
    container.innerHTML = data.projects.map(p => `
      <div class="project-card" style="margin-bottom:12px; padding:14px; border:1px solid #eee; border-radius:10px;">
        <h4 style="margin:0 0 6px;">${escapeHtml(p.project_name || p.lab_type)}</h4>
        <p style="margin:0 0 8px; color:#666; font-size:13px;">By ${escapeHtml(p.student_name)}</p>
        ${p.already_reviewed
          ? `<p style="color:#2a9d5c; font-size:13px;">✅ You already reviewed this</p>`
          : `<div>
              <select id="rating-${p.id}" style="margin-right:8px; padding:4px;">
                <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                <option value="4">⭐⭐⭐⭐ (4)</option>
                <option value="3">⭐⭐⭐ (3)</option>
                <option value="2">⭐⭐ (2)</option>
                <option value="1">⭐ (1)</option>
              </select>
              <br/>
              <textarea id="comment-${p.id}" rows="2" placeholder="Leave a comment (optional)" style="width:100%; margin-top:6px; padding:6px; border-radius:6px; border:1px solid #ddd;"></textarea>
              <button onclick="submitProjectReview(${p.id})" style="margin-top:6px;">Submit Review</button>
            </div>`
        }
      </div>
    `).join("");
  } catch (err) {
    console.error("Failed to load reviewable projects:", err);
    container.innerHTML = "<p style='color:#c00;'>Failed to load projects.</p>";
  }
}

async function submitProjectReview(projectId) {
  const rating = document.getElementById(`rating-${projectId}`).value;
  const comment = document.getElementById(`comment-${projectId}`).value.trim();
  try {
    const res = await fetch("/labs/peer-review/submit", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ projectId, rating, comment }),
    });
    const data = await res.json();
    if (!data.success) {
      alert(data.message || "Could not submit review");
      return;
    }
    loadReviewableProjects();
  } catch (err) {
    console.error("Failed to submit review:", err);
  }
}

async function loadMyReviews() {
  const container = document.getElementById("myReviewsList");
  if (!container) return;
  try {
    const res = await fetch("/labs/peer-review/mine");
    const data = await res.json();
    if (!data.success || !data.reviews.length) {
      container.innerHTML = "<p style='color:#888;'>No reviews yet.</p>";
      return;
    }
    container.innerHTML = data.reviews.map(r => `
      <div style="margin-bottom:12px; padding:14px; border:1px solid #eee; border-radius:10px;">
        <p style="margin:0 0 4px;">${"⭐".repeat(r.rating)} <strong>${escapeHtml(r.project_name || r.lab_type)}</strong></p>
        ${r.comment ? `<p style="margin:0 0 4px; color:#444;">"${escapeHtml(r.comment)}"</p>` : ""}
        <p style="margin:0; color:#888; font-size:12px;">— ${escapeHtml(r.reviewer_name)}</p>
      </div>
    `).join("");
  } catch (err) {
    console.error("Failed to load my reviews:", err);
    container.innerHTML = "<p style='color:#c00;'>Failed to load reviews.</p>";
  }
}

document.addEventListener("DOMContentLoaded", () => {
  loadReviewableProjects();
  loadMyReviews();
});

