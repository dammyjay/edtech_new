    function sendLessonDuration() {
      if (!lessonStartTime || !currentActivityId) return;

      const endTime = Date.now();
      const duration = Math.max(1, Math.floor((endTime - lessonStartTime) / 1000));

      fetch("/student/lesson-time", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          activityId: currentActivityId,
          duration,
          endTime
        })
      });

      lessonStartTime = null;
      currentActivityId = null;
    }

  window.addEventListener("beforeunload", sendLessonDuration);

