<!-- toggle lesson sidebar -->
<script>
  const lessonsidebar = document.getElementById("lessonSidebar");
  const handle = document.getElementById("sidebarHandle");

  function isMobile() {
    return window.innerWidth <= 600;
  }

  // The lesson sidebar only renders when section === 'module' (viewing a
  // lesson) — on every other dashboard section lessonsidebar/handle are null.
  if (lessonsidebar && handle) {

  // Restore saved desktop state only
  if (!isMobile()) {
    const isSavedCollapsed = localStorage.getItem("lessonSidebarCollapsed") === "true";

    if (isSavedCollapsed) {
      lessonsidebar.classList.add("collapsed");
      handle.innerHTML = "❯";
    }
  }

  handle.addEventListener("click", () => {

    if (isMobile()) {
      // MOBILE BEHAVIOR (overlay slide)
      lessonsidebar.classList.toggle("mobile-open");

    } else {
      // DESKTOP BEHAVIOR (collapse width)
      lessonsidebar.classList.toggle("collapsed");

      const isCollapsed = lessonsidebar.classList.contains("collapsed");
      handle.innerHTML = isCollapsed ? "❯" : "❮";

      localStorage.setItem("lessonSidebarCollapsed", isCollapsed);
    }

  });

  // Optional: Auto close sidebar after clicking lesson on mobile
  document.addEventListener("click", function(e) {
    if (isMobile()) {
      if (e.target.closest(".lesson-toggle") ||
          e.target.closest(".module-toggle") ||
          e.target.closest(".assignment-btn")) {

        lessonsidebar.classList.remove("mobile-open");
      }
    }
  });

  // Handle window resize (important)
  window.addEventListener("resize", () => {
    if (!isMobile()) {
      lessonsidebar.classList.remove("mobile-open");
    }
  });

  }
</script>

<!-- Focus Mode toggle — deliberately its OWN script tag, not appended to
     the sidebar-collapse script above: that one starts with
     document.getElementById("lessonSidebar") unguarded and throws on
     every page that isn't the learning view once a sidebar-collapsed
     preference is saved, which would silently prevent anything placed
     after it in the SAME block from ever registering. A separate tag
     runs independently regardless of what happens in that one. -->
<script>
  const learningContainer = document.getElementById("learningContainer");
  const focusModeBtn = document.getElementById("focusModeBtn");
  if (learningContainer && focusModeBtn) {
    if (localStorage.getItem("focusMode") === "true") {
      learningContainer.classList.add("focus-mode");
      focusModeBtn.classList.add("active");
    }
    window.toggleFocusMode = function () {
      const isOn = learningContainer.classList.toggle("focus-mode");
      focusModeBtn.classList.toggle("active", isOn);
      localStorage.setItem("focusMode", isOn);
    };
  }
</script>

