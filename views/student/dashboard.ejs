function showQuizCelebration(score, xp) {
  const modal = document.getElementById("quizCelebration");
  document.getElementById("celebrationMessage").innerHTML =
    `You completed this quiz with <strong>${score}%</strong> 🎯`;

  document.getElementById("xpEarnedText").innerHTML =
    `+${xp} XP`;

  modal.style.display = "flex";
}

function closeCelebration() {
  document.getElementById("quizCelebration").style.display = "none";
}


function showBadgeCelebration(name, image) {
  const modal = document.getElementById("badgeCelebration");

  document.getElementById("badgeName").innerText =
    name || "Module Completed! 🎉";

  document.getElementById("badgeVisual").innerHTML =
    image
      ? `<img src="${image}" width="80">`
      : `<div style="font-size:60px;">🏅</div>`;

  modal.style.display = "flex";
}

function closeBadgeCelebration() {
