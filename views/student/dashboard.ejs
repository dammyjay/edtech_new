<!-- script to send and receive chat messages -->

<script>

/* =========================
   OPEN / CLOSE PRIVATE CHAT
========================= */

function openChat(teacherId){
  document.getElementById(`chatModal-${teacherId}`).style.display='block'
  loadPrivateMessages(teacherId)
}

function closeChat(teacherId){
  document.getElementById(`chatModal-${teacherId}`).style.display='none'
}


/* =========================
   SEND PRIVATE MESSAGE
========================= */

async function sendChat(teacherId){

  const input=document.getElementById(`chatInput-${teacherId}`)
  const message=input.value.trim()

  if(!message) return

  const res = await fetch('/student/chat/send',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      receiverId:teacherId,
      message
    })
  })

  const data = await res.json()

  if(!data.success){
    showWarning(data.message)
    return
  }

  input.value=""
  loadPrivateMessages(teacherId)

}


/* =========================
   LOAD PRIVATE MESSAGES
========================= */

async function loadPrivateMessages(teacherId){

  const res=await fetch(`/student/chat/messages/${teacherId}`)
  const messages=await res.json()

  const container=document.getElementById(`chatBox-${teacherId}`)

  if(!container) return

  container.innerHTML=""

  messages.forEach(msg=>{

    const div=document.createElement("div")

    const avatar = msg.profile_picture
      ? `<img src="${msg.profile_picture}" class="chat-avatar">`
      : `<img src="/images/profile male.png" class="chat-avatar">`

    div.className="chat-msg"

    div.innerHTML=`

      <div class="chat-row">

        ${avatar}

        <div>

          <div class="chat-name">
            ${msg.fullname}

            <span class="chat-role role-${msg.role}">
              ${msg.role}
            </span>
          </div>

          <div class="chat-bubble msg-${msg.role}">
            ${msg.message}

            <br>

            <small style="color:gray;font-size:10px;">
              ${new Date(msg.created_at).toLocaleTimeString()}
            </small>
          </div>

        </div>

      </div>
    `

    container.appendChild(div)

  })

  container.scrollTop = container.scrollHeight

}


/* =========================
   CLASS CHAT SYSTEM
========================= */

const classroomId = "<%= classroom ? classroom.id : '' %>"


async function sendClassMessage(){

  if(!classroomId) return

  const input=document.getElementById("classMessage")
  const message=input.value.trim()

  if(!message) return

  const res=await fetch('/student/class/send',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      classroomId,
      message
    })
  })

  const data=await res.json()

  if(!data.success){
    await showAlert(data.message)
    showWarning(data.message)
    return
  }

  input.value=""

  loadClassMessages()

}


async function loadClassMessages(){

  if(!classroomId) return

  const res=await fetch(`/student/class/messages/${classroomId}`)
  const messages=await res.json()

  const container=document.getElementById("classChatBox")

  if(!container) return

  container.innerHTML=""

  messages.forEach(msg=>{

    const div=document.createElement("div")

    const avatar = msg.profile_picture
      ? `<img src="${msg.profile_picture}" class="chat-avatar">`
      : `<img src="/images/profile male.png" class="chat-avatar">`

    div.className="chat-msg"

    div.innerHTML=`

      <div class="chat-row">

        ${avatar}

        <div>

          <div class="chat-name">

            ${msg.fullname}

            <span class="chat-role role-${msg.role}">
              ${msg.role}
            </span>

          </div>

          <div class="chat-bubble msg-${msg.role}">

            ${msg.message}

            <br>

            <small style="color:gray;font-size:10px;">
              ${new Date(msg.created_at).toLocaleTimeString()}
            </small>

          </div>

        </div>

      </div>

    `

    container.appendChild(div)

  })

  container.scrollTop = container.scrollHeight

}

function showWarning(msg){

  document.getElementById("warningText").innerText = msg
  document.getElementById("warningModal").style.display="block"

}

function closeWarning(){
  document.getElementById("warningModal").style.display="none"
}

/* =========================
   AUTO REFRESH
========================= */

if(classroomId){
  loadClassMessages()
  setInterval(loadClassMessages,5000)
}

</script>

<!-- styling for AI tutor -->
<style>
  .chat-modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1000; }
  .chat-content { background:#fff; border-radius:8px; width:400px; max-width:90%; margin:80px auto; padding:15px; position:relative; }
  .chat-messages { max-height:300px; overflow-y:auto; border:1px solid #ddd; padding:10px; margin-bottom:10px; }
  .chat-bubble { margin:6px 0; padding:8px 10px; border-radius:10px; max-width:70%; }
  .chat-bubble.self { background:#e5f0ff; align-self:flex-end; margin-left:auto; }
  .chat-bubble.other { background:#f1f1f1; align-self:flex-start; }
  .chat-input { display:flex; gap:6px; }
  .chat-input input { flex:1; padding:6px 10px; }
  .close-chat { position:absolute; top:8px; right:10px; cursor:pointer; font-size:20px; }
</style>

<!-- Badge modal -->
<script>
  function openBadgeModal() {
    document.getElementById("badgeModal").style.display = "block";
  }
  function closeBadgeModal() {
    document.getElementById("badgeModal").style.display = "none";
  }

  function openCertificateModal() {
    document.getElementById("certificateModal").style.display = "block"
  }

  function closeCertificateModal() {
    document.getElementById("certificateModal").style.display = "none"
  }

  function openProjectModal() {
    document.getElementById("projectModal").style.display = "block";
  }

  function closeProjectModal() {
    document.getElementById("projectModal").style.display = "none";
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str == null ? "" : String(str);
    return div.innerHTML;
  }

  async function openQuizResultModal(submissionId) {
    const modal = document.getElementById("quizResultModal");
    const body = document.getElementById("quizResultBody");
    body.innerHTML = "<p>Loading your result... ⏳</p>";
    modal.style.display = "block";

    try {
      const res = await fetch(`/student/quizzes/submission/${submissionId}`);
      const data = await res.json();
      if (!data.success) {
        body.innerHTML = "<p>Couldn't load this result — try again in a bit.</p>";
        return;
      }
      const sub = data.submission;
      let review = [];
      try {
        review = typeof sub.review_data === "string" ? JSON.parse(sub.review_data) : (sub.review_data || []);
      } catch (e) {
        review = [];
      }

      const scoreClass = sub.score >= 80 ? "score-great" : (sub.score >= 60 ? "score-good" : "score-try-again");
      const scoreEmoji = sub.score >= 80 ? "🌟" : (sub.score >= 60 ? "👍" : "💪");
      const bannerText = sub.passed
        ? "Great job, you passed! 🎉"
        : "Nice try — a little more practice and you'll get it! 💪";

      let html = `
        <div class="quiz-result-header">
          <div class="quiz-result-score-ring ${scoreClass}">${sub.score}%</div>
          <div style="flex:1;">
            <h3 style="margin:0 0 4px;">${escapeHtml(sub.lesson_title)}</h3>
            <p style="margin:0; color:var(--text-secondary,#666); font-size:13px;">${escapeHtml(sub.module_title)} · ${escapeHtml(sub.course_title)}</p>
            <p class="quiz-result-banner">${scoreEmoji} ${bannerText}</p>
          </div>
          <a class="report-download-btn" href="/student/quizzes/${submissionId}/report/download" title="Download as PDF">⬇️ PDF</a>
        </div>
        <h4 style="margin:20px 0 10px;">📝 Question by Question</h4>
      `;

      if (review && review.length) {
        review.forEach((q) => {
          html += `
            <div class="quiz-review-card ${q.isCorrect ? 'quiz-review-correct' : 'quiz-review-wrong'}">
              <p class="quiz-review-question">${escapeHtml(q.question)}</p>
              <p><strong>Your answer:</strong> ${escapeHtml(q.yourAnswer || "No answer")}</p>
              ${!q.isCorrect ? `<p><strong>Correct answer:</strong> ${escapeHtml(q.correctAnswer)}</p>` : ""}
              <p class="quiz-review-status">${q.isCorrect ? "✅ Correct!" : "❌ Not quite"}</p>
              ${q.feedback ? `<div class="quiz-review-feedback">🤖 ${escapeHtml(q.feedback)}</div>` : ""}
            </div>
          `;
        });
      } else {
        html += '<p style="color:var(--text-secondary,#666);">No detailed breakdown available for this quiz.</p>';
      }

      body.innerHTML = html;
    } catch (e) {
      body.innerHTML = "<p>Something went wrong loading this result.</p>";
    }
  }

  function closeQuizResultModal() {
    document.getElementById("quizResultModal").style.display = "none";
  }

  window.onclick = function(event) {
    const modal = document.getElementById("badgeModal");
    const certModal = document.getElementById("certificateModal");
    const projectModal = document.getElementById("projectModal");
    const quizResultModal = document.getElementById("quizResultModal");
    if (event.target === modal) modal.style.display = "none";
    if (event.target === certModal) certModal.style.display = "none";
    if (event.target === projectModal) projectModal.style.display = "none"
    if (event.target === quizResultModal) quizResultModal.style.display = "none";
  };
</script>

