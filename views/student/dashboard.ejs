<%- include('../partials/header', { title: 'Dashboard' }) %>

<button id="toggleSidebar" class="hamburger" style="margin-bottom: 20px">
  ☰
</button>

<div class="dashboard-container">

<aside class="sidebar">
  <div class="logo-title">
    <% if (info?.logo_url) { %>
      <a href="/"><img src="<%= info.logo_url %>" alt="Logo" /></a>
    <% } %>
    <p><%= info?.company_name || 'C&S Church Online' %></p>
  </div>

  <hr>

  <div class="sidebar-header">
    <% if (profilePic) { %>
      <img src="<%= profilePic %>" alt="Profile Picture" class="profile-pic" />
    <% } else { %>
      <img src="/images/profile male.png" alt="Default Profile Picture" class="profile-pic" />
    <% } %>
    <h2 style="font-size: 14px;"><%= student.fullname %></h2>
  </div>

  <div class="dash-sect" style="border: #555; border-width: 1px; border-style: solid;">
    <h2 style="font-size: 14px; color: #e5f0ff;">🪙 Xp: <%= student.xp %> points</h2>
    <h2 style="font-size: 14px; color: #e5f0ff;">Wallet: ₦<%= walletBalance.toLocaleString() %></h2>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard">🏠 Dashboard</a></h2>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=profile">👤 My Profile</a></h2>
    <h2 ><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/student/dashboard?section=progress">📊 My Progress</a></h2>
  </div>


    <div class="dash-sect" style="border: #555; border-width: 1px; border-style: solid;">
      <!-- Collapsible: School Info -->
      <% if (student.role === 'student' && school) { %>
          <button class="dropdown-btn">🏫 School Info ▾</button>
          <div class="dropdown-container">
            <% if (school.logo_url) { %>
              <img src="<%= school.logo_url %>" alt="School Logo" style="height:50px; margin-bottom:10px;">
            <% } %>
            <p><strong>School:</strong> <%= school.name %></p>
            <p><strong>Classroom:</strong> <%= classroom?.name || 'Not assigned yet' %></p>
            <p><strong>Teacher:</strong> <%= teacher?.fullname || 'Unassigned' %></p>
            <div style="margin-top:10px; display:flex; gap:10px; flex-wrap:wrap;">
              <a href="/student/dashboard?section=classroom" class="btn-view">👥 Classmates</a>
              <a href="/student/dashboard?section=teacher" class="btn-edit">👨‍🏫 Your Teacher</a>
              <a href="/student/dashboard?section=instructors" class="btn-edit">🧑🏽‍🔧 Instructors</a>
            </div>
          </div>
      <% } %>

      <!-- Collapsible: Parents -->

        <button class="dropdown-btn">👨‍👩‍👧 Parents ▾</button>
        <div class="dropdown-container">
          <% if (parents && parents.length > 0) { %>
            <ul>
              <% parents.forEach(parent => { %>
                <li><strong><%= parent.fullname %></strong> (<%= parent.email %>)</li>
              <% }) %>
            </ul>
          <% } else { %>
            <p>No parent linked yet.</p>
          <% } %>

          <% if (parentRequests && parentRequests.length > 0) { %>
            <h4>📩 Requests</h4>
            <ul>
              <% parentRequests.forEach(req => { %>
                <li>
                  <strong><%= req.parent_name %></strong> (<%= req.parent_email %>)
                  <form action="/student/parent-request/respond" method="POST" style="display:inline-flex; gap:6px;">
                    <input type="hidden" name="requestId" value="<%= req.id %>">
                    <button type="submit" name="action" value="approve">✅</button>
                    <button type="submit" name="action" value="reject">❌</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
   

      <!-- Collapsible: Pathways -->
  
      <button class="dropdown-btn">📂 My Pathways ▾</button>
      <!-- <h2><a class="dropdown-btn" href="">📂 My Pathways ▾</a></h2> -->
      <ul class="dropdown-container">
        <% Object.keys(pathwayCourses).forEach(pathway => { %>
          <li>
            <a href="/student/dashboard?pathway=<%= encodeURIComponent(pathway) %>">
              <%= pathway %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>

  <h2><a style="text-decoration: none; font-size: 14px; color: #e5f0ff;" href="/admin/logout">🚪 Logout</a></h2>


</aside>

<!-- QUIZ CELEBRATION MODAL -->
<div id="quizCelebration" class="celebration-modal">
  <div class="celebration-content">
    <div class="confetti"></div>

    <h2>🎉 Congratulations!</h2>
    <p id="celebrationMessage"></p>

    <div class="xp-box">
      <h3>⭐ XP Earned</h3>
      <p id="xpEarnedText"></p>
    </div>

    <button onclick="closeCelebration()">Continue Learning ➜</button>
  </div>
</div>

<!-- QUIZ CELEBRATION MODAL -->
<div id="quizCelebration" class="celebration-modal">
  <div class="celebration-content">
    <div class="confetti"></div>

    <h2>🎉 Congratulations!</h2>
    <p id="celebrationMessage"></p>

    <div class="xp-box">
      <h3>⭐ XP Earned</h3>
      <p id="xpEarnedText"></p>
    </div>

    <button onclick="closeCelebration()">Continue Learning ➜</button>
  </div>
</div>

<!-- BADGE AWARD MODAL -->
<div id="badgeCelebration" class="celebration-modal">
  <div class="celebration-content badge-mode">
    <h2>🏅 Badge Unlocked!</h2>

    <div id="badgeVisual"></div>
    <h3 id="badgeName"></h3>

    <button onclick="closeBadgeCelebration()">Awesome! 🚀</button>
  </div>
</div>

 <main class="main-content">
  
  <% if (section === 'profile') { %>
    <!-- 👤 PROFILE SECTION -->
    <div class="profile-container">
      <h2>👤 My Profile</h2>

      <div class="profile-card">
        <img src="<%= profilePic || '/images/profile male.png' %>" class="profile-pic-large" />
        <p><strong>Full Name:</strong> <%= student.fullname %></p>
        <p><strong>Gender:</strong> <%= student.gender %></p>
        <p><strong>Date of Birth:</strong> <%= student.dob ? student.dob.toISOString().split('T')[0] : 'N/A' %></p>
        <p style="color: rgb(0, 0, 0);">💰 Wallet: ₦<%= walletBalance.toLocaleString() %></p>
        <button class="btn-create" onclick="openEditModal('profile')">✏️ Edit Profile</button>
      </div>

      <!-- 🏅 Achievements -->
        <h3>🏅 Achievements</h3>
        <div class="achievements">
          <div class="achievement-item">
            <h4>🪙 XP Points</h4>
            <p><%= student.xp || 0 %> points</p>
          </div>

          <div class="achievement-item">
            <h4>📘 Courses Completed</h4>
            <p><%= completedCourses || 0 %></p>
          </div>

          <div class="achievement-item">
            <h4>📜 Certificates</h4>
            <p><%= certificatesCount || 0 %></p>
          </div>
        </div>

        <!-- 📜 Certificates Section -->
        <div class="certificates-section">
          <h3>📜 My Certificates</h3>

          <% if (certificates && certificates.length > 0) { %>
            <div class="certificates-grid">
              <% certificates.forEach(cert => { %>
                <div class="certificate-card">

                  <% if (cert.certificate_url) { %>
                    <a href="<%= cert.certificate_url %>" target="_blank">
                      <img src="<%= cert.certificate_url %>" 
                          alt="<%= cert.course_title %>" 
                          class="certificate-img" />
                    </a>
                  <% } %>

                  <p class="certificate-title"><%= cert.course_title %></p>

                  <p class="certificate-date">
                    Issued: <%= new Date(cert.issued_at).toLocaleDateString() %>
                  </p>

                </div>

              <% }) %>
            </div>
          <% } else { %>
            <p class="no-certificates">
              No certificates yet. Complete courses to earn yours! 🎓
            </p>
          <% } %>
        </div>

      <div class="badges-section">
        <h3>🎖️ Badges Earned</h3>

        <% if (badges && badges.length > 0) { %>
          <div class="badges-grid">
            <% badges.forEach(b => { %>
              <div class="badge-card">
                <!-- Show badge image if exists -->
                <% if (b.badge_image) { %>
                  <a href="<%= b.badge_image %>" target="_blank">
                    <img src="<%= b.badge_image %>" alt="<%= b.badge_name %>" class="badge-img" />
                  </a>
                  
                <% } else { %>
                  <div class="badge-placeholder">🎖️</div>
                <% } %>

                <p class="badge-name"><%= b.badge_name %></p>
                <% if (b.module_title) { %>
                    <p class="badge-module">
                      📘 <strong>Module:</strong> <%= b.module_title %>
                    </p>
                <% } %>

                  <% if (b.course_title) { %>
                    <p class="badge-course">
                      🎓 <strong>Course:</strong> <%= b.course_title %>
                    </p>
                  <% } %>
                <p class="badge-date">Awarded: <%= new Date(b.awarded_at).toLocaleDateString() %></p>

                <!-- Optional: show module title that earned this badge -->
                <% if (b.module_title) { %>
                  <p class="badge-module">Module: <%= b.module_title %></p>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="no-badges">No badges earned yet. Keep learning! 🚀</p>
        <% } %>
      </div>

      <!-- 🚀 Projects Section -->
      <div class="projects-section">
        <h3>🚀 My Projects</h3>

        <% 
          const hasProjects = Object.keys(courseProjects || {}).length > 0;
        %>

        <% if (hasProjects) { %>
          
          <div class="projects-grid">

            <% Object.keys(courseProjects).forEach(courseId => { %>

              <% courseProjects[courseId].forEach(project => { 
                  const submission = projectSubmissions[project.id];
              %>

                <div class="project-card">

                  <h4><%= project.title %></h4>

                  <% if (submission) { %>
                    <p class="project-status completed">
                      ✅ Submitted on 
                      <%= new Date(submission.submitted_at).toLocaleDateString() %>
                    </p>

                    <% if (submission.file_url) { %>
                      <a href="<%= submission.file_url %>" 
                        target="_blank" 
                        class="btn-view">
                        👁 View Submission
                      </a>
                    <% } %>

                  <% } else { %>
                    <p class="project-status pending">
                      ⏳ Not Submitted Yet
                    </p>
                  <% } %>

                </div>

              <% }) %>

            <% }) %>

          </div>

        <% } else { %>
          <p>No projects assigned yet. Keep learning! 🚀</p>
        <% } %>
      </div>


    </div>

    <!-- Student edit profile modal -->
    <!-- <div id="editModal-profile" class="modal" style="display: none;">
      <div class="modal-content">
        <span class="close-modal" onclick="closeEditModal('profile')">&times;</span>
        <h2>Edit Profile</h2>
        <form action="/student/profile/edit" method="POST">
          <input type="hidden" name="student_id" value="<%= student.id %>" />
          <label for="fullname">Full Name:</label>
          <input type="text" id="fullname" name="fullname" value="<%= student.fullname %>" required />

          <label for="gender">Gender:</label>
          <select id="gender" name="gender" required>
            <option value="">Select Gender</option>
            <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= student.gender === 'Other' ? 'selected' : '' %>>Other</option>
          </select>

          <label for="dob">Date of Birth:</label>
          <input type="date" id="dob" name="dob" value="<%= student.dob ? student.dob.toISOString().split('T')[0] : '' %>" required />

          <label for="profile_picture">Profile Picture:</label>
          <input type="file" id="profile_picture" name="profile_picture" accept=".jpg,.jpeg,.png"/>

          <button type="submit">Update Profile</button>
        </form>
      </div>
    </div> -->

    <!-- Student edit profile modal -->
    <div id="editModal-profile" class="modal" style="display:none;">
      <div class="modal-content">

        <span class="close-modal" onclick="closeEditModal('profile')">&times;</span>

        <h2>Edit Profile</h2>

        <form action="/student/profile/edit" method="POST" enctype="multipart/form-data">

          <input type="hidden" name="student_id" value="<%= student.id %>" />

          <label>Full Name:</label>
          <input type="text" name="fullname" value="<%= student.fullname %>" disabled>

          <label>Gender:</label>
          <select name="gender" required>
            <option value="">Select Gender</option>
            <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= student.gender === 'Other' ? 'selected' : '' %>>Other</option>
          </select>

          <label>Date of Birth:</label>
          <input type="date" name="dob"
          value="<%= student.dob ? student.dob.toISOString().split('T')[0] : '' %>">

          <label>Profile Picture:</label>
          <input type="file" name="profile_picture" accept=".jpg,.jpeg,.png">

          <hr>

          <h3>🔑 Change Password</h3>

          <label>Current Password</label>
          <input type="password" name="current_password">

          <label>New Password</label>
          <input type="password" name="new_password">

          <label>Confirm New Password</label>
          <input type="password" name="confirm_password">

          <button type="submit">Update Profile</button>

        </form>

      </div>
    </div>


  <% } else if (section === 'progress') { %>

    <div class="progress-container">

      <h2>📊 My Learning Progress</h2>

      <!-- SUMMARY CARDS -->
      <div class="stats-boxes">
        <div class="stat-box light-blue">
          <h4>📘 Courses</h4>
          <p><%= enrolledCourses.length %></p>
        </div>

        <div class="stat-box light-green">
          <h4>✅ Completed</h4>
          <p><%= completedCourses %></p>
        </div>

        <div class="stat-box light-yellow" onclick="openBadgeModal()">
          <h4>🏅 Badges</h4>
          <p><%= badges.length %></p>
          <small style="cursor:pointer;">View All ➜</small>
        </div>

        <div class="stat-box light-grey" onclick="openCertificateModal()">
          <h4>📜 Certificates</h4>
          <p><%= certificatesCount %></p>
          <small style="cursor:pointer;">View All ➜</small>
        </div>
      </div>

          <!-- BADGE MODAL -->
        <div id="badgeModal" class="modal">
          <div class="modal-content">
            <span class="close" onclick="closeBadgeModal()">&times;</span>
            <h3>🏅 Your Badges</h3>

            <% if (badges && badges.length > 0) { %>
              <div class="badges-grid">
                <% badges.forEach(b => { %>
                  <div class="badge-card">
                    <div class="badge-icon">
                      <% if (b.badge_name === 'Beginner') { %> 🥉
                      <% } else if (b.badge_name === 'Intermediate') { %> 🥈
                      <% } else if (b.badge_name === 'Advanced') { %> 🥇
                      <% } else if (b.badge_name === 'Master') { %> 👑
                      <% } else { %> 🎖️
                      <% } %>
                    </div>
                    <p class="badge-name"><%= b.badge_name %></p>
                    <p class="badge-date">Awarded: <%= new Date(b.awarded_at).toLocaleDateString() %></p>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p>You haven’t earned any badges yet. Keep learning! 🚀</p>
            <% } %>
          </div>
        </div>

            <!-- Certificate MODAL -->
        <div id="certificateModal" class="modal">
          <div class="modal-content">
            <span class="close" onclick="closeCertificateModal()">&times;</span>
            <h3>🏅 Your Certificate</h3>

            <% if (certificates && certificates.length > 0) { %>
              <div class="certificates-grid">
                <% certificates.forEach(cert => { %>
                  <div class="certificate-card">
                    <% if (cert.certificate_url) { %>
                      <a href="<%= cert.certificate_url %>" target="_blank">
                        <img src="<%= cert.certificate_url %>" 
                            alt="<%= cert.course_title %>" 
                            class="certificate-img" />
                      </a>
                    <% } %>

                    <p class="certificate-title"><%= cert.course_title %></p>

                    <p class="certificate-date">
                      Issued: <%= new Date(cert.issued_at).toLocaleDateString() %>
                    </p>

                  </div>

                <% }) %>
              </div>
            <% } else { %>
              <p class="no-certificates">
                No certificates yet. Complete courses to earn yours! 🎓
              </p>
            <% } %>
          </div>
        </div>

        <!-- PROJECT MODAL -->
        <div id="projectModal" class="modal">
          <div class="modal-content">
            <span class="close" onclick="closeProjectModal()">&times;</span>
            <h3>🚀 Your Course Projects</h3>

            <% 
              const hasProjects = Object.keys(courseProjects || {}).length > 0;
            %>

            <% if (hasProjects) { %>

              <% Object.keys(courseProjects).forEach(courseId => { %>
                
                <div class="project-course-section">
                  <% const projects = courseProjects[courseId]; %>

                  <% projects.forEach(project => { 
                      const submission = projectSubmissions[project.id];
                  %>

                    <div class="project-card">
                      <h4><%= project.title %></h4>
                      <!-- <p><%- project.description %></p>  -->

                      <% if (project.resource_url) { %>
                        <a href="<%= project.resource_url %>" target="_blank" class="btn-view">
                          📎 View Instructions
                        </a>
                      <% } %>

                      <% if (submission) { %>
                        <div class="project-submitted">
                          <p>✅ Submitted on 
                            <%= new Date(submission.submitted_at).toLocaleDateString() %>
                          </p>

                          <% if (submission.file_url) { %>
                            <a href="<%= submission.file_url %>" target="_blank" class="btn-view">
                              👁 View Submission
                            </a>
                          <% } %>

                          <% if (submission.notes) { %>
                            <p class="submission-notes">
                              📝 <%= submission.notes %>
                            </p>
                          <% } %>
                        </div>
                      <% } else { %>
                        <p class="not-submitted">❌ Not submitted yet</p>
                      <% } %>

                    </div>

                  <% }) %>

                </div>

              <% }) %>

            <% } else { %>
              <p>No projects assigned yet. Keep progressing! 🎯</p>
            <% } %>

          </div>
        </div>

      <!-- COURSE PROGRESS -->
      <div class="course-grid">

        <% enrolledCourses.forEach(course => { %>
          <div class="course-card3" style="flex-direction: column;">

            <img src="<%= course.thumbnail_url || '/images/default-course.png' %>" />
            <div>
              <h4><%= course.title %></h4>
              <p><%= course.progress %>% complete</p>
            </div>
            
            <div class="progress-bar">
              <div class="filled" style="width: <%= course.progress %>%"></div>
            </div>

            <div>
              
              <!-- Child-friendly encouragement -->
              <% if (course.progress == 100) { %>
                <p style="color:green;">🎉 You finished this course!</p>
              <% } else if (course.progress >= 50) { %>
                <p style="color:orange;">🔥 You're doing great!</p>
              <% } else { %>
                <p style="color:#555;">💪 Keep going!</p>
              <% } %>

              <a href="/student/dashboard?section=module&courseId=<%= course.id %>" class="btn-view" style="text-decoration: none;">
                📖 View Course
              </a>
            </div>

          </div>
        <% }) %>

      </div>

    </div>


  <% } else if (section === 'classroom' && classroom) { %>
  <h2>👥 Your Classmates in <%= classroom.name %></h2>
  <% if (classmates.length > 0) { %>
    <div class="table-responsive">
      <table class="user-table">
        <thead>
          <tr>
            <th>Profile</th>
            <th>Full Name</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% classmates.forEach(c => { %>
            <tr>
              <td>
                <img src="<%= c.profile_picture || '/images/profile male.png' %>" 
                    alt="Profile" 
                    style="width:40px; height:40px; border-radius:50%;">
              </td>
              <td><%= c.fullname %></td>
              <td><%= c.email %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div>
      <h3>💬 Class Chat</h3>

      <div id="classChatBox"
        style="border:1px solid #ccc;
        height:300px;
        overflow-y:auto;
        padding:10px;
        background:#fafafa;">
      </div>

      <textarea id="classMessage"
        placeholder="Message the class..."
        style="width:80%;margin-top:10px;">
      </textarea>

      <button onclick="sendClassMessage()">Send</button>

      <div id="warningModal" class="modal">
      <div class="modal-content">
        <h3>⚠ Message Blocked</h3>
        <p id="warningText"></p>
        <button onclick="closeWarning()">OK</button>
      </div>
    </div>
    </div>
  <% } else { %>
    <p>No classmates found in this classroom.</p>
  <% } %>

  <% } else if (section === 'teacher' && classroom) { %>
  <h2>👨‍🏫 Your Teacher(s) for <%= classroom.name %></h2>
  <% if (teachers.length > 0) { %>
    <div class="card-container">
      <% teachers.forEach(t => { %>
        <div class="card">
          <div class="card-header">
            <img src="<%= t.profile_picture || '/images/profile male.png' %>" 
                 alt="Teacher" 
                 class="card-avatar" style=" object-fit:contain;">
            <h3><%= t.fullname %></h3>
          </div>
          
          <div class="card-body">
            <p><strong>Email:</strong> <%= t.email %></p>
            <p><strong>Role:</strong> Teacher</p>

            <!-- 💬 Chat Button -->
            <button class="btn-chat" onclick="openChat('<%= t.id %>', '<%= t.fullname %>')">💬 Chat</button>

           
          </div>

        </div>
         <!-- Chat Modal -->
            <div id="chatModal-<%= t.id %>" class="chat-modal">
              <div class="chat-content">
                <span class="close-chat" onclick="closeChat('<%= t.id %>')">&times;</span>
                <h3>Chat with <%= t.fullname %></h3>
                <div class="chat-messages" id="chatMessages-<%= t.id %>"></div>
                <div class="chat-input">
                  <input type="text" id="chatInput-<%= t.id %>" placeholder="Type a message..." />
                  <button onclick="sendChat('<%= t.id %>')">Send</button>
                </div>
              </div>
            </div>
      <% }) %>
    </div>
  <% } else { %>
    <p>No teacher assigned to this classroom yet.</p>
  <% } %>

  <% } else if (section === 'instructors' && classroom) { %>
  <h2>🧑🏽‍🔧 Your Instructors for <%= classroom.name %></h2>
  <% if (instructors.length > 0) { %>
    <div class="card-container">
      <% instructors.forEach(i => { %>
        <div class="card">
          <div class="card-header">
            <img src="<%= i.profile_picture || '/images/profile male.png' %>" 
                 alt="Instructor" 
                 class="card-avatar" style="object-fit:contain;">
            <h3><%= i.fullname %></h3>
          </div>
        
           <div class="card-body">
              <p><strong>Email:</strong> <%= i.email %></p>
              <p><strong>Role:</strong> Instructor</p>

              <!-- 💬 Chat Button -->
              <button class="btn-chat" onclick="openChat('<%= i.id %>', '<%= i.fullname %>')">💬 Chat</button>

             
            </div>
        </div>
         <!-- Chat Modal -->
              <div id="chatModal-<%= i.id %>" class="chat-modal">
                <div class="chat-content">
                  <span class="close-chat" onclick="closeChat('<%= i.id %>')">&times;</span>
