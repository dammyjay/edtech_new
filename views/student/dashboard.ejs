    function sendLessonDuration() {
      if (!lessonStartTime || !currentActivityId) return;

      const endTime = Date.now();
      const duration = Math.max(1, Math.floor((endTime - lessonStartTime) / 1000));

      const data = JSON.stringify({
        activityId: currentActivityId,
        duration,
        endTime
      });

      navigator.sendBeacon("/student/lesson-time", data);
    }

