<%- include('../partials/header', { title: course.title }) %>

<div class="dashboard-container" style="padding:20px; max-width:900px; margin:0 auto;">

  <a href="/student/dashboard?section=progress" class="btn-view" style="text-decoration:none; display:inline-block; margin-bottom:20px;">← Back to My Courses</a>

  <div style="background:var(--grey, #f5f5f5); padding:20px; border-radius:8px; margin-bottom:20px;">
    <h2>🔒 <%= course.title %></h2>
    <p style="color:#666;">This course is from a classroom you were previously in. You can view lessons you already completed, but you can't start anything new here.</p>
  </div>

  <% modules.forEach(mod => { %>
    <div class="module-block" style="margin-bottom:20px; border:1px solid #eee; border-radius:8px; padding:15px;">
      <h3>📦 Module <%= mod.order_number %>: <%= mod.title %></h3>

      <ul style="list-style:none; padding-left:0;">
        <% (lessonsByModule[mod.id] || []).forEach(lesson => { %>
          <li style="padding:10px; border-bottom:1px solid #f3f3f3; display:flex; justify-content:space-between; align-items:center;">
            <span>
              <%= lesson.completed ? "✅" : "🔒" %> Lesson <%= lesson.order_number %>: <%= lesson.title.replace(/^lesson\s+\d+\s*[:.\-]?\s*/i, '') %>
            </span>
            <% if (lesson.completed) { %>
              <button class="btn-view" onclick="loadPastLesson(<%= lesson.id %>)">👁 View</button>
            <% } else { %>
              <span style="color:#999; font-size:13px;">Not completed — locked</span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  <% }) %>

  <div id="pastLessonContent" style="margin-top:20px; padding:20px; border-radius:8px; background:#fff; border:1px solid #eee; display:none;"></div>

</div>

<script>
function loadPastLesson(lessonId) {
  const area = document.getElementById("pastLessonContent");
  area.style.display = "block";
  area.innerHTML = "<p>Loading...</p>";

  fetch(`/student/lessons/${lessonId}`)
    .then(res => res.json())
    .then(data => {
      if (!data.success) {
        area.innerHTML = `<p>⚠️ ${data.message || "Failed to load lesson."}</p>`;
        return;
      }
      let html = `<h3>${data.title}</h3>`;
      if (data.video_url) {
        html += `<video controls style="width:100%; max-width:700px;" src="${data.video_url}"></video>`;
      }
      if (data.content) {
        html += `<div style="margin-top:15px;">${data.content}</div>`;
      }
      area.innerHTML = html;
      area.scrollIntoView({ behavior: "smooth" });
    })
    .catch(() => {
      area.innerHTML = "<p>⚠️ Failed to load lesson.</p>";
    });
}
</script>
