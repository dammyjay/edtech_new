<%- include('../partials/header', { title: 'Arcade' }) %>
<link rel="stylesheet" href="/css/arcade.css" />

<div class="arcade-wrap">
  <div class="arcade-header">
    <div>
      <h2>🎮 Arcade</h2>
      <p class="subtitle">15 games — swipe, tap, or drag on any device.</p>
    </div>
    <div class="arcade-coins">🪙 <span id="arcadeCoins"><%= coins %></span> coins</div>
  </div>

  <% if (!arcadeEnabled) { %>
    <div class="arcade-disabled-banner">
      Your school has turned off the Arcade for <%= classroomName || 'your classroom' %> right now. Check back later!
    </div>
  <% } else {
    const tags = ["All", ...new Set(games.map(g => g.tag))];
  %>
    <div class="arcade-filters" id="arcadeFilters">
      <% tags.forEach((t, i) => { %>
        <button type="button" class="arcade-filter-chip <%= i === 0 ? 'active' : '' %>" data-tag="<%= t %>"><%= t %></button>
      <% }) %>
    </div>

    <div class="arcade-grid" id="arcadeGrid">
      <% games.forEach(g => { %>
        <div class="arcade-card" data-tag="<%= g.tag %>" style="--card-accent:<%= g.accent %>; --card-accent-dark:<%= g.accentDark %>;">
          <span class="tag"><%= g.tag %></span>
          <div class="icon"><%= g.icon %></div>
          <h3><%= g.name %></h3>
          <p><%= g.description %></p>
          <button type="button" class="arcade-play-btn" onclick="playGame('<%= g.id %>', <%= g.playCost %>, <%= g.hasDifficulty ? 'true' : 'false' %>)">🪙 <%= g.playCost %> — Play</button>
        </div>
      <% }) %>
    </div>

    <div id="arcadeStage" style="display:none;">
      <button type="button" class="stage-back" onclick="closeGame()">&larr; Back to games</button>
      <div class="arcade-stage-card arcade-stage-relative" id="arcadeGameContainer"></div>
    </div>
  <% } %>
</div>

<script src="/js/arcadeEngine.js"></script>
<script src="/games/snake.js"></script>
<script src="/games/2048.js"></script>
<script src="/games/memory-match.js"></script>
<script src="/games/brick-breaker.js"></script>
<script src="/games/flappy-block.js"></script>
<script src="/games/bubble-pop.js"></script>
<script src="/games/whack-a-mole.js"></script>
<script src="/games/reaction-test.js"></script>
<script src="/games/color-match.js"></script>
<script src="/games/simon-says.js"></script>
<script src="/games/tic-tac-toe.js"></script>
<script src="/games/connect-four.js"></script>
<script src="/games/math-blitz.js"></script>
<script src="/games/typing-rush.js"></script>
<script src="/games/word-scramble.js"></script>
<script>
  function showToast(message) {
    const el = document.createElement('div');
    el.className = 'app-toast';
    el.textContent = message;
    Object.assign(el.style, {
      position: 'fixed', bottom: '20px', right: '20px', background: '#111827', color: '#fff',
      padding: '10px 16px', borderRadius: '8px', zIndex: 9999, opacity: 0, transition: 'opacity .3s',
    });
    document.body.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = 1; });
    setTimeout(() => { el.style.opacity = 0; setTimeout(() => el.remove(), 300); }, 2200);
  }

  // Genre filter chips
  document.getElementById('arcadeFilters')?.addEventListener('click', (e) => {
    const chip = e.target.closest('.arcade-filter-chip');
    if (!chip) return;
    document.querySelectorAll('.arcade-filter-chip').forEach(c => c.classList.remove('active'));
    chip.classList.add('active');
    const tag = chip.dataset.tag;
    document.querySelectorAll('#arcadeGrid .arcade-card').forEach(card => {
      card.style.display = (tag === 'All' || card.dataset.tag === tag) ? '' : 'none';
    });
  });

  let currentGameId = null;

  // Games marked hasDifficulty in utils/arcadeGames.js get an Easy/Medium/
  // Hard pick before the coin spend — everything else skips straight to
  // startActualGame (difficulty stays null, which every game + the score
  // endpoint already treat as "unspecified").
  function playGame(gameId, cost, hasDifficulty) {
    if (!hasDifficulty) {
      startActualGame(gameId, cost, null);
      return;
    }

    const container = document.getElementById('arcadeGameContainer');
    const grid = document.getElementById('arcadeGrid');
    const filters = document.getElementById('arcadeFilters');
    const stage = document.getElementById('arcadeStage');

    grid.style.display = 'none';
    if (filters) filters.style.display = 'none';
    stage.style.display = 'block';
    container.innerHTML = `
      <div class="arcade-difficulty-pick">
        <h3>Choose a difficulty</h3>
        <div class="arcade-difficulty-options">
          <button type="button" class="arcade-btn-primary" data-difficulty="easy">🟢 Easy</button>
          <button type="button" class="arcade-btn-primary" data-difficulty="medium">🟡 Medium</button>
          <button type="button" class="arcade-btn-primary" data-difficulty="hard">🔴 Hard</button>
        </div>
      </div>
    `;
    container.querySelectorAll('[data-difficulty]').forEach((btn) => {
      btn.addEventListener('click', () => startActualGame(gameId, cost, btn.dataset.difficulty));
    });
  }

  async function startActualGame(gameId, cost, difficulty) {
    const grid = document.getElementById('arcadeGrid');
    const filters = document.getElementById('arcadeFilters');
    const stage = document.getElementById('arcadeStage');
    const container = document.getElementById('arcadeGameContainer');

    // Loading state — the coin-spend round trip is quick, but the swap
    // still shouldn't feel instant-and-jarring or dead-silent.
    container.innerHTML = '<div style="padding:60px 0;"><div class="arcade-dpad-btn" style="width:44px;height:44px;border-radius:50%;margin:0 auto;animation:arcadeSpin 0.8s linear infinite;border-top-color:#f59e0b;"></div></div>';
    grid.style.display = 'none';
    if (filters) filters.style.display = 'none';
    stage.style.display = 'block';

    try {
      const res = await fetch(`/student/arcade/${gameId}/play`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json();
      if (!data.success) {
        showToast(data.message || 'Could not start game.');
        closeGame();
        return;
      }
      document.getElementById('arcadeCoins').textContent = data.coins;
      showToast(`-${cost} 🪙 — enjoy!`);

      currentGameId = gameId;
      container.innerHTML = '';
      // Read by arcadeEngine.js's reportScore() when the game ends, and by
      // a difficulty-aware game itself (e.g. public/games/math-blitz.js)
      // to adjust its own behavior — see the hasDifficulty comment in
      // utils/arcadeGames.js.
      container.dataset.gameId = gameId;
      if (difficulty) container.dataset.difficulty = difficulty;
      else delete container.dataset.difficulty;

      const game = window.ArcadeGames && window.ArcadeGames[gameId];
      if (game && game.start) {
        game.start(container);
      } else {
        container.innerHTML = '<p>This game could not be loaded.</p>';
      }
    } catch (err) {
      showToast('Something went wrong starting the game.');
      closeGame();
    }
  }

  function closeGame() {
    const container = document.getElementById('arcadeGameContainer');
    const game = currentGameId && window.ArcadeGames && window.ArcadeGames[currentGameId];
    if (game && game.stop) game.stop(container);
    container.innerHTML = '';
    currentGameId = null;
    document.getElementById('arcadeStage').style.display = 'none';
    document.getElementById('arcadeGrid').style.display = 'grid';
    const filters = document.getElementById('arcadeFilters');
    if (filters) filters.style.display = 'flex';
  }
</script>
<style>
  @keyframes arcadeSpin { to { transform: rotate(360deg); } }
</style>
