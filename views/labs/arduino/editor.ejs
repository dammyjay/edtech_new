<link rel="stylesheet" href="/labs/css/arduino.css">

<div class="arduino-container">

  <div class="components-panel">
    <h3>Components</h3>

    <div class="component" draggable="true" data-type="wokwi-arduino-uno">
      <div class="component-preview preview-board"><wokwi-arduino-uno></wokwi-arduino-uno></div>
      Arduino Uno
    </div>

    <div class="component" draggable="true" data-type="wokwi-led">
      <div class="component-preview preview-led"><wokwi-led color="red"></wokwi-led></div>
      LED
    </div>

    <div class="component" draggable="true" data-type="wokwi-pushbutton">
      <div class="component-preview preview-button"><wokwi-pushbutton></wokwi-pushbutton></div>
      Push Button
    </div>

    <div class="component" draggable="true" data-type="wokwi-buzzer">
      <div class="component-preview preview-buzzer"><wokwi-buzzer></wokwi-buzzer></div>
      Buzzer
    </div>

    <p class="components-hint">Drag a part onto the canvas, then drag from one pin to another to wire it up. Click a wire to remove it.</p>

  </div>

  <div id="circuitCanvas" class="circuit-canvas">

    <h2 id="circuitCanvasHint">Drop Components Here</h2>

    <svg id="wireOverlay" class="wire-overlay"></svg>

  </div>

</div>

<div class="code-section">

  <div id="arduinoCodeEditor" class="code-editor"></div>

</div>

<div class="serial-monitor">
  <div class="serial-monitor-header">
    <span class="serial-dot"></span>
    <span>Serial Monitor</span>
    <span class="serial-baud">9600 baud</span>
  </div>
  <div id="serialOutput" class="serial-output"></div>
</div>

<div class="controls">

<button id="runBtn">
Run Simulation
</button>

<button id="stopBtn" disabled>
Stop
</button>

<button id="saveBtn">
Save
</button>

<span id="arduinoStatus" class="arduino-status">Idle</span>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs/loader.min.js"></script>
<!-- Real component graphics + pin geometry (pinInfo) for the circuit builder — the same web components Wokwi's own simulator renders. -->
<script src="https://cdn.jsdelivr.net/npm/@wokwi/elements@1.9.2/dist/wokwi-elements.bundle.js"></script>
<script src="/labs/js/arduinoLab.js"></script>