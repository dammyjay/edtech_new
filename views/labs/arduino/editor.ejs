<link rel="stylesheet" href="/labs/css/arduino.css">

<div id="labToast" class="lab-toast"></div>

<div class="arduino-lab">

  <div class="lab-topbar">
    <div class="lab-topbar-left">
      <a href="/labs" class="lab-back-link" title="Back to Learning Labs">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <div class="lab-title">
        <span class="lab-title-main">Arduino Lab</span>
        <span class="lab-title-sub">Circuit Simulator</span>
      </div>
    </div>

    <div class="lab-topbar-controls">
      <button id="runBtn" class="lab-btn lab-btn--run">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4 L20 12 L6 20 Z"/></svg>
        Run Simulation
      </button>
      <button id="stopBtn" class="lab-btn lab-btn--stop" disabled>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="1.5"/></svg>
        Stop
      </button>
      <button id="saveBtn" class="lab-btn lab-btn--save">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h11l3 3v13H5z"/><path d="M8 4v6h8V4"/><path d="M8 20v-5h8v5"/></svg>
        Save
      </button>
    </div>

    <div class="lab-topbar-extra">
      <button id="copyCircuitBtn" class="lab-icon-btn" title="Copy circuit to clipboard">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
      </button>
      <button id="downloadCircuitBtn" class="lab-icon-btn" title="Download circuit as a file">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
      </button>
      <button id="exportInoBtn" class="lab-icon-btn" title="Export code as sketch.ino">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
      </button>
    </div>

    <div class="lab-topbar-right">
      <span id="arduinoStatus" class="arduino-status">Idle</span>
    </div>
  </div>

  <div class="lab-body">

    <div class="components-panel">
      <h3>Components</h3>

      <input type="text" id="componentSearch" class="component-search" placeholder="Search components…" autocomplete="off">

      <div class="component-category">Boards</div>
      <div class="component" draggable="true" data-type="wokwi-arduino-uno">
        <div class="component-preview preview-board"><wokwi-arduino-uno></wokwi-arduino-uno></div>
        Arduino Uno
      </div>

      <div class="component-category">Prototyping</div>
      <div class="component" draggable="true" data-type="custom-breadboard">
        <div class="component-preview preview-breadboard">
          <svg viewBox="0 0 60 30" width="52" height="26">
            <rect x="1" y="1" width="58" height="28" rx="3" fill="#f0ead8" stroke="#c9c0a0"/>
            <line x1="4" y1="6" x2="56" y2="6" stroke="#d9534f" stroke-width="1.2"/>
            <line x1="4" y1="10" x2="56" y2="10" stroke="#337ab7" stroke-width="1.2"/>
            <line x1="4" y1="20" x2="56" y2="20" stroke="#d9534f" stroke-width="1.2"/>
            <line x1="4" y1="24" x2="56" y2="24" stroke="#337ab7" stroke-width="1.2"/>
            <circle cx="10" cy="14" r="0.8" fill="#999"/><circle cx="16" cy="14" r="0.8" fill="#999"/><circle cx="22" cy="14" r="0.8" fill="#999"/>
            <circle cx="28" cy="14" r="0.8" fill="#999"/><circle cx="34" cy="14" r="0.8" fill="#999"/><circle cx="40" cy="14" r="0.8" fill="#999"/>
            <circle cx="46" cy="14" r="0.8" fill="#999"/><circle cx="52" cy="14" r="0.8" fill="#999"/>
          </svg>
        </div>
        Breadboard
      </div>

      <div class="component-category">Output</div>
      <div class="component" draggable="true" data-type="wokwi-led">
        <div class="component-preview preview-led"><wokwi-led color="red"></wokwi-led></div>
        LED
      </div>

      <div class="component" draggable="true" data-type="wokwi-rgb-led">
        <div class="component-preview preview-rgb-led"><wokwi-rgb-led></wokwi-rgb-led></div>
        RGB LED
      </div>

      <div class="component" draggable="true" data-type="wokwi-buzzer">
        <div class="component-preview preview-buzzer"><wokwi-buzzer></wokwi-buzzer></div>
        Buzzer
      </div>

      <div class="component" draggable="true" data-type="wokwi-servo">
        <div class="component-preview preview-servo"><wokwi-servo></wokwi-servo></div>
        Servo Motor
      </div>

      <div class="component-category">Input</div>
      <div class="component" draggable="true" data-type="wokwi-pushbutton">
        <div class="component-preview preview-button"><wokwi-pushbutton></wokwi-pushbutton></div>
        Push Button
      </div>

      <div class="component" draggable="true" data-type="wokwi-slide-switch">
        <div class="component-preview preview-slide-switch"><wokwi-slide-switch></wokwi-slide-switch></div>
        Slide Switch
      </div>

      <div class="component" draggable="true" data-type="wokwi-potentiometer">
        <div class="component-preview preview-potentiometer"><wokwi-potentiometer></wokwi-potentiometer></div>
        Potentiometer
      </div>

      <div class="component-category">Sensors</div>
      <div class="component" draggable="true" data-type="wokwi-photoresistor-sensor">
        <div class="component-preview preview-photoresistor"><wokwi-photoresistor-sensor></wokwi-photoresistor-sensor></div>
        Light Sensor
      </div>

      <p class="components-hint">Drag a part onto the canvas, then drag from one pin to another to wire it up. Click a wire to remove it. Drop a breadboard first, then place a part with a leg near a hole to plug it into that row — everything in the same row is electrically connected, just like a real breadboard. Click a placed part to flip, turn, duplicate, or delete it.</p>
    </div>

    <div class="canvas-wrap">
      <div id="circuitCanvas" class="circuit-canvas">

        <h2 id="circuitCanvasHint">Drop Components Here</h2>

        <div id="canvasViewport" class="canvas-viewport"></div>

        <svg id="wireOverlay" class="wire-overlay"></svg>

        <div id="componentToolbar" class="component-toolbar" hidden>
          <button type="button" data-action="flip" title="Flip horizontally">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18"/><path d="M17 8l3 4-3 4"/><path d="M7 8l-3 4 3 4"/></svg>
          </button>
          <button type="button" data-action="turn" title="Turn 180°">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
          </button>
          <button type="button" data-action="duplicate" title="Duplicate">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
          </button>
          <button type="button" data-action="delete" class="ct-danger" title="Delete">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/></svg>
          </button>
        </div>

        <div class="view-controls">
          <div class="view-controls-pad">
            <button type="button" class="vc-btn vc-up" data-pan="up" title="Pan up">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            </button>
            <button type="button" class="vc-btn vc-left" data-pan="left" title="Pan left">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" class="vc-btn vc-reset" id="viewResetBtn" title="Reset view">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
            </button>
            <button type="button" class="vc-btn vc-right" data-pan="right" title="Pan right">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
            <button type="button" class="vc-btn vc-down" data-pan="down" title="Pan down">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </button>
          </div>
          <div class="view-controls-zoom">
            <button type="button" class="vc-btn" id="zoomOutBtn" title="Zoom out">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/></svg>
            </button>
            <span id="zoomLevel" class="vc-zoom-level">100%</span>
            <button type="button" class="vc-btn" id="zoomInBtn" title="Zoom in">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
        </div>

      </div>
    </div>

    <div class="right-panel">

      <div class="code-section">
        <div id="arduinoCodeEditor" class="code-editor"></div>
      </div>

      <div class="serial-monitor">
        <div class="serial-monitor-header">
          <span class="serial-dot"></span>
          <span>Serial Monitor</span>
          <span class="serial-baud">9600 baud</span>
        </div>
        <div id="serialOutput" class="serial-output"></div>
      </div>

    </div>

  </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs/loader.min.js"></script>
<!-- Real component graphics + pin geometry (pinInfo) for the circuit builder — the same web components Wokwi's own simulator renders. -->
<script src="https://cdn.jsdelivr.net/npm/@wokwi/elements@1.9.2/dist/wokwi-elements.bundle.js"></script>
<script src="/labs/js/arduinoLab.js"></script>
