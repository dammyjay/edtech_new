          <field name="NUM">0.25</field>
        </shadow>
      </value>
    </block>

    <block type="play_note">
      <value name="NOTE">
        <shadow type="math_number">
          <field name="NUM">60</field>
        </shadow>
      </value>
      <value name="BEATS">
        <shadow type="math_number">
          <field name="NUM">0.5</field>
        </shadow>
      </value>
    </block>

    <block type="set_instrument"></block>

    <block type="change_tempo">
      <value name="VALUE">
        <shadow type="math_number">
          <field name="NUM">20</field>
        </shadow>
      </value>
    </block>

    <block type="set_tempo">
      <value name="VALUE">
        <shadow type="math_number">
          <field name="NUM">60</field>
        </shadow>
      </value>
    </block>

    <block type="tempo_reporter"></block>

  </category>
</xml>


<div id="costumesModal" class="modal">
  <div class="modal-content asset-picker-modal">
    <h3>Costumes</h3>

    <input type="search" class="asset-picker-search" id="costumesModalSearch" placeholder="🔍 Search costumes…"
           oninput="filterCostumesModal(this.value)" />

    <div class="asset-picker-scroll">
      <div class="sprite-grid" id="costumesModalGrid"></div>
      <p class="asset-picker-empty" id="costumesModalEmpty" style="display:none">No costumes match your search.</p>
    </div>

    <button type="button" id="addCostumeBtn" onclick="openAddCostumeModal()">+ Add Costume</button>
  </div>
</div>

<div id="soundsModal" class="modal">
  <div class="modal-content asset-picker-modal">
    <h3>Sounds</h3>

    <input type="search" class="asset-picker-search" id="soundsModalSearch" placeholder="🔍 Search sounds…"
           oninput="filterSoundsModal(this.value)" />

    <div class="asset-picker-scroll">
      <div class="sprite-grid" id="soundsModalGrid"></div>
      <p class="asset-picker-empty" id="soundsModalEmpty" style="display:none">No sounds match your search.</p>
    </div>

    <!-- Unlike "+ Add Costume" (which picks from the existing admin
         sprite library), there's no shared sound library to pick from —
         a student uploads their own file directly. -->
    <button type="button" id="addSoundBtn" onclick="document.getElementById('soundFileInput').click()">+ Add Sound</button>
    <input type="file" id="soundFileInput" accept="audio/*" style="display:none" onchange="handleSoundFileSelected(this)" />
  </div>
</div>

<!-- Comes after costumesModal in the DOM so, at equal z-index, it
     correctly stacks ON TOP when "+ Add Costume" opens it over an
     already-open Costumes panel. -->
<div id="spriteModal" class="modal">
  <div class="modal-content asset-picker-modal">
    <h3>Choose Sprite</h3>

    <input type="search" class="asset-picker-search" placeholder="🔍 Search sprites…"
           oninput="filterAssetPicker('sprite', this.value)" />

    <div class="asset-picker-tabs">
      <button class="asset-picker-tab active" data-filter="all" onclick="filterAssetPickerCategory('sprite','all', this)">All</button>
      <% spriteCategories.forEach(cat => { if (cat.assets.length) { %>
        <button class="asset-picker-tab" data-filter="<%= cat.id %>" onclick="filterAssetPickerCategory('sprite','<%= cat.id %>', this)"><%= cat.name %></button>
      <% } }) %>
    </div>

    <div class="asset-picker-scroll">
      <div class="sprite-grid" id="spriteGrid">
        <% spriteCategories.forEach(cat => { cat.assets.forEach(a => { %>
          <div class="asset-picker-item" data-cat="<%= cat.id %>" data-name="<%= a.name.toLowerCase() %>" data-costumes='<%- JSON.stringify((a.costumes || []).map(c => ({ name: c.name, src: c.asset_url }))).replace(/'/g, "&#39;") %>' data-sounds='<%- JSON.stringify((a.sounds || []).map(s => ({ name: s.name, src: s.asset_url }))).replace(/'/g, "&#39;") %>'>
            <img src="<%= a.asset_url %>" title="<%= a.name %>" loading="lazy" onclick="handleSpriteAssetPick('<%= a.name %>', '<%= a.asset_url %>', this.parentElement.dataset.costumes, this.parentElement.dataset.sounds)" />
            <span class="asset-picker-label"><%= a.name %></span>
            <% if ((a.costumes && a.costumes.length) || (a.sounds && a.sounds.length)) { %>
              <span class="asset-picker-extras">
                <% if (a.costumes && a.costumes.length) { %><span title="<%= a.costumes.length %> costume<%= a.costumes.length === 1 ? '' : 's' %> included">🎭<%= a.costumes.length %></span><% } %>
                <% if (a.sounds && a.sounds.length) { %><span title="<%= a.sounds.length %> sound<%= a.sounds.length === 1 ? '' : 's' %> included">🔊<%= a.sounds.length %></span><% } %>
              </span>
            <% } %>
          </div>
        <% }) }) %>
      </div>
      <p class="asset-picker-empty" id="spriteGridEmpty" style="display:none">No sprites match your search.</p>
    </div>
  </div>
</div>

<div id="backgroundModal" class="modal">
  <div class="modal-content asset-picker-modal">
    <h3>Choose Background</h3>

    <input type="search" class="asset-picker-search" placeholder="🔍 Search backgrounds…"
           oninput="filterAssetPicker('background', this.value)" />

    <div class="asset-picker-tabs">
      <button class="asset-picker-tab active" data-filter="all" onclick="filterAssetPickerCategory('background','all', this)">All</button>
      <% backgroundCategories.forEach(cat => { if (cat.assets.length) { %>
        <button class="asset-picker-tab" data-filter="<%= cat.id %>" onclick="filterAssetPickerCategory('background','<%= cat.id %>', this)"><%= cat.name %></button>
      <% } }) %>
    </div>

    <div class="asset-picker-scroll">
      <div class="background-grid" id="backgroundGrid">
        <% backgroundCategories.forEach(cat => { cat.assets.forEach(a => { %>
          <div class="asset-picker-item" data-cat="<%= cat.id %>" data-name="<%= a.name.toLowerCase() %>">
            <img src="<%= a.asset_url %>" title="<%= a.name %>" loading="lazy" onclick="addBackground('<%= a.asset_url %>', '<%= a.name %>')" />
            <span class="asset-picker-label"><%= a.name %></span>
          </div>
        <% }) }) %>
      </div>
      <p class="asset-picker-empty" id="backgroundGridEmpty" style="display:none">No backgrounds match your search.</p>
    </div>
  </div>
</div>
