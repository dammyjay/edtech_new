<!-- views/labs/blockly/editor.ejs -->
<%- include('../../partials/header', { title: 'Blockly Playground' }) %>

<% if (lessonLab) { %>
  <script>
    // Read by blocklyLab.js's submit handler to build the "Back to Lesson" /
    // "Proceed to Next Lesson" deep links (/student/dashboard?section=
    // module&moduleId=&openLesson=) instead of the bare dashboard.
    window.LESSON_MODULE_ID = <%- JSON.stringify(lessonLab.module_id || null) %>;
  </script>
<% } %>

<script src="/js/uiAlerts.js"></script>
<link rel="stylesheet" href="/labs/css/blockly.css" />
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  integrity="sha512-..."
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>

<script src="https://unpkg.com/blockly/blockly.min.js"></script>
<script src="https://unpkg.com/blockly/javascript_compressed.js"></script>

<script src="/labs/js/blockly/blocks/motion.js"></script>
<script src="/labs/js/blockly/blocks/looks.js"></script>
<script src="/labs/js/blockly/blocks/events.js"></script>
<script src="/labs/js/blockly/blocks/console.js"></script>
<script src="/labs/js/blockly/blocks/sensors.js"></script>
<script src="/labs/js/blockly/blocks/control.js"></script>
<script src="/labs/js/blockly/blocks/pen.js"></script>

<script src="/labs/js/blockly/generators/motion.js"></script>
<script src="/labs/js/blockly/generators/looks.js"></script>
<script src="/labs/js/blockly/generators/events.js"></script>
<script src="/labs/js/blockly/generators/console.js"></script>
<script src="/labs/js/blockly/generators/sensors.js"></script>
<script src="/labs/js/blockly/generators/control.js"></script>

<script src="/labs/js/blockly/engine.js"></script>
<script src="/labs/js/blocklyLab.js"></script>

<div class="editor-toolbar">
  <% if (lessonLab) { %>
    <a href="/student/dashboard?section=module&moduleId=<%= lessonLab.module_id %>&openLesson=<%= lessonLab.lesson_id %>" class="editor-back-link" title="Back to your lesson">
      <i class="fas fa-arrow-left"></i> Back to Lesson
    </a>
  <% } else { %>
    <a href="/labs" class="editor-back-link" title="Back to Learning Labs">
      <i class="fas fa-arrow-left"></i> Labs
    </a>
  <% } %>

  <div class="toolbar-group">
    <button id="runBtn" class="tb-primary"><i class="fas fa-play"></i> Run</button>
    <button id="stopBtn" class="tb-danger" style="display: none">
      <i class="fas fa-stop"></i> Stop
    </button>
  </div>

  <div class="toolbar-group">
    <button id="submitBtn" class="tb-primary"><i class="fas fa-flag-checkered"></i> Submit</button>
  </div>

  <div class="toolbar-group">
    <button id="saveBtn"><i class="fas fa-save"></i> Save</button>
    <button id="resetBtn"><i class="fas fa-rotate-right"></i> Reset</button>
  </div>

  <div class="toolbar-group">
    <button id="screenshotBtn"><i class="fas fa-camera"></i> Screenshot</button>
    <button id="recordBtn"><i class="fas fa-circle"></i> Record</button>
    <button id="stopRecordBtn" style="display: none">
      <i class="fas fa-stop"></i> Stop Recording
    </button>
    <div id="recordingTimer" class="recording-timer">🔴 REC 00:00</div>
  </div>

  <div class="toolbar-group">
    <button id="fullscreenBtn"><i class="fas fa-expand"></i> Full Screen</button>
    <button id="exitFullscreenBtn" style="display: none">
      <i class="fas fa-compress"></i> Minimize
    </button>
  </div>

  <div id="runStatus">Ready</div>
</div>

<% if (lessonLab) { %>
  <div class="blockly-lesson-banner">
    <strong>🧩 <%= lessonLab.title %></strong>
    <% if (lessonLab.description) { %><p><%= lessonLab.description %></p><% } %>
    <% if (lessonLab.instructions) { %>
      <details>
        <summary>Instructions</summary>
        <div style="white-space:pre-wrap;"><%= lessonLab.instructions %></div>
      </details>
    <% } %>
  </div>
<% } %>

<div class="blockly-container">
  <div class="block-console">
    <div class="blockly-wrapper">
      <% if (info?.logo_url) { %>
      <img
        src="<%= info.logo_url %>"
        class="workspace-logo"
        alt="Company Logo"
      />
      <% } %>

      <div id="blocklyDiv"></div>
    </div>

    <div id="console">This is the console area</div>
  </div>

  <div class="stage-panel">
    <div class="stage-area">
      <!-- Stage -->
      <div id="stage">
        <div id="recordCursor"></div>
        <div id="mouseXIndicator">X: 0</div>
        <div id="mouseYIndicator">Y: 0</div>
        <canvas id="penCanvas"></canvas>
          <div id="askBox" class="ask-box" style="display:none;">
            <div id="askQuestion"></div>
            
            <input
              type="text"
              id="askInput"
              placeholder="Type your answer..."
            />

            <button id="askSubmit">
              OK
            </button>
          </div>
        <img
          id="sprite"
          class="extra-sprite"
          src="/labs/images/sprites/Jay.png"
        />

        <!-- <div id="spriteContainer">
            <img
              id="sprite"
              class="extra-sprite"
              src="/labs/images/sprites/Jay.png"
            />
        </div> -->
      </div>
    </div>
    <!-- Sprite Panel -->
    <div class="asset-row">
      <div class="sprite-panel">
        <!-- Compact Sprite Info -->
        <div class="sprite-properties">
          <div class="sprite-top-row">
            <span class="label">Sprite</span>

            <input id="spriteName" type="text" />

            <span>X</span>
            <input id="spriteX" type="number" />

            <span>Y</span>
            <input id="spriteY" type="number" />
          </div>

          <div class="sprite-bottom-row">
            <span>Size</span>
            <input id="spriteWidth" type="number" />
            <input id="spriteHeight" type="number" />

            <span>Direction</span>
            <input id="spriteRotation" type="number" />

            <label class="show-toggle">
              <input type="checkbox" id="spriteVisible" />
              Show
            </label>
          </div>
        </div>

        <div id="spriteList"></div>

        <button id="addSpriteBtn">+ Add Sprite</button>
        <!-- <button id="addSpriteBtn">
              <i class="fa-solid fa-plus"></i>
          </button> -->
      </div>
      <!-- Background Panel -->
      <div class="background-panel">
        <button id="addBackgroundBtn">+ Add Background</button>

        <div id="backgroundList"></div>
      </div>
    </div>
    <!-- <div id="console"></div> -->
  </div>
</div>

  <div id="xMonitor" class="monitor">
    X: 0
  </div>
<xml id="toolbox" style="display: none">

  <!-- MOTION -->
  <category name="Motion" colour="#4C97FF">
    <block type="move_sprite">
      <value name="STEPS">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>

    <block type="turn_sprite">
      <value name="ANGLE">
        <shadow type="math_number">
          <field name="NUM">15</field>
        </shadow>
      </value>
    </block>

    <block type="point_direction">
      <value name="DIRECTION">
        <shadow type="math_number">
          <field name="NUM">90</field>
        </shadow>
      </value>
    </block>

    <block type="go_to_position">
      <value name="X">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>

      <value name="Y">
        <shadow type="math_number">
          <field name="NUM">0</field>
        </shadow>
      </value>
    </block>

    <block type="set_speed">
      <value name="SPEED">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>

    <block type="change_x">
      <value name="VALUE">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>

    <block type="change_y">
      <value name="VALUE">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>

    <block type="glide_to"></block>
  </category>

  <!-- LOOKS -->
  <category name="Looks" colour="#9966FF">
    <block type="say_text">
      <value name="TEXT">
        <shadow type="text">
          <field name="TEXT">Hello!</field>
        </shadow>
      </value>
    </block>

    <block type="say_for_seconds">
      <value name="TEXT">
        <shadow type="text">
          <field name="TEXT">Hello!</field>
        </shadow>
      </value>
    </block>

    <block type="set_background_image"></block>

    <block type="change_background"></block>

    <block type="add_sprite">
      <value name="X">
        <shadow type="math_number">
          <field name="NUM">100</field>
        </shadow>
      </value>

      <value name="Y">
        <shadow type="math_number">
          <field name="NUM">100</field>
        </shadow>
      </value>
    </block>

    <block type="set_sprite"></block>

    <block type="show_sprite"></block>

    <block type="hide_sprite"></block>

    <block type="set_sprite_size"></block>

    <block type="change_size_by"></block>

    <block type="next_background"></block>

    <block type="previous_background"></block>

    <block type="random_background"></block>
  </category>

  <!-- EVENTS -->
  <category name="Events" colour="#ffd900">
    <block type="when_run_clicked"></block>
    <block type="when_key_pressed"></block>

    <block type="when_sprite_clicked"></block>

    <block type="broadcast_message"></block>

    <!-- <block type="broadcast_wait"></block> -->

    <block type="when_message_received"></block>
  </category>

  <!-- CONTROL -->
  <category name="Control" colour="#ffab19">
    <block type="wait_seconds">
      <value name="SECONDS">
        <shadow type="math_number">
          <field name="NUM">1</field>
        </shadow>
      </value>
    </block>

    <block type="forever"></block>

    <block type="repeat_times">
      <value name="TIMES">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>

     <block type="if_block"></block>

    <block type="if_else_block"></block>

    <block type="repeat_until"></block>

    <block type="wait_until"></block>

    <block type="stop_all"></block>
  </category>

  <!-- LOGIC -->
  <category name="Logic" colour="#5c81a6">
    <block type="logic_compare"></block>

    <block type="logic_operation"></block>

    <block type="logic_negate"></block>

    <block type="logic_boolean"></block>

    <block type="logic_null"></block>

    <block type="logic_ternary"></block>
  </category>

  <!-- LOOPS -->
  <category name="Loops" colour="#ffab19">
    <block type="controls_repeat_ext"></block>

    <block type="controls_whileUntil"></block>

    <block type="controls_for"></block>

    <block type="controls_forEach"></block>

    <block type="controls_flow_statements"></block>
  </category>
  <!-- MATH -->
  <category name="Math" colour="#5ca65c">
    <block type="random_number">
      <value name="MIN">
        <shadow type="math_number">
          <field name="NUM">1</field>
        </shadow>
      </value>

      <value name="MAX">
        <shadow type="math_number">
          <field name="NUM">10</field>
        </shadow>
      </value>
    </block>

    <block type="math_number"></block>

    <block type="math_arithmetic"></block>

    <block type="math_single"></block>

    <block type="math_trig"></block>

    <block type="math_constant"></block>

    <block type="math_number_property"></block>

    <block type="math_round"></block>

    <block type="math_modulo"></block>

    <block type="math_constrain"></block>

    <block type="math_random_int"></block>

    <block type="math_random_float"></block>
  </category>

  <!-- TEXT -->
  <category name="Text" colour="#5ca68d">
    <block type="text"></block>

    <block type="text_join"></block>

    <block type="text_append"></block>

    <block type="text_length"></block>

    <block type="text_isEmpty"></block>

    <block type="text_indexOf"></block>

    <block type="text_charAt"></block>

    <block type="text_getSubstring"></block>

    <block type="text_changeCase"></block>

    <block type="text_trim"></block>

    <block type="text_prompt_ext"></block>
  </category>

  <!-- LISTS -->
  <category name="Lists" colour="#745ca6">
    <block type="lists_create_with"></block>

    <block type="lists_repeat"></block>

    <block type="lists_length"></block>

    <block type="lists_isEmpty"></block>

    <block type="lists_indexOf"></block>

    <block type="lists_getIndex"></block>

    <block type="lists_setIndex"></block>

    <block type="lists_sort"></block>
  </category>

  <!-- SENSING -->
  <category name="Sensing" colour="#5CB1D6">

    <block type="touching_edge"></block>
    <block type="when_touching_edge"></block>

    <block type="touching_sprite"></block>

    <block type="touching_mouse"></block>

    <block type="mouse_x"></block>

    <block type="mouse_y"></block>

    <block type="mouse_down"></block>

    <!-- <block type="distance_to_mouse"></block> -->

    <block type="key_pressed"></block>

    <block type="any_key_pressed"></block>

    <block type="last_key_pressed"></block>

    <block type="sprite_x_position"></block>

    <block type="sprite_y_position"></block>

    <!-- <block type="sprite_direction"></block> -->

    <!-- <block type="distance_to_edge"></block> -->

    <block type="ask_and_wait"></block>

    <block type="answer"></block>

    <block type="timer"></block>

    <block type="reset_timer"></block>

    <block type="show_variable_monitor"></block>

  </category>

  <!-- VARIABLES -->
  <category name="Variables" colour="#a65c81" custom="VARIABLE"> </category>

  <!-- FUNCTIONS -->
  <category name="Functions" colour="#995ba5" custom="PROCEDURE"> </category>

  <!-- CONSOLE -->
  <category name="Console" colour="#4caf50">
    <block type="print_message">
      <value name="TEXT">
        <shadow type="text">
          <field name="TEXT">Hello World</field>
        </shadow>
      </value>
    </block>
  </category>

  <category name="Pen" colour="#0fBD8C">

    <block type="pen_down"></block>

    <block type="pen_up"></block>

    <block type="clear_pen"></block>

    <block type="set_pen_color"></block>

    <block type="set_pen_size"></block>

    <block type="change_pen_size"></block>

  </category>
</xml>


<div id="spriteModal" class="modal">
  <div class="modal-content asset-picker-modal">
    <h3>Choose Sprite</h3>

    <input type="search" class="asset-picker-search" placeholder="🔍 Search sprites…"
           oninput="filterAssetPicker('sprite', this.value)" />

    <div class="asset-picker-tabs">
      <button class="asset-picker-tab active" data-filter="all" onclick="filterAssetPickerCategory('sprite','all', this)">All</button>
      <% spriteCategories.forEach(cat => { if (cat.assets.length) { %>
        <button class="asset-picker-tab" data-filter="<%= cat.id %>" onclick="filterAssetPickerCategory('sprite','<%= cat.id %>', this)"><%= cat.name %></button>
      <% } }) %>
    </div>

    <div class="asset-picker-scroll">
      <div class="sprite-grid" id="spriteGrid">
        <% spriteCategories.forEach(cat => { cat.assets.forEach(a => { %>
          <div class="asset-picker-item" data-cat="<%= cat.id %>" data-name="<%= a.name.toLowerCase() %>">
            <img src="<%= a.asset_url %>" title="<%= a.name %>" onclick="createSprite('<%= a.name %>', '<%= a.asset_url %>')" />
            <span class="asset-picker-label"><%= a.name %></span>
          </div>
        <% }) }) %>
      </div>
      <p class="asset-picker-empty" id="spriteGridEmpty" style="display:none">No sprites match your search.</p>
    </div>
  </div>
</div>

<div id="backgroundModal" class="modal">
  <div class="modal-content asset-picker-modal">
    <h3>Choose Background</h3>

    <input type="search" class="asset-picker-search" placeholder="🔍 Search backgrounds…"
           oninput="filterAssetPicker('background', this.value)" />

    <div class="asset-picker-tabs">
      <button class="asset-picker-tab active" data-filter="all" onclick="filterAssetPickerCategory('background','all', this)">All</button>
      <% backgroundCategories.forEach(cat => { if (cat.assets.length) { %>
        <button class="asset-picker-tab" data-filter="<%= cat.id %>" onclick="filterAssetPickerCategory('background','<%= cat.id %>', this)"><%= cat.name %></button>
      <% } }) %>
    </div>

    <div class="asset-picker-scroll">
      <div class="background-grid" id="backgroundGrid">
        <% backgroundCategories.forEach(cat => { cat.assets.forEach(a => { %>
          <div class="asset-picker-item" data-cat="<%= cat.id %>" data-name="<%= a.name.toLowerCase() %>">
            <img src="<%= a.asset_url %>" title="<%= a.name %>" onclick="addBackground('<%= a.asset_url %>', '<%= a.name %>')" />
            <span class="asset-picker-label"><%= a.name %></span>
          </div>
        <% }) }) %>
      </div>
      <p class="asset-picker-empty" id="backgroundGridEmpty" style="display:none">No backgrounds match your search.</p>
    </div>
  </div>
</div>
