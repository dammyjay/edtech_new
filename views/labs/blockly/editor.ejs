<script>
  // AI tutor context provider (public/labs/js/labAiTutor.js) — hands over
  // the current sprite's generated JavaScript each time the student asks
  // a question. `workspace` and `javascript` are blocklyLab.js's/Blockly's
  // own top-level script globals, in scope here since classic <script>
  // tags on one page share a global lexical environment.
  window.LAB_AI_TUTOR_TITLE = "🤖 Blockly Tutor";
  window.getLabAIContext = function () {
    try {
      const code = workspace ? javascript.javascriptGenerator.workspaceToCode(workspace) : "";
      const spriteName = window.currentSprite ? window.currentSprite.name : "";
      const header = spriteName ? `Sprite: ${spriteName}\n\n` : "";
      return { labType: "blockly", code: header + (code.trim() || "(no blocks placed yet)") };
    } catch (e) {
      console.error("getLabAIContext error:", e);
      return null;
    }
  };
</script>
